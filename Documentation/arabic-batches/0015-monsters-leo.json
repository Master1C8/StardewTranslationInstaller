    { "target": "Characters/Dialogue/Leo", "key": "Mon", "source": "Hi... Everything okay?", "translation": "مرحباً... هل كل شيء بخير؟" },
    { "target": "Characters/Dialogue/Leo", "key": "AcceptGift_(O)StardropTea", "source": "Wow, tastes just like golden walnuts! This is great!", "translation": "واو، مذاقه مثل الجوز الذهبي تماماً! هذا رائع!" },
    { "target": "Characters/Dialogue/Leo", "key": "AcceptGift_(TR)ParrotEgg", "source": "This is a precious egg... A baby! I'm glad you brought it to me, I'll keep it safe.", "translation": "هذه بيضة ثمينة... صغير! يسعدني أنك أحضرتها إليّ، سأحافظ عليها آمنة." },
    { "target": "Characters/Dialogue/Leo", "key": "Mon4", "source": "I've learned a lot from my parrot family...#$b#But I'm sure there's a lot more out there I don't know.$s", "translation": "تعلمت الكثير من عائلة الببغاوات التي أعيش معها...#$b#لكنني واثق بأن في الخارج أشياء أكثر بكثير لا أعرفها.$s" },
    { "target": "Characters/Dialogue/Leo", "key": "Tue", "source": "When Sun is angry, it feels good in the jungle.#$e#Sun can't find us beneath the leaves. We trick him! Haha...$h", "translation": "عندما تغضب الشمس، يكون الجو لطيفاً في الأدغال.#$e#لا تستطيع الشمس العثور علينا تحت الأوراق. لقد خدعناها! هاها...$h" },
    { "target": "Characters/Dialogue/Leo", "key": "Wed", "source": "...Sorry... I'm shy today.$3", "translation": "...آسف... أشعر بالخجل اليوم.$3" },
    { "target": "Characters/Dialogue/Leo", "key": "Wed2", "source": "Be careful in the volcano... the spirits don't like outsiders.", "translation": "كن حذراً في البركان... فالأرواح لا تحب الغرباء." },
    { "target": "Characters/Dialogue/Leo", "key": "Thu", "source": "Have you met the others like you?#$b#I don't talk to them much. I feel safer with my own kind...$3", "translation": "هل قابلت الآخرين الذين يشبهونك؟#$b#لا أتحدث إليهم كثيراً. أشعر بأمان أكبر مع بني جنسي...$3" },
    { "target": "Characters/Dialogue/Leo", "key": "Fri", "source": "One time... I was at the top of the volcano at night, and I saw lights far, far away.#$b#I wonder if there are other bird families out there?$3", "translation": "ذات مرة... كنت على قمة البركان ليلاً، ورأيت أضواء بعيدة جداً جداً.#$b#أتساءل إن كانت هناك عائلات أخرى من الطيور في الخارج؟$3" },
    { "target": "Characters/Dialogue/Leo", "key": "Fri4", "source": "I wonder if I could see your home from the top of the volcano?", "translation": "أتساءل إن كنت أستطيع رؤية منزلك من قمة البركان؟" },
    { "target": "Characters/Dialogue/Leo", "key": "Sat", "source": "...I'm sad today.$s#$e#You go on... have fun. Let me be sad.$s", "translation": "...أنا حزين اليوم.$s#$e#اذهب أنت... واستمتع بوقتك. دعني أحزن.$s" },
    { "target": "Characters/Dialogue/Leo", "key": "Sun", "source": "When it rains, strange birds visit.#$b#I try to speak to them... but they fly away.$s#$b#I guess they don't want to be friends...$s", "translation": "عندما تمطر، تزورنا طيور غريبة.#$b#أحاول التحدث إليها... لكنها تطير بعيداً.$s#$b#أظن أنها لا تريد أن نصبح أصدقاء...$s" }
  ]
}
