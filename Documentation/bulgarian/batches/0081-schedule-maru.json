  "target": "Strings/schedules/Maru",
  "status": "reviewed",
  "entries": {
    "marriage_Mon.002": "Надявам се Пени някой ден да реши да се омъжи.",
    "winter_16.000": "Уау, технологията в това нещо е невероятна!",
    "marriageJob.000": "На работа съм, слънчице! Не позволявай на доктора да те види.",
    "marriageJob.002": "Смяната ми почти приключи...",
    "marriage_Mon.001": "Татко напредва добре с експеримента си.",
    "summer.000": "Трудно е човек наистина да осъзнае мащаба на вселената.$8",
    "marriage_Mon.000": "Хей! Мама изглежда се справя добре и без помощта ми. Тя е силна жена.",
    "marriageJob.001": "Хубаво е, че ме посещаваш.$h"
  },
