    "ElvishJewelry_Name": "Елфически накит",
    "ElvishJewelry_Description": "Мръсен, но все така красив. Отстрани има изящен надпис, който според някои е на древния език на елфите. Никога не са намирани елфически кости.",
    "Emerald_Name": "Изумруд",
    "Emerald_Description": "Скъпоценен камък с блестящ зелен цвят.",
    "EmeraldRing_Name": "Изумруден пръстен",
    "EmeraldRing_Description": "Увеличава скоростта на оръжието с 10%.",
    "EmeraldStone_Name": "Изумруден камък",
    "EmeraldStone_Description": "Разбий го, за да получиш изумруди.",
    "EnergyTonic_Name": "Енергиен тоник",
    "EnergyTonic_Description": "Възстановява много енергия.",
    "Enricher_Name": "Обогатител",
    "Enricher_Description": "Постави го върху пръскачка и го зареди с тор, за да нанася тора автоматично при засаждане на семена наблизо.",
    "Escargot_Name": "Ескарго",
    "Escargot_Description": "Напоени с масло охлюви, сготвени до съвършенство.",
    "Esperite_Name": "Есперит",
    "Esperite_Description": "Кристалите светят в яркозелено, когато бъдат стимулирани.",
    "ExplosiveAmmo_Name": "Взривни боеприпаси",
    "ExplosiveAmmo_Description": "Изстреляй ги с прашката.",
    "FairyDust_Name": "Приказен прах",
    "FairyDust_Description": "Поръси Бурета за ферментация, Пещи и друго оборудване за преработка, за да получиш продукта им незабавно.",
    "FairyRose_Name": "Приказна роза",
    "FairyRose_Description": "Стара народна легенда твърди, че сладкият аромат на това цвете привлича феи.",
    "FairySeeds_Name": "Приказни семена",
