    {
      "target": "Strings/Movies",
      "key": "NaturalWonders_Description",
      "field": null,
      "source": "Take a tour through the lands of the Ferngill Republic... from The Fern Islands to Zuzu City, this world is full of life!",
      "translation": "Vydejte se na prohlídku krajů Republiky Ferngill... Od Kapradinových ostrovů po město Zuzu je tento svět plný života!",
      "sourceSHA256": "034e48c3a8342d4535f1aa6f43e3ba8ed356313c97e59d25ff2b9cce6342f0bd",
      "translationSHA256": "74dcdc111497fa4c2cce6c2edab8fbfe667f5180e39c47fe5eb92f3db420a8a1",
