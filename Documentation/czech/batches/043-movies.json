    },
    {
      "target": "Strings/Movies",
      "key": "NaturalWonders_Scene8",
      "field": null,
      "source": "Finally, we return to the mainland, to visit one of the most pleasant areas of the continent... Stardew Valley.",
      "translation": "Nakonec se vrátíme na pevninu a navštívíme jednu z nejpříjemnějších oblastí kontinentu... údolí Stardew.",
      "sourceSHA256": "361283eb6a82c03a893b0a7952a03b177ac47440ff709a5b801d714bf1e2a9e5",
      "translationSHA256": "f554ff158f878ae464cc1e75bd8ccaca411d01b3082dbea05f2bf9ab45c98aef",
      "reviewChecks": [
