    {
      "target": "Strings/SpecialOrderStrings",
      "key": "Lewis_RE_Text_1",
      "field": null,
      "source": "Apparently, {Crop:TextPlural} are considered the latest 'superfood' in Zuzu City. ",
      "translation": "Plodina „{Crop:TextPlural}“ je prý ve městě Zuzu považována za nejnovější „superpotravinu“. ",
