      ]
    },
    {
      "target": "Strings/schedules/Evelyn",
      "key": "2.001",
      "field": null,
      "source": "Oh dear, is it an emergency? Why are you here?$s",
      "translation": "Ach bože, je to naléhavé? Proč jsi tady?$s",
      "sourceSHA256": "36e0c3226fc3a829d3493df85f477a0ff5e8aba845489b7901701379f1e394c7",
      "translationSHA256": "3f543c4aad8d5bb4e3e43f732c55eba7b2835e4a07e1294a3395530f5c4d5661",
      "reviewChecks": [
        "sourceMeaning",
