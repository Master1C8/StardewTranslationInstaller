  "reviewNote": "Read all 6 pairs twice after restoring Evelyns usual informal player address. Community Center restoration, Pelican Town tradition, George vocative, clinic concern and formal address to Harvey are all distinct and marker-safe.",
  "rows": [
    {
      "target": "Strings/schedules/Evelyn",
      "key": "Thu.000",
      "field": null,
      "source": "This place is full of memories for me. Thank you so much for restoring it.$h",
      "translation": "Tohle místo je pro mě plné vzpomínek. Moc děkuji za jeho obnovení.$h",
      "sourceSHA256": "04158562c4b12e46d96750145316d5a2f6976032940705d02c0b00bb3fb6aaf3",
      "translationSHA256": "23d0ab5a068ca98f97b9ec7d6414bcb17791a8841c6af77f36b6c4763f40665f",
      "reviewChecks": [
        "sourceMeaning",
