    {
      "target": "Strings/StringsFromCSFiles",
      "key": "SlayMonsterQuest.cs.13744",
      "field": null,
      "source": "Those slimes can be pretty dangerous in groups.#$b#It should be a little easier to go spelunking now, thanks to your efforts. Enjoy your reward!",
      "translation": "Ti slizové dokážou být ve skupinách pořádně nebezpeční.#$b#Díky tvému úsilí by teď mělo být prolézání jeskyní o něco snazší. Užij si odměnu!",
      "sourceSHA256": "5dc1025a34f925afc28e38332e3087bdfdd5e76f28d391e970b234b81ad78588",
      "translationSHA256": "4847e4ec195232ccf083d708ee8e502f637d2e120930d0fe3beacd7dcbba1a62",
      "reviewChecks": [
