      "key": "AcceptGift_(O)66",
      "field": null,
      "source": "$c 0.5#Wow... it's just my color! Thanks, @!$h#Thank you! This is my favorite stone. It's so pretty.",
      "translation": "$c 0.5#Páni... přesně moje barva! Díky, @!$h#Děkuju! Tohle je můj oblíbený kámen. Je tak krásný.",
      "sourceSHA256": "4f90a706e1496dcf786df6486a9b52b8530c5ab450dbf461f382b9b308836b29",
      "translationSHA256": "8d4d2c2d5340cfeb94236c8523258f013ded927947a36e545a5963b0d0a15f81",
      "reviewChecks": [
        "sourceMeaning",
