      ]
    },
    {
      "target": "Characters/Dialogue/Abigail",
      "key": "Event_Grave4",
      "field": null,
      "source": "Really? That's surprising.$8#$b#I've lived in the valley my whole life, but I've never really done anything memorable. I want to go on an adventure!$8",
      "translation": "Opravdu? To je překvapivé.$8#$b#V údolí žiju celý život, ale nikdy jsem neudělala nic opravdu nezapomenutelného. Chci vyrazit za dobrodružstvím!$8",
      "sourceSHA256": "a39ece773c751c392ece722565c7cca3f39fba535b89a294d87cdaeaa99d2215",
      "translationSHA256": "b291fe2659ce40c4a8be3b32b38e2183a652e2ddc19b510a3cd71cd1b1f9cf4d",
      "reviewChecks": [
