    {
      "target": "Characters/Dialogue/Abigail",
      "key": "Event_VideoGame_No",
      "field": null,
      "source": "Oh? *sigh*... I guess I'll never get past this level, then...$s",
      "translation": "Vážně? *povzdech*... Tak to se přes tuhle úroveň asi nikdy nedostanu...$s",
      "sourceSHA256": "ebee7b918072320b396cd9beee3fef34e2ed5dc10bafaa14a41038111e01094c",
      "translationSHA256": "6f804dc2692ded269954f69fd85460b8ef9f399f6ebb5b6c01b7d8a666bdb632",
      "reviewChecks": [
