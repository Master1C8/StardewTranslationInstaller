    {
      "target": "Characters/Dialogue/Abigail",
      "key": "Event_Grave1",
      "field": null,
      "source": "See? You understand why I'm out here, then.#$b#I've lived in the valley my whole life, but I've never really done anything memorable. I want to go on an adventure!$8",
      "translation": "Vidíš? Takže chápeš, proč jsem tady.#$b#V údolí žiju celý život, ale nikdy jsem neudělala nic opravdu nezapomenutelného. Chci vyrazit za dobrodružstvím!$8",
      "sourceSHA256": "d2ee0e029b0db7aa2de045b7522ab20579e5061b5cd6c987cdaa269cc8e13e38",
      "translationSHA256": "4511a5772d374626e30b94cef19257eee6ca3a229e6ccf7c5ea9e60ac3d455b0",
      "reviewChecks": [
        "sourceMeaning",
