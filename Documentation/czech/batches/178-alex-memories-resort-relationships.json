    {
      "target": "Characters/Dialogue/Alex",
      "key": "Resort_Towel_2",
      "field": null,
      "source": "Phew, it feels good to finally get these abs a little sunlight.#$e#Kind of a shame to have them hidden away all the time back home.",
      "translation": "Uf, je příjemné konečně dopřát břišním svalům trochu slunce.#$e#Je docela škoda mít je doma pořád schované.",
      "sourceSHA256": "5b4b149b6bc9594aa54850aeae66214f7082699a1e60599416488687c252eba9",
      "translationSHA256": "1d5e5c71d920c58938ab398ee65e398e55fa8828fce74e0bd7f90d427ecee546",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
