    {
      "target": "Characters/Dialogue/Alex",
      "key": "GreenRain_2",
      "field": null,
      "source": "I tried to go for a run this morning, but the plants have gone crazy! I couldn't get very far...",
      "translation": "Dnes ráno jsem se pokusil vyběhnout, ale rostliny se úplně zbláznily! Moc daleko jsem se nedostal...",
