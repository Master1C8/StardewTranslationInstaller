    {
      "target": "Characters/Dialogue/Alex",
      "key": "fishCaught_139",
      "field": null,
      "source": "I saw you catch that salmon.#$b#If you happen to make a 'salmon dinner' out of it, let me have a bite!",
      "translation": "Viděl jsem tě chytit toho lososa.#$b#Jestli z něj náhodou uděláš „lososovou večeři“, nech mi ochutnat!",
      "sourceSHA256": "028a5aaa707120e0f50257e7b44c4d9d78e798e61bba44318ee39275a70a444e",
      "translationSHA256": "289cc04d783cf203eefde2da3da62265bc01acd49ae7a7384e7b845167307f2d",
