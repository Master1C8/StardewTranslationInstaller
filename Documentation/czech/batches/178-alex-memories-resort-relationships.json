    {
      "target": "Characters/Dialogue/Alex",
      "key": "Resort_Shore",
      "field": null,
      "source": "I wonder how far I could swim out, and still make it back?#$e#I'm guessing at least a mile.#$b#... Don't worry, I'm not going to try it.$h",
      "translation": "Jak daleko bych asi dokázal doplavat a ještě se vrátit?#$e#Tipuju aspoň míli.#$b#... Neboj, zkoušet to nebudu.$h",
      "sourceSHA256": "3d8d1f5d76d82a7f70cbc2792d7a029f725805d4d332d487ceeaa50ce3cf1eee",
      "translationSHA256": "a4b8e34eb8d3457276143552f25b174769c9323034b2c397340a6a066832ebec",
