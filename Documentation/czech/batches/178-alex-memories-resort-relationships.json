    {
      "target": "Characters/Dialogue/Alex",
      "key": "Resort_Wander_2",
      "field": null,
      "source": "I wonder if anyone would be up for a volleyball tournament.#$e#Don't worry, I'll go easy!$h",
      "translation": "Zajímalo by mě, jestli by měl někdo chuť na volejbalový turnaj.#$e#Neboj, nebudu hrát naplno!$h",
      "sourceSHA256": "021ad5949998e5fcd120c5db772a31a3471726a0a503d0b78bd0a4f72b893751",
      "translationSHA256": "185488cf0105d3e41e79310e359415f1e91f2193fbd7d0a2a054297d293ef660",
