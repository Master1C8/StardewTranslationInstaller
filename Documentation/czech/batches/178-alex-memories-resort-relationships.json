    {
      "target": "Characters/Dialogue/Alex",
      "key": "Resort_Wander",
      "field": null,
      "source": "I knew I shoulda brought a frisbee... Oh well.$h",
      "translation": "Já věděl, že jsem si měl vzít frisbee... No nic.$h",
