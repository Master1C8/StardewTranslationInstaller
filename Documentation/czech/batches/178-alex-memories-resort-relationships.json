    {
      "target": "Characters/Dialogue/Alex",
      "key": "Resort_Towel",
      "field": null,
      "source": "With this island open, there's no excuse to be pasty anymore!",
      "translation": "Když je teď ostrov přístupný, už nikdo nemusí zůstávat bledý jako stěna!",
      "sourceSHA256": "55c4bb286b3359d117e3a1a0a0a8196a4d9de0b528c987ff04c80efbed512190",
      "translationSHA256": "827105c4db75ead8c06441717b5f4328abf27ff1a3a3fed6fd9069fb1d17d19c",
      "reviewChecks": [
        "sourceMeaning",
