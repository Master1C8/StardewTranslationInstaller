    {
      "target": "Characters/Dialogue/Alex",
      "key": "Resort_Towel_3",
      "field": null,
      "source": "When I go pro, I'll vacation on islands all around the world.#$e#But for now, this place will do just fine!$h",
      "translation": "Až budu profesionál, budu jezdit na dovolenou na ostrovy po celém světě.#$e#Prozatím mi ale tohle místo dokonale stačí!$h",
      "sourceSHA256": "45466b02511306ba490789efeeb802e1e324f6a7299ff9dc5827fc5dd18fff9f",
      "translationSHA256": "f2d16632d30482471f35ae16bd8e59cadca4420852ba4268a97001fbd0ff9053",
      "reviewChecks": [
