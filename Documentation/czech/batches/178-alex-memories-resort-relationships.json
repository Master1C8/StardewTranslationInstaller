    {
      "target": "Characters/Dialogue/Alex",
      "key": "GreenRain",
      "field": null,
      "source": "What's going on out there? Any action?#$e#I gotta stay here with my grandparents...$s",
      "translation": "Co se to venku děje? Je tam nějaká akce?#$e#Musím zůstat tady s prarodiči...$s",
      "sourceSHA256": "b0e317b8031904f3cb6b56cecb7deb59d5f8d2830bae86f981967804e10a64c4",
      "translationSHA256": "c1830774f948bd9f48bcd4e1e9820013d8e26557762968f68b5796545de3698e",
