    {
      "target": "Characters/Dialogue/Alex",
      "key": "winter_1",
      "field": null,
      "source": "Winter is kind of lame. There's too much snow to do anything fun.#$e#I guess some people like it.",
      "translation": "Zima stojí za houby. Je tu moc sněhu na to, aby se dalo dělat něco zábavného.#$e#Někteří lidé ji asi mají rádi.",
      "sourceSHA256": "8c8904b39c320e29ff9a415f6539d584b6aea479837e29753f164efd95b6fee0",
      "translationSHA256": "292c07b090e4640554b0bd1ba4b1b9319196449b57ae0b7807ef3d479986d483",
      "reviewChecks": [
