    {
      "target": "Characters/Dialogue/Alex",
      "key": "winter_Tue4",
      "field": null,
      "source": "Hey, @. Could you do me a favor?$l#$b#If you see Haley, tell her I'm busy.$l#$e#Thanks.",
      "translation": "Hej, @. Můžeš pro mě něco udělat?$l#$b#Jestli uvidíš Haley, řekni jí, že nemám čas.$l#$e#Díky.",
      "sourceSHA256": "3f2a023a5f4556aadf9610282e363d022325c9b688a7b937a0daa87fe0cab13c",
      "translationSHA256": "ce2fb51b12fa3d538a9bb0d76bb6b52da0dd862d99d375d2b6656c9da5e39bdf",
      "reviewChecks": [
