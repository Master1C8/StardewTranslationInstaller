    {
      "target": "Characters/Dialogue/Alex",
      "key": "winter_Sat6",
      "field": null,
      "source": "I guess it's interesting that some people are totally different than us, you know?#$b#I don't always understand why others act the way they do, but that's fine.",
      "translation": "Je vlastně zajímavé, že někteří lidé jsou úplně jiní než my, nemyslíš?#$b#Ne vždycky chápu, proč se ostatní chovají právě takhle, ale to nevadí.",
      "sourceSHA256": "2e763d73efc95f238f6e25f607c3f510feeadc5820aa51560399005b7fc14b76",
      "translationSHA256": "98a40007a2beb1e4561b08b2cff5c5a0bc8032b2ba481534c0369001a49cc509",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
