    {
      "target": "Characters/Dialogue/Alex",
      "key": "winter_Mon",
      "field": null,
      "source": "You like the snow? Me... I'm just looking forward to spring.",
      "translation": "Líbí se ti sníh? Já... Já se prostě těším na jaro.",
      "sourceSHA256": "fa982b34b508ff190ee0b0ca41126b752974d5c50de218a1ca67bbddb5e0aa3d",
      "translationSHA256": "c8e23ff564a2f14f638761796d33d3da55e30857844f547ddf5dbbb8a2309fde",
      "reviewChecks": [
        "sourceMeaning",
