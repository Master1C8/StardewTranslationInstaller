    {
      "target": "Characters/Dialogue/Alex",
      "key": "winter_Tue",
      "field": null,
      "source": "Hey, can you go find Haley and tell her I said 'hi'?",
      "translation": "Hej, můžeš prosím zajít za Haley a vyřídit jí ode mě pozdrav?",
      "sourceSHA256": "f5972625796fc4968b56b5921dc958525cba5123e14280f07364b41820a8b6bd",
      "translationSHA256": "39d5d1dc6dfdfff55d076d3e3c511a9722f79aac82f5dccc7be6da6dfa30506b",
      "reviewChecks": [
        "sourceMeaning",
