      "translation": "Kéž bych mohl ovládat počasí.",
      "sourceSHA256": "a745c5b75c71fbbd4112d2131c735916b7d53d3a19dace26c681048290f336cf",
      "translationSHA256": "283fd23937f77d3d52d703e4f431658bfa3274645fcc3e6b41e549aeddd1306d",
