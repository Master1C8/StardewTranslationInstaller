    {
      "target": "Characters/Dialogue/Alex",
      "key": "winter_Fri4",
      "field": null,
      "source": "You came all the way through the snow to see me?#$e#That's nice of you.$h",
      "translation": "Taková cesta sněhem jen kvůli mně?#$e#To je od tebe milé.$h",
      "sourceSHA256": "0fa8701ea13b5344977ae328082699d9b2aa6c6964559cad8642439bfc7c07e7",
      "translationSHA256": "b483a25ff49d21fa65113182a13212f9457f7904220158144c446d9ece61916a",
      "reviewChecks": [
        "sourceMeaning",
