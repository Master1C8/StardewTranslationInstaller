    },
    {
      "target": "Characters/Dialogue/Alex",
      "key": "winter_Tue_inlaw_Haley",
      "field": null,
      "source": "Oh, hey. How's the married life coming along?$9",
      "translation": "Jé, ahoj. Jak se daří v manželství?$9",
      "sourceSHA256": "38177674f207f4f1ed4ff1221e5892eafc9de211c11e538fc6ad2b1e87c7141a",
      "translationSHA256": "a58eaef37e4ed8e2c60b2840015ddc67bbe57e91d6142e30b17cfaa860e1d0d2",
      "reviewChecks": [
        "sourceMeaning",
