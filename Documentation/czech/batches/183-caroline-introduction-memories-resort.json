    {
      "target": "Characters/Dialogue/Caroline",
      "key": "GreenRain",
      "field": null,
      "source": "I've never seen green rain before... It must not be too dangerous if you made it here!",
      "translation": "Zelený déšť jsem ještě nikdy neviděla... Když se ti podařilo dorazit až sem, asi nebude moc nebezpečný!",
      "sourceSHA256": "f2730aecb9ca9bd3a5c2631f0d46932c14bd6367cc4c9244e6895299e49d3e09",
      "translationSHA256": "da51cab0d6b51538b4df6ab3729b7e25c17ce20af3fe6ecb8ee1d25a6276a363",
