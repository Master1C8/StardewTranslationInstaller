      "sourceSHA256": "3a6cfa0e98e62395f8e86d43b7c27d677f24368a229df9aae955a73c7a1b07b1",
      "translationSHA256": "6e01db518a93ad40df9a3fe198835b2d8f09ce7944dc422e550eaf8d781859e8",
