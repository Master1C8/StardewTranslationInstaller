    {
      "target": "Characters/Dialogue/Demetrius",
      "key": "fall_Tue",
      "field": null,
      "source": "We know a lot about nature thanks to science.#$e#But there's always a lot more to learn.",
      "translation": "Díky vědě toho o přírodě víme hodně.#$e#Vždycky se ale můžeme naučit ještě mnohem víc.",
      "sourceSHA256": "79ab65e96ad9d9bf58f7d5f13e5fbbeca6fb0acb55aa056bfcec0c21e234a73f",
      "translationSHA256": "63ef029f40c5a98acaca74e420929b96c1e68bbb6acb860c040e2f1f1854d22e",
      "reviewChecks": [
        "sourceMeaning",
