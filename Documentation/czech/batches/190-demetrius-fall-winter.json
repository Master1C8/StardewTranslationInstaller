    {
      "target": "Characters/Dialogue/Demetrius",
      "key": "fall_Fri_inlaw_Maru",
      "field": null,
      "source": "I'm still flabbergasted about Maru's secret robot... was it all a dream?",
      "translation": "Pořád nemůžu uvěřit tomu tajnému robotovi, kterého Maru sestrojila... Nebyl to všechno jen sen?",
      "sourceSHA256": "75135bd0303453fc72f4cb69677d2f618c3514f38e462687906e7161d24b453d",
      "translationSHA256": "df574f85ed4a45593567401eabf79ee7325368df3ba2d0f894605ba02a917a01",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
