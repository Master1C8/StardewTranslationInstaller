    {
      "target": "Characters/Dialogue/Demetrius",
      "key": "winter_Wed",
      "field": null,
      "source": "Do you have a kitchen in your house yet?#$e#Cooking is kind of like doing lab work.",
      "translation": "Máš už doma kuchyň?#$e#Vaření je tak trochu jako práce v laboratoři.",
      "sourceSHA256": "38ed026eee7c01c822e75342cff681128e5d659a4c54b48f498994e1cd077622",
      "translationSHA256": "51ef527d742fe8920f781e25cafb031da28abd05e519aa5d4a21fa7d2210f8ee",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/Demetrius",
      "key": "winter_Thu",
      "field": null,
      "source": "Do you have any animals on your farm?",
      "translation": "Máš na farmě nějaká zvířata?",
      "sourceSHA256": "c5f7c5b13cd3143434383faf5fb0e5f207bb62ff627cc256eef35cfefd81ed19",
      "translationSHA256": "61cf6886f869a579994a3b2470e09083c2410b5b0418f2b35a791dba433bb33b",
