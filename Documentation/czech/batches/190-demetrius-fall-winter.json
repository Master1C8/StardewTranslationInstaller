    {
      "target": "Characters/Dialogue/Demetrius",
      "key": "winter_Tue",
      "field": null,
      "source": "Talk to my wife if you want to increase the size of your house.",
      "translation": "Jestli chceš zvětšit dům, promluv si s mou ženou.",
      "sourceSHA256": "ced6f78622a34ea2248bc7a8d466fb0b7e245134cda343c6b8e35402802b9bf0",
      "translationSHA256": "6f4ed6f452a45bcef412444d8b9fa97752373ab2f2d566191953ae536700dddd",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
