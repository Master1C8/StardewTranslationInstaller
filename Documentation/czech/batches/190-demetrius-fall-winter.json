    {
      "target": "Characters/Dialogue/Demetrius",
      "key": "winter_Fri",
      "field": null,
      "source": "Hello.#$e#%Demetrius seems lost in thought.",
      "translation": "Ahoj.#$e#%Demetrius vypadá zamyšleně.",
      "sourceSHA256": "f9bd84f19da1ff2757f6906bcef5a46d89e34a43d8c17377a463a0499b0b16fc",
      "translationSHA256": "f7fbeba0c32173456eaee8b8804f680dceb597857d92069c27bb8fc103693062",
      "reviewChecks": [
