    {
      "target": "Characters/Dialogue/Demetrius",
      "key": "winter_Sun",
      "field": null,
      "source": "Feel free to harvest as much lumber and stone from this area as you please.",
      "translation": "Klidně si z této oblasti vezmi tolik dřeva a kamene, kolik jen chceš.",
      "sourceSHA256": "4724aa3f7ec28b517cf92c559c2338a66a7918662dd1cc0eed41bdc720a4b894",
      "translationSHA256": "d59860813c4bac008319c02e20a1e919f0a8ad2536dae84f2933ad8b8bf2e233",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
