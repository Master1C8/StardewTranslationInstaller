    {
      "target": "Characters/Dialogue/Demetrius",
      "key": "fall_Wed6",
      "field": null,
      "source": "Hi @. I'm always glad when you come for a visit.#$e#It's nice to have some company after all this lonely lab-work.",
      "translation": "Ahoj, @. Tvá návštěva mě vždycky potěší.#$e#Po té osamělé práci v laboratoři je příjemné mít společnost.",
      "sourceSHA256": "4651ff6103cdd40e38ff2e078a10f9f54348556e4d048b951902f3079a8b46fa",
      "translationSHA256": "8a9c30444cae3baf43cafe4faa25dcb54a556812f5a6f81ec9ef018a589c986a",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/Demetrius",
      "key": "winter_Mon",
      "field": null,
      "source": "I'm taking a break from my research right now.",
      "translation": "Právě teď odpočívám od výzkumu.",
      "sourceSHA256": "b09dc13624574b0c4db8f27783ca8f22d8e295d7e72b0aadb02d096073ac61ce",
      "translationSHA256": "651c6b73e4cac253a4b18dff843c568d5675e569826763bb79ef2d781339984d",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
