    },
    {
      "target": "Characters/Dialogue/Demetrius",
      "key": "fall_Thu",
      "field": null,
      "source": "How's the farming business going? It's corn season, isn't it?#$e#I can imagine it being pretty peaceful, working outdoors with plants all day.",
      "translation": "Jak se daří farmaření? Je sezóna kukuřice, že?#$e#Dovedu si představit, že celodenní práce venku s rostlinami je docela klidná.",
      "sourceSHA256": "904bf88386dbaf7a3f799cd07746794a2dd34138249792e57d0e9cf1c60c3826",
      "translationSHA256": "cc3ac59e15fec37f96f642a7757dc6af26793c5531213393eb701b47590b1217",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/Demetrius",
      "key": "fall_Fri",
      "field": null,
      "source": "Maru sure spends a lot of time working on those gadgets of hers.#$e#I'm glad she's so dedicated.",
      "translation": "Maru tráví prací na svých přístrojích opravdu hodně času.#$e#Jsem rád, že je tak odhodlaná.",
      "sourceSHA256": "e869ac98f08cdc49ded96ecaa6fb21d69a52f7fe7d49d89ddc05e82641ef4787",
      "translationSHA256": "000818394ddc8ff1640b08ddc6ef698a59011c37f512be6b4cbc10cea7c1e34a",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
