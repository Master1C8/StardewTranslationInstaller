    {
      "target": "Characters/Dialogue/Demetrius",
      "key": "fall_Mon",
      "field": null,
      "source": "During this time of year I divert my attentions to fungi.",
      "translation": "V tomto ročním období se zaměřuju na houby.",
      "sourceSHA256": "1c1dd99087b7aa699f7b804758e1b1962ac8b9695341d05e9d2fea26c2d7fea4",
      "translationSHA256": "ae1757c565c57765b75fedc5ce88b3361d0202a274e079b75b3b63f4e04da1cc",
      "reviewChecks": [
        "sourceMeaning",
