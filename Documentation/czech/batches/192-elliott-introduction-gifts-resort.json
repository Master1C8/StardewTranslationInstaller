    {
      "target": "Characters/Dialogue/Elliott",
      "key": "AcceptBirthdayGift_Negative",
      "field": null,
      "source": "Another year gone by, another gray hair... I suppose this gift can commemorate my decline.$s",
      "translation": "Další rok uplynul, další šedina... Tento dárek může být památkou na můj úpadek.$s",
      "sourceSHA256": "9209a86ff67d1f1f2887e6fff299c257003e9623ef21f78d8a4a40faaf709d83",
      "translationSHA256": "850b4a2cc9c1d338ee445bc524dd0d3c955a271df4a6263a4a219c96ac246367",
