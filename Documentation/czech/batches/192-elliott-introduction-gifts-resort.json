    {
      "target": "Characters/Dialogue/Elliott",
      "key": "SquidFest",
      "field": null,
      "source": "It's rare to see so many people at the beach. All for the love of squid!",
      "translation": "Tolik lidí se na pláži vidí málokdy. A všichni sem přišli z lásky k olihním!",
      "sourceSHA256": "1d9b7261c011db7b297052cb17341254d840c821e0d0db400174740e9cee9f1b",
      "translationSHA256": "e12fc28698b11493b84d6caa6cfd0d3bf6c1db1a808e26c898c74de4a3d82017",
