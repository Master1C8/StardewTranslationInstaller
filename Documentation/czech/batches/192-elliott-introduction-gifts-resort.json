    {
      "target": "Characters/Dialogue/Elliott",
      "key": "AcceptBirthdayGift_Positive",
      "field": null,
      "source": "I'm honored that you would remember my birthday! Thank you!$h",
      "translation": "Je mi ctí, že pamatuješ na mé narozeniny! Děkuju!$h",
