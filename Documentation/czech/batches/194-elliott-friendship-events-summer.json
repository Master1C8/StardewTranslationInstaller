    },
    {
      "target": "Characters/Dialogue/Elliott",
      "key": "Fri4",
      "field": null,
      "source": "Ah... do not get too close to my hair with a torch...$8",
      "translation": "Ach... nepřibližuj se prosím s pochodní příliš blízko k mým vlasům...$8",
      "sourceSHA256": "42337e8db6a571ee1ed03658ceb67c5bf7181e9602801c8e4c234dc87b5aaf07",
      "translationSHA256": "42b5f6050a6ab0180806fb5db34e422c20ef224be14084af082798ac197ccb06",
      "reviewChecks": [
        "sourceMeaning",
