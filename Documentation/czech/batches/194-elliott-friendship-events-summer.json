    {
      "target": "Characters/Dialogue/Elliott",
      "key": "event_boat1",
      "field": null,
      "source": "... I was worried you might not feel this way about another man.$l^So am I.$l",
      "translation": "... Bál jsem se, že k jinému muži možná necítíš totéž.$l^Já také.$l",
      "sourceSHA256": "fc753c3ad06afaf287f211e2d6217575528e72362ee869928644b56912e401f1",
      "translationSHA256": "e8e9497dce505065b5d0483a641d2c0e04c2c6e250307b61549804a835e13525",
      "reviewChecks": [
