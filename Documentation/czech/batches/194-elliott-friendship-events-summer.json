    {
      "target": "Characters/Dialogue/Elliott",
      "key": "Fri8",
      "field": null,
      "source": "I'll admit... it takes me several hours each morning to make my hair look this good.",
      "translation": "Přiznávám... Každé ráno mi trvá několik hodin, než své vlasy dovedu k takové dokonalosti.",
      "sourceSHA256": "09742e758d411174288979d6e0d52d9514dd807cdf5cc25f469549e3a34810a6",
      "translationSHA256": "25ee7dd7d6bb43f1e0fab75d3e23f667100b6e306b2bc59aa86815b62f62461a",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
