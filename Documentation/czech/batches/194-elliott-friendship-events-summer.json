    {
      "target": "Characters/Dialogue/Elliott",
      "key": "Sat",
      "field": null,
      "source": "You probably wouldn't like it inside my cabin. It's dark and full of spiders.$s",
      "translation": "Uvnitř mé chatky by se ti asi nelíbilo. Je tam tma a plno pavouků.$s",
      "sourceSHA256": "5fdb22e8c3447329983779a48d5330983e5755842670b34ffc7af3178e09b205",
      "translationSHA256": "5177ec17fda78d37417d56dbb54f178b6ca5d091a73034f5a18426ecd04ae880",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/Elliott",
      "key": "Sat4",
      "field": null,
      "source": "Please excuse the sorry state of my cabin.",
      "translation": "Omluv prosím žalostný stav mé chatky.",
      "sourceSHA256": "d0caf814993c43efe8a4ab91511325255e821e2662e11636ef58f1d0a989380a",
      "translationSHA256": "0401ade40286684a09f7f29122f8d83addd3167d48b2c640b6e57c38ff3bc8ef",
      "reviewChecks": [
        "sourceMeaning",
