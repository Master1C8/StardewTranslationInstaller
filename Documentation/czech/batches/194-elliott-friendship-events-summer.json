    {
      "target": "Characters/Dialogue/Elliott",
      "key": "summer_Mon4",
      "field": null,
      "source": "I know that I am kind of an 'oddball'.#$e#I hope you don't mind.$h",
      "translation": "Vím, že jsem tak trochu ‚podivín‘.#$e#Doufám, že ti to nevadí.$h",
      "sourceSHA256": "8c3ed40397fdf74a92f0ba9ac3cf3cfa4de77653bdfa5023da53da95d3369de7",
      "translationSHA256": "fa1b8eb58a51a4e47d000aba971f9e4bb686b8e31bcbbd710de1b3c2d903e119",
