    {
      "target": "Characters/Dialogue/Elliott",
      "key": "Sun",
      "field": null,
      "source": "Hello. I hope your new farming life is panning out as you'd hoped?",
      "translation": "Ahoj. Doufám, že se nový život na farmě vyvíjí podle tvých představ.",
      "sourceSHA256": "f57c929ac239970621f40c6844fcbd7cecd80f13239af3d45f49fae5f36628c7",
      "translationSHA256": "02a359244eb177888d8533df11bc2767c4e3b0a17e7799f3391839eecac33b41",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
