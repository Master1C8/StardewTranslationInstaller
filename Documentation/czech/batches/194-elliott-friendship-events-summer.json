    {
      "target": "Characters/Dialogue/Elliott",
      "key": "summer_Mon6",
      "field": null,
      "source": "@, I know you have faith in my abilities as a writer. That means a lot to me.$h",
      "translation": "@, vím, že věříš v mé spisovatelské schopnosti. Znamená to pro mě opravdu hodně.$h",
      "sourceSHA256": "9864880d0e2bf7f5416612549a3a3fd78832370dd8e2fe0879ece69dc5da64a2",
