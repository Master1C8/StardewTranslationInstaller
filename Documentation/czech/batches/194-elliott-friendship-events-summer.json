    {
      "target": "Characters/Dialogue/Elliott",
      "key": "Fri",
      "field": null,
      "source": "The fresh air of this valley is good for body and mind.#$e#A quick stroll outdoors always invigorates me.",
      "translation": "Svěží vzduch tohoto údolí prospívá tělu i mysli.#$e#Krátká procházka venku mě vždy povzbudí.",
      "sourceSHA256": "f457f5804af596e2fa1caf5dfaba19a274ab3092b50465cb07184e712e827570",
      "translationSHA256": "15a401e99974cf9219b8a3b05f38d62ac5c13877064210792c0d21d326ca4b01",
      "reviewChecks": [
        "sourceMeaning",
