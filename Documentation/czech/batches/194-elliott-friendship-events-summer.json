    {
      "target": "Characters/Dialogue/Elliott",
      "key": "event_toast4",
      "field": null,
      "source": "Ah, to a harmonious future for the community... what a virtuous idea.#$b#Here's to Pelican Town!",
      "translation": "Ach, na harmonickou budoucnost celé komunity... jak ctnostná myšlenka.#$b#Na Pelikánov!",
      "sourceSHA256": "932a8a71ac1b55a4c5b3ba990c130b5781673f44e0d6328a1334bd38f2532263",
      "translationSHA256": "d92d5b31974ab8a7c9561b185fd1e75df0844220040de8c8b6bdbc45f520b082",
