    {
      "target": "Characters/Dialogue/Elliott",
      "key": "Sun6",
      "field": null,
      "source": "Oh, @! I was hoping you'd show up.#$e#It's always a pleasure to see you.$h",
      "translation": "Ach, @! Doufal jsem, že se ukážeš.#$e#Pohled na tebe mě vždy potěší.$h",
      "sourceSHA256": "2008fca47297f5aef83e03001a34b364f6e494194a1b50bf2094d083766f0657",
      "translationSHA256": "6a3e86b34022667739812152c50eef26abc19cc6a620367694f97cf8e6e56854",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
