    {
      "target": "Characters/Dialogue/Elliott",
      "key": "event_idea3",
      "field": null,
      "source": "I would've never guessed! I suppose even those of the 'earthiest' profession sometimes have their heads in the stars.$h#$b#I'll remember that.",
      "translation": "To bych nikdy neuhodl! Zdá se, že i člověk z toho nejpozemštějšího povolání mívá hlavu mezi hvězdami.$h#$b#Budu na to pamatovat.",
      "sourceSHA256": "ea70d8454169ce2d3f7cae5e833543d835ae4d009397e671e924f8e1ec0749ce",
      "translationSHA256": "9a51897c2edab8982cbfcd76b9ca805f753953d7bbf2fd43942cfd558b92d9af",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
