    {
      "target": "Characters/Dialogue/Elliott",
      "key": "event_idea1",
      "field": null,
      "source": "Mystery, huh? It's definitely an exciting genre. I'll remember that.",
      "translation": "Záhada, říkáš? Rozhodně je to vzrušující žánr. Budu na to pamatovat.",
      "sourceSHA256": "9c1b09e3e2a82f70ced2d750a5ea634377f3bb2826e719ced685e742b66cf08e",
      "translationSHA256": "9f0752111aaf7304f37e2609602b1a73e7b7a675e9d81d9fe64de3a5f310ae08",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/Elliott",
      "key": "event_idea2",
      "field": null,
      "source": "Ah, one of the classic genres. I'll remember that.",
      "translation": "Ach, jeden z klasických žánrů. Budu na to pamatovat.",
      "sourceSHA256": "1698c4367e7e5dfb9d29c838228a052c8e53f17d13e215e9f82f3fd0a6e53fda",
      "translationSHA256": "6de56e88be97760e6403caee07582a7cb634b95702b366a6f978c5e20436094b",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
