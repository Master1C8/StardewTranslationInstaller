        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/Elliott",
      "key": "summer_Thu",
      "field": null,
      "source": "Oh dear! My shoes are filled with sand.$s#$e#That's the trouble with living on the beach.",
      "translation": "Ach běda! Mám boty plné písku.$s#$e#Takové jsou strasti života na pláži.",
      "sourceSHA256": "5ff8a9e8c0e2da2a7fae41ea7536a1a63e25977c77682b9409b986852e355c40",
      "translationSHA256": "40867cefeba3b747e3382ef90e8a41b2cfb66ef7cd1dc84b3c7abcc8e61a3761",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/Elliott",
      "key": "summer_Fri",
      "field": null,
      "source": "@? You look puzzled.#$b#I guess the hot summer air can make us a little dizzy.",
      "translation": "@? Vypadáš zmateně.#$b#Horký letní vzduch nám asi dokáže trochu zamotat hlavu.",
      "sourceSHA256": "3f5fb69795c6e3324cb8cd483d4f1c4ea48dab274a77c3677545be6c3125fb7b",
      "translationSHA256": "ea23b026a4fb83c897f22f33f4b454e587cede72f83c8c51455307aa7285bc7d",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/Elliott",
      "key": "summer_Sat",
      "field": null,
      "source": "The sun is angry today... My skin is a bit too delicate, I'm afraid.",
      "translation": "Slunce se dnes hněvá... Obávám se, že má pokožka je poněkud příliš citlivá.",
      "sourceSHA256": "cf1929c40a2d52e1b6cfc93a868f16e8a5e641805a5a8108768a61d4ce4ee74c",
      "translationSHA256": "a4023f712a9340416de6d383e252f3b0311d962e447d09e7383f1b297696e26e",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/Elliott",
      "key": "summer_Sun",
      "field": null,
      "source": "You came all the way here just to talk to me? How kind.$h",
      "translation": "Taková cesta jen kvůli rozhovoru se mnou? Jak laskavé.$h",
      "sourceSHA256": "bd57b066abc09e56a43108377ce4e55ba4561003e2a2548e3ad30633c4ab13c1",
      "translationSHA256": "c7073e3193c615a67f3a8da7579c20f2934d264e1d9bef4a94f721365b1fd4cd",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/Elliott",
      "key": "summer_Sun4",
      "field": null,
      "source": "Visit my cabin whenever you like. I could use the company.$h",
      "translation": "Navštiv mou chatku, kdykoli budeš chtít. Společnost by mi prospěla.$h",
      "sourceSHA256": "23644384153661941167063d0cc517f6a6d6246e7a213d5eac50654aa988ae63",
      "translationSHA256": "cfff9882426142d228dd4b82496c90f2119f7044502e09aee30efae64069db67",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/Elliott",
      "key": "fall_Mon",
      "field": null,
      "source": "Hello @.#$e#Make sure and take breaks from your work now and then.",
      "translation": "Ahoj, @.#$e#Nezapomínej si při práci čas od času odpočinout.",
      "sourceSHA256": "31985f960c5057ce3d28fce124afa83e0618e6d3762baec20afb589ac99c90cb",
      "translationSHA256": "7fe4b8ecb9e253b527ae0644feeab48ca1ceb251ddfe6842661552b174e2927f",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/Elliott",
      "key": "fall_Mon4",
      "field": null,
      "source": "Come visit me if you need a break from your labors.$h#$e#I'm usually at my house.",
      "translation": "Přijď mě navštívit, kdykoli si budeš chtít odpočinout od lopoty.$h#$e#Obvykle bývám doma.",
      "sourceSHA256": "7ad0ec5d265c98baad0d0a2c28648616b2192cab812833430566bfbc57fdb5eb",
      "translationSHA256": "5421446c1d253467cb38dfff63f13d51517fed97f8fe8ccbf9d5191f25d0cdff",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/Elliott",
      "key": "fall_Tue",
      "field": null,
      "source": "It's been said that a pirate's ship, full of plundered gold, shipwrecked here a long time ago.",
      "translation": "Říká se, že tu před mnoha lety ztroskotala pirátská loď plná uloupeného zlata.",
      "sourceSHA256": "a4838acf6e60b9eb4d01fe9cb4a66fbf40e60378373cb2169e31ea1e73b7d1b0",
      "translationSHA256": "62f7c3a0afdf8624ac5f72d4045c8c74574cfd9386db406685c75623e5196d2e",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/Elliott",
      "key": "GreenRain",
      "field": null,
      "source": "Let's not get in a tizzy, now... Gus! I propose a round of drinks to settle the nerves!%noturn",
      "translation": "Nepropadejme teď panice... Gusi! Navrhuju, abychom si dali rundu na uklidnění nervů!%noturn",
      "sourceSHA256": "a15722f33834bd1d88f7cd24c44859a21686aefec83757cde9b3533a0a56ce64",
      "translationSHA256": "13ae93b77e35998591d2cadc6395a9d5975bc2526ffa57f81435f77e943baebf",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/Elliott",
      "key": "GreenRain_2",
      "field": null,
      "source": "Ah, yet another unique day in the valley. Stimulating, to say the least!",
      "translation": "Ach, další jedinečný den v údolí. Přinejmenším je podnětný!",
      "sourceSHA256": "7a0be893170fc3968c2cec047f9979fd07c599d383cddcfa3ca17bd360dcbcfb",
      "translationSHA256": "33e087fa16f66d3f40bb1260f24ee40e0425893885291e6292b5d781ce57dd2a",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/Elliott",
      "key": "fall_Tue8",
      "field": null,
      "source": "@, I was just thinking about you.$l#$e#Maybe you sensed it.$h#$e#So! Tell me about your day.",
      "translation": "@, právě jsem na tebe myslel.$l#$e#Možná k tobě ta myšlenka dolehla.$h#$e#Nuže! Vyprávěj mi o svém dni.",
      "sourceSHA256": "24e5f4f8080c47c4dcd0ca8fdaaeffff99575091e19374dd4782e68d462b18b9",
      "translationSHA256": "126a2f47a47ebd4aac40812e679c52a739f802ce4dca7bce96cbb3a45036c2b5",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/Elliott",
      "key": "fall_Wed8",
      "field": null,
      "source": "I wouldn't mind trying my hand at farming.#$e#The quiet atmosphere of a farm might be a good source of literary inspiration, don't you think?$h",
      "translation": "Nevadilo by mi zkusit farmařit.#$e#Klidná atmosféra farmy by mohla být dobrým zdrojem literární inspirace, nemyslíš?$h",
      "sourceSHA256": "7533710726872f98b8ddf29372a0fce22ee257ad12521ae820e074d5aac3cbc4",
      "translationSHA256": "461ddfacdaea2e12ab825d742c2d2d9d7bc416ad8b397c87494e83c4bad117b6",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/Elliott",
      "key": "fall_Thu",
      "field": null,
      "source": "Oh dear! A tiny crab appears to have made his home in my shirt pocket.$l#$e#That's the trouble with living on the beach.",
      "translation": "Ach běda! Zdá se, že se mi v náprsní kapse zabydlel drobný krab.$l#$e#Takové jsou strasti života na pláži.",
      "sourceSHA256": "69f82f9f235d743939d6756f61704e989b9ca9024c3bd2f8d2738cd8d63bf6ac",
      "translationSHA256": "ad0b559bdcaa10d44301edb8b228145777deb56b0c2504bf78df2ce82f23605e",
