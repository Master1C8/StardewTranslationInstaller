    },
    {
      "target": "Characters/Dialogue/Elliott",
      "key": "summer_Wed",
      "field": null,
      "source": "It must be satisfying to follow your crop from seed to harvest.#$e#It's as if your essence is infused into the fruit.$u",
      "translation": "Musí být uspokojivé sledovat cestu plodiny od semínka až ke sklizni.#$e#Jako by plod vstřebal část tvé podstaty.$u",
      "sourceSHA256": "4452b5254c925af7961938db171bc4ca4e91fbd8f6ea99126008741f607a1e89",
      "translationSHA256": "baa4458104ae75d98a3bae6e2e4ae45ab7cc1d75ac5dc7776a50313a200fa37e",
      "reviewChecks": [
        "sourceMeaning",
