      "target": "Characters/Dialogue/Emily",
      "key": "Tue",
      "field": null,
      "source": "I work part-time at Gus' saloon. It pays the bills.",
      "translation": "Pracuju na částečný úvazek v Saloonu U Hvězdné kapky. Pokryje mi to účty.",
      "sourceSHA256": "f3ceeef092b9e927e4c889dcf843f9d1b709445634dfccbdeaa198f0f782cf94",
      "translationSHA256": "f99991dc6ceb4f7bd6db46e237aa291022c17c7871e2371aaa4e4197b4b80fcc",
