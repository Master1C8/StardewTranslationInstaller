    {
      "target": "Characters/Dialogue/Emily",
      "key": "Resort",
      "field": null,
      "source": "If you open your heart to the sun, you can feel a loving energy inside of you.$h",
      "translation": "Když otevřeš srdce slunci, ucítíš v sobě láskyplnou energii.$h",
