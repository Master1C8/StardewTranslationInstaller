    {
      "target": "Characters/Dialogue/Emily",
      "key": "divorced",
      "field": null,
      "source": "@... You broke my heart... I just can't talk to you anymore.$s#$e#Please, let me try to heal...$s",
      "translation": "@... Kvůli tobě mám zlomené srdce... Už s tebou prostě nemůžu mluvit.$s#$e#Prosím, nech mě, abych se mohla zotavit...$s",
