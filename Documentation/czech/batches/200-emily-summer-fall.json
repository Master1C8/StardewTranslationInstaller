    {
      "target": "Characters/Dialogue/Emily",
      "key": "summer_Sun4",
      "field": null,
      "source": "It's around this time of year that my good friends visit the region... I mean the parrots!",
      "translation": "Právě v tuhle roční dobu navštěvují kraj mí dobří přátelé... Mám na mysli papoušky!",
      "sourceSHA256": "c477afbd52bd1984286958afef0b1f657e85279b76e7be8bb3b0ad47f641b1c7",
      "translationSHA256": "a6af144e2eae66e801a90305120cac93b161968307443256070305039b1be762",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
