      ]
    },
    {
      "target": "Characters/Dialogue/Emily",
      "key": "fall_1",
      "field": null,
      "source": "Well, fall is here. Time to plant some new crops, huh?",
      "translation": "Tak už je tu podzim. Čas zasadit nějaké nové plodiny, že?",
      "sourceSHA256": "cc857c502fbc83a4984897cdde964724c74ba32a224509687c1ede0e9a52e57e",
      "translationSHA256": "7d19ef9146c92060813a5e83b42963b181fa1588fcba3a62cd23ef24596bbf54",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
