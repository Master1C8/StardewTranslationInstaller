      ]
    },
    {
      "target": "Characters/Dialogue/Emily",
      "key": "fall_Mon",
      "field": null,
      "source": "It's good weather for a picnic, isn't it?",
      "translation": "Na piknik je pěkné počasí, že?",
      "sourceSHA256": "a89aa51f25c88144ac0352f86bc85b84eca4ce309dd251d81d516431acedec3d",
      "translationSHA256": "4dfa495108c7466d6fc0688865f82ed33c8181375b4be9ee5b6ca7e56710312d",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/Emily",
      "key": "fall_Mon8",
      "field": null,
      "source": "If I didn't have to work I'd suggest we go on a nice picnic!",
      "translation": "Kdybych nemusela pracovat, navrhla bych, abychom vyrazili na příjemný piknik!",
      "sourceSHA256": "890f421785b2ce4aff3f0c5c0224c35633de02d5787de055503849a23003a68b",
      "translationSHA256": "68171cd6f0032e85bb07eb58d84b865658d6c6f08c2711699908cde54956ede7",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/Emily",
      "key": "fall_Tue",
      "field": null,
      "source": "Hello. Did you have a good summer?",
      "translation": "Ahoj. Jaké bylo léto?",
      "sourceSHA256": "dcf06ad07e049d12fd3cbcc950d483b05f71afc0a9239e2efad8f0f8d14f9d82",
      "translationSHA256": "b781fb6412a75602c8adf06a3b526f61c1976c240ea9d89a52aa1dc67cb52ad6",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/Emily",
      "key": "fall_Tue4",
      "field": null,
      "source": "Hi @! I bet your farm did great this past summer, huh?#$e#You're an excellent farmer.$h",
      "translation": "Ahoj, @! Vsadím se, že si tvá farma minulé léto vedla skvěle, co?#$e#Farmaření ti jde výborně.$h",
      "sourceSHA256": "1fc0f219fed9d30746e6d84c4981d26f91201b30659567593de0fd39e677917c",
      "translationSHA256": "a03de43dea30af2d0a82660b227ad752a4536f9fc2a34375daf04d99bce3bcfa",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/Emily",
      "key": "fall_Wed",
      "field": null,
      "source": "My friend runs a shop in the desert. If you ever go there stop in and say hi for me.#$e#I think she sells some rare products.",
      "translation": "Má kamarádka vede obchod v poušti. Jestli se tam někdy vydáš, zastav se u ní a pozdravuj ji ode mě.#$e#Myslím, že prodává vzácné zboží.",
      "sourceSHA256": "cc5624da4699f2db3899398e799cbe479feae372fe6136386e455637d9a27f06",
      "translationSHA256": "1a69e939ccc79531537e0b0f781e7fc36a57d805e62541dc96cbda723f1431f0",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/Emily",
      "key": "fall_Thu",
      "field": null,
      "source": "Are you friends with Clint? He's a nice guy, if you get to know him.#$e#He gets lonely working in his shop all day. But he's so shy he has trouble making new friends.",
      "translation": "Přátelíš se s Clintem? Když ho člověk pozná, je moc milý.#$e#Když celý den pracuje ve své kovárně, bývá osamělý. Je ale tak plachý, že se mu těžko navazují nová přátelství.",
      "sourceSHA256": "7976fee845259bb6b3ece41f877684d664875d233d0d8ef187daa21bfe7513e6",
      "translationSHA256": "91dc045fdf76a657fe3bdf93a44cdd8cf52f7ef5cc1a8e9b2815ec7c81ab10bf",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/Emily",
      "key": "fall_Thu8",
      "field": null,
      "source": "I think Clint's mad at me. He never looks at me anymore...$u#$e#I always thought we were friends.$u",
      "translation": "Myslím, že se na mě Clint zlobí. Už se na mě ani nepodívá...$u#$e#Vždycky jsem si myslela, že jsme přátelé.$u",
      "sourceSHA256": "9ed9c4045d91680dbcdac5645955b0c628163be303a8b369ea845a8f9b5460e5",
      "translationSHA256": "a31f16ff0f2f1272d94deb86e9758d8551db5a0d0d94c0803fd6106487d545a9",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/Emily",
      "key": "fall_Fri",
      "field": null,
      "source": "Another beautiful fall day.#$e#It's a pity it'll soon be over.",
      "translation": "Další nádherný podzimní den.#$e#Škoda, že brzy skončí.",
      "sourceSHA256": "d7fb657a03aa6a23f4b9231c1a9a9261522f2f7051c7f47d7c2e9eb885f208d6",
      "translationSHA256": "e002684772204164f3d734badd32ab68f4326d53ddda59bef1a9f3878ed95eed",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/Emily",
      "key": "fall_Fri6",
      "field": null,
      "source": "Smell that clean air? It's lovely, isn't it?#$b#I just fear that the Joja Co.'s of the world will take this away from us.$u",
      "translation": "Cítíš ten čistý vzduch? Je nádherný, že?#$b#Jen se bojím, že nám ho vezmou společnosti jako Joja.$u",
      "sourceSHA256": "a57538abc2f2e55d6e07e1cbfc43f56267b6358e4dd43509b159c4a75fead6aa",
      "translationSHA256": "0e23dad239934c800ba28dec20bc8cdbad3752b8e2c1ccdb3607e983a7c62b1e",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/Emily",
      "key": "fall_Sat",
      "field": null,
      "source": "Keep your mind open and some interesting things might take root.#$e#Anyway, how is your day going?",
      "translation": "Udržuj si otevřenou mysl a možná v ní zakoření něco zajímavého.#$e#Každopádně, jak se ti dnes daří?",
      "sourceSHA256": "be4f308a6954477a23e1c6bf4c5dc46fc46cab702e125177a8a94b66100d7c87",
      "translationSHA256": "670a58b59176c95b16eaec2ff67a0879fac5b9a7a2b94175d3f927fe50cef2f8",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/Emily",
      "key": "fall_Sat6",
      "field": null,
      "source": "I don't have any huge plans for life. I prefer not to stress about the future.",
      "translation": "Nemám žádné velké životní plány. Raději se kvůli budoucnosti nestresuju.",
      "sourceSHA256": "b586bee73dbb388d74b44f63304d4281cb12527ffc504f2dddf7b283a8d6f527",
      "translationSHA256": "d89662b8dbd566dcce18433773231a98818a15b8261f32c4b8603bd334244b68",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
