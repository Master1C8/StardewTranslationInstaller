    {
      "target": "Characters/Dialogue/Emily",
      "key": "summer_Sun",
      "field": null,
      "source": "Hi @!",
      "translation": "Ahoj, @!",
      "sourceSHA256": "6478c43b537193fc1c54665a0a24c12559331a931451bb1b3019ec79b1497358",
      "translationSHA256": "fa57e34277ffaa17fe38043cbe48f0b64552aa883f670f0ae8afb66fc034b83f",
      "reviewChecks": [
        "sourceMeaning",
