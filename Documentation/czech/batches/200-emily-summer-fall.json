    {
      "target": "Characters/Dialogue/Emily",
      "key": "fall_15",
      "field": null,
      "source": "$d bus#I'm visiting Sandy today. We're best friends!#$e#I'm really happy that the bus is repaired.|*Sigh*... If only that old bus were fixed, I would've visited my friend Sandy today...$s",
      "translation": "$d bus#Dnes jedu navštívit Sandy. Jsme nejlepší kamarádky!#$e#Mám velkou radost, že je autobus opravený.|*povzdech*... Kdyby byl ten starý autobus opravený, dnes bych navštívila svou kamarádku Sandy...$s",
      "sourceSHA256": "3ef47c90b0003479ea18c56c2b23de4c06d642fca5596ac2614afa06f433ef3d",
      "translationSHA256": "f6d4720da4d5388612a27e034eefd0a6b21a934ea37a626640c3bda55484f3fe",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
