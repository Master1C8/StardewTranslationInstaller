    {
      "target": "Characters/Dialogue/Emily",
      "key": "summer_Wed",
      "field": null,
      "source": "It doesn't rain much in summer, does it?#$e#That just means more watering work for you, huh?#$e#Or do you enjoy the sunny weather?",
      "translation": "V létě moc neprší, že?#$e#Pro tebe to znamená jen víc práce se zaléváním, viď?#$e#Nebo si slunečné počasí užíváš?",
      "sourceSHA256": "63d608d3d54b17a8b2edcd0fb2fa819efd32d12000f027c008c35ec35143ab91",
      "translationSHA256": "1322a8362c474350dd7b1cd89c21db935444988fa418fdfb1ef34f5b43726d93",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/Emily",
      "key": "summer_Thu",
      "field": null,
      "source": "I consider the bees and butterflies to be my special friends!",
      "translation": "Včely a motýly považuju za své výjimečné přátele!",
      "sourceSHA256": "d5607288cb72135678c102098459b7baf351c4567f72f7834b7c845bc86319dc",
      "translationSHA256": "3e892c27710220eda8d9ecc4e31d8d1ba05583a2826c8f74409d2edf5654dd0b",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/Emily",
      "key": "summer_Fri",
      "field": null,
      "source": "If I wasn't so busy I'd come help you on the farm!#$e#But Gus would be upset if I had another job...$s",
      "translation": "Kdybych neměla tolik práce, přišla bych ti pomoct na farmu!#$e#Gus by se ale zlobil, kdybych měla ještě další práci...$s",
      "sourceSHA256": "9fb960281f116fc42f4293081c2f9928bd5a93caedcfc280ffeaa744c36c7f76",
      "translationSHA256": "cd97a64559267faea62447d81877c146680fa7959e095b2083c74941979536af",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/Emily",
      "key": "summer_Fri6",
      "field": null,
      "source": "You know, I'm sure Gus would understand if I wanted to leave the Saloon someday.#$b#There's so much out there, I can't stay a barmaid forever.$u",
      "translation": "Víš, určitě by Gus pochopil, kdybych jednoho dne chtěla odejít ze Saloonu U Hvězdné kapky.#$b#Venku toho na mě čeká tolik, nemůžu zůstat barmankou navždy.$u",
      "sourceSHA256": "ba64afdb48c0de8e947485d37dee48e8b9ecd9eceea1cd7275496d767f56aa7f",
      "translationSHA256": "a13c4118c91170fd4fdc1771c90da25d9a1011c8801eaeb97ed696e1f9972ff0",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/Emily",
      "key": "summer_Sat",
      "field": null,
      "source": "Don't overwork yourself or you might end up in Harvey's clinic!",
      "translation": "Nepřepracuj se, jinak můžeš skončit na Harveyho klinice!",
      "sourceSHA256": "28f3b224975fe6c26b8306346a1fb7160b6d2e3a3471c0363cfd0d4dfb319221",
      "translationSHA256": "13b7d93e00cfd4f7406540bbdafcdcbd2459aae1cff1d41f281e71088bcb8b6f",
      "reviewChecks": [
        "sourceMeaning",
