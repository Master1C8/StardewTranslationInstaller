    {
      "target": "Characters/Dialogue/Emily",
      "key": "summer_Sun8",
      "field": null,
      "source": "Hi, @! We've become decent friends, haven't we?$h#$e#This may sound weird, but I've always been certain this would happen.",
      "translation": "Ahoj, @! Vzniklo mezi námi docela pěkné přátelství, že?$h#$e#Možná to zní zvláštně, ale vždycky jsem věděla, že k tomu dojde.",
      "sourceSHA256": "486d8c1de616683a7fa61b140d3dc7db05dd992ebbb6377d47b3ba1829f6fb75",
      "translationSHA256": "5d1eff3f29bc9fe33757e046012c73041b82c0a1f1adb42f2fc460eca3186d2e",
      "reviewChecks": [
        "sourceMeaning",
