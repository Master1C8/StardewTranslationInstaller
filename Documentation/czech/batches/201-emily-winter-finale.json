        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/Emily",
      "key": "winter_Tue",
      "field": null,
      "source": "Oh, hello @!$h#$e#You must be getting very good at farming by now, huh?",
      "translation": "Jé, ahoj, @!$h#$e#Farmaření už ti teď musí jít opravdu dobře, že?",
      "sourceSHA256": "0557780e6610e505953fcfaa457c324fabd7ab4529800fb22610715ff3b4f365",
      "translationSHA256": "d0c1949d55fa49cf4413a9cbf3d812278cbccc11d4decdd293f5510bdefd3128",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/Emily",
      "key": "winter_Tue2",
      "field": null,
      "source": "I bet you're an excellent farmer by now!",
      "translation": "Vsadím se, že už ti farmaření jde skvěle!",
      "sourceSHA256": "8ecd81060b35dadce968e189d5a5da3f5681e105a6a865320179a45841a5e6c4",
      "translationSHA256": "0c5bf57a1cce7b627d59586b3488732f8a2cffaaa05f5933f07727e7269a2971",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/Emily",
      "key": "winter_Tue4",
      "field": null,
      "source": "I think my hair is frozen solid...$s",
      "translation": "Myslím, že mi vlasy zmrzly na kámen...$s",
      "sourceSHA256": "9ea410379e60cf0e421712ded38de2656c8f8be491b6ad43677a1b52fc424e7b",
      "translationSHA256": "50981945064b36b7f8b8d014fc3cb9630e3a73dc00447fcf03526d564c817cec",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
