    {
      "target": "Characters/Dialogue/Emily",
      "key": "fall_Sun6",
      "field": null,
      "source": "There's so many invisible barriers holding us back. Why can't people learn to let go and explore their true potential?#$e#Me? Well, you know what they say... 'You can't cage a wild Junimo'.",
      "translation": "Brzdí nás tolik neviditelných překážek. Proč se lidé nedokážou oprostit a prozkoumat svůj skutečný potenciál?#$e#Já? Však víš, co se říká... ‚Divokého junima do klece nezavřeš.‘",
      "sourceSHA256": "52ff2df3b04c7b21a7494e22e3496e2f4faf703359326f5d1240fd3b426af2bd",
      "translationSHA256": "e89dcb98337d3ac8588053e7f6f8a570c9e2ebb10b6249f199ce59b36591229f",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/Emily",
      "key": "fall_Sun10",
      "field": null,
      "source": "You're such a nice person, @! Thanks for being my friend.$h",
      "translation": "Máš tak dobré srdce, @! Díky za přátelství.$h",
      "sourceSHA256": "5e1df3dd7fed5f9ef7233c3e533360d4d831ea7bd251ad028da410df673c61b2",
      "translationSHA256": "444724c4d45631d5d7903af31681b7d406912b64cd1048c78a10cd747c6d4149",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/Emily",
      "key": "winter_Mon",
      "field": null,
      "source": "Be careful an icicle doesn't fall on your head!",
      "translation": "Pozor, ať ti na hlavu nespadne rampouch!",
      "sourceSHA256": "0161f43dc426df2f8c8e1219f0268179fb96e902fce7c885e264f69a9bed5db2",
      "translationSHA256": "3e9105647ae678a2fd2f731296514fde6d6bdc4cdb13d2b7f515bc2ef6f94c32",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/Emily",
      "key": "winter_Mon10",
      "field": null,
      "source": "Be careful an icicle doesn't fall on your head! I wouldn't want you to get hurt!",
      "translation": "Pozor, ať ti na hlavu nespadne rampouch! Nerada bych, aby se ti něco stalo!",
      "sourceSHA256": "24d8ca548bb25ca8f46247f6bd2b5d03aa0147a3299731ea702ea0a2b92b94dc",
      "translationSHA256": "df08cdb3d4da7779f4ebf01fe1f44ba51dce2c03a6d692425d822061b16ae9f4",
      "reviewChecks": [
        "sourceMeaning",
