  "rows": [
    {
      "target": "Characters/Dialogue/Emily",
      "key": "fall_Sun",
      "field": null,
      "source": "Nothing like a sunny Sunday to lift the spirits!",
      "translation": "Nic nepozvedne náladu tak jako slunečná neděle!",
      "sourceSHA256": "c76f9342d1ad819567a11f1f077bcb5f23214500fd642147751ef72f15e96309",
      "translationSHA256": "41d37235c24c8db95c36ebd290de2ee590e057bf0d857c527e6f9b8f5e424a2c",
      "reviewChecks": [
        "sourceMeaning",
