    },
    {
      "target": "Characters/Dialogue/Emily",
      "key": "winter_Sun6",
      "field": null,
      "source": "My sister and I might fight sometimes, but I would really miss her if she left.#$e#I think she'll become a very nice young lady some day... Don't tell her I said that.$h#$e#So, is there anything you want to talk about?",
      "translation": "Se sestrou se někdy hádáme, ale kdyby odešla, moc by mi chyběla.#$e#Myslím, že z ní jednou bude velmi milá mladá dáma... Neříkej jí, že jsem to řekla.$h#$e#Takže chceš o něčem mluvit?",
      "sourceSHA256": "c28c04bf1f79b8056b2b1b0887372e1937b562f4effe029ccc199b6bf40c1c66",
      "translationSHA256": "8904a3264ea5bc7500716ad0f856e064a30b66f5e43fe2104cf1069d22931f18",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/Emily",
      "key": "winter_Sun6_inlaw_Haley",
      "field": null,
      "source": "Say hi to my sister for me! And remind her to visit me tomorrow.",
      "translation": "Pozdravuj ode mě sestru! A připomeň jí, ať mě zítra navštíví.",
      "sourceSHA256": "389f0fef3bf0f8a6ff1281f9abe8ed43625468b6e6c7fc93c31f27edebf3b643",
      "translationSHA256": "806b09717a784731afc9b13f21134c686dd0a66f50b4ba89ff65214ebab39b52",
      "reviewChecks": [
