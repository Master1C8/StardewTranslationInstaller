    {
      "target": "Characters/Dialogue/Haley",
      "key": "Resort_Shore",
      "field": null,
      "source": "It's strange the places life can take you... who knows what other lands are out there?",
      "translation": "Je zvláštní, kam všude člověka život může zavést... Kdo ví, jaké další země ještě existují?",
      "sourceSHA256": "bb64efa5b64d91677f350a031d118d4559915a97e45da47a532ad2f8f0829d5e",
      "translationSHA256": "b4008042ced558df5522462e970e26b7174d8e38c8755033aaef6881432dedb5",
      "reviewChecks": [
        "sourceMeaning",
