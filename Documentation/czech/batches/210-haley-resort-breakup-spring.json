    {
      "target": "Characters/Dialogue/Haley",
      "key": "divorced",
      "field": null,
      "source": "I'll be fine on my own...$7#$e#Thanks for the memories.$7#$e#Why are you still clinging to me? Go live your own life.$7",
      "translation": "Sama budu v pohodě...$7#$e#Díky za vzpomínky.$7#$e#Proč se mě pořád držíš? Žij si vlastní život.$7",
      "sourceSHA256": "1c759ff3eaf5bcb9661e07942c2f3b94f36ba8beb5c348c6ea737dece911c606",
      "translationSHA256": "3ea127dc3737de9b5b930caf65626c1a147eabf3c868a9364b47272ae9670368",
      "reviewChecks": [
