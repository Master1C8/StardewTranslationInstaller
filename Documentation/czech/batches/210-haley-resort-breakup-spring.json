    {
      "target": "Characters/Dialogue/Haley",
      "key": "Resort_Towel_3",
      "field": null,
      "source": "Emily's friend had this swimsuit shipped to me from all the way out in Zuzu City.#$e#City fashion is on a whole different level, isn't it?$h",
      "translation": "Emilyina kamarádka mi tyhle plavky nechala poslat až z města Zuzu.#$e#Městská móda je na úplně jiné úrovni, viď?$h",
      "sourceSHA256": "64059a0f37b8227f078b6f18d4243efb5c48f56c1401c909bcd123626a7e6609",
      "translationSHA256": "b17ca9bff7262b6920632124181b65a045c37fd7be2bfa37704168af47240de5",
