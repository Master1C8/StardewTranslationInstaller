    {
      "target": "Characters/Dialogue/Haley",
      "key": "Resort_Bar",
      "field": null,
      "source": "Gus made a cute, fruity drink just for me!$h",
      "translation": "Gus jenom pro mě připravil roztomilý ovocný nápoj!$h",
      "sourceSHA256": "6b2212de433fdb35789a7468c65a411608ad522c395ec6c61cc75eb30a097d6b",
      "translationSHA256": "1188298d37e59e84732d1c9d6d0b57a0256e73c00329803e0d16d25a70ec9a92",
