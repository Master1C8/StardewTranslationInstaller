    {
      "target": "Characters/Dialogue/Haley",
      "key": "secondChance_Girls",
      "field": null,
      "source": "Alright, alright... I'm done giving you the cold shoulder. Just promise me you'll never, ever lie to me again.$s",
      "translation": "Dobře, dobře... Už tě přestanu přehlížet. Jen mi slib, že už mi nikdy, ale opravdu nikdy nebudeš lhát.$s",
      "sourceSHA256": "8e44b8fda93f93e0957c99e252255af2dec709a93f780b77edc8cc956a6e6a82",
      "translationSHA256": "1d82ea746304964fc33836056b0826ef7153fd3832e03911530c2a322255c34d",
