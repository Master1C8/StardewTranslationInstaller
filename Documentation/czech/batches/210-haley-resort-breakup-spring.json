    {
      "target": "Characters/Dialogue/Haley",
      "key": "Mon",
      "field": null,
      "source": "This town is so small. It sucks.$u#$e#I have to drive, like, twenty miles to buy any decent clothes.$s#$e#That's why I usually just order online.#$e#What?",
      "translation": "Tohle město je tak malé. Je to na nic.$u#$e#Za jakýmkoli slušným oblečením musím jet snad třicet kilometrů.$s#$e#Proto většinou objednávám přes internet.#$e#Co je?",
      "sourceSHA256": "7c2be07d37f413eba1303b88b4b28d1b96c9b6764ad781a86445551b04ca9b31",
      "translationSHA256": "6d75669dd88ae4ee9073affd9cf2b59af7682427225710c8a87faf4fbf7e9192",
