    {
      "target": "Characters/Dialogue/Haley",
      "key": "Tue",
      "field": null,
      "source": "Nice shoes.^Nice makeup.#$b#Are those made out of plastic?^Or wait... Are you even wearing any?#$e#I'm bored.",
      "translation": "Hezké boty.^Hezký make-up.#$b#Jsou z plastu?^Nebo počkat... Ty vůbec nějaký máš?#$e#Nudím se.",
      "sourceSHA256": "62dde76b176ca4e3b0b24805d6639980187a89d6afb86b64c29e1b594cea2568",
      "translationSHA256": "3443fd4d3346102537ab6f578c5c32d0508e7f006d6c62d746c1ce890e6eb2b2",
