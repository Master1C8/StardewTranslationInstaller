    {
      "target": "Characters/Dialogue/Haley",
      "key": "Resort_Leaving",
      "field": null,
      "source": "There's something about the sun that just makes me feel good.",
      "translation": "Slunce má v sobě něco, co mi prostě zvedá náladu.",
      "sourceSHA256": "919670549ced2418f0901c29654abbbd5e9b9e16293598c462357147583c3359",
      "translationSHA256": "86cf4b08f14ed3caf15f6050ec13c2577f1730f4efc2303a7c797073fb340aa8",
