    {
      "target": "Characters/Dialogue/Haley",
      "key": "Resort_Towel",
      "field": null,
      "source": "Getting the perfect tan is an art form...#$e#It's kind of like toasting a marshmallow... you have to rotate the body just right.$h",
      "translation": "Dokonalé opálení je umění...#$e#Je to trochu jako opékat marshmallow... Tělo musíš otáčet přesně tak, jak je potřeba.$h",
      "sourceSHA256": "9652086ef8fde383328cd65b4db7b68acd41894dbf721e73016db962ef99f1e6",
      "translationSHA256": "0ce87fb35fc6efd711b3295fbe1157a998f6abf7aca0d590cbb5f33bf0366a9b",
      "reviewChecks": [
        "sourceMeaning",
