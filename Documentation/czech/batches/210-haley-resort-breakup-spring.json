    {
      "target": "Characters/Dialogue/Haley",
      "key": "Resort",
      "field": null,
      "source": "This is such a perfect beach. I'd stay here forever if I could!",
      "translation": "Tohle je naprosto dokonalá pláž. Kdybych mohla, zůstala bych tu navždycky!",
      "sourceSHA256": "98214a96ef6ca2af6515998c4e87b05c3146734dc8fc8feb01758ade017cd299",
      "translationSHA256": "66788898b879746c2012fcc512462b15f0134d2fa0ab9e2dcbdbd89f5d22d526",
