    {
      "target": "Characters/Dialogue/Haley",
      "key": "Resort_Chair",
      "field": null,
      "source": "I painted my toenails blue to match the sea. What do you think? *wiggle* *wiggle*$h",
      "translation": "Nalakovala jsem si nehty na nohou modře, aby ladily s mořem. Co myslíš? *zavrtění prsty* *zavrtění prsty*$h",
      "sourceSHA256": "493b4e779a1b0df86c4ab41caa48720acb842245db4eabba804b35c61091a4b1",
      "translationSHA256": "fcd9b4c508a5bc10ca5cdb7766f0df8f0a78b1987285e6ff6c35d896429477f9",
