    {
      "target": "Characters/Dialogue/Haley",
      "key": "breakUp",
      "field": null,
      "source": "Agh!$8#$b#Oh... hmph. Beat me to it, huh? Alright...",
      "translation": "Kruci!$8#$b#Aha... hmpf. Tak jsem to nestihla říct první, co? Dobře...",
      "sourceSHA256": "1db0efa7f97d810985c5014490050e65dc9934ead8d8fd5d6b4bad813cb9a22f",
      "translationSHA256": "62d467a2af41b875515ae827e69c629fec11d0dd64228e7e4d32af2f5d395e1c",
      "reviewChecks": [
        "sourceMeaning",
