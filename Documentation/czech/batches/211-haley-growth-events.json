  "reviewNote": "Full package was previously reviewed. Rechecked Event_clean2 against English: the direct plural rebuke is restored without imposing player gender; all markers and other rows unchanged.",
  "rows": [
    {
      "target": "Characters/Dialogue/Haley",
      "key": "Fri2",
      "field": null,
      "source": "Don't you get tired of running around on that farm all day, or whatever it is you do?#$e#I couldn't stand getting all dirty like that.#$e#You probably get a nice tan, though.",
      "translation": "Neunavuje tě celý den pobíhat po farmě nebo dělat cokoli, co tam vlastně děláš?#$e#Nesnesla bych, kdybych se takhle celá ušpinila.#$e#Nejspíš se ale pěkně opálíš.",
      "sourceSHA256": "172e4fb989837825aeaf09688c4ed59911924636472957b9ea405e8b8cf0c8d6",
      "translationSHA256": "e6587f070d569287e9816e60566a9c2dd8ac62ea0fa8d86dd09307e3bbfebdac",
      "reviewChecks": [
