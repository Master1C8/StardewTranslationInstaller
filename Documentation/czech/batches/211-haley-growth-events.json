    {
      "target": "Characters/Dialogue/Haley",
      "key": "Sat",
      "field": null,
      "source": "I'm feeling an urge to go shopping. Ugh! I wish there was a mall here.",
      "translation": "Dostala jsem chuť jít nakupovat. Uf! Kéž by tu bylo nákupní centrum.",
      "sourceSHA256": "5b2cffac12f7e8b7828011c4641f2835f5281e0172b4684978a0a939cf32a9ff",
      "translationSHA256": "0b86d1e8a1f0a781b3f0aa5916559186eb23423a8d92b8806b41d53bfa463303",
      "reviewChecks": [
        "sourceMeaning",
