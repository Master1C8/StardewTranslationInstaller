    {
      "target": "Characters/Dialogue/Haley",
      "key": "Fri10",
      "field": null,
      "source": "@, can we go on a camping trip someday?#$e#The most exotic place I've been is Zuzu city.",
      "translation": "@, mohli bychom někdy vyrazit tábořit?#$e#Nejexotičtější místo, kde jsem kdy byla, je město Zuzu.",
      "sourceSHA256": "8bb6319438a6e33a87cf77d11c09ab10d35b24923f8d3bdb6ecee07424fd5e66",
      "translationSHA256": "a6b0037944dc4b376aa6745738f5f7b09174a284d3d3f6e3f50cc01e4e3654e4",
