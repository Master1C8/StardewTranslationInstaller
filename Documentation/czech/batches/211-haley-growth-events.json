      "sourceSHA256": "cd1e604571a6a1ab3cfbe6fd924f41d16d48f1b120d2cdc3a4dde06617320fc3",
      "translationSHA256": "c3c302ceab9cdf0cf7673122bdf64cf7c929f4579107e1ca0c8c9d74905e9e0c",
