    {
      "target": "Characters/Dialogue/Haley",
      "key": "Event_room1",
      "field": null,
      "source": "Him? No!#$b#...Well, I guess I used to like Alex. But not anymore! He's immature.",
      "translation": "On? Ne!#$b#...No, asi se mi Alex dřív líbil. Ale už ne! Je nezralý.",
