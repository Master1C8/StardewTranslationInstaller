    {
      "target": "Characters/Dialogue/Haley",
      "key": "summer_Mon6",
      "field": null,
      "source": "I should start reading some books instead of magazines.#$e#It's good to learn things, isn't it?#$e#I only ever look at the pictures.",
      "translation": "Měla bych začít číst knihy místo časopisů.#$e#Je dobré učit se nové věci, ne?#$e#Já se vždycky dívám jen na obrázky.",
      "sourceSHA256": "5b9e8ee0f5e8182b68ce4f23caaf04e6c19438919edc54d42102b4b9f36d80a7",
      "translationSHA256": "ee066b054c0e89d737fceca8a9a4740d5e26313b2c02751c850f0a08ce5aff15",
