      "target": "Characters/Dialogue/Haley",
      "key": "summer_Sat_13",
      "field": null,
      "source": "What? You'd better not be doing that!$a",
      "translation": "Cože? Ani se neopovažuj něco takového dělat!$a",
      "sourceSHA256": "59d73365447cfae97bafaa5e1f7d8ca64e96cb408c3b646bf696f4342b276333",
      "translationSHA256": "03919312b0c168413e03e18ff5d97154611863c8629ed5e059cfc3a581b2fb02",
