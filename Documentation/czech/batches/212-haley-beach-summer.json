      "translation": "Dneska je takové horko!#$e#Kéž bych měla nějakou zmrzlinu.$s",
      "sourceSHA256": "171abc98a583a350bbc0903bc6541e3c46f839698dda490b940f300db6c9af78",
      "translationSHA256": "0ff58a7bcb44c85e2b76c7514ad1e8e7653977fdb6b6f6ed5ce2e658fe474f0d",
      "reviewChecks": [
