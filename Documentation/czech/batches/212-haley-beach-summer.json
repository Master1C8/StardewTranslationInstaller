    {
      "target": "Characters/Dialogue/Haley",
      "key": "summer_10",
      "field": null,
      "source": "Do you have baby bunnies on your farm? Bunnies are SO cute! <",
      "translation": "Máš na farmě králíčata? Králíčci jsou TAK roztomilí! <",
      "sourceSHA256": "c3fe5d60f4be579fc3cbcb097cfef87aab358fab839d4efe2da6983b6d57068e",
      "translationSHA256": "2473d34fc7eb4bff2feb42ed540264dd4b843741debb0015f70c701199cacd22",
      "reviewChecks": [
        "sourceMeaning",
