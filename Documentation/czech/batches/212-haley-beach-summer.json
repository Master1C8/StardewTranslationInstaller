    {
      "target": "Characters/Dialogue/Haley",
      "key": "summer_Fri",
      "field": null,
      "source": "I wonder what Alex is doing today...#$e#Huh? I didn't notice you standing there.",
      "translation": "Zajímalo by mě, co dnes dělá Alex...#$e#Cože? Nevšimla jsem si, že tam stojíš.",
      "sourceSHA256": "89ea6e63506a1943821f32694ffc57205ab3bec6be5a0c99567acc937aff9da1",
      "translationSHA256": "f58e29bb02991b7992e9f86887ee9a2b457af081246b8f2bcee8f99f7ebf29f3",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
