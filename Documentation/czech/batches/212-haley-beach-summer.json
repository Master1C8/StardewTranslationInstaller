      "key": "summer_Tue4",
      "field": null,
      "source": "$p 47#Hey I found this new tool to open jars with. So you won't need to help me anymore.$h|There's not a cloud in the sky today.$h",
      "translation": "$p 47#Hele, našla jsem novou pomůcku na otevírání sklenic. Takže už mi nemusíš pomáhat.$h|Dnes není na obloze ani mráček.$h",
      "sourceSHA256": "e4c17316ff0e5625d5ae28d8fbe74984a3cc890b3403a098c952471e53cc2151",
      "translationSHA256": "eeaa383f493611890624427aac1f630e991a33080f1474bf16fa13ae6f1b512e",
