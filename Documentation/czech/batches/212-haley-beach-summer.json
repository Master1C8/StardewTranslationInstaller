    {
      "target": "Characters/Dialogue/Haley",
      "key": "summer_Fri4",
      "field": null,
      "source": "I spent 3 hours practicing my signature today.#$e#I guess that's pretty silly, huh?",
      "translation": "Dnes jsem strávila tři hodiny nacvičováním svého podpisu.#$e#Asi je to pěkně hloupé, co?",
      "sourceSHA256": "242c0c276b28013c9040809f68248524895581cda1040159627de442a1931017",
      "translationSHA256": "31ff6b4dfb2eecd88a90abdb9382150316f0688dc521051f4e998a61e37524f7",
      "reviewChecks": [
