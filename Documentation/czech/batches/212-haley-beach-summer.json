    {
      "target": "Characters/Dialogue/Haley",
      "key": "summer_Sat",
      "field": null,
      "source": "Farming sounds so boring...#$q 42/43 summer_Sat_old#What do you even do all day?#$r 42 10 summer_Sat_12#Care for plants#$r 42 10 summer_Sat_12#Explore the caves#$r 43 -10 summer_Sat_13#Snoop around in your room#$r 42 10 summer_Sat_12#Dig for treasure",
      "translation": "Farmaření zní tak nudně...#$q 42/43 summer_Sat_old#Co vlastně celý den děláš?#$r 42 10 summer_Sat_12#Starám se o rostliny#$r 42 10 summer_Sat_12#Prozkoumávám jeskyně#$r 43 -10 summer_Sat_13#Šmejdím ti v pokoji#$r 42 10 summer_Sat_12#Hledám poklady",
      "sourceSHA256": "da66aff45bb231ae99a09db1d3354f415f02478144bfabd6607568a50d30dbeb",
      "translationSHA256": "f6e53d10cb514542789dda0fe490d1b9e6a091b8a8e4b6c56567c882c588e9af",
