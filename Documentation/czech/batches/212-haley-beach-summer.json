    {
      "target": "Characters/Dialogue/Haley",
      "key": "summer_Wed",
      "field": null,
      "source": "Um... Yes?#$e#I didn't hear you, I'm thinking about something else.",
      "translation": "Ehm... Ano?#$e#Neslyšela jsem tě, přemýšlím o něčem jiném.",
      "sourceSHA256": "0b3286295b935576ee395ba10b57892d83a8d952f966e2bcee3a3ca8074798c6",
      "translationSHA256": "a94de0d3903c6b8cef8c6443930eed5282cc530481cf2fec9d5a43ce5a7d8621",
      "reviewChecks": [
