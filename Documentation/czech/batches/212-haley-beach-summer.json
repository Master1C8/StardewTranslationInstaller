    {
      "target": "Characters/Dialogue/Haley",
      "key": "summer_Thu",
      "field": null,
      "source": "If you stay in the sun a lot it'll make your hair lighter.#$e#It's a good thing to know!",
      "translation": "Když budeš trávit hodně času na slunci, zesvětlí ti vlasy.#$e#Je dobré to vědět!",
      "sourceSHA256": "c3f99a6d6d2e1c36da48f52a6663f7c161f162d45a817cd23e06a5350008ba39",
      "translationSHA256": "2a7d3e71294c5e0fb99ecce758684322bbbbe82d6e6427e71f9b1d10a79c4905",
      "reviewChecks": [
        "sourceMeaning",
