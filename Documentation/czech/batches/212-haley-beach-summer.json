    {
      "target": "Characters/Dialogue/Haley",
      "key": "summer_Sat_old",
      "field": null,
      "source": "#$p 43#Hey, you better not be snooping around in my room anymore!$a|But I guess it could get you in pretty good shape.",
      "translation": "#$p 43#Radši už mi v pokoji nešmejdi!$a|Ale asi se při tom můžeš dostat do docela dobré kondice.",
      "sourceSHA256": "b4890c9c5837efe9472ae3fb223cef554c5b2a35f8bfacd7b457bdff2764a166",
      "translationSHA256": "72849f1fe0dfb2686c8f27c83b8816e6b38d1e497db70a87ce18710e0979d543",
      "reviewChecks": [
