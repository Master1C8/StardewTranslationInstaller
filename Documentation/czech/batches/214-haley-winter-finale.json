    {
      "target": "Characters/Dialogue/Haley",
      "key": "winter_Sat",
      "field": null,
      "source": "The only good thing about winter is that I get to sleep more.#$e#I like at least 10 hours of sleep every night.",
      "translation": "Jediná dobrá věc na zimě je, že můžu víc spát.#$e#Každou noc potřebuji alespoň deset hodin spánku.",
      "sourceSHA256": "c63ba794e51acd42aa760922fb25fb042137e72807ac2c13d518e5cd70181a22",
      "translationSHA256": "70005637dfe6bfca366e5e6cfb911b748a432579e3e1b18ac265d91fdea0e558",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
