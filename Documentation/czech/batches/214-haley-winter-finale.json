    {
      "target": "Characters/Dialogue/Haley",
      "key": "winter_Tue2",
      "field": null,
      "source": "Your name is @, right?#$e#I keep forgetting.",
      "translation": "Jmenuješ se @, že?#$e#Pořád to zapomínám.",
      "sourceSHA256": "3b6fb140a4928fbafd6a73d1d8a11c97b5804c8a3f0b6e65f8d5ae88709e47c0",
      "translationSHA256": "44d92f8396abb2f98998139c23d7b9e4b60f1504711b3ad97eaf851f17757b7e",
      "reviewChecks": [
