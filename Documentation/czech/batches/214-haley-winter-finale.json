    {
      "target": "Characters/Dialogue/Haley",
      "key": "winter_Thu",
      "field": null,
      "source": "I'm going to start writing a list of all the clothes I need for next spring.",
      "translation": "Začnu si sepisovat seznam všeho oblečení, které budu potřebovat na příští jaro.",
      "sourceSHA256": "31a9dd8084469d53b22ef1ed318a15e9f2602318f23093f8d597ab22a16f2dcd",
      "translationSHA256": "ccb95b77340375bb6274c591d1c328a777fe2ce3f2b31453bc6f9c590464abf7",
      "reviewChecks": [
