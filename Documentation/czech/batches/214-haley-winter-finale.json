    {
      "target": "Characters/Dialogue/Haley",
      "key": "winter_9",
      "field": null,
      "source": "Hmm. What brand is your shirt?#$e#Oh. Um, never mind.",
      "translation": "Hmm. Jaká je značka tvé košile?#$e#Aha. Ehm, vlastně nic.",
      "sourceSHA256": "24a709709a60027e656af349ad0399cdba05a9735dbd30c6ad563d3f4504de19",
      "translationSHA256": "d734c3be34f4eb773e59393d6f1cf2a5bdedcf8d57615cd1a65502a02a5eaa14",
      "reviewChecks": [
        "sourceMeaning",
