    {
      "target": "Characters/Dialogue/Haley",
      "key": "winter_Wed",
      "field": null,
      "source": "I wish someone would bring me a peppermint coffee.$s#$e#Don't even bother, I know you won't be able to make one.",
      "translation": "Kéž by mi někdo přinesl mátovou kávu.$s#$e#Ani se o to nepokoušej, vím, že ji nebudeš umět připravit.",
      "sourceSHA256": "23f798b3f3887e9ec5e52d28a6e68fa5c1a1736950b3ee10af368b9dedf6e753",
      "translationSHA256": "1ce0e24f2c6dd4ad52a5751cc6941bca3387cff9417daf3b990892117ea7941c",
      "reviewChecks": [
        "sourceMeaning",
