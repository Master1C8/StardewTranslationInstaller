    },
    {
      "target": "Characters/Dialogue/Haley",
      "key": "winter_Sun",
      "field": null,
      "source": "Will you say hi to Alex for me?#$e#Thanks.",
      "translation": "Pozdravíš ode mě Alexe?#$e#Díky.",
      "sourceSHA256": "32977e672803d6ba3fc9d4bf73d5696f0ea63bce0df6b2e86819c7f341e8b207",
      "translationSHA256": "ced61b8415fc12675d32a0f8b1771625bb0e5d7cf5ce7e8359868da287fac5cc",
      "reviewChecks": [
