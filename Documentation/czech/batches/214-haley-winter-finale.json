      "target": "Characters/Dialogue/Haley",
      "key": "winter_Fri8",
      "field": null,
      "source": "Do you think you'll ever have a pony on your farm?",
      "translation": "Myslíš, že někdy budeš mít na farmě poníka?",
      "sourceSHA256": "5ac03ef645d87b55c960d845f4d92a24c121dfe8f55d86c42508e69a94a5c6fb",
      "translationSHA256": "9e4ff97e410017e26e6d39c534429c74160d94ed4b7b880f1a61df7f60010a7a",
      "reviewChecks": [
        "sourceMeaning",
