    {
      "target": "Characters/Dialogue/Haley",
      "key": "winter_Mon8",
      "field": null,
      "source": "I wish it were warmer here in Stardew Valley.#$e#I could move somewhere else, but...",
      "translation": "Kéž by tady v údolí Stardew bylo tepleji.#$e#Mohla bych se odstěhovat jinam, ale...",
      "sourceSHA256": "405fa18792e06f83581ef4525ec4f0ff68b304dad77966aeb4541791b0ee2f24",
      "translationSHA256": "77b7a8531dff55d903c80ec50e97e8b793c2e48725c7422fbf26d8f8c38c14cf",
      "reviewChecks": [
        "sourceMeaning",
