    {
      "target": "Characters/Dialogue/Haley",
      "key": "winter_Tue",
      "field": null,
      "source": "Hi. Do you need something from me?#$e#...",
      "translation": "Ahoj. Potřebuješ ode mě něco?#$e#...",
      "sourceSHA256": "1f6b53e3791242dc4c4387341abf82c54821105d304b3d1cba5901e4479dd122",
      "translationSHA256": "7812475ae958794abd06893655c222831322f2e7f32e85002c2fe0cc6cc5b4e4",
