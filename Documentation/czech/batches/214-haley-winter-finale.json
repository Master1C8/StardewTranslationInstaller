      "key": "winter_Sat8",
      "field": null,
      "source": "I'm glad you have less work to do in the winter.#$e#It must be nice to have a break, huh?",
      "translation": "Jsem ráda, že máš v zimě méně práce.#$e#Musí být příjemné dát si pauzu, co?",
      "sourceSHA256": "683e81d59f358197a22b822ac8fe73fb4d066cd51477c09b62860b224eecc4de",
      "translationSHA256": "24d279f0e2599a1b19e7ec6845ffce56f28da435eee13c00f805caffd24106bc",
