    {
      "target": "Characters/Dialogue/Haley",
      "key": "winter_Fri",
      "field": null,
      "source": "Do you have a pony on your farm?$h#$e#Oh. That's disappointing...$s",
      "translation": "Máš na farmě poníka?$h#$e#Aha. To je zklamání...$s",
      "sourceSHA256": "cc637ebcfc5350816e9db5ef1ffd44688eb6ccf333835b27cdbb6b4192390866",
      "translationSHA256": "7d14736a9d77a5bc83d3f012c3ad15f12f5aea2810c151d0ef02c69f850ba5d4",
      "reviewChecks": [
        "sourceMeaning",
