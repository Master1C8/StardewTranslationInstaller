  "glossarySHA256": "cb0b94baf37d83f13a5401acdc21e0c6ef37e2bfd7c91616b1db7ae966dc2161",
  "reviewNote": "Full batch reread after contextual hospital realization; canonical 'Farmářský oběd', event controls, and tokens verified.",
  "rows": [
    {
      "target": "Characters/Dialogue/Harvey",
      "key": "Fri4",
      "field": null,
      "source": "If you want to hang out in my apartment, that's okay with me. I live above the clinic.",
      "translation": "Jestli chceš trávit čas v mém bytě, klidně můžeš. Bydlím nad klinikou.",
      "sourceSHA256": "56d3fdd593a86bb3ee72a51690ba1e83eeada577dc474f862685842bf7bd70ac",
      "translationSHA256": "55bda143d79794c5ac5a7317c6f81022022ba05233cbfeaa9d27e43a446112f1",
      "reviewChecks": [
