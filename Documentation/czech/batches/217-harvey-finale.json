    {
      "target": "Characters/Dialogue/Harvey",
      "key": "event_grave1",
      "field": null,
      "source": "...You're right.#$b#...Thanks.",
      "translation": "...Máš pravdu.#$b#...Díky.",
      "sourceSHA256": "f6a0274de08df6a0e5d5e2d97e3f70461483a58299806ff314edcf452bff92e8",
      "translationSHA256": "a07d9d7599a33fe624acd16ad0b4c1c30b5c90e9a3c7e1917935f761bc3b4ec2",
