    {
      "target": "Characters/Dialogue/Harvey",
      "key": "event_aerobics2",
      "field": null,
      "source": "*Sigh*... rude.$s",
      "translation": "*Povzdech*... To bylo hrubé.$s",
      "sourceSHA256": "80b732ae9562287d718676f69f1fb158336fab14074679987e84d056219932da",
      "translationSHA256": "b41c2b3c3cabb84fed0e7ddfbda90331c45d3adb331607549fdbae26c4d87901",
