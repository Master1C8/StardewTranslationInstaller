        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/Harvey",
      "key": "Sat",
      "field": null,
      "source": "Can I do anything for you?#$e#Take care.",
      "translation": "Mohu pro tebe něco udělat?#$e#Opatruj se.",
      "sourceSHA256": "9e8f48602e372e28d0183988c91d432b768229e9f4c741c2607de63e5b8187a9",
      "translationSHA256": "292c1e9f75d3854a2c649dfb74a04f04761a56541bd674e06c1db8447857132d",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
