    {
      "target": "Characters/Dialogue/Harvey",
      "key": "Fri10",
      "field": null,
      "source": "Stop by my place if you ever need a confidential check-up.$l",
      "translation": "Kdykoli budeš potřebovat důvěrnou prohlídku, zastav se u mě.$l",
      "sourceSHA256": "57389d06ae8ed7e30dc86cc2c8b1de2234dd93a456081a21777a72e63711b6bf",
      "translationSHA256": "ef0c5dad7b7095e752f58b9a59342615abb140fbce823689f3eeb1a84e157e21",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
