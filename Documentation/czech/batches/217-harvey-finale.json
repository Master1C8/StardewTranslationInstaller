    {
      "target": "Characters/Dialogue/Harvey",
      "key": "event_heart1",
      "field": null,
      "source": "Oh! Hospitals make you nervous, huh?#$b#Just try and relax. I'm here to help.$h",
      "translation": "Aha! Nemocnice tě znervózňují, viď?#$b#Zkus se uvolnit. Jsem tu, abych ti pomohl.$h",
      "sourceSHA256": "7d8df9d5704db9d2a89bd13ab10b278b19845deadc82f10c7944e4aa6a8d10df",
      "translationSHA256": "2fcc3a7a036e28153f871d65babe1053e4645cc6c19e8e10f7c1b5d83d45d1bd",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/Harvey",
      "key": "event_heart2",
      "field": null,
      "source": "Okay. That makes sense.",
      "translation": "Dobře. To dává smysl.",
      "sourceSHA256": "14781a94b00be8b9ac48fae43bc0252d1293e69cb1054fe81f84ca4701bec8b7",
      "translationSHA256": "ca83a4b609765e943e905ba4739257e6f2d20f2a4f3d39672926992b744433cf",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/Harvey",
      "key": "event_heart3",
      "field": null,
      "source": "Um. Okay... If you say so.$s",
      "translation": "Ehm. Dobře... Když to říkáš.$s",
      "sourceSHA256": "99ef40addccff1cf4501b2788eed5be4800a7e12d598aa2b27e7c6d1fd24e0d3",
      "translationSHA256": "1b3d0ffde956f76a8f4a3cce4f694517fa0b496bef4f776b56f961750c981b0f",
      "reviewChecks": [
