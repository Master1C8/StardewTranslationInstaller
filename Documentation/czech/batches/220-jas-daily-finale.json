    {
      "target": "Characters/Dialogue/Jas",
      "key": "Fri4",
      "field": null,
      "source": "I like living on the farm... my favorite is the fresh ice cream from our cows' milk.",
      "translation": "Ráda žiju na farmě... Nejraději mám čerstvou zmrzlinu z mléka našich krav.",
      "sourceSHA256": "f63d14a7b16aec6ee6a419c3f97f50d25cc7ee08bbfc76f6caa8f4554b83ca1c",
      "translationSHA256": "c8a949f5ead5ec72e98a42bf10d5d9448adad8f08bc633567e4b1afcb26c2b0b",
      "reviewChecks": [
