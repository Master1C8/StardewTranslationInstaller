      "target": "Characters/Dialogue/Jas",
      "key": "Sun",
      "field": null,
      "source": "Um... d...do you want something?$u#$e#I'm not supposed to talk to strangers.$u",
      "translation": "Ehm... c... chceš něco?$u#$e#Nemám mluvit s cizími lidmi.$u",
      "sourceSHA256": "8388dca8f339cc6278295678cdd1f6cb3f23111a68b8ec67f162acacda1d8b89",
      "translationSHA256": "1e41b9262a0ad11bb6da9e3c57428d6b7fb1693993921169d609288bf274b5d0",
      "reviewChecks": [
        "sourceMeaning",
