    {
      "target": "Characters/Dialogue/Jas",
      "key": "Wed4",
      "field": null,
      "source": "Aunt Marnie won't let me go out after 6 o'clock. It's not fair!$s#$e#I'm not afraid of the dark anymore!",
      "translation": "Teta Marnie mě po šesté hodině nepustí ven. To není fér!$s#$e#Tmy už se nebojím!",
      "sourceSHA256": "279ae59196457aef81ed9723e2bc385238e277815c7e3c0e03cc9467589176fb",
      "translationSHA256": "208f77db07c7b40a35e637d891ae00a1ef20702442c2d30e3286527fc9dfa33e",
      "reviewChecks": [
