    {
      "target": "Characters/Dialogue/Jas",
      "key": "Sat8",
      "field": null,
      "source": "You're always so nice to me, ${Mr.^Ms.}$ @.$h#$e#Grown-ups are usually mean and boring, but you're different.",
      "translation": "${Vždycky jste na mě tak hodný, pane^Vždycky jste na mě tak hodná, paní}$ @.$h#$e#Dospělí jsou obvykle protivní a nudní, ale vy takoví nejste.",
      "sourceSHA256": "eb60976e261f5d1ae6e410de17f88b4c3f08a2f5606d1c1c708a02625e277f30",
      "translationSHA256": "f6e35d90ca432d0bc880cee274c0d19041c91233d49606e5692084946e4d19bd",
      "reviewChecks": [
        "sourceMeaning",
