    {
      "target": "Characters/Dialogue/Kent",
      "key": "eventSeen_100_memory_oneday",
      "field": null,
      "source": "My apologies for the other day.#$e#I don't want any special treatment. I just want to be a normal person, like everyone else.",
      "translation": "Omlouvám se za to, co se stalo onehdy.#$e#Nechci žádné zvláštní zacházení. Chci být jen normálním člověkem jako všichni ostatní.",
      "sourceSHA256": "27ca6c9477ed8d2273a2c8d29aa18c86103069e25d9e685e5f1de08e05a5437d",
      "translationSHA256": "422a4617bacaca4060d018559b2e46244fc13a2f28f1f1f342b70e7a6d75715b",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
