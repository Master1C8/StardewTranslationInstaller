    {
      "target": "Characters/Dialogue/Kent",
      "key": "Mon4",
      "field": null,
      "source": "I don't know if I'll ever get used to being back home.#$e#The peacefulness of the town feels like a mask. That's probably just me though.",
      "translation": "Nevím, jestli si někdy zvyknu, že jsem zase doma.#$e#Poklidnost města mi připadá jako maska. To bude ale nejspíš jen můj pocit.",
      "sourceSHA256": "07a4b0f987cf1096251f1476bb9b6717c8c4f09098f49fc5a538c948c9d2ef48",
      "translationSHA256": "656a119520bca947f91dcdf8ae425a97037772bc02bbaf5137dd362005c242fb",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
