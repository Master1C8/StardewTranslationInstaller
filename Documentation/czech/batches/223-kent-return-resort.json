      ]
    },
    {
      "target": "Characters/Dialogue/Kent",
      "key": "MovieInvitation",
      "field": null,
      "source": "Erm... okay. Thank you. I'll meet you there.$h",
      "translation": "Ehm... dobře. Děkuji. Sejdeme se tam.$h",
      "sourceSHA256": "9e5b8e9a9afd42acc2e901c8576ec0672f62668b12c5a4d97274581b72e0530f",
      "translationSHA256": "f7c31bb9578a599426d1c6b17724f253bc73895b292076dec215c12388f5547b",
      "reviewChecks": [
