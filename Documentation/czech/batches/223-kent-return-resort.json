      ]
    },
    {
      "target": "Characters/Dialogue/Kent",
      "key": "Resort_Bar",
      "field": null,
      "source": "Just getting some water.",
      "translation": "Jen si jdu pro trochu vody.",
      "sourceSHA256": "5919b44dd03875776c31ecd0b7d4f984624357848d7f2d191c98075ec8c300a6",
      "translationSHA256": "accd47ae5b9a9805e74f6e62888bc34418bdda4e120f6797bf0acc78977300bc",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
