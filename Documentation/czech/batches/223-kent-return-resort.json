    {
      "target": "Characters/Dialogue/Kent",
      "key": "AcceptGift_(O)StardropTea",
      "field": null,
      "source": "For me? Well, that's unexpected... But I won't say no. Thanks!",
      "translation": "Pro mě? To jsem nečekal... Ale neodmítnu. Díky!",
      "sourceSHA256": "1270e359308fd61072b5bdc0ab930c4970d1cebe507373fb66f0c86bdb2872bb",
      "translationSHA256": "3820a1fd505eff07ad09a22067a19ae843037e855fe732604ed19370d52dfea7",
