    {
      "target": "Characters/Dialogue/Kent",
      "key": "Mon",
      "field": null,
      "source": "Hello, farmer.#$e#I've been gone so long... I feel like a stranger.",
      "translation": "Zdravím tě.#$e#Byl jsem pryč tak dlouho... Připadám si jako cizinec.",
      "sourceSHA256": "b5b2b70e70f8c868b9a908ca782afabebc2481eac94d77dcd3764311d28ea8fb",
      "translationSHA256": "ef9346f2a60588164963cdd318e6bea73599777bf4bcbdd092fbc4537b8bd285",
