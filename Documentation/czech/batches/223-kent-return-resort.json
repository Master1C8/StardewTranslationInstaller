    {
      "target": "Characters/Dialogue/Kent",
      "key": "AcceptGift_(O)Book_Bombs",
      "field": null,
      "source": "Well, I can't read Dwarvish, but it's an interesting collector's item. Thank you.",
      "translation": "Trpasličí písmo sice číst neumím, ale je to zajímavý sběratelský kousek. Děkuji.",
      "sourceSHA256": "71c6dbea7042fcaf71a8653b51afb15ec24f8d38ec380b3c156973aa066228d4",
      "translationSHA256": "120cb0080557beb75ff0e995c11c176d9b670e2eb8ad7a5a87f2eb5fb777c0fd",
