      ]
    },
    {
      "target": "Characters/Dialogue/Kent",
      "key": "Tue",
      "field": null,
      "source": "Things haven't changed much since I've been gone.#$e#Well, except that you're here.",
      "translation": "Za tu dobu, co jsem byl pryč, se toho moc nezměnilo.#$e#Až na to, že jsi teď tady.",
      "sourceSHA256": "562a029bc99140bca61bbf559cb6e44b400c5b9469136f0ad7e5065afbe9aa6c",
      "translationSHA256": "20350c21c469d3deeae1b58700a7cf78cb2c6a9b6509e06b0b1968eba057e537",
