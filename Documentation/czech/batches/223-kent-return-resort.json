    },
    {
      "target": "Characters/Dialogue/Kent",
      "key": "married_Sam",
      "field": null,
      "source": "It makes a father proud to see his boy become a man. You have my heartfelt blessing.$h",
      "translation": "Otce naplňuje hrdostí, když vidí, jak se z jeho chlapce stává muž. Máte mé upřímné požehnání.$h",
      "sourceSHA256": "1ff52ea08236cc60142fa05d04d2f8e1b4d6477182d71a64133c43f5940b12ed",
      "translationSHA256": "52c311a72a0e518ae42430a3ac65040aa1131ba199780e96d9a3992fbedbaaca",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
