        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/Kent",
      "key": "reject_865",
      "field": null,
      "source": "Yep... It's been tightly sealed, so the flavor should still be really potent.",
      "translation": "Ano... Je to pevně uzavřené, takže chuť by stále měla být opravdu výrazná.",
      "sourceSHA256": "5a016549a7468da4c38d090de6bb3d8fe8b3b128471149c780e20ca8a1a389ee",
      "translationSHA256": "e59e9f28055c09fb66d7dfa83cc0bda7163061843b9f3943f695404b26c979cd",
      "reviewChecks": [
        "sourceMeaning",
