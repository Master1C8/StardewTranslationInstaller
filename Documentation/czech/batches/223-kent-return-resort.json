    {
      "target": "Characters/Dialogue/Kent",
      "key": "Resort",
      "field": null,
      "source": "The boat ride was fun. I even got to use some of my nautical training to help navigate.$h",
      "translation": "Plavba lodí byla zábavná. Dokonce jsem mohl využít něco ze svého námořního výcviku a pomoci s navigací.$h",
      "sourceSHA256": "074a3f3f7d80d40f7981f6a080ffb3735f66c772c36988bed0627feef6c24566",
      "translationSHA256": "15f1e68166ec909d08f1621c2d06e0597815e827ae813c68d3ca1fda3d360b52",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
