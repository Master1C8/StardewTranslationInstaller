    {
      "target": "Characters/Dialogue/Kent",
      "key": "Resort_Entering",
      "field": null,
      "source": "Hey, @. Nice to see you.",
      "translation": "Ahoj, @. Rád tě vidím.",
      "sourceSHA256": "ff1b22eb9bf8c456620890d0dd8af6d6dc36ca0fb743b9ce2f0c128bb794e680",
      "translationSHA256": "edf4e6105f8acc05db1670c31b457ff876d2f355af0ae9877a334e0763a8de59",
      "reviewChecks": [
