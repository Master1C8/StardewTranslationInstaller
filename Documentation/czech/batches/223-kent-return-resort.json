    {
      "target": "Characters/Dialogue/Kent",
      "key": "Resort_Shore",
      "field": null,
      "source": "Standing on this beach... I feel a rare sense of peace.$h#$e#The ocean is a very special thing.",
      "translation": "Když stojím na této pláži... cítím vzácný klid.$h#$e#Oceán je něco velmi výjimečného.",
      "sourceSHA256": "ded195f3d55cb03f74146bd96fa02dc810c05bb1d43f7ac4a603b2059e47a309",
      "translationSHA256": "6cc053f6276dfc7abd9f1c70ceee9715e829bcae59f051497cad090908c626c8",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/Kent",
      "key": "Resort_Chair",
      "field": null,
      "source": "This is a great place to bond with the family. I really appreciate you fixing it up.",
      "translation": "Tohle je skvělé místo, kde se můžeme s rodinou sblížit. Opravdu si vážím toho, že se ti to tu podařilo dát do pořádku.",
      "sourceSHA256": "815d2d874dd6b60d99bc508fa4966249be4abe7a5dda0696ee64a233366eb7f0",
      "translationSHA256": "a86e3c70080da8cc24405267266f3545e5e1abdee6733dfdb3550e3eea63d083",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
