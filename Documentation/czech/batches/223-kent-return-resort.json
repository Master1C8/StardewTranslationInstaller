    {
      "target": "Characters/Dialogue/Kent",
      "key": "Resort_Leaving",
      "field": null,
      "source": "Time to head home.",
      "translation": "Je čas vyrazit domů.",
      "sourceSHA256": "b10c48ae48f75770fa7ad784e4c33b6775c807228b84c86c388c14528d908827",
      "translationSHA256": "f9666360fae26aa11c5f637817159ef4c9db2b823615faf82d19190c2fbec101",
      "reviewChecks": [
