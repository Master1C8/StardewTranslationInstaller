    {
      "target": "Characters/Dialogue/Krobus",
      "key": "18_*",
      "field": null,
      "source": "I try not to make too much noise down here. Imagine if the townspeople heard my weird sounds coming from the sewer drain...",
      "translation": "Snažím se tu dole nedělat příliš velký hluk. Představ si, že by obyvatelé města zaslechli mé podivné zvuky z kanálu...",
      "sourceSHA256": "0e7553ed2f2dd2d73a5d5812957cd9bc1762a95984d1ecbd5c41da2ff822d149",
      "translationSHA256": "29829d9e2903c8770854d599ffb18f2d1490cd181c74e0f1642a6e68fd8bb88e",
