    {
      "target": "Characters/Dialogue/Krobus",
      "key": "AcceptBirthdayGift_Negative",
      "field": null,
      "source": "Oh... is this what you call a 'birthday present'? I don't understand humans...$s",
      "translation": "Ach... tomuhle říkáš ‚dárek k narozeninám‘? Lidem nerozumím...$s",
