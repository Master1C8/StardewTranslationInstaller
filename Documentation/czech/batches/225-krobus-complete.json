    {
      "target": "Characters/Dialogue/Krobus",
      "key": "reject_868",
      "field": null,
      "source": "Oh, it's an arctic shard! That's a very rare magical item.#$b#I'd bring that to the Wizard if I were you!",
      "translation": "Aha, to je arktický úlomek! Je to velmi vzácný kouzelný předmět.#$b#Na tvém místě bych ho odnesl Čaroději!",
      "sourceSHA256": "93c1e5437e51ee99fe867e6f0bd83c7100f8cfd045e6eb0b3aefce7bbc949913",
      "translationSHA256": "f1ddb693233bf9808aca2724b34e98c96969ceff71c31eee10c660acd65a6b8b",
      "reviewChecks": [
