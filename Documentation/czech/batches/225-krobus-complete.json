    {
      "target": "Characters/Dialogue/Krobus",
      "key": "Mon6",
      "field": null,
      "source": "'Krobus' means 'bridge-crosser' in our language.",
      "translation": "‚Krobus‘ v našem jazyce znamená ‚ten, kdo přechází mosty‘.",
      "sourceSHA256": "6946fb303e1c8d4ffb50e315bf21e40d05ee4ec1d9b955c4be43b5464a36e2d3",
      "translationSHA256": "6dce6abd3db36c1ed74471c3649c9ef9db36d5001bc12bbccbda59812ad2b3af",
      "reviewChecks": [
