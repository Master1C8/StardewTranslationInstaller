    {
      "target": "Characters/Dialogue/Krobus",
      "key": "8_*",
      "field": null,
      "source": "A 1000 year war between my people and the dwarves recently ended. There's still a lot of resentment on both sides.",
      "translation": "Nedávno skončila tisíciletá válka mezi mým lidem a trpaslíky. Na obou stranách stále zůstává mnoho zášti.",
      "sourceSHA256": "53ea7bbc298a39fa50d0fb6d0f28fc914834c8cf27cf2690897a7935b73178b2",
      "translationSHA256": "a62ee72ea07399005520f629de38dfd7e5d79ecabf47a7f6fe61bacd5cff9942",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/Krobus",
      "key": "15_*",
      "field": null,
      "source": "Please keep my location a secret. If the dwarves knew of me, they'd surely send an assassin.",
      "translation": "Prosím, neprozrazuj, kde se nacházím. Kdyby o mně trpaslíci věděli, určitě by poslali vraha.",
      "sourceSHA256": "923c3d612e22e84d3b0c8adee72ba6d7658275534349ba0b57eb8706477a1260",
      "translationSHA256": "ac926b9ebb34315e819d2f58a4ede6de8a9d0e0b727961b2f6760013c62f4a9e",
      "reviewChecks": [
