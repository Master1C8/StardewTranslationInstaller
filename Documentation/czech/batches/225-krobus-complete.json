    {
      "target": "Characters/Dialogue/Krobus",
      "key": "AcceptBirthdayGift_Positive",
      "field": null,
      "source": "Oh, a gift to remember the day that I hatched! Thank you!$h",
      "translation": "Jé, dárek na památku dne, kdy jsem se vylíhl! Děkuji!$h",
      "sourceSHA256": "9dca5e51915878b5a661cfe41ef2ba0275be6b3ccb0d8e9f339203b939a8bf25",
      "translationSHA256": "ec31a966433e28f93869317f677c152a8af5e9e402c55b3b8fa86283db0d7a3c",
