    {
      "target": "Characters/Dialogue/Krobus",
      "key": "SpouseStardrop",
      "field": null,
      "source": "I wanted to give you this as a 'thank you' for letting me live here with you.$h",
      "translation": "Chtěl jsem ti tohle dát jako poděkování za to, že tu s tebou mohu žít.$h",
      "sourceSHA256": "4a440604e0cf964263808f9b1972101712516726252f479f119232fa77c4e041",
      "translationSHA256": "e19cca9523e7b9b6055003de0dad54d0ed29aabbf5bdf59432aa39e2f1b2f1b2",
