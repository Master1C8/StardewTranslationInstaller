    },
    {
      "target": "Characters/Dialogue/Krobus",
      "key": "Thu",
      "field": null,
      "source": "Please don't tell anyone about me.#$b#Humans tend to destroy things they can't understand.",
      "translation": "Prosím, nikomu o mně neříkej.#$b#Lidé mají sklon ničit věci, kterým nerozumějí.",
      "sourceSHA256": "62c24e225d9425589f85b89d0ec6ea1203f142418f9d460e50e69dde8343a9d0",
      "translationSHA256": "fcb63e072daf747f21503f6c73cafd2c932ffdcabb4a55c893651f6684c86d64",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/Krobus",
      "key": "Thu6",
      "field": null,
      "source": "Please don't tell anyone about me.#$b#Most humans are frightened by us shadow people... maybe for good reason.$s#$b#But regardless, if the townspeople knew about me, I might not be safe here.",
      "translation": "Prosím, nikomu o mně neříkej.#$b#Většina lidí se nás, Stínových lidí, bojí... možná k tomu mají dobrý důvod.$s#$b#Každopádně kdyby o mně obyvatelé města věděli, možná bych tu nebyl v bezpečí.",
      "sourceSHA256": "9a9b12f4301f4e1406d5d2b0eff2165afed554132aa332f1abf6c32eabf9ac50",
      "translationSHA256": "3c4f55c24a903e6ccf85271ef1f692305d01848bbfce6aee0b993579df068011",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
