    },
    {
      "target": "Characters/Dialogue/Krobus",
      "key": "Wed6",
      "field": null,
      "source": "If you put your ear up to the right pipe, you can hear into any house from down here.#$b#I wouldn't eavesdrop, though!$3",
      "translation": "Když přiložíš ucho ke správné trubce, můžeš odsud poslouchat, co se děje v kterémkoli domě.#$b#Já bych ale nikdy neodposlouchával!$3",
      "sourceSHA256": "847b890a4452676121955a5cc678c6daba9532ac6d27bcf44df4e9e07184c301",
      "translationSHA256": "f14b9e1ab94eaa867e2500f0a08f914ce0a629d478d941a1487f26068cba9f8f",
      "reviewChecks": [
        "sourceMeaning",
