    {
      "target": "Characters/Dialogue/Krobus",
      "key": "AcceptGift_(O)308",
      "field": null,
      "source": "This smells delicious! I'll eat half, and use the other half to moisturize my body...$h",
      "translation": "To voní lahodně! Polovinu sním a druhou polovinou si zvlhčím tělo...$h",
      "sourceSHA256": "5559a109e13f501681338460f9dcae93ec46d3c91c3c8330090a8da4f093a1b9",
