    {
      "target": "Characters/Dialogue/Krobus",
      "key": "Wed",
      "field": null,
      "source": "I find things here and I sell them. Care to buy anything?",
      "translation": "Nacházím tu různé věci a prodávám je. Nechceš si něco koupit?",
      "sourceSHA256": "2ca9f4c50693073bcbb22dd3343d5808c3ee632e92c14f86f4d53086a239e9c4",
      "translationSHA256": "9667105971ab6e4a88240f65009758bb265a9056154672397960e6ff273348f4",
      "reviewChecks": [
        "sourceMeaning",
