    {
      "target": "Characters/Dialogue/Krobus",
      "key": "GreenRain",
      "field": null,
      "source": "The flow of water has been unusually strong today... what's going on up there?",
      "translation": "Proud vody je dnes nezvykle silný... Co se tam nahoře děje?",
