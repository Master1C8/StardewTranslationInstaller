    {
      "target": "Characters/Dialogue/Leah",
      "key": "AcceptGift_(O)196",
      "field": null,
      "source": "$c 0.8#This looks delicious... Thank you! There's nothing quite like a fresh, wild salad.$h#Oh, wow, @! This is exactly what I was craving! How'd you know?$h",
      "translation": "$c 0.8#Vypadá to výborně... Děkuji! Čerstvému salátu z planých rostlin se nic nevyrovná.$h#Páni, @! Přesně na tohle jsem měla chuť! Jak se ti to podařilo uhodnout?$h",
      "sourceSHA256": "8ba6795addecf01cf0a66a9da56f440289dd5356960cb7c6330400bf4de84bc0",
      "translationSHA256": "ba7207411d141e6b4851cf5a72d9aa0fc4d33a5209becef593a185f5a9368ca8",
      "reviewChecks": [
        "sourceMeaning",
