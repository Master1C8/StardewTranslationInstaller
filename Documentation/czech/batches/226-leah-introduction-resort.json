    {
      "target": "Characters/Dialogue/Leah",
      "key": "AcceptGift_(O)StardropTea",
      "field": null,
      "source": "Oh, wow... I had a sip of this stuff when I was a kid, and I've never forgotten the taste.",
      "translation": "Páni... Když jsem byla malá, jednou jsem to ochutnala a na tu chuť jsem nikdy nezapomněla.",
      "sourceSHA256": "701c9dc154758771bce2144ae083103209be593cfdabe6d4c70fcc2a435c84a7",
      "translationSHA256": "61d2bff71abe0dce9fc3bd488102964b0c7fb8215e7c315f8f08722ba3502d7e",
