        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/Leah",
      "key": "AcceptGift_(O)169",
      "field": null,
      "source": "Oh! Thank you! This one has an interesting shape...$h",
      "translation": "Jé! Děkuji! Tenhle má zajímavý tvar...$h",
      "sourceSHA256": "8d21e6c1f05e1aff6a6f25149d97c7bdeb2910f0e845a392aefe2893f003506e",
      "translationSHA256": "29b90cefaad64d1ab8696e4ec25096640a080e0c975909567df639b94a02fa1c",
      "reviewChecks": [
        "sourceMeaning",
