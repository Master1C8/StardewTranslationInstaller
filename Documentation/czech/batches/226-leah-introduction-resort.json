    {
      "target": "Characters/Dialogue/Leah",
      "key": "Introduction",
      "field": null,
      "source": "Hello, it's nice to meet you. $h#$e#You picked a good time to move here... The spring is lovely.",
      "translation": "Ahoj, těší mě. $h#$e#Přistěhování ti vyšlo na vhodnou dobu... Jaro je nádherné.",
      "sourceSHA256": "77c5735a7d51efd720157b1ca9a7996c0d8298e3915cbb99dd8c3cd62c759e12",
      "translationSHA256": "16c8072003e1f8b93b78d0752f18b3a4371ec77b84480b8e8f4033b5ef95ba87",
