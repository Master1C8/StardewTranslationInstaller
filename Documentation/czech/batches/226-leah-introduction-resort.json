    {
      "target": "Characters/Dialogue/Leah",
      "key": "AcceptBirthdayGift_Positive",
      "field": null,
      "source": "Hey, thanks a bunch, @! This makes my birthday feel special.$h",
      "translation": "Hej, mockrát děkuji, @! Díky tomu jsou moje narozeniny opravdu výjimečné.$h",
      "sourceSHA256": "8f7c00105998b61344f5f424d7331301deb1497efd1893b30ce486baac678780",
      "translationSHA256": "361b0c82cc22cf4cd9138eeb33bfce574c3ef284cbba822d3bb03c40acb55ab5",
