    {
      "target": "Characters/Dialogue/Leah",
      "key": "AcceptGift_(O)200",
      "field": null,
      "source": "Mmm... Back in the city, the veggies never tasted this fresh. I love it!$h",
      "translation": "Mmm... Ve městě zelenina nikdy nechutnala tak čerstvě. Moc se mi to líbí!$h",
      "sourceSHA256": "bcb20038dbc8e99f4614c18c5ecd90bf4ae79dc0d443ff9d9b2a54d696b4364e",
      "translationSHA256": "8f9301fe7c93ecbcb638f8834277b0c4ff88ef1cc07b46d76022244771aa5b92",
