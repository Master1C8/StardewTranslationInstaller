      ]
    },
    {
      "target": "Characters/Dialogue/Leah",
      "key": "married_Elliott",
      "field": null,
      "source": "Elliott's a real romantic... I'm sure your days will be filled with poetry!$h",
      "translation": "Elliott je opravdový romantik... Tvé dny budou určitě plné poezie!$h",
      "sourceSHA256": "28b8246c9cc6b208d1e939fd0ef35a54ac42339c2861c5c2255fceda5f294c70",
      "translationSHA256": "73563da9b2341fb278b9fe48d9a1e4042021f95306542a088898a8a956a2200c",
      "reviewChecks": [
