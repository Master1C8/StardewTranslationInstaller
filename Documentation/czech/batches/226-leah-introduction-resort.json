    {
      "target": "Characters/Dialogue/Leah",
      "key": "FlowerDance_Accept_Spouse",
      "field": null,
      "source": "Finally! I was starting to get worried you wanted to dance with someone else!$h",
      "translation": "Konečně! Už jsem se začínala bát, že chceš tančit s někým jiným!$h",
      "sourceSHA256": "bcfbbfaeeb955695ac79c69d37acd38b07ad93d832f84ec6b22a9ea4a721e428",
