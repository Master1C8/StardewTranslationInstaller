    {
      "target": "Characters/Dialogue/Leah",
      "key": "FlowerDance_Accept",
      "field": null,
      "source": "You want to dance with me? Yes!$h#$e#I was wondering if you'd ask me...$h",
      "translation": "Chceš se mnou tančit? Ano!$h#$e#Přemýšlela jsem, jestli mě požádáš...$h",
      "sourceSHA256": "4cb7805bea2576c82072d842a2386c8f30cb7e9412f9e65a92611f02ad5fcaad",
      "translationSHA256": "9c744329a0679bc2ad7be40965c086407dc676cc7d7ab3e0359a210f5ce2a2be",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/Leah",
      "key": "dating_Leah",
      "field": null,
      "source": "I had a feeling you would ask me...$l",
      "translation": "Tušila jsem, že se mě zeptáš...$l",
      "sourceSHA256": "48ea3246008465adf547b44f52a73147e7fba4fa33ee8ee42ec79e93579068ad",
      "translationSHA256": "535e7e0093c4a8e07e081ba4e5cfa67eab56319e8328b20a44068d8249162c11",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
