    {
      "target": "Characters/Dialogue/Leo",
      "key": "Mon4",
      "field": null,
      "source": "I've learned a lot from my parrot family...#$b#But I'm sure there's a lot more out there I don't know.$s",
      "translation": "Od své papouščí rodiny jsem se toho hodně naučil...#$b#Určitě ale venku existuje ještě spousta věcí, které neznám.$s",
      "sourceSHA256": "52ae89024294a5d476a7bf01f09e110b65ff6fb25de035ebc379a9ba80fbbffc",
      "translationSHA256": "38609d0ea7469f00c37630866037e98cb0afdcd9a156f285ab4beeb861c8faca",
      "reviewChecks": [
