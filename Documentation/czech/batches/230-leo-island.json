    {
      "target": "Characters/Dialogue/Leo",
      "key": "Sat",
      "field": null,
      "source": "...I'm sad today.$s#$e#You go on... have fun. Let me be sad.$s",
      "translation": "...Dnes jsem smutný.$s#$e#Jen běž... bav se. Nech mě být smutný.$s",
      "sourceSHA256": "b2c8dad903b4dc10bfe739f36976a476524ec037a9e7ee1a7784b01d9296b8a4",
      "translationSHA256": "80d924351677b0b7abbd79d3dd9320db3b6930b077f6e641f287999a57cb32a6",
