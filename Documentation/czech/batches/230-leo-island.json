    {
      "target": "Characters/Dialogue/Leo",
      "key": "Tue",
      "field": null,
      "source": "When Sun is angry, it feels good in the jungle.#$e#Sun can't find us beneath the leaves. We trick him! Haha...$h",
      "translation": "Když se Slunce zlobí, v džungli je příjemně.#$e#Pod listy nás Slunce nenajde. Přelstíme ho! Haha...$h",
      "sourceSHA256": "86e3b120a85a2109f0612e818318a3aff75c43ed502cfe5698936d097195569e",
      "translationSHA256": "e8cb9cc29b4691a23b31c0c5015d23389e6418b8eafafdbeaa2fafda61ab9856",
      "reviewChecks": [
