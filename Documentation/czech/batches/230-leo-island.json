    {
      "target": "Characters/Dialogue/Leo",
      "key": "Sun",
      "field": null,
      "source": "When it rains, strange birds visit.#$b#I try to speak to them... but they fly away.$s#$b#I guess they don't want to be friends...$s",
      "translation": "Když prší, přilétají zvláštní ptáci.#$b#Snažím se s nimi mluvit... ale odletí pryč.$s#$b#Asi se nechtějí přátelit...$s",
      "sourceSHA256": "c08901fb2ca61c9ed41ef819fcb373bc992683363301d7b30c8ee33d6120f67b",
      "translationSHA256": "50102ce198c62ca19337f48e775cf34da6bbd746ee0847515eb70b7c106c0fe6",
