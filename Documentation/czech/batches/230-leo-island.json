    {
      "target": "Characters/Dialogue/Leo",
      "key": "Wed2",
      "field": null,
      "source": "Be careful in the volcano... the spirits don't like outsiders.",
      "translation": "Dávej ve sopce pozor... Duchové nemají rádi cizince.",
      "sourceSHA256": "5a5ce3e0d7931eb6008405e1ac157242268d1c86aaf0a52593b32f5e8ee5b7a1",
      "translationSHA256": "89094caf01740b6874843aba8656005c92beed61b88cccbc8e50f4143666c454",
      "reviewChecks": [
        "sourceMeaning",
