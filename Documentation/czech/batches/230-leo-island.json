    {
      "target": "Characters/Dialogue/Leo",
      "key": "Fri",
      "field": null,
      "source": "One time... I was at the top of the volcano at night, and I saw lights far, far away.#$b#I wonder if there are other bird families out there?$3",
      "translation": "Jednou... jsem byl v noci na vrcholu sopky a daleko, předaleko jsem uviděl světla.#$b#Zajímalo by mě, jestli tam venku žijí další ptačí rodiny.$3",
      "sourceSHA256": "a49b7c81a66269239de728a629007717f902380b8ae6a49d29cab48d8c6008e9",
      "translationSHA256": "1a19a05533c3235d917fca0e5656e2172ba248ed037f512027a13a943cd0193a",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/Leo",
      "key": "Fri4",
      "field": null,
      "source": "I wonder if I could see your home from the top of the volcano?",
      "translation": "Zajímalo by mě, jestli bych z vrcholu sopky viděl tvůj domov.",
      "sourceSHA256": "7f83c655d81ee9d55299e57dd15fa67f1a19e3867a13cfd0bb65837faea66d85",
      "translationSHA256": "98d7ecacf10c174e27d680e764b6442be2542535b9e817a00de203e5500209ce",
      "reviewChecks": [
