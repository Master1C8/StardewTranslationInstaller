    {
      "target": "Characters/Dialogue/Leo",
      "key": "Thu",
      "field": null,
      "source": "Have you met the others like you?#$b#I don't talk to them much. I feel safer with my own kind...$3",
      "translation": "Už znáš ostatní, kteří jsou jako ty?#$b#Moc s nimi nemluvím. Se svými se cítím bezpečněji...$3",
      "sourceSHA256": "efd21bc823a55c8d5cc8de877a8563fb5354f8ad2e51b09bd3bea093f2e4ea3c",
      "translationSHA256": "4fbf2433e61d4d86f7371b4de9bb6d934d7a29b7ae162f88e675a83325f697a4",
      "reviewChecks": [
        "sourceMeaning",
