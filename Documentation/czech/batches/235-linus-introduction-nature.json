      ]
    },
    {
      "target": "Characters/Dialogue/Linus",
      "key": "AcceptGift_(O)StardropTea",
      "field": null,
      "source": "This means a lot to me, @. I'll save it for a quiet day in the tent. Thank you!",
      "translation": "To pro mě hodně znamená, @. Schovám si ho na nějaký klidný den ve stanu. Děkuji!",
      "sourceSHA256": "d0586170947154c35d68b01233c9aa24ad3d6502a95e0da8accccee0c0007735",
      "translationSHA256": "7056cdbdbeb72d15c88729a90e9ed085ef9a88dcf8d353ebdde905be620258c5",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
