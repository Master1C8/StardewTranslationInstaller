      ]
    },
    {
      "target": "Characters/Dialogue/Linus",
      "key": "AcceptGift_(O)Book_Trash",
      "field": null,
      "source": "I don't usually read books... But this one is right up my 'alley'... Thank you!$h",
      "translation": "Knihy obvykle nečtu... Ale tahle je zrovna můj ‚šálek odpadu‘... Děkuji!$h",
      "sourceSHA256": "0bced255eeb53d38594851561051e962b506be54528ed9c4fb57dc30f4b9692f",
      "translationSHA256": "b3df0094b57c7d4a120e2054aa74efd9729107cea3bcdf60a384381238091bf7",
      "reviewChecks": [
