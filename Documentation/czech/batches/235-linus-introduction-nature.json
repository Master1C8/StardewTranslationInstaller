      ]
    },
    {
      "target": "Characters/Dialogue/Linus",
      "key": "reject_869",
      "field": null,
      "source": "What do you have there? Looks like it would make good bait.$h",
      "translation": "Copak to tam máš? Vypadá to, že by z toho byla dobrá návnada.$h",
      "sourceSHA256": "1190d4387585bc7fa3159d3e9947d991ab470c622a73a15beac6f5ecae620ef4",
      "translationSHA256": "b54a2e4557b931f82022105caaaef9224500ca2e57dbdcd6eb6a8b30160aad2a",
      "reviewChecks": [
        "sourceMeaning",
