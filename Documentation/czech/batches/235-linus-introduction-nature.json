    {
      "target": "Characters/Dialogue/Linus",
      "key": "AcceptGift_Positive_category_greens",
      "field": null,
      "source": "That's a good find! I'm always happy when eating wild food. Thank you.",
      "translation": "To je pěkný nález! Jídlo z divočiny mě vždycky potěší. Děkuji.",
      "sourceSHA256": "f90a4330b861ebe8e0901e696fd9d3de5a3cc531d41367655c7f143181d79049",
      "translationSHA256": "57410ce8dcd4d6f6c42a64a96c54adfe7ca2d1377c4e8b6de142edcc368e0dc1",
      "reviewChecks": [
