  "rows": [
    {
      "target": "Characters/Dialogue/Linus",
      "key": "Introduction",
      "field": null,
      "source": "A stranger?... Hello.#$e#Don't mind me. I just live out here alone.",
      "translation": "Někdo cizí?... Zdravím.#$e#Mě si nevšímej. Jen tu žiji o samotě.",
      "sourceSHA256": "e81244e01498e5dcbc18d14dab3c334d40416a8bd0d79f54879372ee01cbb7ff",
      "translationSHA256": "97353cc7fbb360c6b50fd3722db4fbd229e2cd1933377ab88a7830b69370c3d8",
      "reviewChecks": [
        "sourceMeaning",
