      "target": "Characters/Dialogue/MarriageDialogue",
      "key": "Rainy_Day_Alex",
      "field": null,
      "source": "Hmm... I guess I'll have to do push-ups and sit-ups indoors today.",
      "translation": "Hmm... Asi dnes budu muset dělat kliky a sedy lehy uvnitř.",
      "sourceSHA256": "52ae47cc57d94a5dd6dcb544456be7100f5a1963647f821f4c01540444e20fd3",
      "translationSHA256": "f09306d23f293e8c168245660c18f55cad5bdaa9f6ddb54ed2d1090b6fb1dcd4",
