      "target": "Characters/Dialogue/MarriageDialogue",
      "key": "Rainy_Day_Sam",
      "field": null,
      "source": "I might spend some time today fixing any leaks in the roof or the windows.",
      "translation": "Možná dnes strávím nějaký čas opravou všech míst ve střeše nebo u oken, kudy zatéká.",
      "sourceSHA256": "d2897a4b857a6e52c6b610018a020a5c1d79ddbef8efe510e08ea71358b5251f",
      "translationSHA256": "dc1d3b5a062bfd3bd2ea7844526f8e313e38ea383a9e48525e356aa0e8caf2a7",
