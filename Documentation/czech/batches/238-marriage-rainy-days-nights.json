    {
      "target": "Characters/Dialogue/MarriageDialogue",
      "key": "Rainy_Day_1",
      "field": null,
      "source": "It's raining! That means we don't have to water the crops today.$h#$e#Nature can be a big help sometimes.#$e#Have you fed the animals yet, honey?",
      "translation": "Prší! To znamená, že dnes nemusíme zalévat plodiny.$h#$e#Příroda někdy dokáže hodně pomoci.#$e#Už mají zvířata nakrmeno, zlato?",
      "sourceSHA256": "0abb548bb7e6ae539e7b06654907d21ff59021ad360102b597c76fc04d932c3d",
      "translationSHA256": "293288328a8cd8c3d1e8394e08ab7583772c84a5dd94a10bc53bdb3ffe8600cc",
      "reviewChecks": [
        "sourceMeaning",
