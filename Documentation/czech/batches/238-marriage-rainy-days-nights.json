    {
      "target": "Characters/Dialogue/MarriageDialogue",
      "key": "Rainy_Day_2",
      "field": null,
      "source": "Good morning! I woke up early from the sound of the rain and made you some breakfast. [194 195 210 211 216]  #$e#Stay warm and don't work too hard. I want you to stay healthy.",
      "translation": "Dobré ráno! Zvuk deště mě brzy probudil, a tak je pro tebe připravená snídaně. [194 195 210 211 216]  #$e#Zůstaň v teple, příliš se nenamáhej a pečuj o své zdraví.",
      "sourceSHA256": "b77a40567eea266c93ae6d7a907b7771020581f69df3bbba2c8ba58603dfd11c",
      "translationSHA256": "cba95ce0574c7dc63c24cf241413b2c4ebc802bdc3a31cd893a69cbf5489a5e1",
      "reviewChecks": [
        "sourceMeaning",
