      "target": "Characters/Dialogue/MarriageDialogue",
      "key": "Rainy_Day_Maru",
      "field": null,
      "source": "Despite all the technology we have, a rainy day is still the best tool for watering crops.",
      "translation": "Navzdory všem technologiím, které máme, je deštivý den stále nejlepším nástrojem k zalévání plodin.",
      "sourceSHA256": "a7dda825abb36fcc42a215a5e4f8d8c3841477d37671bde3b7bb2fd668ac4e0d",
      "translationSHA256": "4c02746e72cfa96964bfa237e0f83a7692a12753d5113ed4215d282606bd5fff",
