      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogue",
      "key": "Rainy_Day_3",
      "field": null,
      "source": "What's on your agenda today, dear?#$e#I don't want to go outside in this weather... I'll just do some things around the house.#$e#Maybe I'll make something hot for dinner.",
      "translation": "Co máš dnes v plánu, miláčku?#$e#V tomhle počasí se mi nechce ven... Udělám jen pár věcí kolem domu.#$e#Možná k večeři připravím něco teplého.",
      "sourceSHA256": "193f8554cd89c88a2f225dce3de3c66d84a2f4e3f646b5ee514ee6b6f0b4f3d8",
      "translationSHA256": "737e9d9c0f15fe5cb2d77aa1d61a13b62cfa6a9e3446decfb10ce3ae66f1caa9",
      "reviewChecks": [
