    {
      "target": "Characters/Dialogue/MarriageDialogue",
      "key": "Rainy_Day_Harvey",
      "field": null,
      "source": "Make sure you stay dry today, dear. I don't want you to become hypothermic.",
      "translation": "Dávej dnes pozor, ať zůstaneš v suchu, miláčku. Podchlazení není žádná legrace.",
      "sourceSHA256": "f81ea37dddda3c33e949a0a733bdfc9a123aa430c10066c75add53f0a30b8f6d",
      "translationSHA256": "a902084b87386bf88b8fa9f4776a2c0c4f66392f5a06d7191628a2f948045ca1",
