  "glossarySHA256": "cb0b94baf37d83f13a5401acdc21e0c6ef37e2bfd7c91616b1db7ae966dc2161",
  "reviewNote": "Celý balíček byl dříve plně porovnán s anglickým zdrojem; po jediné změně znovu ověřena přesná dvojice Rainy_Night_Penny, význam neúspěšného pečení a token $s.",
  "rows": [
    {
      "target": "Characters/Dialogue/MarriageDialogue",
      "key": "Rainy_Day_0",
      "field": null,
      "source": "It's raining outside. Make sure you don't catch cold, dear.#$e#Stay indoors as much as possible.$h#$e#I worry about you sometimes!",
      "translation": "Venku prší. Dávej pozor, ať nenastydneš, miláčku.#$e#Zůstaň co nejvíc uvnitř.$h#$e#Někdy o tebe mám strach!",
      "sourceSHA256": "3f2f18a4cc1c8cd068fed188315c6325506747c66a558797d7e76bf12bff3e46",
      "translationSHA256": "830abb4604f17c0716ce53e2e48ed4871da28d36642be1fad47d3c5525bf34fb",
