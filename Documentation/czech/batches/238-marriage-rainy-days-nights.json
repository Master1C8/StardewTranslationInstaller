    {
      "target": "Characters/Dialogue/MarriageDialogue",
      "key": "Rainy_Night_1",
      "field": null,
      "source": "Make sure you change into something warm. I don't want you to get sick.#$e#Can you hear the rain pattering on the roof, @?",
      "translation": "Nezapomeň se převléct do něčeho teplého. Ať neonemocníš.#$e#Slyšíš, jak déšť bubnuje na střechu, @?",
      "sourceSHA256": "1d02f7717da511690d6ce2da5ca15e81cdca45cdc08024d24a2c9ec0c8a5a022",
      "translationSHA256": "f3300ae1e0d3d021637f6ec166ff80d741d7c3f6beb1d9cfadbf2248c98b3225",
