      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogue",
      "key": "Rainy_Day_4",
      "field": null,
      "source": "Any dinner requests for tonight?",
      "translation": "Máš nějaké přání k dnešní večeři?",
      "sourceSHA256": "530760d47df0ac2843dd35e57786c48c4bed96b830aecfc9291c8603da41d0ba",
      "translationSHA256": "b19738c1f0d61ae4331350190f2296f67d94f8c2995ee62b66d35356b69d0b16",
