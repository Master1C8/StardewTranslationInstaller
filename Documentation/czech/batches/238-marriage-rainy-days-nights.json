    {
      "target": "Characters/Dialogue/MarriageDialogue",
      "key": "Rainy_Day_Sebastian",
      "field": null,
      "source": "I got up just before dawn and took a walk around the farm. It's really peaceful at that hour.",
      "translation": "Vstal jsem těsně před úsvitem a prošel se po farmě. V tuto hodinu je tam opravdu klid.",
      "sourceSHA256": "c36077b02a33bbf55d69d3589665c550c3560d01ee0ff48b85c3946eafbaf89e",
      "translationSHA256": "3e14294a47c910cc577204e6c0d2c0ce117dce50834a87255578946e4e3635b7",
