    {
      "target": "Characters/Dialogue/MarriageDialogue",
      "key": "Rainy_Night_0",
      "field": null,
      "source": "The rain makes it feel like we're all alone.$l#$e#I'm cold... Aren't you ready to tuck into bed?$l",
      "translation": "Kvůli dešti mám pocit, jako bychom byli na světě sami.$l#$e#Je mi zima... Nechceš už zalézt do postele?$l",
      "sourceSHA256": "72b5315afc69c1d2ef0b421d47dafc83bc2672361b948b250d9ea6f453e11e0c",
      "translationSHA256": "60925d891e1ed24c182085c98a634c9c6d5a4629b670f085bbcf4ba9a44a3530",
