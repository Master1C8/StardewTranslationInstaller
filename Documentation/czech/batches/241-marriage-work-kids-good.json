        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogue",
      "key": "Neutral_1",
      "field": null,
      "source": "Do you think your grandpa would be proud of the work we've done?",
      "translation": "Myslíš, že by byl tvůj dědeček hrdý na to, co jsme dokázali?",
      "sourceSHA256": "53b46ab699e016680dd9ef3b2a853b295e7d129905045009bfaaf9edcb4e34e5",
      "translationSHA256": "49402d8f1480a5a53f6a905eb94ca1aab70c4e0fb525e864adbe2e140b323a0b",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogue",
      "key": "Neutral_2",
      "field": null,
      "source": "Taking a break? I guess being a farmer is easier than I thought...",
      "translation": "Dáváš si pauzu? Farmaření je tedy asi snazší, než se zdá...",
      "sourceSHA256": "eeec8ecff4d2c77a76ca1496b374f808182a47bcda4ddcc0a608f66355fc2a5f",
      "translationSHA256": "3ea29d07b22a612ad9ba1a9c1b595137d0aca4de6eb8fdfc45cd2c767d394251",
      "reviewChecks": [
        "sourceMeaning",
