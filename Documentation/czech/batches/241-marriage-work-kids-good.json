        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogue",
      "key": "Neutral_0",
      "field": null,
      "source": "I hope you'll still like me when I'm old and gray.$s",
      "translation": "Doufám, že mě budeš milovat i ve stáří.$s",
      "sourceSHA256": "2fc1b04d3af844fb077e11736137de7d90693306487524575aa0a6b396e395e7",
      "translationSHA256": "6d20ea9570d4d9e59c8b48d0dc79d4d0f8570fa4bda89a0fad8bde3d3c723727",
      "reviewChecks": [
        "sourceMeaning",
