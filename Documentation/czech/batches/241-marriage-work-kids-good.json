    {
      "target": "Characters/Dialogue/MarriageDialogue",
      "key": "OneKid_0",
      "field": null,
      "source": "Have you spent any time with %kid1 today?",
      "translation": "Našlo se dnes trochu času na %kid1?",
      "sourceSHA256": "cd5b4b8c460ec59b89157f0a1bf53e3725d59944ff26152887139250e3a4df2e",
      "translationSHA256": "75495d5c7ff4fddeda3059cc186f75720b9213a755c0de93f61dfdff9d5f597e",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogue",
      "key": "OneKid_1",
      "field": null,
      "source": "I wonder if %kid1 will grow up to be a farmer like you?",
      "translation": "Zajímalo by mě, jestli %kid1 půjde v tvých stopách a jednou povede farmu.",
      "sourceSHA256": "e5d36c29801e16d3a6cfbcc32bf0f9ec410c1daed28ef74fc40eeb360f34e5f1",
      "translationSHA256": "242c399a1cac7436230649be589f2dca6da8be14f9770161e4d051602d6d40f8",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogue",
      "key": "OneKid_2",
      "field": null,
      "source": "Don't worry, I'll feed %kid1 today. You can just focus on running the farm.",
      "translation": "Neboj, dnes %kid1 nakrmím. Ty se můžeš soustředit na vedení farmy.",
      "sourceSHA256": "eb9ed49033af97b28404fb4bf72aa4ec18c6e110db948ce3356e5bbf54ce9104",
      "translationSHA256": "ce6a7e54ef21e70c01c4af5879a4d980fe99b9f5bd134100696ee9289155d8ea",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogue",
      "key": "OneKid_3",
      "field": null,
      "source": "Life's a lot different now that we have a child.",
      "translation": "Teď, když máme dítě, je život úplně jiný.",
      "sourceSHA256": "3ab5cfc4269919bb9b535882b111820e5ebacc79e2359b14f6de79e649664886",
      "translationSHA256": "a39307642699da98c153ec6b995cf263675271a549bc3133e1bfdffbaa8ab829",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogue",
      "key": "TwoKids_0",
      "field": null,
      "source": "I already gave %kid1 and %kid2 their breakfast. They were hungry!",
      "translation": "Obě děti, %kid1 a %kid2, už dostaly snídani. Měly hlad!",
      "sourceSHA256": "f3bdd2e9e98305ba8232c5947fa4281f24ef3f01fa65c8de0f4f0a3e91d83f96",
      "translationSHA256": "f8baa7ac508ab7bc7f5194745ec76f5c6d8ed26c7936aeb68282d66727f48182",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogue",
      "key": "TwoKids_1",
      "field": null,
      "source": "We have to make sure and give %kid1 a lot of attention now that we have %kid2. We don't want any jealousy between them.",
      "translation": "Teď, když máme %kid2, musíme dávat %kid1 dostatek pozornosti. Nechceme, aby mezi nimi vznikla žárlivost.",
      "sourceSHA256": "a4a1205484e08f549e2dcede2d57f32fad7de4cfe2c1c101bb290f96cf15e336",
      "translationSHA256": "35a43d9d2f6e8b010d4d1580bb36d6f1465e4fe7794e67d2df660d1350812ea4",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogue",
      "key": "TwoKids_2",
      "field": null,
      "source": "You know, I think %kid2 has your nose.",
      "translation": "Víš, myslím, že %kid2 má tvůj nos.",
      "sourceSHA256": "c4127e06b8dd9bb50acd7ccbd4a28703b8e5529a962f6b47712fb66200e305f3",
      "translationSHA256": "7f846abeb0ba4564a3c825f913b81e90e81276dbc0376c97ad06163d16068e7c",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogue",
      "key": "TwoKids_3",
      "field": null,
      "source": "A nice house, two wonderful kids, and a beautiful plot of land. What's left?",
      "translation": "Pěkný dům, dvě úžasné děti a krásný pozemek. Co víc si přát?",
      "sourceSHA256": "eb797c47b217f279bd1b8f54def8ef567ac455d65e148b0f319cd8ba04757827",
      "translationSHA256": "2c9530034336689dd5db55cf25a1b7fc66b303418f6a6268a3c4e46b9b6c8ad4",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogue",
      "key": "Good_0",
      "field": null,
      "source": "It's hard to believe we're finally married...$l",
      "translation": "Je těžké uvěřit, že jsme konečně svoji...$l",
      "sourceSHA256": "1db1bfd77e4a9c9bd720bfbe567962e76e506a7135e0a541b8104652d25d205b",
      "translationSHA256": "c65f6088c782297e50276d336adc255399b73de7f2fba003b6b4b8ef9bb37fdf",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogue",
      "key": "Good_1",
      "field": null,
      "source": "You know, I always had a feeling we'd be together some day.$l",
      "translation": "Víš, odjakživa mi něco říkalo, že jednou budeme spolu.$l",
      "sourceSHA256": "a44cf32a3b6156dd1e1acc16b7bd0a4f1ff33e4090b7978302602f69f5a4fcbc",
      "translationSHA256": "7fbf2c283b362c055fbece25a6c6565190b50714ee459643017137c3424f4d12",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogue",
      "key": "Good_2",
      "field": null,
      "source": "Are you enjoying the married life, @?#$e#I am.$l",
      "translation": "Užíváš si manželský život, @?#$e#Já ano.$l",
      "sourceSHA256": "86d4fd1639b17c1d6d2d158c9b84beba29c11ba59cbf606ef408f97826ff18bb",
      "translationSHA256": "a0ce16855df7e336f0e2e4dae0bea7f184f9abc3d6ec8d77886fc04b3594c82e",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogue",
      "key": "Good_3",
      "field": null,
      "source": "Wow, you look really handsome today!$l^Wow, you look beautiful today.$l",
      "translation": "Páni, dnes jsi vážně fešák!$l^Páni, dnes jsi opravdu nádherná.$l",
      "sourceSHA256": "6c4d62864c757c5d6a0e46c85f0e8bef077305ef1df32c87505924ffe1041c1d",
      "translationSHA256": "ede2cc9cca7064e7a103308ba6a39d473913d6c9921ef2cdd6f358e43762785a",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogue",
      "key": "Good_4",
      "field": null,
      "source": "This place is my home now... I'm happy here.$l",
      "translation": "Tady je teď můj domov... Je mi tu dobře.$l",
      "sourceSHA256": "87b8a1748b0f017b14dbeb0a5847d990367b586a090040ad28f80f72265f9c29",
      "translationSHA256": "b38a3593ef5ae46c4bc4a6f0f3c72b671458b10f1c0e73c4689070156b824fee",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogue",
      "key": "Good_5",
      "field": null,
      "source": "I was just admiring my wedding amulet... The shell is flawless. It must have cost you a fortune!$l",
      "translation": "Zrovna obdivuji svůj svatební amulet... Mušle je bez jediného kazu. Musel tě stát celé jmění!$l",
      "sourceSHA256": "c57af7e079fcf4d603f084a0c2610fa3269221b7963a789ee3bc75e6f0798f80",
      "translationSHA256": "583d6c4b1fcf93fdb5914761f1d72fc87331fcc834edf3a8633f0b2d551a970c",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogue",
      "key": "Good_6",
      "field": null,
      "source": "Be careful out there! Sometimes I worry about you falling into a mine shaft.",
      "translation": "Venku na sebe dávej pozor! Někdy mám strach, že spadneš do důlní šachty.",
      "sourceSHA256": "6b4a1108e905db14e13f96c0696d0f7e40f999ef217db1818987b681ef220b21",
      "translationSHA256": "ee7a84f81480a6451c717695a55e2f8f311e92314ecb83baa49dddbc01f171b7",
      "reviewChecks": [
        "sourceMeaning",
