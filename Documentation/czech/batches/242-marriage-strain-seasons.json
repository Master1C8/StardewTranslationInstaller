    {
      "target": "Characters/Dialogue/MarriageDialogue",
      "key": "spring_Abigail",
      "field": null,
      "source": "I may like the colder seasons, but by the end I'm always glad to see spring arrive.",
      "translation": "Možná mám ráda chladnější roční období, ale na jejich konci mám vždy radost, když přijde jaro.",
      "sourceSHA256": "58994f0d38b51e1f79d552e247162fc741d29666708944184c676e07f72e0579",
      "translationSHA256": "a41416961e15c99bf6c0863d19ded6c6b9a5ea6ff074ea25699245399a99ee5c",
      "reviewChecks": [
