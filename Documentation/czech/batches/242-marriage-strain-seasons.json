    {
      "target": "Characters/Dialogue/MarriageDialogue",
      "key": "Bad_9",
      "field": null,
      "source": "I wonder if I could've done better.$s",
      "translation": "Občas si říkám, jestli pro mě nebyla lepší možnost.$s",
      "sourceSHA256": "aeff3c04ecb85c6c5cb58164ade878b2fe38dfbc4074ef621e17418cd70c1b88",
      "translationSHA256": "2b2880050f45e874a597a7aa1c9920201ee10f966539eb5970639368dab54b61",
