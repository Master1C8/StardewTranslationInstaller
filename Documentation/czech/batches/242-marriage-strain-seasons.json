      "target": "Characters/Dialogue/MarriageDialogue",
      "key": "fall_15",
      "field": null,
      "source": "Have you figured out what you're going to use for our grange display tomorrow?",
      "translation": "Už víš, co zítra použiješ do naší farmářské výstavky?",
      "sourceSHA256": "e691d91eeea352006eb0f40022b6cfbe9bcd296f6ffec21ef326656f651be1d0",
      "translationSHA256": "3501f4c56a9466cdb5ded50fb8a3929bad0490153d8689d5042a800af4745e0d",
