    {
      "target": "Characters/Dialogue/MarriageDialogue",
      "key": "fall_1",
      "field": null,
      "source": "This weather feels pretty nice after the heat of summer.",
      "translation": "Po letním horku je toto počasí docela příjemné.",
      "sourceSHA256": "2f19d6accb34b369271913d39ac59ec97052b705d3ceef38115d9f3a91f92496",
      "translationSHA256": "bfde81ba37df4cb7bd41873714cc11f5fa3987b379bef07e7164391730ed131a",
      "reviewChecks": [
