    {
      "target": "Characters/Dialogue/MarriageDialogue",
      "key": "Bad_5",
      "field": null,
      "source": "You used to be romantic... what happened?$s#$e#I know I'm not as young as I used to be... is that what you married me for?$a",
      "translation": "Dřív v tobě bylo víc romantiky... co se stalo?$s#$e#Vím, že mládí netrvá věčně... bylo snad mé mládí důvodem ke svatbě?$a",
      "sourceSHA256": "9423733a3c64feafb6287e2c28b4e851008a55cb6b4433f0bb6381cc9e105b39",
      "translationSHA256": "ba8d5af6c8079e8dac877deaf02104348576cdef0abf254ceecea8f007369b1a",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogue",
      "key": "Bad_6",
      "field": null,
      "source": "We only have one short life to live... is this the best way to do it?$s",
      "translation": "Máme jen jeden krátký život... je tohle nejlepší způsob, jak ho prožít?$s",
      "sourceSHA256": "d3d6ce016348fd995b7e920ffbb357be7f4a51f960dd77b7e4934d91515ace18",
      "translationSHA256": "08329c0f3925baf3f416c541164c991047bfb636fc970964b12c70445efe51a1",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogue",
      "key": "Bad_7",
      "field": null,
      "source": "I used to be your sweetie... now you only seem to put up with me when I make a hot dinner.$s",
      "translation": "Dřív mezi námi bylo samé ‚zlatíčko‘... teď mě zřejmě snášíš jen tehdy, když připravím teplou večeři.$s",
      "sourceSHA256": "d3a16ff6923e31c6329639546c68543976d4651d2a2c5d28517220f7c6e689ea",
      "translationSHA256": "87f90b3aaf257c6019815c587be24d9d3dfbabd903c9f946aa233801d07421e6",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogue",
      "key": "Bad_8",
      "field": null,
      "source": "You've been so cold to me lately...$s",
      "translation": "Poslední dobou se ke mně chováš tak chladně...$s",
      "sourceSHA256": "726caf94c5633ef5c23ec2f4314ad67b4c73a999377320553100696b74fb154d",
      "translationSHA256": "6ecdaec66f4321c4105255a7a92867902ccd351ffe70cf0e4893fe2b5cececc9",
      "reviewChecks": [
