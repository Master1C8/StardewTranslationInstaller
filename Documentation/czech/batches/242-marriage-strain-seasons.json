    {
      "target": "Characters/Dialogue/MarriageDialogue",
      "key": "spring_Haley",
      "field": null,
      "source": "Aren't you glad winter's over, honey? Things seem more hopeful now.",
      "translation": "Máš radost, že zima skončila, zlato? Všechno teď vypadá nadějněji.",
      "sourceSHA256": "2c72d61a7ef6b8aa2461ae2eebd5129baeff00652e07fa25424852131caa5554",
      "translationSHA256": "dc948f63be2d36be6b57c6c050ab64dbc5839b1840699aaa2e9fa09a00235367",
