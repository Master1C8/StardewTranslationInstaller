      "target": "Characters/Dialogue/MarriageDialogue",
      "key": "winter_28",
      "field": null,
      "source": "Thanks for a great year, @. I'm excited to tackle next year together.$l",
      "translation": "Děkuji za skvělý rok, @. Těším se, až se spolu pustíme do toho dalšího.$l",
      "sourceSHA256": "dc2414dba4588691b7c3a566f0e377fdcaec75d9b0a70fce9aded763836bf126",
      "translationSHA256": "fa9f2bc2053a35e5ca09e05ea424de286f2423236da9661349663c3737a2011d",
