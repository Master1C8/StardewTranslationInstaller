    {
      "target": "Characters/Dialogue/MarriageDialogue",
      "key": "summer_8",
      "field": null,
      "source": "Sorry if I smell... I was sweating all night in the heat.",
      "translation": "Promiň, jestli zapáchám... V tom horku ze mě celou noc jen lil pot.",
      "sourceSHA256": "fdcbb70542b50875f1268c5c4408b9e0d2b4c5f82f5c8e6a6af5dce1b39bf494",
      "translationSHA256": "c1373911b1247c56744ba2fb2be3ae4232da459f1feb2beaef8523b487dca017",
      "reviewChecks": [
        "sourceMeaning",
