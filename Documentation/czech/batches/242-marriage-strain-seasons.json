      "target": "Characters/Dialogue/MarriageDialogue",
      "key": "winter_1",
      "field": null,
      "source": "Brrr.... It's cold. I guess winter has arrived.",
      "translation": "Brrr... To je chladno. Zřejmě dorazila zima.",
      "sourceSHA256": "633ad31dd7746713f7fb74bbc9c9e518e7af665ef80136bd6dd904e6dd0d4319",
      "translationSHA256": "0e3cdb57f5495ff8ed2b86ff8982d1398a827f7b0d73951fd0f2777fef8ba2ee",
