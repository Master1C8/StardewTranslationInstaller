      "target": "Characters/Dialogue/MarriageDialogue",
      "key": "winter_7",
      "field": null,
      "source": "Are you going to enter the fishing contest tomorrow?",
      "translation": "Zúčastníš se zítra rybářské soutěže?",
      "sourceSHA256": "8ae8c6e40257e7dce9cfd505988cfbf6f4a94513f4e2c81b2609a7604ac8a5c2",
