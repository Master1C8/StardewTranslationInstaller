    {
      "target": "Characters/Dialogue/MarriageDialogue",
      "key": "spring_Maru",
      "field": null,
      "source": "I'm feeling excited for a new year of farming, @!$h",
      "translation": "Těším se na nový rok farmaření, @!$h",
      "sourceSHA256": "70ac01a4797c0d5fe1e6d3beb1cf4c9bca8add307568c02b93354627af7509d3",
      "translationSHA256": "e3b758ded6a806a0fe1a657574df0f9b9037d5543c8079611c74fa7e88bdacd7",
      "reviewChecks": [
