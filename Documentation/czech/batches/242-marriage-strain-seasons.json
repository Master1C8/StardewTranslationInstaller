    {
      "target": "Characters/Dialogue/MarriageDialogue",
      "key": "Bad_4",
      "field": null,
      "source": "Do you ever wonder what else is out there?$s",
      "translation": "Přemýšlíš někdy, co dalšího je tam venku?$s",
      "sourceSHA256": "6579f1fff02f9c2dcad0852ba3b483434e98d98dd20effe54866169677ed1329",
      "translationSHA256": "b7a19bba28ce042d0ed4fec313da1a9b719b32361f43f77b6a54d6914a6d1eb5",
      "reviewChecks": [
        "sourceMeaning",
