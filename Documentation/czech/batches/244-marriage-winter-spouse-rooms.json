    {
      "target": "Characters/Dialogue/MarriageDialogue",
      "key": "spouseRoom_Haley",
      "field": null,
      "source": "#$c .5#Go ahead and start your day, honey. I'm just putting on my make-up.#$e#Have any plans for the day?",
      "translation": "#$c .5#Klidně se pusť do svých věcí, zlato. Já se jen nalíčím.#$e#Máš na dnešek nějaké plány?",
      "sourceSHA256": "d834fe18663789076196a2ff6ff76cc1fe4bb6634fcc06c4354fd293d48bc7a0",
      "translationSHA256": "d18790c16367ce8aac0e304f042414cae1fc6e4f064483b822d693715dc77fd1",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
