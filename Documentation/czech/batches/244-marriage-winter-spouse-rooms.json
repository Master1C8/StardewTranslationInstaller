    {
      "target": "Characters/Dialogue/MarriageDialogue",
      "key": "winter_Shane",
      "field": null,
      "source": "There's a wide, wide world out there... but I'd rather stay in my room.",
      "translation": "Tam venku je širý, přeširý svět... ale já raději zůstanu ve svém pokoji.",
      "sourceSHA256": "09bca6f3033225b39b950eae102062fc14932fd47b71c1c75bb50898892140df",
      "translationSHA256": "0ff0dfc3b71888148a946642226774e55065fbe7d5d4bcd1e0445c967e9c4a3a",
      "reviewChecks": [
