    {
      "target": "Characters/Dialogue/MarriageDialogue",
      "key": "spouseRoom_Maru",
      "field": null,
      "source": "#$c .5#I got up early to do a little star-gazing.#$e#I hope you don't mind if I spend some time on my projects today, honey.",
      "translation": "#$c .5#Vstala jsem brzy, abych chvíli pozorovala hvězdy.#$e#Doufám, že ti nebude vadit, když dnes věnuji nějaký čas svým projektům, zlato.",
      "sourceSHA256": "6c12f57e13dc434c067b53130619c5e19662f001c3b823fda28e1d54a18f87bd",
      "translationSHA256": "b92eb5fdd1bd9f1f99fb6497f3f2b47e0e44cc9edd60d65d7ef75721eb948ab4",
      "reviewChecks": [
        "sourceMeaning",
