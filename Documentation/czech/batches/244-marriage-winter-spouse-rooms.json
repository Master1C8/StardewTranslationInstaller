    },
    {
      "target": "Characters/Dialogue/MarriageDialogue",
      "key": "spouseRoom_Sebastian",
      "field": null,
      "source": "#$c .5#I'm debating whether I should work or just read comics all day.#$e#Hey, do we have any pizza in the freezer? I'm hungry.",
      "translation": "#$c .5#Rozhoduji se, jestli mám pracovat, nebo celý den číst komiksy.#$e#Hej, máme v mrazáku nějakou pizzu? Mám hlad.",
      "sourceSHA256": "9635144d3be91ff23b8ee13bfc31ecec7c7eb37c01ec85f6addee67fb6833fe9",
      "translationSHA256": "94acc27ff26ae45161232ba5bc6dd23581f6df7678fd8cab64949656a063b6fc",
