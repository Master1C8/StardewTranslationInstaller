    {
      "target": "Characters/Dialogue/MarriageDialogue",
      "key": "winter_Haley",
      "field": null,
      "source": "I was just thinking about the time you helped me open a jar of pickles.$h#$e#We've come a long way since then.$l",
      "translation": "Zrovna jsem přemýšlela o tom, jak se mi s tvou pomocí podařilo otevřít sklenici nakládaných okurek.$h#$e#Od té doby jsme urazili dlouhou cestu.$l",
      "sourceSHA256": "f42cb7c4d18461d9ca698b4c640d734074b55c54eb30070768d3fd5d1d62cfa9",
      "translationSHA256": "a6cd1cf68c35413c31e5403b57a1cdc76a2d67c0cacab0d2e275a8c0fe913a44",
