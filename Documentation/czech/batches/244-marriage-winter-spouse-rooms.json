    {
      "target": "Characters/Dialogue/MarriageDialogue",
      "key": "winter_Alex",
      "field": null,
      "source": "I hope my grandparents are doing okay. They used to rely on my help quite a bit. You know, with lifting heavy objects or whatever.",
      "translation": "Doufám, že se prarodičům daří dobře. Dřív na mou pomoc docela spoléhali. Víš, třeba se zvedáním těžkých věcí a tak.",
      "sourceSHA256": "e206dead5bbe8ec5aa81a1a4a5aa268c1d34d80e1edac69f5648e1beb00d395d",
      "translationSHA256": "75f647961b73bf2fbb40daed936d7e3bf92903c83b48b9ef1f5504988f6780a5",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogue",
      "key": "winter_Sam",
      "field": null,
      "source": "I've given up on being a musician. I'm a family man now!",
      "translation": "Vzdal jsem se hudební kariéry. Teď jsem muž od rodiny!",
      "sourceSHA256": "2637a60c10d9578d412c82269f322f3f47031e2029f4bd19c1c20409e5672488",
      "translationSHA256": "ab26493e9b3d39628357faa4393d4229a49777cf032b85d6e7a5edda1b335db2",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogue",
      "key": "winter_Emily",
      "field": null,
      "source": "Whoops, my hair is frozen solid again.$s",
      "translation": "Jejda, vlasy mi zase úplně zmrzly.$s",
      "sourceSHA256": "0896b4c08de0980a2257b2b046a470020c1ea57eb2d83ce56324dde201910d75",
      "translationSHA256": "489383825afb7db980c815c5ffde21cdf5eb5af36e349f1c66b34b6af0548914",
      "reviewChecks": [
