    {
      "target": "Characters/Dialogue/MarriageDialogue",
      "key": "winter_Harvey",
      "field": null,
      "source": "Winter is flu season, so work is probably going to be a lot more stressful. Sorry in advance if I'm grouchy.",
      "translation": "Zima je chřipková sezóna, takže práce bude nejspíš mnohem stresující. Předem se omlouvám, pokud budu nevrlý.",
      "sourceSHA256": "f47863f36dec11e4c626f871b692f8eefa3ae8b621eb8fb9344aea85ed019fe3",
      "translationSHA256": "90d39d13ebd5c8876a3d0b076b0c6801b23199652aaad477d17741e6214d6ea1",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogue",
      "key": "winter_Elliott",
      "field": null,
      "source": "I think I might do some writing this winter. There's not much else to do, anyway.",
      "translation": "Myslím, že bych tuto zimu mohl trochu psát. Stejně se toho moc jiného dělat nedá.",
      "sourceSHA256": "769de0c9b17809f6f9056abecbb9e02209765fdb4d560a31c9c77882f57c6f7a",
      "translationSHA256": "e156311f5db55e8f89a8b948ff93bd93749d3ca25f284ca4920fae9ca0dde6e9",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
