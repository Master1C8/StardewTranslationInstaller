    {
      "target": "Characters/Dialogue/MarriageDialogue",
      "key": "spouseRoom_Penny",
      "field": null,
      "source": "#$c .5#I always wanted my very own library. This is so charming.$h#$e#I like to do a little reading first thing in the morning. It gets my brain into gear.",
      "translation": "#$c .5#Vždycky jsem chtěla vlastní knihovnu. Tohle je tak kouzelné.$h#$e#Ráda si hned po ránu trochu čtu. Pomáhá mi to nastartovat mozek.",
      "sourceSHA256": "5c3e85f21d01f5767c95421575a6a785f0cc9fc0fc469d3aa2f680520becca03",
      "translationSHA256": "17908f666fd3ecb67e1d10ba963a595ec0b6e661460296f1f9a7c48441f656db",
      "reviewChecks": [
        "sourceMeaning",
