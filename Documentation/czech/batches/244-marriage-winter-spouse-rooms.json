    {
      "target": "Characters/Dialogue/MarriageDialogue",
      "key": "winter_Penny",
      "field": null,
      "source": "I'm going to do a lot of reading this winter.",
      "translation": "Tuto zimu budu hodně číst.",
      "sourceSHA256": "d90fc7e82f0a8e0744f5baff93ccf848914f04e77bc0434c672e73614cae4c68",
      "translationSHA256": "c03f907b4981a96a3d7bc4108ff4776d269f34b65d456b9eb3b2e1f60eeac7c7",
      "reviewChecks": [
        "sourceMeaning",
