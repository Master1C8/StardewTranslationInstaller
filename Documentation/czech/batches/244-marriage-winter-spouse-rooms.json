      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogue",
      "key": "winter_Sebastian",
      "field": null,
      "source": "I wonder what Sam's up to? We used to be really good friends.",
      "translation": "Co asi dělá Sam? Bývali jsme opravdu dobří přátelé.",
      "sourceSHA256": "311b1fdaba1196526597ebdff87154469d17a689eee70e9eb7e5e46f63348011",
      "translationSHA256": "eafe8e2e4353a252abe246721d2ef64f0057c9815faba295e8a96813595bec6a",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
