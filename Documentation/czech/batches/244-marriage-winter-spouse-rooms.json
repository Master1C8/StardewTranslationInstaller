    {
      "target": "Characters/Dialogue/MarriageDialogue",
      "key": "winter_Leah",
      "field": null,
      "source": "I always start craving salad in the winter... Inconvenient, I know.",
      "translation": "V zimě vždycky začnu mít chuť na salát... Trochu nepraktické, já vím.",
      "sourceSHA256": "38643e8d0794b535a168bbdcff3a547dd0f2f3ea2c52ed7d10aca7f9d05b2ce3",
      "translationSHA256": "548c704ac4c7179722abcf7058e603a8c0a6ae9eff0acd1eb94b0c5d3ebe4342",
      "reviewChecks": [
