      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogue",
      "key": "spouseRoom_Leah",
      "field": null,
      "source": "#$c .5#One of these days I'll have to do your portrait.#$e#The view from this window is inspiring, don't you think?",
      "translation": "#$c .5#Jednou budu muset namalovat tvůj portrét.#$e#Výhled z tohoto okna je inspirující, nemyslíš?",
      "sourceSHA256": "0134c3dc491b55a99fc25a6e1a1068934d4df07a02eff0be7d1306f6f0acfc2e",
      "translationSHA256": "ac0f6f4ae52a609802d56cc8594617e0143b1104093e59ab1d27ef8ef9ddb8a6",
      "reviewChecks": [
        "sourceMeaning",
