    {
      "target": "Characters/Dialogue/MarriageDialogue",
      "key": "spouseRoom_Sam",
      "field": null,
      "source": "#$c .5#The old guitar... I don't have as much drive to play it anymore. That's fine.#$e#What's on your agenda today?",
      "translation": "#$c .5#Stará kytara... Už nemám takovou chuť na ni hrát. To nevadí.#$e#Co máš dnes v plánu?",
      "sourceSHA256": "b86e9b9085f505bff05195bbc77263e827e38432b68a3d538afb6d2c461fa3d4",
      "translationSHA256": "295309ab727632ec101cd714d0c9b736d75fc50b81fd1402a00350f9d470e903",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
