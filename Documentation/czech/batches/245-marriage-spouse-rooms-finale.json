    {
      "target": "Characters/Dialogue/MarriageDialogue",
      "key": "spouseRoom_Elliott",
      "field": null,
      "source": "#$c .5#I think I might do some writing today.#$e#Will you be okay without my help?",
      "translation": "#$c .5#Myslím, že dnes možná budu trochu psát.#$e#Zvládneš to bez mé pomoci?",
      "sourceSHA256": "154aa89d19d00b62d53e128bac64af1405af51ae4dcd0d3d64a053ed88bcee8b",
      "translationSHA256": "62596d001e5eba041417b09c2458ae504e74fa436f5e3dd5458a61e2df9f5bf3",
