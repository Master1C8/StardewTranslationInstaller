    {
      "target": "Characters/Dialogue/MarriageDialogue",
      "key": "spouseRoom_Alex",
      "field": null,
      "source": "#$c .5#Don't ever let me get lazy. I want to stay in good shape for you!#$e#There's lots of room here to do my exercises. I'm making more progress than ever!",
      "translation": "#$c .5#Nikdy nedovol, abych zlenivěl. Chci se pro tebe udržovat v dobré kondici!#$e#Mám tu spoustu prostoru na cvičení. Dělám větší pokroky než kdy dřív!",
      "sourceSHA256": "43d4c8e530a4194c0cf2f0dfe9dbd3bde21f38733dfafb52fb2732cc4a959458",
      "translationSHA256": "7478cba5855a0c5ddaca018a533a802a701946e687f414aff045f95d9d7b86de",
      "reviewChecks": [
        "sourceMeaning",
