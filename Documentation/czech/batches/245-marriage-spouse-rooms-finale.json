        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogue",
      "key": "spouseRoom_Emily",
      "field": null,
      "source": "I'm going to spend some time with the parrot today. It breaks my heart that he'll never fly again.$u",
      "translation": "Dnes strávím nějaký čas s papouškem. Při pomyšlení, že už nikdy nebude létat, mi puká srdce.$u",
      "sourceSHA256": "0d5b5dd43f0665b937db799992e5d31eb4608f69f993087002e3a97c67f7cc25",
      "translationSHA256": "f8da779d2a549b27bd836bad9787750f8f5e18ffc7ff255325885adf5490ec39",
      "reviewChecks": [
