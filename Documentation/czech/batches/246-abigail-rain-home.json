      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueAbigail",
      "key": "Rainy_Night_4",
      "field": null,
      "source": "I felt like making some soup for dinner. I hope it's not too disgusting. [199 218 219 727 730]$h",
      "translation": "Dostala jsem chuť uvařit k večeři polévku. Doufám, že není příliš odporná. [199 218 219 727 730]$h",
      "sourceSHA256": "1886a602445623767112422f9f56b10abc26b70c4c01ef52e309475e09dcc66f",
      "translationSHA256": "dbb886146def010c9d95cebb7853d15ff00eb9cc2975be730f8ae9c9e569d545",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
