      "target": "Characters/Dialogue/MarriageDialogueAbigail",
      "key": "Rainy_Day_0",
      "field": null,
      "source": "The dark... the rain... it gets me excited.$l",
      "translation": "Ta temnota... déšť... vzrušuje mě to.$l",
      "sourceSHA256": "38f3a12070149c2d8b3ad97600162c349d1b80925ec800c15ec0913abf194071",
      "translationSHA256": "ba4bb2540b4b91192b4cb55c30dc7ab6875575a3460131b3024a35f33dc6c452",
