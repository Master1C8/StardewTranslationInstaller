        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueAbigail",
      "key": "Rainy_Night_5",
      "field": null,
      "source": "Hey! You look like you've been hard at work. Can I help you relax?^Have you been working hard? You look cute when you're a little exhausted.$h",
      "translation": "Ahoj! Vypadáš, že jsi pilně pracoval. Můžu ti pomoci si odpočinout?^Pracovala jsi pilně? Když jsi trochu vyčerpaná, vypadáš roztomile.$h",
      "sourceSHA256": "3ea528c92eb6d9e48dc2b0f3d7a44c447ca7b4d1ffd461628010259df53a4a54",
      "translationSHA256": "c227ecc92c531f7c8f576c8d2ee435e026be841a8551fcc3ffab41ddecb64d65",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueAbigail",
      "key": "Rainy_Night_Abigail",
      "field": null,
      "source": "The sound of rain should put us right to sleep tonight.",
      "translation": "Zvuk deště nás dnes v noci určitě hned uspí.",
      "sourceSHA256": "51b40f4bc3a6e8767cdf1eeabb3be7dc5a3a9954fd8dbd69c6cc28b763755ee7",
      "translationSHA256": "b3a3a86b7b4334c457f6da6d067e1059641fe4f4abf558981feacb1135dc634b",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueAbigail",
      "key": "Indoor_Day_0",
      "field": null,
      "source": "I always loved this place, long before you moved in. Now I can explore the farm whenever I want!$h",
      "translation": "Tohle místo jsem milovala dávno před tvým nastěhováním. Teď můžu farmu prozkoumávat, kdykoli chci!$h",
      "sourceSHA256": "3969916d7024d22c60ef28fe0889838f0b4d84f1500f4ee966b723462e53989a",
      "translationSHA256": "084ded006c05877840cfff6463d56f12c64f7e1e697d37c5f91ea5c6560bdfa2",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueAbigail",
      "key": "Indoor_Day_1",
      "field": null,
      "source": "Hey, @. Heading out into the wild? I got you something...[286 287 205 732]#$e#Use that if you get into a tough spot. It should help keep you safe.",
      "translation": "Ahoj, @. Vyrážíš do divočiny? Něco jsem ti sehnala...[286 287 205 732]#$e#Použij to, pokud se dostaneš do úzkých. Mělo by tě to ochránit.",
      "sourceSHA256": "8087fd6c2ef1e46251b11635601352766bfaecfb536bea9992e99f0f99074e6c",
      "translationSHA256": "97813f9c2e2bf74626ef059b6ec8fc9500174b726ecb561b24851c0cbcbfa287",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueAbigail",
      "key": "Indoor_Day_2",
      "field": null,
      "source": "Heading to the mines? Hey... if you find something tasty, remember to bring me a piece!$h",
      "translation": "Míříš do Dolů? Hej... Kdyby se ti podařilo najít něco chutného, nezapomeň mi kousek přinést!$h",
      "sourceSHA256": "9cc6d60b34fcee7f708e53c02817126542869b4a13838caf1325e9eadf1473c6",
      "translationSHA256": "2c2b4a3216e34a8f5653dc243e479d643d07a6acf5a29b5705dd984fb38f7a11",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueAbigail",
      "key": "Indoor_Day_3",
      "field": null,
      "source": "Hey! I'm just debating what I should do today. I'm not used to having this much freedom!",
      "translation": "Ahoj! Zrovna přemýšlím, co bych dnes měla dělat. Nejsem zvyklá mít tolik svobody!",
      "sourceSHA256": "4a0fa51b82b7152366e185ccbfa516aa87fe7ce4a2a06a0a5d4027c18d8fb624",
      "translationSHA256": "eeeea74d6942ca361c14e69068fd3c91988ce1fe7af289c5675530873253180f",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueAbigail",
      "key": "Indoor_Day_4",
      "field": null,
      "source": "You don't mind if I do some re-decorating now and then, do you? I'm still excited to have a place of my own to work on.",
      "translation": "Nevadí ti, když čas od času trochu pozměním výzdobu, že ne? Pořád mě těší, že mám vlastní prostor, který můžu upravovat.",
      "sourceSHA256": "2511bba2cd85b855590bcb08dcb52ba81476c01227a82b4ca389886e7a94df93",
      "translationSHA256": "531bba5a470d7e288edcb5f180bba71146618f609ff1cecb85c95bb787d530d4",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueAbigail",
      "key": "Indoor_Day_Abigail",
      "field": null,
      "source": "There's always something new happening on our farm... I love it.",
      "translation": "Na naší farmě se pořád děje něco nového... Mám to tu moc ráda.",
      "sourceSHA256": "38c9450ecdf4a8a040b9dc17458d268080fad859616a51344ae58aaecabb986e",
      "translationSHA256": "e13f4001e4a99c2c32d0b20a9c69acfd5824275b88f004d33ad5ed46860181d9",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueAbigail",
      "key": "Indoor_Night_0",
      "field": null,
      "source": "I had a good day, today. There's always something interesting going on around here, if you look close enough.",
      "translation": "Dnes jsem měla dobrý den. Když se člověk pozorně dívá, pořád se tu děje něco zajímavého.",
      "sourceSHA256": "5106f6109b6fd0be3dd622a2e0bea48faac38eb202f08fbc8b32043f967d863f",
      "translationSHA256": "549a5fb74e6ef76715945395ab870b869c5ab8af40ea6974458349534fbab26d",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueAbigail",
      "key": "Indoor_Night_1",
      "field": null,
      "source": "Hey! Tell me about your day. Did anything exciting happen?$h",
      "translation": "Ahoj! Pověz mi o svém dni. Stalo se něco vzrušujícího?$h",
      "sourceSHA256": "e68f7f8f7bea2aba4fc4f228a3054fd53f47890f20ee35b53e710de2eda4e00c",
      "translationSHA256": "21190842ac5dc3373622ec9851e2d0bdf461191cd685cd5b1c115a16765fbf40",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
