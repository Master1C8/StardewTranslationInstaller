        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueAbigail",
      "key": "Rainy_Day_4",
      "field": null,
      "source": "Maybe I'll boot up Journey Of The Prairie King today... one of these days I swear, I'll beat the whole game.$h",
      "translation": "Možná si dnes zapnu Putování krále prérie... Přísahám, že jednou tu hru porazím celou.$h",
      "sourceSHA256": "c3954412ef42d7a8a7ebbbb38b93e275724d2d87775c4ab60984c2cca93f70d2",
      "translationSHA256": "beaac9953c1e58909375f532e0ae65b19edf4204e2ccbada532aaa946caeea6d",
