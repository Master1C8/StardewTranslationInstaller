      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueAbigail",
      "key": "Indoor_Night_2",
      "field": null,
      "source": "I used to be a night owl, but I'm starting to enjoy the rhythm of life on the farm. It feels natural.",
      "translation": "Dřív jsem bývala noční sova, ale začínám si užívat rytmus života na farmě. Připadá mi přirozený.",
      "sourceSHA256": "c07605e889070679684d369e137ecf8ead6cbbad81c5508037056a427e86b241",
      "translationSHA256": "ecffb9485556d8e8fc3ed383da0193b74eb76385abb1139584e4dccabf99808d",
