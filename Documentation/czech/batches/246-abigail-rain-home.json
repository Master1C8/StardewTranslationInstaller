        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueAbigail",
      "key": "Rainy_Day_2",
      "field": null,
      "source": "Hey! I woke up early and did some exploring on my own. I found this and it reminded me of you. [768 767 769 66 82]#$e#Think you can find something better than that? I'm not so sure!$h",
      "translation": "Ahoj! Vstala jsem brzy a vydala se sama na průzkum. Našla jsem tohle a připomnělo mi to tebe. [768 767 769 66 82]#$e#Myslíš, že najdeš něco lepšího? Tím si nejsem tak jistá!$h",
      "sourceSHA256": "f17eebef46af3a0c5960a174e94c3442a7e597fa191c22da6d374b58fc3840aa",
      "translationSHA256": "952a9fa901dde5dbb7479b11140bf28ccf8c562e022c40ce4b0e25bec6aed405",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
