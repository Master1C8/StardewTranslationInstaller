      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueAbigail",
      "key": "Rainy_Day_3",
      "field": null,
      "source": "It might be a good day to visit the caves, huh? Just be careful out there.#$e#If you go, bring a Life Elixir or two.",
      "translation": "Dnes by mohl být vhodný den k návštěvě jeskyní, co? Jen si tam venku dávej pozor.#$e#Pokud vyrazíš, vezmi si jeden nebo dva Elixíry života.",
      "sourceSHA256": "daa1a829c5df8a97981197c63ef58858ef41edb375fc6e947f3b0f808522b967",
      "translationSHA256": "16b2b5fdf1102f87af8c53844443ba7e2742a6d97debad186d8397a414162833",
      "reviewChecks": [
        "sourceMeaning",
