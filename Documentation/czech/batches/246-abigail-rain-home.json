    {
      "target": "Characters/Dialogue/MarriageDialogueAbigail",
      "key": "patio_Abigail",
      "field": null,
      "source": "%Abigail is lost in her music.",
      "translation": "%Abigail se ztrácí ve své hudbě.",
      "sourceSHA256": "939a14180867fa89d7a574d0f30a97cc8fbfebdf57169ec2b9e748cf9fadebc2",
      "translationSHA256": "dccf12d5fb416271f891c2dbbe506dc0b643341285401438b32d3ab544980870",
      "reviewChecks": [
