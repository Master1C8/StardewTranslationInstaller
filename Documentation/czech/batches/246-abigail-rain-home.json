    {
      "target": "Characters/Dialogue/MarriageDialogueAbigail",
      "key": "Indoor_Night_3",
      "field": null,
      "source": "*yawn*... I'm ready to call it a night pretty soon.$h",
      "translation": "*zívnutí*... Za chvíli už budu připravená jít spát.$h",
