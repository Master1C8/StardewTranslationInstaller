      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueAbigail",
      "key": "Neutral_1",
      "field": null,
      "source": "Do you think your Grandpa would be proud of us?",
      "translation": "Myslíš, že by na nás byl tvůj dědeček hrdý?",
      "sourceSHA256": "92cd574641cdee53614a1e66ada50d629af37b17343ae689866969098c482932",
      "translationSHA256": "67e9199e979db4dc201ccbb113d8b2756a46e4de53a8505d847b2d8854a34fc2",
      "reviewChecks": [
        "sourceMeaning",
