        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueAbigail",
      "key": "Neutral_0",
      "field": null,
      "source": "I hope you'll still like me when I'm old and shriveled. It's going to happen some day!",
      "translation": "Doufám, že mě budeš milovat, i až budu stará a scvrklá. Jednou k tomu dojde!",
      "sourceSHA256": "9e07aa1257f196df27c7f432c6fd72d14ea7b6dfb027b9c6d5657e450026f22c",
      "translationSHA256": "8a3c77d94ab8f2093a201a0d28a406e69127d85fb0050f4f36076a9f2392020a",
      "reviewChecks": [
        "sourceMeaning",
