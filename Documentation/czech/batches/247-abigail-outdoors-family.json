    {
      "target": "Characters/Dialogue/MarriageDialogueAbigail",
      "key": "Indoor_Night_4",
      "field": null,
      "source": "The sounds of the night are louder out here. I'll never stop enjoying that.",
      "translation": "Tady venku jsou zvuky noci hlasitější. Nikdy mě nepřestane bavit je poslouchat.",
      "sourceSHA256": "59527293cce862a82a5dfcfb44c11a593576c97e90b3760ecb0271bf072a2579",
