    {
      "target": "Characters/Dialogue/MarriageDialogueAbigail",
      "key": "Indoor_Night_Abigail",
      "field": null,
      "source": "Are you ready for bed soon? I turned on the electric blanket for us...$l",
      "translation": "Chce se ti už brzy do postele? Zapnula jsem nám elektrickou deku...$l",
      "sourceSHA256": "64c9fa2762d480b9cec54d74a1be1becc78c1378afafdb84a941bd1499d19623",
