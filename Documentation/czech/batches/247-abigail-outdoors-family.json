    {
      "target": "Characters/Dialogue/MarriageDialogueAbigail",
      "key": "Outdoor_0",
      "field": null,
      "source": "The soft breeze is blowing mountain air throughout the valley today. It smells like fresh pine and sage.",
      "translation": "Dnes vane údolím jemný vánek a nese horský vzduch. Voní po čerstvých borovicích a šalvěji.",
      "sourceSHA256": "7132f4292ac7ce7dc119930f9fac3f8d15d2f1a85e3d13d36d4eb5256a6e2292",
      "translationSHA256": "58c026a615e9da361770e3f0e2c0b9e13a4bbe11ea30a3d2af2c05338ffef3be",
      "reviewChecks": [
        "sourceMeaning",
