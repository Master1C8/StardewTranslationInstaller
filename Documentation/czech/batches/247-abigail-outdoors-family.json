      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueAbigail",
      "key": "Outdoor_2",
      "field": null,
      "source": "Make sure to keep things tidy around your Grandpa's shrine. There's something special about it, I can feel it.",
      "translation": "Hlavně udržuj kolem Dědečkovy svatyně pořádek. Je na ní něco zvláštního, cítím to.",
      "sourceSHA256": "99040e712d8e6fb7dc640c240132974f093a0bdfa2e8cce6d09ba57fe1f8af1d",
      "translationSHA256": "50206d169d8ac5a0829de20a8ec26662370cd5ad79134f639776afb485f08e2b",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueAbigail",
      "key": "Outdoor_3",
      "field": null,
      "source": "It's pretty cool that we have a cave on our property. It's something I always dreamed about.$h",
      "translation": "Je vážně skvělé, že máme na pozemku jeskyni. Vždycky jsem o tom snila.$h",
      "sourceSHA256": "1247d3dd0ff1659fa9b5123e0104eb3d2241d72bb589fd1d35d17a9f4e16d9c1",
      "translationSHA256": "54ea52a54534f2fc35e3a6d46c4df396ac292162c42018131d055c245b5e73e8",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueAbigail",
      "key": "Outdoor_4",
      "field": null,
      "source": "I always forget to put some snacks in my pocket. *rumble*$h",
      "translation": "Vždycky si zapomenu dát do kapsy nějakou svačinu. *zakručení*$h",
      "sourceSHA256": "53b630f415a4ca7fc99fc67478e7436f5fbb08347384f6aaa4dc4cd96bfbbd45",
      "translationSHA256": "0a27398e4bed33ecf443f2e781d453cf63072370e534012da943743bb227514d",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueAbigail",
      "key": "Outdoor_Abigail",
      "field": null,
      "source": "I'm just going to hang out here, okay?#$e#There's a lot of interesting bugs and things out here. *chuckle*$h",
      "translation": "Budu se tu jen tak poflakovat, dobře?#$e#Je tu spousta zajímavých brouků a dalších věcí. *uchechtnutí*$h",
      "sourceSHA256": "12e9eb4076d0eb12c6d863bc452052108bef40d60202e4befc24320b07d01cb3",
      "translationSHA256": "cbe86937546e2fe6ad4f922ec127202c254b604644bb8ae8528da19bcbd82dd9",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueAbigail",
      "key": "funLeave_Abigail",
      "field": null,
      "source": "I'm going in to town today, just so you know. I need to stretch these legs a bit.",
      "translation": "Dnes jdu do města, ať víš. Potřebuji si trochu protáhnout nohy.",
      "sourceSHA256": "b21b90f37fb077106efcaa9baf7a60e65f04d1e349e5bf124261faa505f8917b",
      "translationSHA256": "2f1ebdee64d8dea865cffdade50c026e921c2f7fa723722aa02193ee3659789e",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueAbigail",
      "key": "funReturn_Abigail",
      "field": null,
      "source": "Hey! Did you have a good day? Mine went well. It was refreshing to take a walk.$h",
      "translation": "Ahoj! Jaký byl tvůj den? Můj byl fajn. Ta procházka mě osvěžila.$h",
      "sourceSHA256": "600c570a866a9344b152cb2d7b97572710aeb1b489b014d81915fbc7dd7e4a16",
      "translationSHA256": "5b7ebc3c8f47dc0ecc511ddcc93bc05e23af76a3966dc02232dcde4f7b3797b9",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueAbigail",
      "key": "OneKid_3",
      "field": null,
      "source": "I can't believe I'm a \"mom\"... life is weird.$h",
      "translation": "Nemůžu uvěřit, že jsem ‚máma‘... Život je zvláštní.$h",
      "sourceSHA256": "f7816c57e0f43d14996eb87b64820b787579b14d0edf2bfbb9e2c3f79efd65c7",
      "translationSHA256": "be9cd96284fd98867052e3fa93b91f55498b168fc2ed3341e2a6a8fff51e755e",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueAbigail",
      "key": "TwoKids_0",
      "field": null,
      "source": "I already gave %kid1 and %kid2 their chocolate cereal. They were screaming!",
      "translation": "Už jsem dala %kid1 a %kid2 čokoládové cereálie. To bylo křiku!",
      "sourceSHA256": "81f778b1169330951b1d0a211c207e1fcefc7dd1b3cdd7676eaf43542277eb30",
      "translationSHA256": "02e90de586999311313682bdef44a3a347f71559b1de66e0bb22eb2a2a1c0552",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueAbigail",
      "key": "TwoKids_2",
      "field": null,
      "source": "I had a dream that %kid2 will grow up to be a famous monster hunter. I've already been thinking about a little armor set.",
      "translation": "Zdálo se mi, že se %kid2 proslaví lovem příšer. Už přemýšlím o malé zbroji.",
      "sourceSHA256": "cf6fec5071da254b22aa4f02d78d9e8a0ef0fc2b830a9f12ba6457cb2f60cfe0",
      "translationSHA256": "27d90743c8a3dc4e23eb5364ede7da496a42e385aa9ad6f0ea4b8086f9cb7886",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueAbigail",
      "key": "TwoKids_3",
      "field": null,
      "source": "A cool old house, a couple kids, and an amazing farm. I never thought I'd come this far... but, hey! Our lives are just getting started.$h",
      "translation": "Parádní starý dům, dvě děti a úžasná farma. Nikdy by mě nenapadlo, že se dostanu tak daleko... Ale hele! Naše životy teprve začínají.$h",
      "sourceSHA256": "6d03159e9a52a7c0ab42d49433923ed2b81aa6252a26a73d9b90f2abd7aa20d9",
      "translationSHA256": "83f91b2aa327a5b5e8cb5f787f97f308c47eae653d81642f39761390c520c595",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueAbigail",
      "key": "Good_1",
      "field": null,
      "source": "Did you hear that? Sometimes I'm convinced this house is haunted.$u",
      "translation": "Slyšíš to? Někdy jsem přesvědčená, že v tomhle domě straší.$u",
      "sourceSHA256": "24f0c60a242a0b92b72baa301f8b29d645f97a6ead2fb587f39c3f5dc0dfac9d",
      "translationSHA256": "8c31a9e625432f6c3168a3c140ce3943a55605869e6bd568a126552a98ac32c8",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueAbigail",
      "key": "Good_2",
      "field": null,
      "source": "Welwick's horoscope predicted great things for me today. I feel really motivated!",
      "translation": "Welwickin horoskop mi na dnešek předpověděl velké věci. Teď jsem opravdu plná elánu!",
      "sourceSHA256": "afedbf2fbfd8273ae56c4ce9072f5c2d54ee4bf0ccfb637777db5e20efdc4d39",
      "translationSHA256": "d43029b9f47e5d07afca2382f784f30a304b0fcd54153f965661810e3824889f",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueAbigail",
      "key": "Good_3",
      "field": null,
      "source": "I can't even remember the last time I dyed my hair... I swear, it never fades from this color...",
      "translation": "Ani si nevzpomínám, kdy jsem si naposledy barvila vlasy... Přísahám, že tahle barva nikdy nevybledne...",
      "sourceSHA256": "ed3356b95c8e0a913aa8567977f46aefc190119078fc9f281507fe3259e829a3",
      "translationSHA256": "f673fbab6abffaf2e90a96af0448d5fbda42f13245f3ab9e644271ddb9656e0f",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueAbigail",
      "key": "Good_4",
      "field": null,
      "source": "I'm glad I owned a heavy pair of boots before moving in. It's hard to imagine tip-toeing around the mud in sneakers.$h",
      "translation": "Jsem ráda, že jsem už před nastěhováním měla pořádné pevné boty. Nedovedu si představit, že bych v teniskách našlapovala kolem bláta.$h",
      "sourceSHA256": "43f03cf8dfe7754284f0ba8878301c2724128b2427f2e4e359d2abd2d9a140b4",
      "translationSHA256": "3d1f41c81cda41ae1a6fc5e7d7ef366c05034f43feadbbde1205472704cac3d1",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueAbigail",
      "key": "Good_5",
      "field": null,
      "source": "I was just admiring the mermaid's pendant you gave me... I'll proudly wear this to my grave.$l",
      "translation": "Zrovna jsem obdivovala Přívěsek mořské panny, který mám od tebe... Budu ho hrdě nosit až do hrobu.$l",
      "sourceSHA256": "58409cd5200cab0e7f57da7e09805fdc0de91403849448b6f39e73105801772e",
      "translationSHA256": "64e62b4dc0c42907f4ce568e59238534e36c121c8f089f8de3b9dcf1a10273c6",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueAbigail",
      "key": "Good_6",
      "field": null,
      "source": "Hey. I know you're smart, but I still worry about you sometimes. The world is full of monsters.$6#$e#Just promise me you'll be careful. I don't want to lose you.",
      "translation": "Ahoj. Vím, že ti to myslí, ale stejně si o tebe občas dělám starosti. Svět je plný příšer.$6#$e#Jen mi slib, že si budeš dávat pozor. Nechci tě ztratit.",
      "sourceSHA256": "0bbd23c82227698ed2ca879b616884e41f4f7bd2c2267dd9fe60d11676f7643a",
      "translationSHA256": "1d35b49dc50feb871af23b9ce4eef73b3ddeee1428d89b70fc0c498c082ac1cd",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueAbigail",
      "key": "Good_7",
      "field": null,
      "source": "@? I just want to say that I appreciate all the hard work you do for us. I'm really proud of you.$l",
      "translation": "@? Jen ti chci říct, že si vážím všeho, co pro nás děláš. Jsem na tebe opravdu hrdá.$l",
      "sourceSHA256": "0189eb39ccd1b0035c76ea1f925aae26adcdca97fcc4820943dff0123459605a",
      "translationSHA256": "7f729bfef8c928ca6255d3b88c6a4c245fc581c671d924175f93a47a359292e9",
      "reviewChecks": [
        "sourceMeaning",
