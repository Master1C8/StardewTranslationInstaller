    {
      "target": "Characters/Dialogue/MarriageDialogueAbigail",
      "key": "Outdoor_1",
      "field": null,
      "source": "Hmm... I think we've got plenty of space for outdoor slime ranching!",
      "translation": "Hmm... Myslím, že tu máme spoustu místa na venkovní chov slizů!",
      "sourceSHA256": "113634eb6512ec31043b19ccf879cba5cbd75a91c32fecd730c9f8989690e7e3",
      "translationSHA256": "6b1fb7d2512af73ea470cdf6ac7e60b8670d6bb7956190869962317582a5ff6a",
      "reviewChecks": [
        "sourceMeaning",
