    {
      "target": "Characters/Dialogue/MarriageDialogueAbigail",
      "key": "winter_Abigail",
      "field": null,
      "source": "Remember when we played 'Prairie King' together in my room, so long ago? Those were good times.$h",
      "translation": "Vzpomínáš, jak jsme spolu v mém pokoji hráli Putování krále prérie? To byly krásné časy.$h",
      "sourceSHA256": "90cc488bd137e73eba24a0a5d14e7ced700316919ec0391a4637ed1a8979a36e",
      "translationSHA256": "9ca2f67e5b5f41726685787002a6f7138b285ced1785ca609a812c1da8cb6473",
