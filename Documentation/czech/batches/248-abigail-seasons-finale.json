        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueAbigail",
      "key": "Neutral_9",
      "field": null,
      "source": "I wonder if we'll live here our entire lives? I might get bored.",
      "translation": "Zajímalo by mě, jestli tu budeme žít celý život. Možná bych se začala nudit.",
      "sourceSHA256": "ff2756192f66b92b34c77bba8208f92a68927c079c85db2bf2db13ee859ac421",
      "translationSHA256": "2d5d7ca5eaf1b7a61fdbaf530256b07462e233c411f5ecbccbfb9b49efc79e67",
      "reviewChecks": [
        "sourceMeaning",
