    {
      "target": "Characters/Dialogue/MarriageDialogueAbigail",
      "key": "spouseRoom_Abigail",
      "field": null,
      "source": "#$c .5#I got up a little before you and fed David Jr. He's very active this morning.#$e#I hope you don't mind the guinea pig smell.",
      "translation": "#$c .5#Vstala jsem o něco dřív než ty a nakrmila Davida juniora. Dnes ráno je velmi čilý.#$e#Doufám, že ti nevadí pach morčete.",
      "sourceSHA256": "3318bf78ae55b72648797d465d7188ba97f24658baea3c32608c317777814831",
      "translationSHA256": "71d2204fd3414073737c03d1a1f980f7cf324b09784b4799b28221c3d1e14049",
