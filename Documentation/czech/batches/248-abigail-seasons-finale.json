    {
      "target": "Characters/Dialogue/MarriageDialogueAbigail",
      "key": "Neutral_7",
      "field": null,
      "source": "If you moved on to the spirit world, I'd set up a little shrine for you next to Grandpa's.",
      "translation": "Kdyby tvá cesta vedla do světa duchů, postavila bych ti malou svatyni vedle Dědečkovy svatyně.",
      "sourceSHA256": "e8d5a40c07e846db6112611a208886f7ccfd8e5119cc0983c07d5e9bb1580f4b",
      "translationSHA256": "b291d93eefb1dddc08ba3e673fd51e796d0711d4ae2ed96b54be17836bcc4bbb",
      "reviewChecks": [
