    {
      "target": "Characters/Dialogue/MarriageDialogueAbigail",
      "key": "Neutral_8",
      "field": null,
      "source": "No matter how much we clean, the house keeps getting dirty again.#$e#I guess farms are kind of dirty.",
      "translation": "Ať uklízíme sebevíc, dům je hned zase špinavý.#$e#Farmy jsou asi zkrátka trochu špinavé.",
      "sourceSHA256": "3804ffb529d666d0a0b0edee9e6b5735a28535bcbab6c80928cec16ebd9f0571",
      "translationSHA256": "2044f242ea410d4fd22caf9e22a1866c62877aa4b770446650fc08a2ac3cda1e",
      "reviewChecks": [
        "sourceMeaning",
