        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueAbigail",
      "key": "summer_15",
      "field": null,
      "source": "It's summer... that means the house is full of flies.#$e#Don't worry, I'll take care of them. It's fun!$h",
      "translation": "Je léto... To znamená, že je dům plný much.#$e#Neboj, postarám se o ně. Je to zábava!$h",
      "sourceSHA256": "cd5b74f6638c9dcd0f01c17adbcc182b57d3284c1a83f872bc6dfc906cbd9190",
      "translationSHA256": "be8747acaab60c19710e4fd20aec696b168b8d65a3ed66e87b02eddfc3cc45a6",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
