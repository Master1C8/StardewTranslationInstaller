      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueAbigail",
      "key": "fall_Abigail",
      "field": null,
      "source": "Do I smell pumpkin on you? Maybe I'm just dreaming...$h",
      "translation": "Voníš po dýni? Možná se mi to jen zdá...$h",
      "sourceSHA256": "5df49bb0b7a88ce7191eb823eda0382079a0f92e1d67ad2ab6f1d8bf88056166",
      "translationSHA256": "5345a655296c73027674c2db358fef93ddd4278576988292249d688b4376161f",
