        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueAbigail",
      "key": "fall_6",
      "field": null,
      "source": "Ah... fall. This might be my favorite time of year. The colors really complement my hair, don't you think?",
      "translation": "Ach... podzim. Možná je to moje nejoblíbenější roční období. Ty barvy mi vážně ladí k vlasům, nemyslíš?",
      "sourceSHA256": "ed3c998409eaed1fda3b8b6436e68a221b9847adf579b3ee86473c448d152f1d",
      "translationSHA256": "be001c742dd857ce1bac177fa2dfd995397eae729ba72d9340dbd0331a064b7e",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueAbigail",
      "key": "fall_1",
      "field": null,
      "source": "The scent is unmistakable... mushroom, rotting leaves, pumpkin. It's fall, alright. Isn't it lovely?",
      "translation": "Ta vůně se nedá splést... houby, tlející listí a dýně. Ano, je tu podzim. Není nádherný?",
      "sourceSHA256": "298d96418670f4bf0b1dfbe6646a08fbb9594fcab10679b1b2e380526ac9d6ba",
      "translationSHA256": "c2a602134b6ac710f7681361b4475532ff399354e6ba094e1cb5e893082b00fe",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueAbigail",
      "key": "fall_2",
      "field": null,
      "source": "Can we grow giant pumpkins this season? Please, honey?$h",
      "translation": "Můžeme letos vypěstovat obří dýně? Prosím, zlato?$h",
      "sourceSHA256": "db067bda2dfd111b6eb8165dd9f975011cfc0491208db2197c7cc4cd81cec830",
      "translationSHA256": "6e897f1ef33ac12f2ec23b69c52404608d6a8ef1bf7149513fd90963bb7c9172",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueAbigail",
      "key": "fall_20",
      "field": null,
      "source": "Honey... you're worth more to me than a chest full of quartz.#$e#Now, a chest full of amethyst? Hmm... I'd have to think about that one.$h",
      "translation": "Zlato... Máš pro mě větší cenu než truhla plná křemene.#$e#Ale co truhla plná ametystů? Hmm... To bych si musela promyslet.$h",
      "sourceSHA256": "3c6851d1d944ad66d57dba8d485c42b3ba9139eb5d519e97a155cdb11b45c4a5",
      "translationSHA256": "25ade33b4483259fcfc43523a7a2dfc896956dab08c8da586d963e4936271fc7",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueAbigail",
      "key": "winter_3",
      "field": null,
      "source": "I actually like the cold weather. It just gives me an excuse to get cozy!$h",
      "translation": "Mně se chladné počasí vlastně líbí. Aspoň mám záminku se pěkně zachumlat!$h",
      "sourceSHA256": "18558b8706c06624b503a7c17bd3d415026052e137fa77039638a6f5ae0312f5",
      "translationSHA256": "ab749d8790f034fc0f38fb171b32c06521a00fad07e99756851d6c41e3584521",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueAbigail",
      "key": "winter_15",
      "field": null,
      "source": "It's fun to explore the valley in winter! Everything is so different under a blanket of snow. And so quiet...",
      "translation": "Prozkoumávat údolí v zimě je zábava! Pod sněhovou přikrývkou je všechno úplně jiné. A je tu takové ticho...",
      "sourceSHA256": "93a995f70662e2590fd6bed8ef62d8dbedb241503157b101171da42658ede74c",
      "translationSHA256": "8712e06804b68402f8b5f27e1933b0183eb99924a6c540ad63ac5a940dae98b5",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueAbigail",
      "key": "spring_Abigail",
      "field": null,
      "source": "I may like the colder seasons, but by the end I'm always glad to see spring arrive.",
      "translation": "Mám sice ráda chladnější roční období, ale na jejich konci se vždycky těším, až přijde jaro.",
      "sourceSHA256": "58994f0d38b51e1f79d552e247162fc741d29666708944184c676e07f72e0579",
      "translationSHA256": "ddb1810e2c7a87c89a9d4495835bac7e935944c367351fc57451050eda7ad9bb",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueAbigail",
      "key": "summer_Abigail",
      "field": null,
      "source": "Oh man... I could go for some chocolate cake.",
      "translation": "Ach jo... Dala bych si čokoládový dort.",
      "sourceSHA256": "1b93730feb4f85ccf8d444c2e2de36104df1682bd4d16af260917a96e02671ed",
      "translationSHA256": "e8237318307165f540cb770e5785a06d3b9b1bd059775fb2e2ee2ced015df617",
      "reviewChecks": [
