        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueAlex",
      "key": "patio_Alex",
      "field": null,
      "source": "Unghh... one... Unghhh... two... It feels great to lift weights outdoors!$6",
      "translation": "Uhh... raz... Uhhh... dva... Zvedat činky venku je skvělý pocit!$6",
      "sourceSHA256": "5be713a4fb92a4147e2f1927f648823b366b76adcb58da6115770dda91c2a3e1",
      "translationSHA256": "f51bf9a7699e18680a0e39c4c63c8fd4ee27d33c59cc7c4bec389b625586400a",
      "reviewChecks": [
