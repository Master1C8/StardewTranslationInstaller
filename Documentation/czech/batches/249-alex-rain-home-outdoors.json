    {
      "target": "Characters/Dialogue/MarriageDialogueAlex",
      "key": "Rainy_Day_0",
      "field": null,
      "source": "With all this space, I can really achieve a full body workout.",
      "translation": "Tady mám tolik prostoru, že si můžu pořádně procvičit celé tělo.",
      "sourceSHA256": "0160d81a2ed6563e1798af79ac0d02abb513637b8aafb6db9650f416850e8556",
      "translationSHA256": "c24e9cdd07ad7300782be3877017e5f9a6fb2c7f7aaaba8778ab9c6f73db45d3",
