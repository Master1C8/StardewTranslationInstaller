    {
      "target": "Characters/Dialogue/MarriageDialogueAlex",
      "key": "Rainy_Day_1",
      "field": null,
      "source": "I never had many friends in town... I sometimes wonder how I'd end up if you never moved here.$9",
      "translation": "Ve městě jsem nikdy neměl moc přátel... Někdy přemýšlím, jaký by byl můj život bez tvého příchodu.$9",
      "sourceSHA256": "3f21ae44c00b386f338fab258349799f634a68e8fb6274529a5719907d663b46",
      "translationSHA256": "2d3c72e2acdd6c344cbeadf95e97632810b513c0d7f3540ff60685bda48dbca5",
      "reviewChecks": [
        "sourceMeaning",
