      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueAlex",
      "key": "Rainy_Day_2",
      "field": null,
      "source": "Aw... I was gonna do some jogging outside. But I can't really do it in this weather.",
      "translation": "Ach jo... Chtěl jsem si jít ven zaběhat. V tomhle počasí to ale vážně nejde.",
      "sourceSHA256": "75000769852ff55c946e0861dca5e0a145b28e685550578db7a76c4586b12cd1",
      "translationSHA256": "767a3a1a11577a4340ddc264a346fb0d850919677ae570bc5bc4d5499a329529",
      "reviewChecks": [
