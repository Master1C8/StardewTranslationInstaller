    {
      "target": "Characters/Dialogue/MarriageDialogueAlex",
      "key": "Rainy_Day_4",
      "field": null,
      "source": "I think I might start reading books. I don't want to become stagnant now that I'm a married guy!",
      "translation": "Možná začnu číst knihy. Nechci zakrnět jen proto, že jsem teď ženatý!",
      "sourceSHA256": "ad8ac3b0e841595e81215c7d6ed9d6b34c040130532c980b60568ba99432553e",
      "translationSHA256": "fa88e1e1f841548035ff1d769d2f2ed3af0ec00950d3b4e369dc4706321b1dc3",
      "reviewChecks": [
        "sourceMeaning",
