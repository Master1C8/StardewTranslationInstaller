    {
      "target": "Characters/Dialogue/MarriageDialogueAlex",
      "key": "Rainy_Day_3",
      "field": null,
      "source": "*grumble*... I just woke up and I'm hungry for some protein.$9",
      "translation": "*zavrčení*... Zrovna jsem vstal a mám chuť na nějaké bílkoviny.$9",
      "sourceSHA256": "76640b2763e69178653d79903754fd40132ed565986cc1d0a41d9f43b118e2df",
      "translationSHA256": "508fe078430dc737ae8e647ea98da32e6809da10076477e277c06cac05b0d050",
      "reviewChecks": [
