    {
      "target": "Characters/Dialogue/MarriageDialogueAlex",
      "key": "TwoKids_2",
      "field": null,
      "source": "Maybe %kid2 will be the first professional gridball player from Pelican Town?$h",
      "translation": "Možná bude %kid2 první, kdo se z Pelikánova dostane k profesionálnímu gridballu?$h",
      "sourceSHA256": "04aefd520c7741993f2f9176dfb27ed23cbf5a161c7913e821a9e1448b6b401d",
      "translationSHA256": "a72f073bb476a1d7cf90b555df0aefb028faad69a707496ed57b78e9006f6c56",
      "reviewChecks": [
        "sourceMeaning",
