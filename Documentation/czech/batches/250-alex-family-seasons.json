    {
      "target": "Characters/Dialogue/MarriageDialogueAlex",
      "key": "TwoKids_3",
      "field": null,
      "source": "I finally have the family life that I missed out on as a kid... thank you.$l",
      "translation": "Konečně mám rodinný život, který mi jako dítěti chyběl... Děkuji ti.$l",
      "sourceSHA256": "d274538b95d4166c06d38fa3a4b81b3f59074ee29402c25e7de6a5a59b291cc2",
      "translationSHA256": "2401702a9732843265e1e6759c776c0e8949b5a1d38b4d88e021edf3b7ce29b1",
      "reviewChecks": [
