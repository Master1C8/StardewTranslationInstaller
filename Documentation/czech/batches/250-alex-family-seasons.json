    {
      "target": "Characters/Dialogue/MarriageDialogueAlex",
      "key": "OneKid_1",
      "field": null,
      "source": "Little %kid1 is going to grow up strong, just like Daddy.",
      "translation": "Až %kid1 vyroste, bude mít sílu po tatínkovi.",
      "sourceSHA256": "5f056cd82a4876fad7d58c58eaa09b3c95566eb21373074bd69a537f0f065b3d",
      "translationSHA256": "927babe12a85d07ad8e8f596d9b1f86d5888acc2be7279af31ae3afc9abb989d",
      "reviewChecks": [
