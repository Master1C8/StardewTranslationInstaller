    {
      "target": "Characters/Dialogue/MarriageDialogueAlex",
      "key": "Good_0",
      "field": null,
      "source": "@... I will always love you.$l",
      "translation": "@... Vždycky tě budu milovat.$l",
      "sourceSHA256": "9bd2b0cb2a3468d7920ee6cd62623956f57debd9eb6140d5bb64b56768dce6b6",
      "translationSHA256": "32cbf659e54a50e3a804df559446f83438a0618f9c51f4193e342d2dfb96387c",
