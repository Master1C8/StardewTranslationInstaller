    {
      "target": "Characters/Dialogue/MarriageDialogueAlex",
      "key": "Good_6",
      "field": null,
      "source": "I know you're strong, but sometimes I worry that you might get eaten by slimes... or worse. Just be careful.$9",
      "translation": "Vím, že máš sílu, ale někdy mám strach, že tě sežerou slizové příšery... nebo něco ještě horšího. Dávej na sebe pozor.$9",
      "sourceSHA256": "8a25cacc3541088c0f87facde6d3d2436e01ae0bb7bc3c8c8b47fc0a26a7d6b4",
      "translationSHA256": "c0d4e5cdbea21851883e4ad477b6f66950cb03f53700ce08cc9e0d5f89acfa21",
      "reviewChecks": [
        "sourceMeaning",
