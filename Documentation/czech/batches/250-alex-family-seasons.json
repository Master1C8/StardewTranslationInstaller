    {
      "target": "Characters/Dialogue/MarriageDialogueAlex",
      "key": "Good_1",
      "field": null,
      "source": "You're very handsome... have I told you that?$l^You're very beautiful... have I told you that?$l",
      "translation": "Jsi opravdu pohledný... Už jsem ti to říkal?$l^Jsi opravdu krásná... Už jsem ti to říkal?$l",
      "sourceSHA256": "8e4894bff46eb79167609eee34e945fe407920e2f1beabaa0566c5dbb75a6226",
      "translationSHA256": "89bf5526a048f90b21b926178433099411e52e1637369952a0d0efcbaf418fb5",
      "reviewChecks": [
        "sourceMeaning",
