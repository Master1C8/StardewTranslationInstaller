    {
      "target": "Characters/Dialogue/MarriageDialogueAlex",
      "key": "funLeave_Alex",
      "field": null,
      "source": "I'm going into town today. I'll see you tonight.",
      "translation": "Dnes jdu do města. Uvidíme se večer.",
      "sourceSHA256": "9c432a77822342f8f155ca24d80b5cea2cccd05511e071b908acde7fe7a47c2b",
      "translationSHA256": "d6e633f9c3dd9333d6557896d158cc8bbe9932fd412edc393bc9b8a4e249aff4",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
