    {
      "target": "Characters/Dialogue/MarriageDialogueAlex",
      "key": "winter_28",
      "field": null,
      "source": "It's been a great year, @. I'm looking forward to next year! Now, come closer... $l",
      "translation": "Byl to skvělý rok, @. Těším se na ten příští! Teď pojď blíž... $l",
      "sourceSHA256": "c6f2ecffd0db5153301fba0fc8c0260784afad0712317f5a2b687cb621771ceb",
      "translationSHA256": "55cbe5d8913e73e00b685fd1202b3dda0a92a795d0614b4015ef1a6ba850e692",
