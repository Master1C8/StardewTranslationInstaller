    {
      "target": "Characters/Dialogue/MarriageDialogueAlex",
      "key": "OneKid_0",
      "field": null,
      "source": "I'm still getting used to my new life as a stay-at-home dad.$h",
      "translation": "Pořád si zvykám na nový život táty v domácnosti.$h",
      "sourceSHA256": "fd7c0b997b9572d2501081f96832d96fba42dd4e42b0145242b4b01b851546dd",
      "translationSHA256": "a0a8f3f324458633029005b9be7d67b387987deb0fb64d12b307e637b7339d39",
