        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueAlex",
      "key": "funReturn_Alex",
      "field": null,
      "source": "I had a good day. I like to see my grandparents often, they're getting pretty old.",
      "translation": "Měl jsem hezký den. Rád prarodiče často navštěvuji, už jsou docela staří.",
      "sourceSHA256": "a6310f4c91483eefa86772e0855c8a228bf09fac70825dc448e1149c2aa19395",
      "translationSHA256": "e1c0aabb3af3a10a848cc64dda83c39347013c53234499d08d0e3157e5f7c1cf",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueAlex",
      "key": "spring_1",
      "field": null,
      "source": "Finally, the snow has melted and the sun is back! My body feels great.$h",
      "translation": "Konečně roztál sníh a vrátilo se slunce! Cítím se ve skvělé formě.$h",
      "sourceSHA256": "0d61013aee4ae845adebc6cb03a24d1d953f17db2ddc69d16eb19eab9d6877fe",
      "translationSHA256": "bd0765faf32a8f50743445f057aae32e08fcd5ef79392590bc404459b852d3d0",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueAlex",
      "key": "spring_6",
      "field": null,
      "source": "I wonder if a powder of stardrop would help me bulk up...",
      "translation": "Zajímalo by mě, jestli by mi prášek z Hvězdné kapky pomohl nabrat svaly...",
      "sourceSHA256": "9b4c9eeaf7dd2ea338efd05a2226c0f00ed54194832e717b175e0e3f0b59f3d7",
      "translationSHA256": "c557ee2064dbddeee507e0e7dac82976a1dc4c07796e1e602900958cf35affef",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueAlex",
      "key": "spring_12",
      "field": null,
      "source": "Are you excited for tomorrow's festival? I guess it'll be good to load up on the free eggs.",
      "translation": "Těšíš se na zítřejší Slavnost vajec? Aspoň se asi pořádně nacpu vejci zdarma.",
      "sourceSHA256": "627c71cf2439025fefb26ed4ac0dee466e778e7eb49ffcd3404a3df6f9a81b1a",
      "translationSHA256": "43ffee4e4ac5534915429e2b274adcf466dd8001132debe04db59fbca59a14b4",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueAlex",
      "key": "spring_23",
      "field": null,
      "source": "Oh... tomorrow's the flower dance, isn't it? I better do some extra push-ups tonight.$9#$e#Those jumpsuits are pretty tight... and everyone's going to be watching closely.",
      "translation": "Ach... Zítra je Květinový tanec, že? Dnes večer raději udělám pár kliků navíc.$9#$e#Ty overaly jsou dost těsné... a všichni se budou pozorně dívat.",
      "sourceSHA256": "b02e6cb35f66285eccb5d9c82292df4542f37d8131b426c11cfa3bf9e5294b1b",
      "translationSHA256": "4f45f1c4dca8b1d2b7b15ab3bb48691843f533dbff42f6703ea234622cc1e38d",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueAlex",
      "key": "summer_1",
      "field": null,
      "source": "Summer's a very energetic time of year, and body feels it too! I feel solid.",
      "translation": "Léto je velmi energické roční období a moje tělo to také cítí! Jsem jako skála.",
      "sourceSHA256": "5bcc4e0caaf1571342b65f5d256d8b05f0373cef58e1b20bf18d3aed44c649fe",
      "translationSHA256": "423f41db2d7ecb98feddeb7b01e9bb8d7160d7941fce288e5a38369d4e1f03f7",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueAlex",
      "key": "summer_10",
      "field": null,
      "source": "Have you thought about what you're going to put in the luau soup?#$e#I have no idea what's good... you're the chef!$h",
      "translation": "Už víš, co dáš do polévky na Luau?#$e#Já vůbec netuším, co je dobré... Vaření je tvoje parketa!$h",
      "sourceSHA256": "c50cd0fd4e6cabeca155dd847c28895b768dccd97bb21eb7b6000b1ed62794bb",
      "translationSHA256": "b42af082dafe86734c97227032c82d91a73adb2c8fa167645afaff620f622b49",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
