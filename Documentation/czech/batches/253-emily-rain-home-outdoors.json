    {
      "target": "Characters/Dialogue/MarriageDialogueEmily",
      "key": "Rainy_Day_1",
      "field": null,
      "source": "A day like this is a blessing from mother nature.",
      "translation": "Takový den je požehnáním od matky přírody.",
