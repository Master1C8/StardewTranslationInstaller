    {
      "target": "Characters/Dialogue/MarriageDialogueEmily",
      "key": "Rainy_Night_2",
      "field": null,
      "source": "How was your day, @? You look a little soggy.",
      "translation": "Jaký byl tvůj den, @? Vypadáš, jako by tě déšť pěkně promočil.",
