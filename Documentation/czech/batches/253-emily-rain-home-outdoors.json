    {
      "target": "Characters/Dialogue/MarriageDialogueEmily",
      "key": "patio_Emily",
      "field": null,
      "source": "This is my favorite spot for a morning meditation.#$e#I visualize the energy from this crystal garden flowing through my body.",
      "translation": "Tohle je mé oblíbené místo pro ranní meditaci.#$e#Představuji si, jak mým tělem proudí energie z této křišťálové zahrady.",
      "sourceSHA256": "541ad85f97235628c1be2f2fac762c0eeb568cd10d00c9983003544bcdd89cf2",
      "translationSHA256": "8cbdcab21204ec7785faf091f0c1fee6e4138066f6747fefdb6a5ca21502b9b5",
      "reviewChecks": [
        "sourceMeaning",
