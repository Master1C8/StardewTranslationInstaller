    {
      "target": "Characters/Dialogue/MarriageDialogueEmily",
      "key": "Rainy_Night_1",
      "field": null,
      "source": "I can hear the plants talking to each other... they're so happy after today's rain!",
      "translation": "Slyším, jak spolu rostliny mluví... Po dnešním dešti jsou tak šťastné!",
      "sourceSHA256": "e2c20fa13460cbce230996ed050360f5127ab7472f28afd9a13e539b28d1e42f",
      "translationSHA256": "32c42f4fb111fa93b31ef08c9e8c6c9ff75800f194ecb2e4d2844015126a3f3a",
      "reviewChecks": [
