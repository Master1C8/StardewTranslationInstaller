    {
      "target": "Characters/Dialogue/MarriageDialogueEmily",
      "key": "Rainy_Day_2",
      "field": null,
      "source": "Good morning... I got this gift for you. Don't worry, I already purified it with sage incense. [428 440 444 338 207]",
      "translation": "Dobré ráno... Mám pro tebe tenhle dárek. Neboj, už jsem ho očistila šalvějovým kadidlem. [428 440 444 338 207]",
      "sourceSHA256": "9366129b24549980b51525d8669b5a9cfd1c9c1845c74f605415927c0424c04b",
      "translationSHA256": "2fc367561b6d9eb57c4c65ac3f9dad2f980d3e656638330f49eda08b57250c25",
