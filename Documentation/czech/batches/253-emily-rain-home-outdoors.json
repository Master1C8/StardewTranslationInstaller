    {
      "target": "Characters/Dialogue/MarriageDialogueEmily",
      "key": "Rainy_Night_0",
      "field": null,
      "source": "Every moment has a unique and precious beauty... do you notice? It can be easy to forget, sometimes.",
      "translation": "Každý okamžik má jedinečnou a vzácnou krásu... Všímáš si jí? Někdy se na to snadno zapomíná.",
      "sourceSHA256": "444d80a35aae5277866c3eef1a1f654168188e20faec7661b386279b0b1e9ee4",
      "translationSHA256": "439a99cc8aa9ff898a4634776abc449b64bb1f73238ae19aa63fc401a7fbebe9",
      "reviewChecks": [
        "sourceMeaning",
