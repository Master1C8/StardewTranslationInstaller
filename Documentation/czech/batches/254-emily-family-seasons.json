    {
      "target": "Characters/Dialogue/MarriageDialogueEmily",
      "key": "spring_1",
      "field": null,
      "source": "Happy new year, honey. Let's make this a special one.$4",
      "translation": "Šťastný nový rok, zlato. Udělejme z něj něco výjimečného.$4",
      "sourceSHA256": "bf5da49d241fc7ffae6df8d840dd4f6569b6d34c1b921531402856862768f97c",
      "translationSHA256": "f7f9c6f7c42266a9cc90c13251b8075c785d901890325ce6dd78fc5285efe394",
      "reviewChecks": [
        "sourceMeaning",
