        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueEmily",
      "key": "summer_2",
      "field": null,
      "source": "May Yoba bless you on this lovely day.$7",
      "translation": "Kéž ti Yoba v tento nádherný den požehná.$7",
      "sourceSHA256": "66741d5e1cf345c070d312fbc881dd8119987f1f36187e78bbbbd458d7783a01",
      "translationSHA256": "5edf39411281f70b51a443dbdaf0d4850d62a71af43368649d1b00ac1d594978",
