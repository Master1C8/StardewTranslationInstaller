    {
      "target": "Characters/Dialogue/MarriageDialogueEmily",
      "key": "fall_1",
      "field": null,
      "source": "The year's already half-way over. Can you believe it?",
      "translation": "Už máme polovinu roku za sebou. Věříš tomu?",
      "sourceSHA256": "22c606cce83ca62e771361fbaaaccb4f6902e26ab63a4b5a63dd44d7d6e01bd5",
      "translationSHA256": "64ba5f4ea6578696cda54507a0f26360a2f4a34f8b3146b3606ffde23fc722fc",
      "reviewChecks": [
        "sourceMeaning",
