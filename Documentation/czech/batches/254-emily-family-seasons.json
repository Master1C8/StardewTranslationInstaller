    {
      "target": "Characters/Dialogue/MarriageDialogueEmily",
      "key": "winter_2",
      "field": null,
      "source": "I can't help but think of all the poor, frozen squirrels out there right now.$s",
      "translation": "Pořád myslím na všechny ty ubohé promrzlé veverky, které jsou teď venku.$s",
      "sourceSHA256": "9c817de26b99b68d2e3d7ea39c317baca32d9cd2de23b6603a669bed518545e5",
      "translationSHA256": "548d98f68c03883fe2ec036ec7fa4fc688960a167c98a3113b2158b82c598130",
