    {
      "target": "Characters/Dialogue/MarriageDialogueEmily",
      "key": "summer_20",
      "field": null,
      "source": "The energy in our bodies fluctuate just as the seasons do. Understanding your own unique rhythm is the first step to inner harmony.",
      "translation": "Energie v našich tělech se proměňuje stejně jako roční období. Pochopit svůj vlastní jedinečný rytmus je prvním krokem k vnitřní harmonii.",
      "sourceSHA256": "dcef22cd0f21627831f9c22c7a4839ddf46a4611fb209eaa2d869705ae4cf762",
      "translationSHA256": "8fcd3ba1e7cbaae0e35cddc98183b73592bc4ca3c90d4a592daeec5ff25157f2",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
