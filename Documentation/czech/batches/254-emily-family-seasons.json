    {
      "target": "Characters/Dialogue/MarriageDialogueEmily",
      "key": "funLeave_Emily",
      "field": null,
      "source": "I'm going to visit town today, and later on I'm going to help out at the saloon. Have a nice day.",
      "translation": "Dnes se půjdu podívat do města a později vypomůžu v Saloonu U Hvězdné kapky. Měj se hezky.",
      "sourceSHA256": "86d5107dba532792c00a53df38d54d59aeb4a3721c12d824121d760ebfd44ec8",
      "translationSHA256": "9a2ee8a62c16f975c722f1df1854cc8e3b4b71953a58004a1be07b152d7ac3f7",
      "reviewChecks": [
        "sourceMeaning",
