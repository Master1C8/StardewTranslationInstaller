    {
      "target": "Characters/Dialogue/MarriageDialogueEmily",
      "key": "TwoKids_1",
      "field": null,
      "source": "A big house, two kids and a parrot... I have my hands full!",
      "translation": "Velký dům, dvě děti a papoušek... Mám plné ruce práce!",
      "sourceSHA256": "5e5539f14c61d031a173e1af201ef373b27680564c1962f59bd498a6004e2665",
      "translationSHA256": "69bcfe2f869d73e06929a4e6a867f1f07a2dd3591925ebfe67b2c4b290d2ce8e",
