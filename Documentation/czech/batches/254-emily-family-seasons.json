    {
      "target": "Characters/Dialogue/MarriageDialogueEmily",
      "key": "spring_22",
      "field": null,
      "source": "Hmm... I'm thinking maybe a salad of fresh foraged greens for dinner tonight?",
      "translation": "Hmm... Co kdybych dnes k večeři připravila salát z čerstvě nasbíraných bylinek?",
      "sourceSHA256": "d3e118719d25d1daef49ce155aae10892e3570abcd98d738aab00519265cd2a9",
      "translationSHA256": "4263ab4d5e136ccac67aad201aaa4cf3a0536c71ef9c85aeacf579097222b4d9",
      "reviewChecks": [
        "sourceMeaning",
