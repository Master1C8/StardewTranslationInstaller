    {
      "target": "Characters/Dialogue/MarriageDialogueEmily",
      "key": "TwoKids_3",
      "field": null,
      "source": "Oh, I already fed the kids their organic quinoa puffs with goat milk. You just focus on the farm!",
      "translation": "Děti už jsem nakrmila bio quinoovými křupkami s kozím mlékem. Ty se soustřeď na farmu!",
      "sourceSHA256": "bb6ff20d0cac182cb2cd52b8128ba1caf776e402a20f6cc1719a5ea65588d10a",
      "translationSHA256": "bf8e842907ae294e85dbbc16e437cda4bcc039b3d3af36e935101ee3babb2333",
      "reviewChecks": [
