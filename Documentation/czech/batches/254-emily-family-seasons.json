    {
      "target": "Characters/Dialogue/MarriageDialogueEmily",
      "key": "TwoKids_2",
      "field": null,
      "source": "Well, %kid2 certainly has your hair...$u",
      "translation": "Tedy, %kid2 má rozhodně vlasy po tobě...$u",
      "sourceSHA256": "1895912119e50acd868dcdf9ecab2d9c652be8bcb62550065d2e5c58c7f85d0e",
