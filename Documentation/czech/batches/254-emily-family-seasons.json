    {
      "target": "Characters/Dialogue/MarriageDialogueEmily",
      "key": "summer_Emily",
      "field": null,
      "source": "Phew! It's hot but it feels great, doesn't it?#$e#Maybe we'll see some wild parrots today.",
      "translation": "Uf! Je horko, ale je to nádhera, nemyslíš?#$e#Možná dnes uvidíme nějaké divoké papoušky.",
