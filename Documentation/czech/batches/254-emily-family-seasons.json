    {
      "target": "Characters/Dialogue/MarriageDialogueEmily",
      "key": "winter_5",
      "field": null,
      "source": "*sigh*... Why does there have to be war and hatred in the world?$s",
      "translation": "*povzdech*... Proč musí na světě existovat válka a nenávist?$s",
      "sourceSHA256": "408c2dbd40313704a0cb65bd980d9016ceca2777c085efdabe79ef35b8664707",
      "translationSHA256": "5156a666dcc0503da3906d822cd40cbb99f0e3440a00d0fccf662cfe5e855b92",
      "reviewChecks": [
