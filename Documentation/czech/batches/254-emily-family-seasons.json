    {
      "target": "Characters/Dialogue/MarriageDialogueEmily",
      "key": "fall_Emily",
      "field": null,
      "source": "I drank a super-food smoothie this morning and I feel aaah-mazing!$h",
      "translation": "Dnes ráno jsem vypila koktejl ze superpotravin a cítím se úúú-žasně!$h",
      "sourceSHA256": "62e912ba6f3c355a99459ddbb292daaf7a97a7ebfd0e796d48077e75c3c44c27",
      "translationSHA256": "e7495610246c99df2f21db8340db672fd2228974d0fa6ee3d1b9b0b3e891a92a",
