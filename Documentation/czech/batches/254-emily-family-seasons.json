    {
      "target": "Characters/Dialogue/MarriageDialogueEmily",
      "key": "spring_2",
      "field": null,
      "source": "My friends, the plants, have come back to life. I feel content.",
      "translation": "Moje rostlinné přítelkyně znovu ožily. Cítím se spokojená.",
      "sourceSHA256": "1b6bf98ba2f0accbdf158e508f4efc3c133fdf6bbfd0e9fb36431ad9c5e4ddff",
      "translationSHA256": "816a4da225a03b1fb7b1bbe70fed828145037c0ac6b0a3a0c016021ac3ba11b5",
      "reviewChecks": [
