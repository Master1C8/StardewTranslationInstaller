    {
      "target": "Characters/Dialogue/MarriageDialogueEmily",
      "key": "funReturn_Emily",
      "field": null,
      "source": "My day went well... it's good to get out of the house now and then.",
      "translation": "Měla jsem hezký den... Čas od času je dobré vyjít z domu.",
      "sourceSHA256": "990ae4252872e85c0551e1e95e59959786389f1bca01d512e8bc03eabf813bf8",
      "translationSHA256": "6b8e9cf2e280bfd3215a4675f5c930adfaea24fc58f347ee831fbaf4089fe550",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
