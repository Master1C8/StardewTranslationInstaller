        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueHaley",
      "key": "fall_2",
      "field": null,
      "source": "I already miss summer...",
      "translation": "Už mi chybí léto...",
      "sourceSHA256": "66961da677b5759f4dba53a14bb0f008edc5cee734111339d411f80672648fc5",
      "translationSHA256": "819cef57de8c2945ab0935ce54c55b8e579c4eff5773d3f9c7e8928813ede17a",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
