      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueHaley",
      "key": "funLeave_Haley",
      "field": null,
      "source": "I'm going to socialize in town for a bit today.",
      "translation": "Dnes si půjdu na chvíli popovídat s lidmi ve městě.",
      "sourceSHA256": "f6a44e8d517431e449d680dd63c63f2266677fa1282b9c3c4de9b6a5f528ab79",
      "translationSHA256": "b32862e0c6ccae8c8971823a9a02a53f3cce4ecf763a81d0b8fafaf89c3d815e",
      "reviewChecks": [
        "sourceMeaning",
