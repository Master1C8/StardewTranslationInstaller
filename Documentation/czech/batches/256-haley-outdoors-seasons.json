    {
      "target": "Characters/Dialogue/MarriageDialogueHaley",
      "key": "spring_1",
      "field": null,
      "source": "Now that winter's over, we've got lots of sunny weather to look forward to. I'm excited.",
      "translation": "Teď, když zima skončila, se můžeme těšit na spoustu slunečných dnů. Už se nemůžu dočkat.",
      "sourceSHA256": "647c24f5455cb66b3f2c4e793397263de93fe27f3290ca0bacce3519036ff4df",
      "translationSHA256": "7e1b0f903a8de6d2f5fbd3c5c8395ce30b170474652cf4309538df4427a51369",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueHaley",
      "key": "summer_3",
      "field": null,
      "source": "Sorry if I don't look my best... the air is just so humid that my hair doesn't hold up too well.",
      "translation": "Promiň, jestli nevypadám nejlépe... Vzduch je tak vlhký, že mi účes vůbec nedrží.",
      "sourceSHA256": "2688064da70b0736afaa79aa2102fda6df35635a3611585386d2adba2a20dbbc",
      "translationSHA256": "f4cedcfcbfdf871f2604ed8d3b31a826ca185e05cdb0960ec7beb45c2e7e440d",
      "reviewChecks": [
        "sourceMeaning",
