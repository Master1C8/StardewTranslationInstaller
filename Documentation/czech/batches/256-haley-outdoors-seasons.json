    {
      "target": "Characters/Dialogue/MarriageDialogueHaley",
      "key": "OneKid_3",
      "field": null,
      "source": "Isn't it strange? I'm not used to being a mother.",
      "translation": "Je to zvláštní, že? Na roli matky si pořád zvykám.",
      "sourceSHA256": "61809db3e7d996900950a19e53817638b2a65e104ecceccdd3693a9fe1c1a4f6",
      "translationSHA256": "0ffb2a99e3cafdd27700025d198f18b29af814f33a7e87719739a95d541a9d59",
      "reviewChecks": [
