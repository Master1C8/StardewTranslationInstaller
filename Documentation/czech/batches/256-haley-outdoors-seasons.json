  "glossarySHA256": "cb0b94baf37d83f13a5401acdc21e0c6ef37e2bfd7c91616b1db7ae966dc2161",
  "reviewNote": "Полностью проверены все 22 строки пакета Хейли по английскому оригиналу; spring_2 уточнён как «letos na jaře», смысл, голос, плейсхолдеры и маркеры сохранены.",
  "rows": [
    {
      "target": "Characters/Dialogue/MarriageDialogueHaley",
      "key": "Outdoor_1",
      "field": null,
      "source": "We've got to make sure the farm is cute! That might be important... right, honey?",
      "translation": "Musíme zajistit, aby naše farma byla roztomilá! To může být důležité... že, zlato?",
      "sourceSHA256": "626ff4b2796ce779d6c3df84d80222f0e32e6064957085df144247a21c68c64d",
      "translationSHA256": "c96027c458fbecfa04c832890c879f78c66f7246d1edfa45feffac2c4c0f0534",
      "reviewChecks": [
