    {
      "target": "Characters/Dialogue/MarriageDialogueHaley",
      "key": "funReturn_Haley",
      "field": null,
      "source": "It was nice seeing everyone in town. Did you have a good day, dear?",
      "translation": "Bylo příjemné vidět všechny ve městě. Jaký byl tvůj den, drahoušku?",
      "sourceSHA256": "40a6ca78efe4a2d82846c08015dd76f6726d160ea01b47b23807186db1dc340e",
      "translationSHA256": "337fb5c217c16cd6bb9e86ac50eb6b1b1aefcf6c4ae7fce7cf350a2180072167",
      "reviewChecks": [
