    {
      "target": "Characters/Dialogue/MarriageDialogueHaley",
      "key": "TwoKids_3",
      "field": null,
      "source": "A big house, two kids, and a beautiful plot of land. I'm not sure what else I could ask for.",
      "translation": "Velký dům, dvě děti a nádherný pozemek. Nevím, co dalšího bych si ještě mohla přát.",
      "sourceSHA256": "a98fce7dbca64e6627f50c3bebdf9c6c6d414f0bc6e9c2d7da5483da18829361",
      "translationSHA256": "ff2a5722e055013c771a35b252b1858a942962a3845fcb8e39403954fdec534e",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueHaley",
      "key": "spring_2",
      "field": null,
      "source": "So, what are we planting this season?",
      "translation": "Tak co budeme letos na jaře sázet?",
      "sourceSHA256": "973114b4cfda9a99d03b75367c297b7d4a610610212e640d5c75874d20dee56f",
      "translationSHA256": "fe898a7978260517df9117c51ea9254023c9417abbbe543986bac25a50e7bdd3",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
