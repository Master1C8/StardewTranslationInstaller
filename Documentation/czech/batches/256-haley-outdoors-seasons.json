    {
      "target": "Characters/Dialogue/MarriageDialogueHaley",
      "key": "TwoKids_2",
      "field": null,
      "source": "Isn't %kid2 a very good-looking baby?",
      "translation": "Není %kid2 nádherné dítě?",
      "sourceSHA256": "bb62de691edb04580b9bed1bfafa9819d759279259695b975ff7b4d95bb4da79",
      "translationSHA256": "6fd467a791146da349a00f060ff51d04868302c47180a5970d90ce3224b3659f",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
