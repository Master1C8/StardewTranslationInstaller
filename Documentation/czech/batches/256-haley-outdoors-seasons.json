    {
      "target": "Characters/Dialogue/MarriageDialogueHaley",
      "key": "summer_15",
      "field": null,
      "source": "It's summer... that means the house is full of flies and ants... yuck.$s",
      "translation": "Je léto... To znamená, že je dům plný much a mravenců... fuj.$s",
      "sourceSHA256": "4e164b3a9813e67f0f23eafc34e2bda416567da9a7c83e41a6c83de3bbe83594",
      "translationSHA256": "095cfde40106659789cfb1fad42d04ffaf078ea4f5d8cea4fc17da8ca74814b2",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
