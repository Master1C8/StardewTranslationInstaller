  "glossarySHA256": "cb0b94baf37d83f13a5401acdc21e0c6ef37e2bfd7c91616b1db7ae966dc2161",
  "reviewNote": "Celý balíček byl dříve plně porovnán; po cílené změně znovu ověřeny všechny dotčené řádky s nepřímou otázkou, jejich význam, interpunkce a řídicí tokeny.",
  "rows": [
    {
      "target": "Characters/Dialogue/MarriageDialogueKrobus",
      "key": "Rainy_Day_0",
      "field": null,
      "source": "Do you like rainy days as much as I do, @?",
      "translation": "Líbí se ti deštivé dny stejně jako mně, @?",
      "sourceSHA256": "5ec91ef556c45bee1bf4cb21ab18f164430323549bb757c15bff2a70569e7ef4",
      "translationSHA256": "f43c4dccd2f395888b4324ee7a353a2a46481be3b5201809327228d246a42ae1",
      "reviewChecks": [
        "sourceMeaning",
