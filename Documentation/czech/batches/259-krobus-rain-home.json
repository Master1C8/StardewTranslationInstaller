      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueKrobus",
      "key": "Rainy_Day_1",
      "field": null,
      "source": "We're different in so many ways... but that's alright.",
      "translation": "V tolika ohledech jsme odlišní... ale to nevadí.",
      "sourceSHA256": "efa884be849cd3e0cf61a743ac93c14c521e1e1aec1cabffb9d03c04516b3859",
      "translationSHA256": "63a5f98ac7a723a0e5538063f9f816a36a03265d6c324372cd3d408499157c5b",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueKrobus",
      "key": "Rainy_Day_2",
      "field": null,
      "source": "Good morning, @. I went out early and found this for you. [305 308 203 795 397]#$e#I hope it's not too strange.",
      "translation": "Dobré ráno, @. Brzy jsem vyšel ven a našel pro tebe tohle. [305 308 203 795 397]#$e#Doufám, že to není příliš zvláštní.",
      "sourceSHA256": "0b8899f78abff1e60fa2df4af8ea6f016ca82e2aaa2f8ad2f2ca0c2e7e5a98d6",
      "translationSHA256": "07a79c4997b1e029b3d212bf4b6dd6113bf5b0eddef971ba7fa63090bc8eea31",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueKrobus",
      "key": "Rainy_Day_3",
      "field": null,
      "source": "I wonder if the wizard knows about... this? I hope he can keep a secret.$s",
      "translation": "Zajímalo by mě, jestli Čaroděj ví o... tomhle. Doufám, že dokáže udržet tajemství.$s",
      "sourceSHA256": "8fe269c8e1b8ec794b207073c3cd0959f3105676803307244a770d57a58d691a",
      "translationSHA256": "cdd28a29b0eb9ae6f8f19309187017567a1122cf552c21256424665f284cf7e7",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueKrobus",
      "key": "Rainy_Day_4",
      "field": null,
      "source": "As much as I try to be civilized, I have the urge to be mischievous sometimes...$6#$e#They say it's a condition of my people.",
      "translation": "Přestože se snažím chovat civilizovaně, občas mě přepadne nutkání něco vyvést...$6#$e#Prý je to vlastnost mého lidu.",
      "sourceSHA256": "575c9ad50d607a7fd4004a252a15f950098127227108f2e333b321c8c424d9bc",
      "translationSHA256": "872c123ec098de42aba63671e33ce332a4644c7cb9f234ed266205fc5a074a7f",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueKrobus",
      "key": "Rainy_Day_Krobus",
      "field": null,
      "source": "Ah, it's more humid today with the rain... I feel a lot more comfortable.",
      "translation": "Á, díky dešti je dnes vlhčeji... Je mi mnohem lépe.",
      "sourceSHA256": "cca13f4444008feb1fc0ac6c072a76dd54a450803f44ca45adcf93b57e9b2ec4",
      "translationSHA256": "7cbeaca8bc8b91356dcfa958569dd76d1ee01d899a63d46aa55732316a2b1ac2",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueKrobus",
      "key": "Rainy_Night_0",
      "field": null,
      "source": "On nights like this, those who gaze out windows sometimes see shadowy figures. To think... it might've been me.$7",
      "translation": "Za takových nocí občas lidé při pohledu z okna spatří stínové postavy. A pomyslet... možná jsem to byl já.$7",
      "sourceSHA256": "402246374b2608306cb37fcc98ccd6546b456ba3d683ac99837eaa4157f959e2",
      "translationSHA256": "3bc8688a6ef16cb671fb95126661ddcf9cde8d9b02dab2678147d18708e5cc09",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueKrobus",
      "key": "Rainy_Night_1",
      "field": null,
      "source": "If the other shadow people knew about our living arrangement, they would... 'punish' me.$s#$e#Most of them despise humans, you know.",
      "translation": "Kdyby se ostatní Stínoví lidé dozvěděli, jak spolu žijeme, tak by mě... ‚potrestali‘.$s#$e#Většina z nich lidmi pohrdá, víš.",
      "sourceSHA256": "2156dbdf6e463274fe5cb806b52dda10f435fe0c729cde4ae3d0f1cbe1d4c2b8",
      "translationSHA256": "e5297bb1cd2946351ff81251f031cfb695cab30dda98bc2c60210a30287d7c99",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueKrobus",
      "key": "Rainy_Night_2",
      "field": null,
      "source": "You're sopping wet, and cold! Isn't that dangerous to your species?$s",
      "translation": "Voda z tebe jen kape a je ti zima! Není to pro tvůj druh nebezpečné?$s",
      "sourceSHA256": "8330395e58f18450edfc3724e940e4da1b3a294cae0502458cf7bf99dda14733",
      "translationSHA256": "29e9feecb8692a2d4f851c9548d110c05c2b5fb0ad4cfab8701ca45bc803a4c1",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueKrobus",
      "key": "Rainy_Night_3",
      "field": null,
      "source": "I already had dinner, but it wasn't something you'd be able to eat... sorry.",
      "translation": "Večeři už jsem měl, ale nebylo to nic, co by pro tebe bylo jedlé... promiň.",
      "sourceSHA256": "0ea2d8c87fd2c12cfa0bd14ff4920e6c171a043ee9b9ad5c2f261e92c18d2cd5",
      "translationSHA256": "8eb0d768818469d945df18379a885cc80bb65a6f528c3952042c296e50ba0474",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueKrobus",
      "key": "Rainy_Night_4",
      "field": null,
      "source": "Ever since I left my people, I've been searching for a new home... now I belong somewhere. That means everything to me.",
      "translation": "Od chvíle, co jsem opustil svůj lid, hledám nový domov... teď někam patřím. Znamená to pro mě všechno.",
      "sourceSHA256": "029e4a1e0955796706bebadacf6f9be6bde2badfccc96b704b094c890e3222ac",
      "translationSHA256": "1ba3bf1e386f2899c2c1d0debd030f0df27c3d249f840e1b554901f85a80f309",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueKrobus",
      "key": "Rainy_Night_5",
      "field": null,
      "source": "It's said that my people came here long ago, when a great catastrophe allowed spirits from the void to cross into the physical plane.",
      "translation": "Říká se, že sem můj lid přišel už dávno, když velká katastrofa umožnila duchům z prázdnoty přejít do hmotného světa.",
      "sourceSHA256": "2c21b033be713dc21183a6d79051a5ce80bc600cdcc2ed34c8e83b16f1006677",
      "translationSHA256": "ef24151e16859e6e42936a7d9236993931c3646cdd2f4b74515f9cb2b0c90b02",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueKrobus",
      "key": "Rainy_Night_Krobus",
      "field": null,
      "source": "The sound of the rain reminds me of the sewers... it's comforting.#$e#The sewers were my refuge... I felt safe there. But don't worry... I feel the same way about my new home, too.",
      "translation": "Zvuk deště mi připomíná Kanalizaci... je uklidňující.#$e#Kanalizace byla mým útočištěm... Cítil jsem se tam v bezpečí. Ale neboj... ve svém novém domově se také cítím v bezpečí.",
      "sourceSHA256": "5a941ac4925bc307ae8b1f91bf0684ea7e6b9d1776c93b5476787775e0cfc108",
      "translationSHA256": "acc631cfac5f79c8cc502338247a8bacc66c16076ac7def803029b570444016b",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueKrobus",
      "key": "Indoor_Day_0",
      "field": null,
      "source": "If I could come help you, I would... but I'll do my best to keep the house in order.",
      "translation": "Kdybych ti mohl přijít pomoct, udělal bych to... ale udělám, co budu moci, abych udržel dům v pořádku.",
      "sourceSHA256": "8be1360f5c7af382d37620a28c297d57f07c97558365f1e5ae36d712b65eaf86",
      "translationSHA256": "f411093d69ad99808f35db5a94ca6ef21d5a5bc12ebee18e635ffafb35eae27c",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueKrobus",
      "key": "Indoor_Day_1",
      "field": null,
      "source": "I tried my best to make human food... [203 204 651 225]#$e#You can eat it later, don't worry about it...",
      "translation": "Snažil jsem se ze všech sil připravit lidské jídlo... [203 204 651 225]#$e#Můžeš ho sníst později, nemusíš si s tím dělat starosti...",
      "sourceSHA256": "adab7c9669cddd109b0b412d880a05d152e0229d6adc78ab7f8c2a92b79237f4",
      "translationSHA256": "fc683e9a0b8d3434022013734768cccf14840aae6bd9c5506c359b8539557379",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueKrobus",
      "key": "Indoor_Day_2",
      "field": null,
      "source": "I'm happy here, in the house. I like to spend all my time in a good spot... I don't need to \"get out\" like humans do.#$e#But I understand that you need to! Please don't feel like you have to stay here with me.$3",
      "translation": "Jsem tu v domě šťastný. Rád trávím všechen čas na jednom příjemném místě... nepotřebuji ‚chodit ven‘ jako lidé.#$e#Ale chápu, že ty ano! Prosím, neměj pocit, že tu se mnou musíš zůstávat.$3",
      "sourceSHA256": "83dc79b760ffa5700a9dc8fac946f4e06ec7acee20479ae56b52554223453086",
      "translationSHA256": "e516bb2c8223441fd2fb889713bb3eb8db25b5f23c3c72886062ed5f9c891d5b",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueKrobus",
      "key": "Indoor_Day_3",
      "field": null,
      "source": "I'm considering spending my day all balled up and wedged in the corner...#$e#What? You mean you don't do that?$3",
      "translation": "Přemýšlím, že dnešek strávím schoulený a vmáčknutý v koutě...#$e#Cože? Chceš říct, že ty to neděláš?$3",
      "sourceSHA256": "8925b6c7f549ad102b24c3e5389f63eea18a485f37f8c0fea0abbbdf688cceae",
      "translationSHA256": "e3f38c9232e49045f62b59b8b76cb7e815274844ce6200c30d68d5e0de43edc5",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueKrobus",
      "key": "Indoor_Day_4",
      "field": null,
      "source": "On Fridays, I like to stay quiet out of respect for Yoba. I hope you don't mind.",
      "translation": "V pátek rád mlčím z úcty k Yobovi. Doufám, že ti to nevadí.",
      "sourceSHA256": "433059433841a564f7088a941e8c5c3c78e0c25c7e6409f8a57b425ab82c9859",
      "translationSHA256": "d79ec6162b1f343be19aed04658be5fa4f86e5ef508d4d2fbdc3ad2f3bfb66a0",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueKrobus",
      "key": "Indoor_Day_Krobus",
      "field": null,
      "source": "I wish I could help you on the farm, but I can't go out in the sun...",
      "translation": "Kéž bych ti mohl pomáhat na farmě, ale nemohu vyjít na slunce...",
      "sourceSHA256": "8f5eeef5af6c37080aacc69e9ff7b9ac1af6994c2bff897b8e37b16b8e6d8579",
      "translationSHA256": "fc5e13cfa5024adcd4d530af0e9acd92c709305c4d6826a83032136d7748cb69",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueKrobus",
      "key": "Indoor_Night_0",
      "field": null,
      "source": "I cleaned all the bugs out of the house today... Sorry, I didn't save you any! *smack*$7",
      "translation": "Dnes jsem vyčistil dům od všeho hmyzu... Promiň, žádný jsem ti nenechal! *mlask*$7",
      "sourceSHA256": "d7ff4016299ecc8baec009cd047ad36f811ddb9db7a3e52ec9b6e2715e8b9af5",
      "translationSHA256": "0113cd522f32c1b1195dc4fe5b8b04de0ab5f5c9cd33b1805174b0ae8ab53c90",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueKrobus",
      "key": "Indoor_Night_1",
      "field": null,
      "source": "You feel solid... sometimes I wish I had bones, too...$s",
      "translation": "Na dotek působíš tak pevně... občas si přeji, abych měl také kosti...$s",
      "sourceSHA256": "ea28c2d4dd803393f52d8f851fd1dbd0790d3bf74d3d7d453ce462b0d16d391a",
      "translationSHA256": "dd5225d4f0c45395d8911beee6a38abb0353af432885d312d2df2f6e01c21083",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueKrobus",
      "key": "Indoor_Night_2",
      "field": null,
      "source": "Sometimes I wonder if humans and shadow people could really ever co-exist... It's a lovely idea, but is it realistic?$s#$e#I hope so...",
      "translation": "Občas přemýšlím, jestli by lidé a Stínoví lidé vůbec někdy mohli žít společně... Je to krásná představa, ale je realistická?$s#$e#Doufám, že ano...",
      "sourceSHA256": "28e69455ba6af876cad833f1bbd121a1f95b459f737760aad277605fe7cc3459",
      "translationSHA256": "7097d979bbd72353b43f89f9d64bb3bfb73d5817bb3f9b8a15735a4890e1a56d",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueKrobus",
      "key": "Indoor_Night_3",
      "field": null,
      "source": "Sometimes I pause and think of all that I've learned about humans from you...#$b#I wish all my fellow shadow people could know this feeling.",
      "translation": "Občas se zastavím a přemýšlím o všem, co jsem se díky tobě naučil o lidech...#$b#Přál bych si, aby tenhle pocit poznali i všichni ostatní Stínoví lidé.",
      "sourceSHA256": "39a19c6f096912e19306471f91581b2bf6a06131a90eab29d7b59e4ed81a2235",
      "translationSHA256": "6fb2d3ee95fd9226df2def8df1c03e954cadc2fbc1fbb11ff442fb21b4d63394",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueKrobus",
      "key": "Indoor_Night_4",
      "field": null,
      "source": "I want to be a good housemate for you, but I never know if I'm doing well... *groan* $s#$e#I have a hard time understanding human expression. B... but... you're happy living with me?#$e#Okay!$7",
      "translation": "Chci pro tebe být dobrým spolubydlícím, ale nikdy nevím, zda si vedu dobře... *zasténá* $s#$e#Lidským projevům těžko rozumím. A... ale... žije se ti se mnou dobře?#$e#Dobře!$7",
      "sourceSHA256": "c9d4e9aad8a969b3e78f25067cb4bd2394c8253e4e12e27b7c572adc99234911",
      "translationSHA256": "43466fb249917485c2319a55d0e37e71d899a36107ccdbf200a8cada2bc2d1d8",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueKrobus",
      "key": "Indoor_Night_Krobus",
      "field": null,
      "source": "Hi, @. Welcome home. You look like you've been working hard out there!$h",
      "translation": "Ahoj, @. Vítej doma. Vypadá to, že máš za sebou spoustu práce venku!$h",
      "sourceSHA256": "48bdc140db779a60f35927d256bbfadef91fdd29dda7bd1b4da8225f3cc3affd",
      "translationSHA256": "b9c5844da4e2ef1752f1735bdd237f41979348403c2fd3662d7bc90e29cf3c72",
      "reviewChecks": [
        "sourceMeaning",
