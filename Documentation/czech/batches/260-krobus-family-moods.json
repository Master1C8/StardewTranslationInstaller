    {
      "target": "Characters/Dialogue/MarriageDialogueKrobus",
      "key": "TwoKids_0",
      "field": null,
      "source": "Don't worry... I already made %kid1 and %kid2 a void egg omelet.",
      "translation": "Neboj... Omeleta z Prázdnotového vejce pro %kid1 a %kid2 už je hotová.",
      "sourceSHA256": "869e9f1c88c0a50685bb0674a497d5dd34eeb36505b7c1bc35ac44eb6bf783bd",
      "translationSHA256": "20e02b7f3d554367958ff116524bf210e91f480ec3b01b80d8536a42ca7e9b86",
      "reviewChecks": [
