    {
      "target": "Characters/Dialogue/MarriageDialogueKrobus",
      "key": "Neutral_2",
      "field": null,
      "source": "Do you think we could get in trouble for living together?$s",
      "translation": "Myslíš, že bychom mohli mít kvůli společnému bydlení potíže?$s",
      "sourceSHA256": "dac36af64f7bc5743da75840b562daea57129dcfb253bd1b33e39a39aa68b651",
      "translationSHA256": "24dcf195e901366e825c12b8399cb818d82c1a402ff0fa2884f9afa908485ae3",
