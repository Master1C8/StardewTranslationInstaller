      "target": "Characters/Dialogue/MarriageDialogueKrobus",
      "key": "Neutral_3",
      "field": null,
      "source": "It's so bright in here... I might close my eyes for a few hours.$s",
      "translation": "Je tu tak jasno... Možná na pár hodin zavřu oči.$s",
      "sourceSHA256": "77a861cc00103fb0a8274a4fb320f23973ca2fc4a4903ee6e5250f8d17bca415",
      "translationSHA256": "401308cee32a2c818f1804aac8012f5f9e90809474156c6a97902eac8afa60fa",
