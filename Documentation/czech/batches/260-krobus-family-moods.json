    {
      "target": "Characters/Dialogue/MarriageDialogueKrobus",
      "key": "Good_1",
      "field": null,
      "source": "I feel a sensation in my body... is this... 'platonic love'?$l#$b#... Oh, wait... I'm just shedding my skin.$s",
      "translation": "V těle něco cítím... je to... ‚platonická láska‘?$l#$b#... Ach, počkat... Jen svlékám kůži.$s",
      "sourceSHA256": "3a76a1ff152d9ceb2d7ac3b080cbc81fe1453fa64ed873ba7604b11a067f2ef2",
      "translationSHA256": "2103df0fe00af56a271a9fd12d3d2021eebc335fd11dd304cfb9c9c93232273e",
