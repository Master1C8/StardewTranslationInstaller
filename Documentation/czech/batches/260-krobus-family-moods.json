    {
      "target": "Characters/Dialogue/MarriageDialogueKrobus",
      "key": "TwoKids_2",
      "field": null,
      "source": "I worry about the future of the children... But I trust that Yoba has a plan for them.",
      "translation": "Dělám si starosti o budoucnost dětí... Ale věřím, že pro ně má Yoba plán.",
      "sourceSHA256": "d54f6e5b74ab31adcc9f5c920c4c445898c32e571ed09613cb272992a8bad256",
      "translationSHA256": "c4a82ce6c3f356cf965a5c1c58d26f29c62d771cca5e0a3f27ef258fb66ff366",
      "reviewChecks": [
