    {
      "target": "Characters/Dialogue/MarriageDialogueKrobus",
      "key": "Good_2",
      "field": null,
      "source": "I've learned to overcome my bias against humans... but Dwarves still disgust me.$a",
      "translation": "Naučil jsem se překonat své předsudky vůči lidem... ale trpaslíci se mi stále hnusí.$a",
      "sourceSHA256": "5b3b98b1ce2f63c874a75db886fa7f9ac9a456b1ad9c224b32104e613443e9a0",
      "translationSHA256": "344552a9fe60b0b77430407c676fb3be9500e0a115dfa25110d00bf15a18962a",
