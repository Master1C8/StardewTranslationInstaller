    {
      "target": "Characters/Dialogue/MarriageDialogueKrobus",
      "key": "OneKid_3",
      "field": null,
      "source": "I'm not sure how, but Yoba has blessed this house with a 'child'...",
      "translation": "Nejsem si jistý, jak k tomu došlo, ale Yoba tomuto domu požehnal ‚dítětem‘...",
      "sourceSHA256": "597806a7791e87483b0c96246d411c8679b1078be670c1d08c3ba715651775f9",
      "translationSHA256": "0319f07b709b417fae542a96ef9467d7344945c64979767b3cb6935003241f95",
