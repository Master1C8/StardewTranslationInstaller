  "glossarySHA256": "cb0b94baf37d83f13a5401acdc21e0c6ef37e2bfd7c91616b1db7ae966dc2161",
  "reviewNote": "Celý balíček byl dříve plně porovnán; po cílené změně znovu ověřeny všechny dotčené řádky s nepřímou otázkou, jejich význam, interpunkce a řídicí tokeny.",
  "rows": [
    {
      "target": "Characters/Dialogue/MarriageDialogueKrobus",
      "key": "Outdoor_Krobus",
      "field": null,
      "source": "I'll wait here for a bit, and see if any bugs come my way.#$e#I haven't had breakfast yet!",
      "translation": "Chvíli tu počkám a uvidím, jestli ke mně nezamíří nějaký hmyz.#$e#Ještě jsem nesnídal!",
      "sourceSHA256": "90e35bf296cc18736c1aa945353fe4e3517ff7a25c50082d0b2ec47524299870",
      "translationSHA256": "a59967a2c1bc4bdbcd18e2255d8de7ffe4e0b232619ce76a2a1845ec866f0d9b",
