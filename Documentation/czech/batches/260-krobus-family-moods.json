      "target": "Characters/Dialogue/MarriageDialogueKrobus",
      "key": "Good_0",
      "field": null,
      "source": "We're making progress, and I feel really hopeful.$h",
      "translation": "Děláme pokroky a jsem opravdu plný naděje.$h",
      "sourceSHA256": "b74c4d4471f6c82c06f4facbc6188d4adaaca654b276c05367baf82aeee219f6",
      "translationSHA256": "318cf84a584b5b4d5d75fb964b741c58a39b89f92b7b87c4f684d2f320797ad6",
