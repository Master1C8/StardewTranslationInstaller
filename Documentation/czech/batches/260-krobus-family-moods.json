    {
      "target": "Characters/Dialogue/MarriageDialogueKrobus",
      "key": "Neutral_1",
      "field": null,
      "source": "Do you think your Grandpa would approve of a monster living in his house?",
      "translation": "Myslíš, že by tvůj dědeček schvaloval, aby v jeho domě žilo monstrum?",
