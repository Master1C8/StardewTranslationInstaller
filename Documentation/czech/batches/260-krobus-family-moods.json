    {
      "target": "Characters/Dialogue/MarriageDialogueKrobus",
      "key": "Neutral_0",
      "field": null,
      "source": "I won't ever grow old, but you will. Sometimes it makes me sad... but that's okay.$s",
      "translation": "Já nikdy nezestárnu, ale ty ano. Občas mě to rozesmutní... ale to nevadí.$s",
      "sourceSHA256": "c8e1f92d250d2ca7c5c722b085cd00470e61c32dc3728b0b372e8325f0c32ab7",
      "translationSHA256": "2aa1c372eba3c676697906f5b840cc8a7b455aafb683491063798e358eeb67c2",
      "reviewChecks": [
