    {
      "target": "Characters/Dialogue/MarriageDialogueKrobus",
      "key": "spring_1",
      "field": null,
      "source": "What's your plan for the new year, @?",
      "translation": "Co máš v novém roce v plánu, @?",
      "sourceSHA256": "e10ecd20862225372e4233637334bca96a5379a327278e7ca1c8c0e94f4c81c2",
      "translationSHA256": "0c5487f9f19560ff196cf2f655cbb89ed511b09599da6131d09217c577cb30d1",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueKrobus",
      "key": "spring_23",
      "field": null,
      "source": "You should go to the flower dance tomorrow! Don't worry about me.",
      "translation": "Zítra je Květinový tanec! Určitě tam běž. O mě si nedělej starosti.",
      "sourceSHA256": "7abbdb348d316a18c83fcc49e45c3f671c4fb239f861529c8d4bed16ed516708",
      "translationSHA256": "0027fa27f8afea87d769b5f30ff254151ad87ce3ca9afff541a5b5c5f1bc8e7c",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueKrobus",
      "key": "summer_1",
      "field": null,
      "source": "I get sunburnt very easily, so I need to be careful this time of year.",
      "translation": "Na slunci se velmi snadno spálím, takže si v tomto období musím dávat pozor.",
      "sourceSHA256": "49a3966fbf1073e0b72ef78c1867447eb65c4334cb70c9009157f66a3714a98a",
      "translationSHA256": "4373fba0e2aecd4c4725f7924605d60711364d45e2d384c3307777cd8c823de6",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueKrobus",
      "key": "summer_8",
      "field": null,
      "source": "Mmm... what's that lovely smell? You must've been sweating all night...$h",
      "translation": "Mmm... co to tak krásně voní? To bude nejspíš následek celonočního pocení...$h",
      "sourceSHA256": "ae1d94c9c4288f5fa198ae5ec1b0cd1120ddc50c9f98540c6714a8a0309d93d1",
      "translationSHA256": "28953461606c13433389f5c97f534a987aa82b4901f8bfdd6516f2c6a40bb59d",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueKrobus",
      "key": "summer_15",
      "field": null,
      "source": "It's summer... that means the house is full of flies.#$e#Don't worry, I'll take care of them. It's good protein!$h",
      "translation": "Je léto... to znamená, že je dům plný much.#$e#Neboj, postarám se o ně. Jsou dobrým zdrojem bílkovin!$h",
      "sourceSHA256": "4da406c180669e49b72b8c1beb4e1a8a474fe67295865ff1e158f625276a96d6",
      "translationSHA256": "164864ec1cb350bfb316a14790ec6ca699593ec09886c2f703ec559731ad9526",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueKrobus",
      "key": "fall_8",
      "field": null,
      "source": "I don't feel like doing anything today.",
      "translation": "Dnes se mi nic nechce dělat.",
      "sourceSHA256": "233b440767521426d2d0b1c64b790e339bf0c8b967f22460096d4184a6b9a260",
      "translationSHA256": "1b54b641cb64a28aebe5f687f995658954b976a300abffd15931de0fab6345f7",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueKrobus",
      "key": "fall_15",
      "field": null,
      "source": "Have you figured out what you're going to use for your grange display tomorrow?",
      "translation": "Už víš, co zítra použiješ do své farmářské výstavky?",
      "sourceSHA256": "2d6e9d69628cb41f867e0c2b8ce3053f4dd6becf70cb3136b6e7d0503f43a093",
      "translationSHA256": "9a175275344df00a21a1aed93736128b39185e24ca8d7294e98d0b5cbb04bd25",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueKrobus",
      "key": "fall_24",
      "field": null,
      "source": "If I showed up to the Spirit's Eve festival they'd put me in a cage...$s",
      "translation": "Kdybych přišel na festival Předvečer duchů, zavřeli by mě do klece...$s",
      "sourceSHA256": "d25752a752fa2f905b39d73b33a80eebfbfce41c38fd2097f918a2682dfc7886",
      "translationSHA256": "4e7ad4e9e27330ff5d8da3b1de635fe01885c7b2694065fa994a429e25665452",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueKrobus",
      "key": "winter_28",
      "field": null,
      "source": "Thanks for letting me stay here, @. I'm looking forward to another great year!$h",
      "translation": "Děkuji, že mě tu necháváš bydlet, @. Těším se na další skvělý rok!$h",
      "sourceSHA256": "eb52a12611aaa71e7a4fd6ed0fa215628ec6436ec30948c90df56d2261c68d6a",
      "translationSHA256": "dbcebbdbe5b7472c794528651a3c3b2d83380305d95b0dc69ccb92b5e01c980f",
      "reviewChecks": [
        "sourceMeaning",
