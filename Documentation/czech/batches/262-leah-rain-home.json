        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueLeah",
      "key": "Rainy_Day_4",
      "field": null,
      "source": "The trees have been begging for this rain... I'm happy for them.",
      "translation": "Stromy už o tenhle déšť prosily... Mám za ně radost.",
      "sourceSHA256": "716351df1bd6117277f1e808cd103aecc117350569bfa056e27141ac3bdb9039",
      "translationSHA256": "ad6724b33f8b1f35a62767a9856d4848ab0a13989247c0f85b1070e4c609d9d9",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueLeah",
      "key": "Rainy_Night_0",
      "field": null,
      "source": "How was your day? Did you see any animals out there?",
      "translation": "Jaký byl tvůj den? Bylo venku k vidění nějaké zvíře?",
      "sourceSHA256": "2c821ef38741c86e104829841550a8c2df72e45fcdf484bb621316435a0f01da",
      "translationSHA256": "0cd9f9a22fa3684a08b5ec5e1c543e5bcddb889f0bd5aff0bbda6b145202adeb",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueLeah",
      "key": "patio_Leah",
      "field": null,
      "source": "Don't look too close, it's a work in progress.",
      "translation": "Nedívej se moc zblízka, ještě na tom pracuji.",
      "sourceSHA256": "e10e283703b8057066ac760a74609483479d16933219d557a9a024d3cf76e37a",
      "translationSHA256": "cb11eb29ebfdb3a95f3ac25cc5a2c5310970e4c679bcb87bde1636352fef50f2",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueLeah",
      "key": "Rainy_Night_1",
      "field": null,
      "source": "I usually go for salad... but a wet night like this gives me cravings for hot soup.$h",
      "translation": "Obvykle si dávám salát... ale za takové deštivé noci dostávám chuť na horkou polévku.$h",
      "sourceSHA256": "4b6e727c559964d4f1e9227d85670fa67488dd1ee5ed33b6b238e9892e9ff18e",
      "translationSHA256": "877c3fb1b245d08bcaca7e437bf6d2cb7209caba8a997f6561d75ba033a377ea",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueLeah",
      "key": "Rainy_Night_2",
      "field": null,
      "source": "It's going to be relaxing to fall asleep on a night like this...$l",
      "translation": "Bude příjemné usínat za takové noci...$l",
      "sourceSHA256": "392766eeedcb6b21890ed8e889678520fc96ad223cb3f8a9f2e8429185df3a9c",
      "translationSHA256": "8c60a4dbe3b074d8e3e9d245c3110dcaa1c953529fb9aa7eb218ca9bf94050e4",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueLeah",
      "key": "Rainy_Night_3",
      "field": null,
      "source": "I made a little wood sculpture today, but it was so ugly I threw it into the fire.$u#$e#I think to become a great artist, you have to be critical of your own work.",
      "translation": "Dnes jsem vyrobila malou dřevěnou sochu, ale byla tak ošklivá, že jsem ji hodila do ohně.$u#$e#Podle mě musí velký umělec umět kriticky posuzovat vlastní tvorbu.",
      "sourceSHA256": "c2876e90036ff8c7d06a107480468d88a3b36e800c8cd8a804b859e4bf994c89",
      "translationSHA256": "a3000afc63a724708b756836ed199d59ee1ea48b8771591f66c039b76cf3feba",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueLeah",
      "key": "Rainy_Night_4",
      "field": null,
      "source": "I'm glad you're home... It's a good night to get under the covers and stay warm.",
      "translation": "Jsem ráda, že jsi doma... Dnes je ta pravá noc zalézt pod peřinu a zůstat v teple.",
      "sourceSHA256": "818466f186adecd6da8d73e0630a102001b69bffdc35342ea5f075453a1759d0",
      "translationSHA256": "f80f15a9db091ab85693625a8d4689e477cddfbf1460c45dde15d7165898fd5d",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueLeah",
      "key": "Rainy_Night_Leah",
      "field": null,
      "source": "How was your day today, dear? Muddy?",
      "translation": "Jaký byl tvůj dnešní den, miláčku? Blátivý?",
      "sourceSHA256": "492ae0f68b54c27ce6725c96ae0623bf795ae8f04efbe3ce75be9a76fb44b5e3",
      "translationSHA256": "156542a198fe8939e65bd7600f9aff48b95dddfa45a21a6a5574d6470984fdec",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueLeah",
      "key": "Indoor_Day_0",
      "field": null,
      "source": "This house is a lot nicer than my old cabin! I don't miss it.",
      "translation": "Tento dům je mnohem hezčí než moje stará chata! Nechybí mi.",
      "sourceSHA256": "602added6fef4d1e27a0b3ad15e68737b90f24a3e97ef3f4cca06bdc83bdd9ab",
      "translationSHA256": "b546066e8d3d2587aa16f59b5d1b17990103f9669c81561954f1c1cf2c4a5072",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueLeah",
      "key": "Indoor_Day_1",
      "field": null,
      "source": "Good morning, @. I've planted these in a little pot out back... [16 18 20 22 90 259 396 402]#$e#I grew that with great love and attention. Enjoy it.",
      "translation": "Dobré ráno, @. Tohle jsem zasadila do malého květináče vzadu za domem... [16 18 20 22 90 259 396 402]#$e#Vypěstovala jsem to s velkou láskou a péčí. Užij si to.",
      "sourceSHA256": "9d34f6095f403099a76c85530c12051d775aa43f1421d4c6e3b516999f720a47",
      "translationSHA256": "e83c7e3a45827cabbc1488272c28bd5fa92f6a385670c5ecc28e0e7a946bc71f",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueLeah",
      "key": "Indoor_Day_2",
      "field": null,
      "source": "Always remember to keep your eyes peeled for wild food! There's lots out there.",
      "translation": "Nezapomínej pozorně vyhlížet jedlé dary přírody! Venku jich najdeš spoustu.",
      "sourceSHA256": "9f1dc621cffb2e5ed12f3c4a9c9a31721b1f2d9ea29b35b8a3457643039ae254",
      "translationSHA256": "b6281792143d327c3d9e3100c7e3d4f6faf9adb8c628c0c99c24768ab057d720",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueLeah",
      "key": "Indoor_Day_3",
      "field": null,
      "source": "I was thinking... life's too short to eat bad food. Luckily, we live in one of the best regions for fresh greens and vegetables!#$e#Here, I made you a healthy salad. [196]#$e#I'm surprised you aren't sick of my salad yet!",
      "translation": "Přemýšlela jsem... život je příliš krátký na špatné jídlo. Naštěstí žijeme v jednom z nejlepších krajů pro pěstování čerstvé listové i další zeleniny!#$e#Tady, připravila jsem ti zdravý salát. [196]#$e#Překvapuje mě, že se ti můj salát ještě nezajedl!",
      "sourceSHA256": "45a29b4f03f48665219d44900844e9563de4f92e7897bc644fc9b4dd43ced036",
      "translationSHA256": "2f99f558713db12d030fd18c857a1d95e44fd1db45a6f05d630b04e324cff246",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueLeah",
      "key": "Indoor_Day_4",
      "field": null,
      "source": "Good morning, @! I made us some coffee.[395]$h#$e#My morning just wouldn't be complete without a hot cup of coffee.",
      "translation": "Dobré ráno, @! Připravila jsem nám kávu.[395]$h#$e#Bez horkého šálku kávy by mé ráno prostě nebylo úplné.",
      "sourceSHA256": "2786a4a60999e7695223274aaca84e99745397ca43b9b83420da0854c10bb0c4",
      "translationSHA256": "b1b553fe05e157d9f1680ec99e9b9381981ebcf4b8dad47a015ae2020367a1be",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueLeah",
      "key": "Indoor_Night_0",
      "field": null,
      "source": "Something about this time of night makes me thirsty.",
      "translation": "V tuhle noční hodinu na mě vždy přichází žízeň.",
      "sourceSHA256": "6785470b59debe450e67a858ea3c3b8564b143fb999034d8426bea4499a8afeb",
      "translationSHA256": "b5906a482414f3a5c76602bf209b6ebcd634f1970d795f0b63f88bb17fa84737",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueLeah",
      "key": "Indoor_Night_1",
      "field": null,
      "source": "The flow of time is so delicate... even the tiniest decision changes the future forever.",
      "translation": "Plynutí času je tak křehké... i sebemenší rozhodnutí navždy změní budoucnost.",
      "sourceSHA256": "e3e938b8cc9c6ec30fac1a454d8bd9346fb180242454a883e64d61a46cebd645",
      "translationSHA256": "a85dd8a1c9794193e46b32dc21319cb3a92954c7b290811857c8310e07892fed",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueLeah",
      "key": "Indoor_Night_2",
      "field": null,
      "source": "It's so much lovelier here at night than the garish glow of the city.#$e#Everything worked out perfectly for me. I'm very lucky.",
      "translation": "V noci je tu mnohem krásněji než v křiklavé záři města.#$e#Všechno dopadlo přesně podle mých představ. Mám veliké štěstí.",
      "sourceSHA256": "b27a33ee016022912e0a661a0bbad9180142f2c9d1c7db675b8d40a10e227b9f",
      "translationSHA256": "f5110b19436ee02566974fb62addde26bf7d9670ee2fe0b7bf542c64e2c88cf5",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueLeah",
      "key": "Indoor_Night_3",
      "field": null,
      "source": "I never thought I'd receive a mermaid's pendant so soon after moving here! I'm happy about it, though.$l",
      "translation": "Nikdy by mě nenapadlo, že tak brzy po přistěhování dostanu Přívěsek mořské panny! Jsem za to ale ráda.$l",
      "sourceSHA256": "24e8aa8f17b3308b24470eb57be906bbe94c21d0dea46c89109afd013ef439de",
      "translationSHA256": "3f741514cf75403e280e8f5d3e4aa996d736e130971769595bce27e9c28b9133",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueLeah",
      "key": "Indoor_Night_4",
      "field": null,
      "source": "I saw a wild rabbit today. I just wish I could pet one someday. They look so soft...",
      "translation": "Dnes jsem zahlédla divokého králíka. Kéž bych si někdy mohla nějakého pohladit. Vypadají tak hebce...",
      "sourceSHA256": "b942d209b548602aea2d436bbd119f77f40052114a040cfe4d7af240c42f35b3",
      "translationSHA256": "7052c276c17910fdef799840cee6eeb85c3bd5018e54bd30a55fb6846853a5a6",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueLeah",
      "key": "Outdoor_0",
      "field": null,
      "source": "The cool breeze feels nice. It reminds me of living by the river.",
      "translation": "Chladivý vánek je příjemný. Připomíná mi život u řeky.",
      "sourceSHA256": "ce9be1649ef740303684d7b2584645223ad9ab7c6efed988a5f8f818073cb5d2",
      "translationSHA256": "8ea26feb9e08e120c8cc16c7ed2460cdd50643a65c3e68a55161624029bae0f8",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueLeah",
      "key": "Outdoor_1",
      "field": null,
      "source": "Hmm... I'm going to do some maintenance over here. I just get the urge to do some hammering now and then.",
      "translation": "Hmm... Tady se pustím do nějaké údržby. Občas prostě dostanu chuť vzít do ruky kladivo.",
      "sourceSHA256": "786cf9be3b81b90d7fd9d907624716b4f0fa93c8b2881174be21d90f29a51b87",
      "translationSHA256": "51d5c1f06908b190e2d20fe18fd12d776912873159dbe7fd0ffe3790fd7d77b3",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueLeah",
      "key": "Outdoor_2",
      "field": null,
      "source": "It's going to be a special day, I can sense it.",
      "translation": "Bude to výjimečný den, cítím to.",
      "sourceSHA256": "1b9830f952bd6692e3e9155f114ebf9d8088affe7f2f2526883a2bafbd2d2d57",
      "translationSHA256": "ab2ddfd3464fc8209e1f938873c74012cbb0dd9af4d6b8c6ce511b101d661876",
