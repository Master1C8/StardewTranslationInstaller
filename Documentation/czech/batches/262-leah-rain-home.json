{
  "id": "262-leah-rain-home",
  "locale": "cs",
  "kind": "long",
  "glossarySHA256": "cb0b94baf37d83f13a5401acdc21e0c6ef37e2bfd7c91616b1db7ae966dc2161",
  "reviewNote": "Second complete 25-row review after apply found no further issue: two player questions are gender neutral and the salad idiom is corrected; Leah voice, item lists, controls, and tokens are preserved.",
  "rows": [
    {
      "target": "Characters/Dialogue/MarriageDialogueLeah",
      "key": "Rainy_Day_0",
      "field": null,
      "source": "I sometimes find inspiration in the most unlikely of places.",
      "translation": "Inspiraci někdy nacházím na těch nejméně očekávaných místech.",
      "sourceSHA256": "3bc50aea313269f15fd63e1ec77343c122452d735328b3fba7d058f7fce60d62",
      "translationSHA256": "c43b0a5387542be0f801b07765392e3800683e2cc844227679f78e707031ddd6",
      "reviewChecks": [
