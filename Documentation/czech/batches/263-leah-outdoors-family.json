      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueLeah",
      "key": "Neutral_7",
      "field": null,
      "source": "I don't really feel like doing anything today.",
      "translation": "Dnes se mi opravdu nic nechce dělat.",
      "sourceSHA256": "19260f173d5b6dad0f36fb99a005c014e30371f2b4eecf062e867dfbb28e2079",
      "translationSHA256": "4adbe7f2af227c2cfddc938e7a9838c98d826244c18140b0148b14324f769951",
      "reviewChecks": [
