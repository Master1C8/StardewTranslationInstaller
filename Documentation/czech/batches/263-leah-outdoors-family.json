      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueLeah",
      "key": "Neutral_6",
      "field": null,
      "source": "I wonder what everyone in town is doing today?",
      "translation": "Zajímalo by mě, co dnes dělají všichni ve městě.",
      "sourceSHA256": "e009833a584e295883a5d0d1083b4040eb82c320b33b4a67042976434734d10f",
      "translationSHA256": "c9202309047a43af35f940e79c300398ef1f252bde1cc754d75382e53d5315e3",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
