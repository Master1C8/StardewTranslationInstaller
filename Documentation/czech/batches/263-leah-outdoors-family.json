{
  "id": "263-leah-outdoors-family",
  "locale": "cs",
  "kind": "long",
  "glossarySHA256": "cb0b94baf37d83f13a5401acdc21e0c6ef37e2bfd7c91616b1db7ae966dc2161",
  "reviewNote": "Celý balíček byl dříve plně porovnán; po jediné změně znovu ověřena dvojice Neutral_1 a správná tečka po nepřímé otázce.",
  "rows": [
    {
      "target": "Characters/Dialogue/MarriageDialogueLeah",
      "key": "Outdoor_3",
      "field": null,
      "source": "Ah... that smell of fresh dirt. There's nothing quite like it.$h#$e#You can just tell the air is clean here... it feels good in the lungs.",
      "translation": "Ach... ta vůně čerstvé půdy. Nic se jí nevyrovná.$h#$e#Člověk tu prostě pozná, že je vzduch čistý... tak dobře se dýchá.",
      "sourceSHA256": "fc7a98ed5df8e1ec5d4909719e8791388d7e4cdbd124bb926df87f75a0cbe0d7",
      "translationSHA256": "b2b49fb72d429e37b7a31b892bad32c150f63df02323026d792a34cab5b5eb5f",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueLeah",
      "key": "Outdoor_4",
      "field": null,
      "source": "Don't overwork yourself, dear.#$e#Make sure and take a break every now and then, or get something to eat.$h",
      "translation": "Nepřepracuj se, miláčku.#$e#Nezapomeň si čas od času odpočinout nebo si dát něco k jídlu.$h",
      "sourceSHA256": "40ba86471899999f1e0c9df6d5c41e0d4581a3b8455e648af940b60474442347",
      "translationSHA256": "e370ec860293b2539272504372964ed3668316dcf9e841793e2ada58dbb8d9c3",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueLeah",
      "key": "funLeave_Leah",
      "field": null,
      "source": "I'm going to take a nature walk today. I need to get out of the house.",
      "translation": "Dnes se půjdu projít do přírody. Potřebuji vypadnout z domu.",
      "sourceSHA256": "1e097ae35e26f3f31ef94269d2954bacb20e3da35fbe4f62388713c6d99eb4ce",
      "translationSHA256": "f31eb410c48fc9b9a4cf665859285c25bb2436fe70ba3adbea0f5760931e0675",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueLeah",
      "key": "funReturn_Leah",
      "field": null,
      "source": "I had a nice, relaxing time today. How did your day go?",
      "translation": "Dnes jsem si příjemně odpočinula. Jaký byl tvůj den?",
      "sourceSHA256": "7c15e8b7124a63c13341f1ca4ad4d44b97b94c9d9fc256cee874e898ead60fd3",
      "translationSHA256": "0174b3ba02043f1612d35f6849d00de9c20e8dfb277b906e81e89eaad72b09b4",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueLeah",
      "key": "OneKid_3",
      "field": null,
      "source": "It's fun to be a parent. I want to make sure %kid1 grows up to have a love for the outdoors.",
      "translation": "Být rodičem je zábava. Chci v %kid1 vypěstovat lásku k přírodě.",
      "sourceSHA256": "86a4034ec62073599673835879149c5cf2ad1b5b0a19dda590a399486ff59a92",
      "translationSHA256": "d800ab0a029de1d312c6ce44ac269a710842e07f74c5d2b68003b11e3bc9b25d",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueLeah",
      "key": "TwoKids_3",
      "field": null,
      "source": "We've got a wonderful farm and a full family. Our new life has really turned out well, hasn't it?",
      "translation": "Máme nádhernou farmu a celou rodinu pohromadě. Náš nový život se opravdu vydařil, viď?",
      "sourceSHA256": "fceed5c2e7fea0fde74e436412b2a584b89c5a57afc9a857824527be12599b47",
      "translationSHA256": "298888a46399f95d6a8844aa3211281cda6e85cfc16f134aff78d193550afb92",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueLeah",
      "key": "Good_0",
      "field": null,
      "source": "Living here, I feel like I'm on the summit of a great mountain.",
      "translation": "Když tu žiju, připadám si, jako bych stála na vrcholu mohutné hory.",
      "sourceSHA256": "926fe9896f988aa576bb38141b1107bb63c69189acb1e13b84bd29811880c2f8",
      "translationSHA256": "4a6fc09acc80cef0d8da4b2d9b745518016f02e82cb96fb54eff02bd6c6ec964",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueLeah",
      "key": "Good_1",
      "field": null,
      "source": "Did I ever tell you... when you first moved here I had a dream that we'd be together someday.",
      "translation": "Řekla jsem ti to někdy...? Krátce po tvém přistěhování se mi zdálo, že jednoho dne budeme spolu.",
      "sourceSHA256": "cf3b331cb794665e140277f52ea66e7b8a667153e0792be75f0e1efa3d67afd7",
      "translationSHA256": "9587d23e68b70bb03a27922f5ae1a4d7634b524703c45d0579b7ea39c2afd9de",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueLeah",
      "key": "Good_2",
      "field": null,
      "source": "Sometimes it's hard not to believe in destiny... the fact that I decided to move here, and that we found each other.#$b#It could've gone entirely differently at any point.",
      "translation": "Někdy je těžké nevěřit na osud... Rozhodla jsem se přestěhovat právě sem a my dva jsme se našli.#$b#V kterékoli chvíli to přitom mohlo dopadnout úplně jinak.",
      "sourceSHA256": "d1509cf3ae7b26f35c281eb69f9e71015db3ae6cfc9ecd064e00138da947b6cf",
      "translationSHA256": "57b8b8bbfca308faeb172c83e0d22962504d9fbfa8e2763ab4ad795098a1040a",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueLeah",
      "key": "Good_3",
      "field": null,
      "source": "Wow, you look full of energy today!$l^You look beautiful today.$l",
      "translation": "Páni, dnes vypadáš plný energie!$l^Dnes vypadáš nádherně.$l",
      "sourceSHA256": "fc2d6e55146d498dc66fcfe046739dd2340a4cd38d53e7cd3c907a5f49718627",
      "translationSHA256": "4e1f287f9baf8859de48393132b5c8c81460cb0b93d6fb3dbc42ecc9abe3c89f",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueLeah",
      "key": "Good_4",
      "field": null,
      "source": "Mmm... You smell nice today.",
      "translation": "Mmm... Dnes krásně voníš.",
      "sourceSHA256": "753eed0f03ef306d22e029dcf41c64afff4c8f1ba4e18c1db38a2e7926f8fe35",
      "translationSHA256": "35ab78c9f8c8cf186ecd122a55a51957a8da5d791688c3a308a4c0b31b31816a",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueLeah",
      "key": "Good_5",
      "field": null,
      "source": "I was just admiring my wedding amulet... I'll cherish this treasure for the rest of my life.$l",
      "translation": "Právě jsem obdivovala svůj svatební amulet... Tohoto pokladu si budu vážit po zbytek života.$l",
      "sourceSHA256": "8cd94e36eb094ccf07b7c7ed67928d010fa52a080ea08c4f18a22940649b9757",
      "translationSHA256": "fe318fdaaab4dd6e1c02c3d153551c22816d6c5417cb049d8d076843fa07580f",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueLeah",
      "key": "Good_6",
      "field": null,
      "source": "Be careful out there! Sometimes I worry about you falling into a mine shaft.",
      "translation": "Venku na sebe dávej pozor! Někdy mám strach, že spadneš do důlní šachty.",
      "sourceSHA256": "6b4a1108e905db14e13f96c0696d0f7e40f999ef217db1818987b681ef220b21",
      "translationSHA256": "ee7a84f81480a6451c717695a55e2f8f311e92314ecb83baa49dddbc01f171b7",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueLeah",
      "key": "Good_7",
      "field": null,
      "source": "@? I just want to say that I appreciate all the hard work you do for our household.$h",
      "translation": "@? Jen ti chci říct, že si vážím veškeré práce, kterou pro naši domácnost děláš.$h",
      "sourceSHA256": "e3a0fd17e89476e27970f940acdc38ff840f76eebf1601f0e4d0ff124db363cc",
      "translationSHA256": "c8f04600f91694164cc68fb5126cf15bbc12df261538ec1f2c72b6563aec3949",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueLeah",
      "key": "Good_8",
      "field": null,
      "source": "Don't worry about me... I know you've got a lot of responsibilities outside of the house. I'm fine in here by myself!$l",
      "translation": "O mě se neboj... Vím, že máš spoustu povinností mimo dům. Doma to zvládnu i bez tebe!$l",
      "sourceSHA256": "179f27b1f8362479543cceb8728f3bffe1962bb0354e7bcfcc41806d2095de0d",
      "translationSHA256": "19487414c4e65437aa43101741504ca727b956b7a1e6960b8f931792dcba2c86",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueLeah",
      "key": "Good_9",
      "field": null,
      "source": "Oh, I'm not bored... I'm just enjoying what we have here.#$e#It's a simple life, but I like it.$h",
      "translation": "Ach, nenudím se... Jen si užívám to, co tu máme.#$e#Je to prostý život, ale líbí se mi.$h",
      "sourceSHA256": "65a9691795c9e07083e13f387f8b78e6af3042657025fa5ac8e6d93f5f046c61",
      "translationSHA256": "1e059b28db664126b878e9cb77b4e5063c1c4b57d728121087d36e194a7a704e",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueLeah",
      "key": "Neutral_0",
      "field": null,
      "source": "I hope you'll still like me when I'm old and gray.",
      "translation": "Doufám, že mě budeš milovat, i až budu stará a šedivá.",
      "sourceSHA256": "e3cbde10a24a200d47b3536c22616c4979e9be89b85536160bddedcc813be21d",
      "translationSHA256": "4b37d5ab605ae30fcfd8071b835da9eaf20b37a3a7371f77cd4cf2de94e919b5",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueLeah",
      "key": "Neutral_1",
      "field": null,
      "source": "I wonder who lived here before us?",
      "translation": "Zajímalo by mě, kdo tu žil před námi.",
      "sourceSHA256": "96f51da8d56678943ebf7989b1953831725f8fa284852bc59a0f9ad4feba66ab",
      "translationSHA256": "9b9f4025f00dded1351f0ec038b66f51098f6056495da01eeaf3dbf56f41da56",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueLeah",
      "key": "Neutral_2",
      "field": null,
      "source": "Don't you have anything to do today?",
      "translation": "Copak dnes nemáš nic na práci?",
      "sourceSHA256": "b269903c006e63dd5a0e4ec2cb53120448ac50572479142c8620882569b5caf3",
      "translationSHA256": "211ed0cdd8e803311d2365e0cb8cb2ab14c101a424bdb18b6c6cb005326df57a",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueLeah",
      "key": "Neutral_3",
      "field": null,
      "source": "If you go into town, make sure and say hi to everyone for me.",
      "translation": "Pokud půjdeš do města, nezapomeň ode mě všechny pozdravovat.",
      "sourceSHA256": "5fc564c164d91d8c89bdd724cd47f6e1dcbb19567c4bfa44fcc72a77db867dcb",
      "translationSHA256": "6aae737f2e5c1acae9f644e5bc46c047daf61a0fa3f1b669fbfed5a5b05d6fc8",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueLeah",
      "key": "Neutral_4",
      "field": null,
      "source": "I'll do the laundry tomorrow morning before you get up... that way you won't have any down-time.",
      "translation": "Zítra ráno vyperu, než vstaneš... nebudeš kvůli tomu ztrácet čas.",
      "sourceSHA256": "5c0e96e257c6f319100c3759c644d875bf72a5e73ea1ece4107d5a8e9bdcbfc1",
      "translationSHA256": "43e64deb257df7ed7ec3c7740da61f063dc2792d4b6fab29c88919b64657251a",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
