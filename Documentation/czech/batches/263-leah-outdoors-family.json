    {
      "target": "Characters/Dialogue/MarriageDialogueLeah",
      "key": "Neutral_8",
      "field": null,
      "source": "No matter how much I clean, the house keeps getting dirty again.#$e#I guess farms can be kind of dirty.",
      "translation": "Ať uklízím sebevíc, dům je pořád znovu špinavý.#$e#Farmy asi bývají trochu špinavé.",
      "sourceSHA256": "a159338a900aead10521789b5623ee3759d6788af082f01cfdd9aedca231a08e",
      "translationSHA256": "0c56c2a06c75fe5dbce2a3af6ad1439a505e47b5e3a434563bf5ab5e440e1009",
