    {
      "target": "Characters/Dialogue/MarriageDialogueLeah",
      "key": "Bad_5",
      "field": null,
      "source": "You used to be romantic... what happened?$s#$e#I know I'm not as young as I used to be... is that what you married me for?$a",
      "translation": "Dřív v tobě bylo víc romantiky... co se stalo?$s#$e#Vím, že mládí netrvá věčně... bylo snad mé mládí důvodem ke svatbě?$a",
      "sourceSHA256": "9423733a3c64feafb6287e2c28b4e851008a55cb6b4433f0bb6381cc9e105b39",
      "translationSHA256": "ba8d5af6c8079e8dac877deaf02104348576cdef0abf254ceecea8f007369b1a",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueLeah",
      "key": "Bad_6",
      "field": null,
      "source": "We only have one short life to live... is this the best way to do it?$s",
      "translation": "Máme jen jeden krátký život... je tohle nejlepší způsob, jak ho prožít?$s",
      "sourceSHA256": "d3d6ce016348fd995b7e920ffbb357be7f4a51f960dd77b7e4934d91515ace18",
      "translationSHA256": "08329c0f3925baf3f416c541164c991047bfb636fc970964b12c70445efe51a1",
      "reviewChecks": [
        "sourceMeaning",
