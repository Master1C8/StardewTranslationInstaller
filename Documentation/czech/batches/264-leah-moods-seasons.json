  "glossarySHA256": "cb0b94baf37d83f13a5401acdc21e0c6ef37e2bfd7c91616b1db7ae966dc2161",
  "reviewNote": "Celý balíček byl dříve plně porovnán; po cílené změně znovu ověřeny všechny dotčené řádky s nepřímou otázkou, jejich význam, interpunkce a řídicí tokeny.",
  "rows": [
    {
      "target": "Characters/Dialogue/MarriageDialogueLeah",
      "key": "Neutral_9",
      "field": null,
      "source": "I wonder if we'll live here our entire lives?",
      "translation": "Zajímalo by mě, jestli tu strávíme celý život.",
