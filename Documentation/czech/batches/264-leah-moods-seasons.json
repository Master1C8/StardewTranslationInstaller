    {
      "target": "Characters/Dialogue/MarriageDialogueLeah",
      "key": "Bad_2",
      "field": null,
      "source": "Are you still happy with me?$s",
      "translation": "Je ti se mnou pořád dobře?$s",
      "sourceSHA256": "e7c73ebd9a8e97e2cbafdbbe13628f6b7465b1661e3166a0eb8e1a132070b23d",
      "translationSHA256": "0a7ee247e6825f8ad5f55eb4af920b882cc411c54c998c58d5c7823f718f16e4",
