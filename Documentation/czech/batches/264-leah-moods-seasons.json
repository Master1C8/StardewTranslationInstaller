    {
      "target": "Characters/Dialogue/MarriageDialogueLeah",
      "key": "winter_1",
      "field": null,
      "source": "Winter's here, and that means crystal fruit is in season. It has such a unique flavor, don't you think?",
      "translation": "Zima je tu a s ní i sezóna křišťálového ovoce. Má tak jedinečnou chuť, nemyslíš?",
      "sourceSHA256": "bc85784bafee94639a02a114b7f41d9de0afd392210884dbe13390ea649525f5",
      "translationSHA256": "fda3798c97ae2a80f381b35e45cea382277d1220d9861fd40b09d0f54db226d3",
      "reviewChecks": [
        "sourceMeaning",
