    {
      "target": "Characters/Dialogue/MarriageDialogueLeah",
      "key": "summer_1",
      "field": null,
      "source": "Ah, summer... I can smell the spice berries already.$h",
      "translation": "Ach, léto... Už teď cítím vůni kořeněných bobulí.$h",
      "sourceSHA256": "e985a4bef8aa8f07f06bd52865c48d3123b4ac3784fe30f670c9f66eec7e1aca",
      "translationSHA256": "5ffc70b03e8e335072c981c1503f09d55c238a40aa2aabf0ea5ffedd7f3a9313",
