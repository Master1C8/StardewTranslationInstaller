    {
      "target": "Characters/Dialogue/MarriageDialogueLeah",
      "key": "Bad_8",
      "field": null,
      "source": "You've been so cold to me lately...$s",
      "translation": "Poslední dobou se ke mně chováš tak chladně...$s",
      "sourceSHA256": "726caf94c5633ef5c23ec2f4314ad67b4c73a999377320553100696b74fb154d",
      "translationSHA256": "6ecdaec66f4321c4105255a7a92867902ccd351ffe70cf0e4893fe2b5cececc9",
      "reviewChecks": [
