    {
      "target": "Characters/Dialogue/MarriageDialogueLeah",
      "key": "winter_7",
      "field": null,
      "source": "I'm looking forward to carving ice sculptures tomorrow. I only get to do it once a year, but it's a lot of fun!",
      "translation": "Těším se, až budu zítra vyřezávat ledové sochy. Můžu to dělat jen jednou ročně, ale je to velká zábava!",
      "sourceSHA256": "0f858f8c6388aefb54963e583a88a0b6460b45edf24a0956691616c80b209f61",
      "translationSHA256": "c0b4404ab3e23d9d6245f1cfdb5497f53ab25e868f821664e4071204e4712b5b",
      "reviewChecks": [
        "sourceMeaning",
