    {
      "target": "Characters/Dialogue/MarriageDialogueLeah",
      "key": "summer_9",
      "field": null,
      "source": "Sorry if I'm wet to the touch... I was sweating all night in the heat.",
      "translation": "Promiň, jestli jsem na dotek vlhká... Celou noc jsem se v tom vedru potila.",
      "sourceSHA256": "1cfd08b4e1716de437e95eca06506aa60b277c8ac078fba9e619358e50534e71",
      "translationSHA256": "8608b85d30a010eee82ce12456dc205c4a90e68ad7da7b3c9e5af987b0725f80",
      "reviewChecks": [
