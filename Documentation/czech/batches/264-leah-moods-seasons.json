      "key": "Bad_1",
      "field": null,
      "source": "*sigh*... Maybe we got married too young.$s",
      "translation": "*povzdech*... Možná byla svatba příliš brzy.$s",
      "sourceSHA256": "459c141c8ed4376d4a2ef1afd3189f79a7e42bf88505a9aa3022914c14056bae",
      "translationSHA256": "d6d355e94aad299ec2cc3b83aa98ec524dcdea7cf55f79d07af5663a3b0c2739",
