        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueLeah",
      "key": "fall_2",
      "field": null,
      "source": "I know harvest season is a busy time for you. I'll try and help out as much as I can.",
      "translation": "Vím, že období sklizně je pro tebe rušné. Pokusím se pomáhat, jak jen budu moci.",
      "sourceSHA256": "89730d2115aca9a8c5d01346e19feb0b308ffb13115a304b8d7242753e1b755a",
      "translationSHA256": "e44377ca4309bd08dd2720d9cee79c89461cc9d70c8be4821913ee379ab14e37",
      "reviewChecks": [
