    {
      "target": "Characters/Dialogue/MarriageDialogueLeah",
      "key": "fall_1",
      "field": null,
      "source": "I love fall for the mushroom hunting opportunities. It comes and goes pretty fast.",
      "translation": "Na podzimu miluji všechny příležitosti vyrazit na houby. Přijde a zase docela rychle pomine.",
      "sourceSHA256": "97f02834511b7017eedf78d5df7fab36a838c1c9b5bfa4cbc548af82e821fae4",
      "translationSHA256": "4990a513a4ba31562a07f334430c78e604fb14903fa374682c4ffd3cc5faed51",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
