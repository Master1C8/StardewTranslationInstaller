    {
      "target": "Characters/Dialogue/MarriageDialogueLeah",
      "key": "fall_20",
      "field": null,
      "source": "Have you planned for winter at all? It's good to have a stockpile of hay.",
      "translation": "Máš už aspoň nějaký plán na zimu? Je dobré mít zásobu sena.",
      "sourceSHA256": "9b4b681dc73028a3692d7b84a1cdcc8e746e7bfebe380e61ffc92c43c7d59c82",
      "translationSHA256": "0c3b8760ab13a18348bddcf45fc2956f0852e471045aac8d60e4c6e9cf5a9c94",
      "reviewChecks": [
