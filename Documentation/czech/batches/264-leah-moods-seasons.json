    {
      "target": "Characters/Dialogue/MarriageDialogueLeah",
      "key": "Bad_7",
      "field": null,
      "source": "I used to be your sweetie... now you only seem to put up with me when I make a hot dinner.$s",
      "translation": "Dřív jsem bývala tvoje zlatíčko... teď mě zřejmě snášíš jen tehdy, když připravím teplou večeři.$s",
      "sourceSHA256": "d3a16ff6923e31c6329639546c68543976d4651d2a2c5d28517220f7c6e689ea",
      "translationSHA256": "57059ded2f9d4251cdf1e9a516d514604f8e571653377c455768277c21474348",
      "reviewChecks": [
