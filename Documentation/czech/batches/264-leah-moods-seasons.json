    {
      "target": "Characters/Dialogue/MarriageDialogueLeah",
      "key": "summer_2",
      "field": null,
      "source": "It's summer... that means the house is full of flies.#$e#Don't worry, I'll take care of them.",
      "translation": "Je léto... to znamená, že je dům plný much.#$e#Neboj, postarám se o ně.",
      "sourceSHA256": "6aef18d60efdbf5b0153483ddba51dd71bd0fd9496b93156e5c02f64732d91a7",
      "translationSHA256": "1e223d4dde30eba4b86df108835c5de664f0749548033d25a9ea2f11566f8d67",
