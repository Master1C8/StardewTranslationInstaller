      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueMaru",
      "key": "patio_Maru",
      "field": null,
      "source": "I'm not sure what this is, yet... but it's fun to turn the old wrench now and then.",
      "translation": "Ještě nevím, co z toho vznikne... ale je zábava občas pootočit starým klíčem.",
      "sourceSHA256": "73d5a3a00bbf61f9b9c400fc2cfbda2356ca298f64773d448b634feb7b69c895",
      "translationSHA256": "94bd258f09a8976c2bc674de5d8fe0659d04007f9f2ccd3c63668d3a53c5ec0d",
      "reviewChecks": [
        "sourceMeaning",
