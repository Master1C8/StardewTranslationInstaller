        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueMaru",
      "key": "Rainy_Night_4",
      "field": null,
      "source": "I made some dessert! Make sure to brush your teeth before bed, though. [232 234 223 220]$h",
      "translation": "Připravila jsem dezert! Před spaním si ale nezapomeň vyčistit zuby. [232 234 223 220]$h",
      "sourceSHA256": "cfe931a0a601380c925dfe051648681b145fae89625a5186df8f3ee69b8be9fe",
      "translationSHA256": "dd972375ac55edaa9221e9215dd15c70a836fceab5189c76100b7dc29ca1e8bb",
      "reviewChecks": [
        "sourceMeaning",
