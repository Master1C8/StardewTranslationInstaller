    {
      "target": "Characters/Dialogue/MarriageDialogueMaru",
      "key": "Rainy_Night_1",
      "field": null,
      "source": "Hi @. How was your day... soggy?#$e#This weather gives me gadget ideas... maybe if I funnel the rainwater it could power a mill?",
      "translation": "Ahoj, @. Jaký byl tvůj den... samá voda?#$e#Tohle počasí mi vnuká nápady na různé přístroje... možná by dešťová voda mohla pohánět mlýn, kdybych ji svedla do potrubí?",
      "sourceSHA256": "49736cde6df9b45803c8480a78efc52c2e0035da3a551e7502a4405371c72655",
      "translationSHA256": "6a16c9aa30fc71c6c8366bf1861d79e9262ff5bf468ce6078b4fb2d008938932",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueMaru",
      "key": "Rainy_Night_2",
      "field": null,
      "source": "Dad's been tracking the weather patterns for the last twenty years.#$e#It's a little too early to tell, but the results have revealed some abnormal trends.",
      "translation": "Táta posledních dvacet let sleduje vývoj počasí.#$e#Na závěry je ještě trochu brzy, ale výsledky odhalily určité neobvyklé trendy.",
      "sourceSHA256": "a068e2107a45429a88c772758416adcc5922ea208e4f09149fc63b33d506f42d",
      "translationSHA256": "03bb8fc1ee314a25247a63a21902c43accb3226b85e5d88634c2e5a705dfdd85",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueMaru",
      "key": "Rainy_Night_3",
      "field": null,
      "source": "Can we have spaghetti in bed tonight?",
      "translation": "Dáme si dnes večer špagety v posteli?",
      "sourceSHA256": "916849e758296be719d4c63d1f8386af795b5ad67938d191952192e867e5c06a",
      "translationSHA256": "be31e536526a916fda14c29fd314d6f0a03f279218bc152e1f57f5b988c44613",
      "reviewChecks": [
        "sourceMeaning",
