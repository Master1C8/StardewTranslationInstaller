      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueMaru",
      "key": "Indoor_Night_4",
      "field": null,
      "source": "I'm really starting to love this old house. It's so cozy at night.#$e#Mom's done a great job improving the place.$h",
      "translation": "Tento starý dům si opravdu začínám zamilovávat. V noci je tak útulný.#$e#Máma odvedla při jeho vylepšování skvělou práci.$h",
      "sourceSHA256": "8589dfaf90c393031a8d55946edab7ab21f1ba0474ad95189dcf5d2bfd115704",
      "translationSHA256": "67a99f0058a73a63a4c2faed1bac606ccf72a5fb93134ad5e8fac6c651eea377",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueMaru",
      "key": "Outdoor_0",
      "field": null,
      "source": "Ahh... the farm smells great, it reminds me of the mountains near my parent's house.",
      "translation": "Ach... Farma krásně voní. Připomíná mi hory poblíž domu mých rodičů.",
      "sourceSHA256": "94228413e35904d2036885b4bf4f30b55cd1bcd4743e4691b1d4784ea47299d9",
      "translationSHA256": "b2d125228d61bdfafc2b0e2cc3439ef0b0f6caa6ebe8dbed47ee93dd292cfe60",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
