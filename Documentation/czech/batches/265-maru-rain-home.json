  "glossarySHA256": "cb0b94baf37d83f13a5401acdc21e0c6ef37e2bfd7c91616b1db7ae966dc2161",
  "reviewNote": "Celý balíček byl dříve plně porovnán; po cílené změně znovu ověřeny všechny dotčené řádky s nepřímou otázkou, jejich význam, interpunkce a řídicí tokeny.",
  "rows": [
    {
      "target": "Characters/Dialogue/MarriageDialogueMaru",
      "key": "Rainy_Day_0",
      "field": null,
      "source": "I wonder how Penny is doing? Maybe I'll give her a call later today.",
      "translation": "Zajímalo by mě, jak se Penny daří. Možná jí dnes později zavolám.",
      "sourceSHA256": "f84ae01ddb0d2e4ea5694c2c38058606fac5056077d61f54ecf9f986c966eb2c",
      "translationSHA256": "dd543c347130b303c851c6c31730b803161b71719bbdc1a46cbf8f854c9a2bd7",
      "reviewChecks": [
