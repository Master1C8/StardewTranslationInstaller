      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueMaru",
      "key": "Outdoor_1",
      "field": null,
      "source": "With a little planning, we could automate most of the farm work and just relax!",
      "translation": "S trochou plánování bychom mohli automatizovat většinu práce na farmě a jen odpočívat!",
      "sourceSHA256": "7388c3cbfc07ebca2358a58e086fcc88ca4a7735c5e7ec36605db54a4c9f0769",
      "translationSHA256": "c58e122d7d17ec08092da600bf62e05721e0ff6ee95565fda77df300bbb5e86b",
      "reviewChecks": [
        "sourceMeaning",
