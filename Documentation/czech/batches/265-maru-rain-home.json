    {
      "target": "Characters/Dialogue/MarriageDialogueMaru",
      "key": "Outdoor_2",
      "field": null,
      "source": "It's going to be clear tonight... I wonder if the %noun constellation will be visible?",
      "translation": "Dnes v noci bude jasno... Zajímalo by mě, jestli bude vidět souhvězdí s názvem ‚%noun‘.",
      "sourceSHA256": "88a1dbfe0655abb548e00b2ceca340a2aee1bea4fb5a5aeb46ef50dbc65c61be",
      "translationSHA256": "f9914149af7340a9355d9648ce386ac59e38ec593e49394f8fa5d4d60d0c84ca",
