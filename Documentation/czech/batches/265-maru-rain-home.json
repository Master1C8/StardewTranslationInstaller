    },
    {
      "target": "Characters/Dialogue/MarriageDialogueMaru",
      "key": "Rainy_Day_1",
      "field": null,
      "source": "I was just daydreaming... do you think MARILDA is okay? I hope she finds some place where she truly belongs...",
      "translation": "Zrovna jsem se zasnila... Myslíš, že je MARILDA v pořádku? Doufám, že najde místo, kam bude opravdu patřit...",
      "sourceSHA256": "33a8684ceae242f5b2dcbcfc0c303348d37ca63bd188a183218d18328c10e0be",
      "translationSHA256": "be9d8b6dcbcfec6142a2c34c12b030da065648a71f26b80f1043da8f7f36617d",
      "reviewChecks": [
