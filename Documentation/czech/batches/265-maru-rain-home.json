        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueMaru",
      "key": "Rainy_Day_3",
      "field": null,
      "source": "The only thing I dislike about rain is the fact that I can't do any stargazing!",
      "translation": "Jediné, co mi na dešti vadí, je, že nemohu pozorovat hvězdy!",
      "sourceSHA256": "4161ffac00d9653b1fd9b778455bb8d6f8b6307d9db91b9f910c18b8c81f5281",
      "translationSHA256": "c7ac840e2b536fcb7fe0b9640aeb2bfb1cf64db710b5c69adef500daa89d17ce",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueMaru",
      "key": "Rainy_Day_4",
      "field": null,
      "source": "Do I hear a leak in the roof? I'll have to check it out. I know a thing or two about carpentry from watching my mother.",
      "translation": "Slyším snad kapání ze střechy? Budu se na to muset podívat. Něco o tesařině vím, odkoukala jsem to od mámy.",
      "sourceSHA256": "df54dda9c1039986445a276465ed753df7fe22a0c4aeb943ff94ce6a0815b9d8",
      "translationSHA256": "041fbd9dc451680a37e7eeed6ba8b58940952c6378942d7de332e4352eb210ab",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueMaru",
      "key": "Rainy_Night_0",
      "field": null,
      "source": "Make sure you don't leave your tools out in the rain! You wouldn't want them to get all rusty.",
      "translation": "Dávej pozor, ať nenecháš nástroje na dešti! Nechceš přece, aby úplně zrezivěly.",
      "sourceSHA256": "777ab92930d8f35644103d04e024413f899ca8a607a3715d8802531b62f3d7ca",
      "translationSHA256": "5e4558d3e25a1ac1e6f2e145d3c86d378f502cafadc267686b497017bad2e396",
      "reviewChecks": [
        "sourceMeaning",
