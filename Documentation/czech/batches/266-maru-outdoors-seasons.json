      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueMaru",
      "key": "funLeave_Maru",
      "field": null,
      "source": "I think I'll visit my parents today. I haven't seen them in a while.",
      "translation": "Asi dnes navštívím rodiče. Už jsem je nějakou dobu neviděla.",
      "sourceSHA256": "ad0254e00e272a6872e454900f58b9bc8de75f1b279dd3caa8ecf13e0c4c1a3f",
      "translationSHA256": "b23a29f64fb2b2e93490279f09d2f617a165edd5a1734ed99ce2956c74ec130a",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueMaru",
      "key": "funReturn_Maru",
      "field": null,
      "source": "Mom and Dad are doing just fine. Their routine is still the same, even with me gone. How was your day?",
      "translation": "Máma i táta se mají dobře. Jejich denní režim se nezměnil, přestože už s nimi nebydlím. Jaký byl tvůj den?",
      "sourceSHA256": "ca1660410b467b087b13a46f6e3ed1a7340dbd30517efa88fef06a11b09eadc6",
      "translationSHA256": "46ceb0f299458ce18e82641d0e9529effd29d3b30473651fb2a8ebd49a59b624",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueMaru",
      "key": "spring_2",
      "field": null,
      "source": "So, what's your strategy for optimizing the farm this year?",
      "translation": "Tak jakou strategii letos zvolíš k optimalizaci chodu farmy?",
      "sourceSHA256": "7bc8f356a028c30cf61aba0e6eb48421ba8ceadebda4f3f84d17daf586f0d83a",
      "translationSHA256": "9fc9b77f1aed8d8347c9d32a1d0c99b4e7e2d5c12000805bda65d8cb36cda515",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueMaru",
      "key": "spring_1",
      "field": null,
      "source": "It's wonderful to see all the plants and animals come back to life during the spring.",
      "translation": "Je nádherné sledovat, jak se všechny rostliny a zvířata na jaře vracejí k životu.",
      "sourceSHA256": "05d9ddefc83fcabb985d735e0e5705e201ef2d5c08a4f2ea50a2b018d89dfa8d",
      "translationSHA256": "c58aea44c3b2c4a25b0863628497a8074aeebf5a5a121cc3f848d5e59d4aaa46",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueMaru",
      "key": "spring_22",
      "field": null,
      "source": "If my brother wasn't such a hermit I'd invite him over for dinner sometime.",
      "translation": "Kdyby můj bratr nebyl takový samotář, někdy bych ho pozvala na večeři.",
      "sourceSHA256": "0a30aa361d09694d1f6b789cc1b7fd59642d9fd466f0205f36d4fb77b271d8bc",
      "translationSHA256": "f8b11670c0657d7b10931089827ae7dba37e80866b035eeeb386b104223df27c",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueMaru",
      "key": "summer_20",
      "field": null,
      "source": "I wonder if my brother will ever have the courage to ask Abigail out?",
      "translation": "Zajímalo by mě, jestli můj bratr někdy najde odvahu pozvat Abigail na rande.",
      "sourceSHA256": "6c512b69d53bc6b903fd04c41a1946b8916dc6983e71e4b1ab3f22f99541436a",
      "translationSHA256": "03ac64f7b3ba6a512adf26a5fb0fddb70c96d699c9e8158dfa84449265b3ede0",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueMaru",
      "key": "summer_2",
      "field": null,
      "source": "I like to catalogue the different insects I see in summer.",
      "translation": "Ráda si vedu katalog různých druhů hmyzu, které v létě vídám.",
      "sourceSHA256": "5e2e8f49ad1fd0f455ff74c6885116b9ec0e898a95568e3f2febf4523bc52097",
      "translationSHA256": "7db7935858887afb34afb14f8af0fd3c9f09759b70f61b7b680d76baa85f8b60",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueMaru",
      "key": "fall_1",
      "field": null,
      "source": "With every season, a new section of the night sky becomes prominent. It's fascinating to witness.",
      "translation": "Každé roční období vystoupí do popředí jiná část noční oblohy. Je fascinující to sledovat.",
      "sourceSHA256": "6495de7a31631130ecf4877301adc25d40b7cdd7c556f28cf8d6cee074790f9c",
      "translationSHA256": "67fccf33e6f0f0b689a0df3ba310a54b78c3d9a78011305d9c71edb594b1f125",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueMaru",
      "key": "fall_25",
      "field": null,
      "source": "Winter's just around the corner. We need to double check the heating system, turn off the valves, and check all the insulation in the house.#$e#Don't worry, dear. I'll take care of it all.",
      "translation": "Zima je za rohem. Musíme znovu zkontrolovat topení, uzavřít ventily a prověřit veškerou izolaci v domě.#$e#Neboj se, miláčku. O všechno se postarám.",
      "sourceSHA256": "091d943d228edf6bd588d4589644136b357a87702d94a4663e75eb59722fe62a",
      "translationSHA256": "41a98b630496d2d4f7b90a0def13a4b560413656043959e1a0e8be852cfcfb50",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueMaru",
      "key": "fall_3",
      "field": null,
      "source": "Fall always reminds me of going out woodcutting with my mom... it might be that smell of freshly cut wood and sap.",
      "translation": "Podzim mi vždy připomíná, jak jsem chodila s mámou kácet stromy... možná je to vůní čerstvě řezaného dřeva a mízy.",
      "sourceSHA256": "28295cf34982ce9fc06358cff67f2ab1dc2917bafe2c058b7f0b9b6363af20f2",
      "translationSHA256": "cf27851c35dac6a5fd990090bd458e8e7153f0e7c0f38ded224d7ff65a50da99",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
