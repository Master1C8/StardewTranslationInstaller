      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueMaru",
      "key": "Neutral_8",
      "field": null,
      "source": "I feel uninspired today.$s",
      "translation": "Dnes mi chybí inspirace.$s",
      "sourceSHA256": "4fbe1f1a1f0762bba98f7613f4f43e5dd47f080a8a1f50125f630d5353f69a6f",
      "translationSHA256": "fefe3501884ca9db7680ea4818b2173512749996f383122c0085f908179fb32c",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
