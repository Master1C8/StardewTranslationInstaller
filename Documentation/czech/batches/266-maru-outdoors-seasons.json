      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueMaru",
      "key": "winter_15",
      "field": null,
      "source": "The winters have been disturbingly mild lately.",
      "translation": "Zimy jsou v poslední době znepokojivě mírné.",
      "sourceSHA256": "b5a6ca90a283e8976b8f3682f78db75d333638648ca9b463bb332de465758157",
      "translationSHA256": "abad9a62ad6f9523ce745a5439d14eaed4fe132dc9d00acb287f7b36c550bc83",
