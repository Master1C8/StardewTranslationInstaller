        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueMaru",
      "key": "Outdoor_4",
      "field": null,
      "source": "I never realized the amount of care and planning necessary to run a farm! It's a lot like working in the laboratory.",
      "translation": "Nikdy jsem si neuvědomovala, kolik péče a plánování vyžaduje provoz farmy! Je to dost podobné práci v laboratoři.",
      "sourceSHA256": "cdd8569deb9e32f05dc243d8844d2bbe0e78291fb86e4d49be11cfbc7e1d4d36",
      "translationSHA256": "55fb447b22afa979760897c50d2041b6f63a0f8d7ccfc05ffbd0aa96349afa24",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueMaru",
      "key": "OneKid_0",
      "field": null,
      "source": "Have you spent any time with %kid1 today? Kids need playtime in order reach their full potential.",
      "translation": "Našlo se dnes trochu času na %kid1? Děti si musí hrát, aby mohly plně rozvinout svůj potenciál.",
      "sourceSHA256": "393119b85472720fcd509e88498b67936ba075a9e0a1e2223a3961507c1b008b",
      "translationSHA256": "bffa37721169c0310c85089e7d0aea5271a63c6a258589e224185dfb3a60443f",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueMaru",
      "key": "OneKid_1",
      "field": null,
      "source": "What do you think... will %kid1 grow up to be a farmer? Or an engineer?",
      "translation": "Co myslíš... Bude se %kid1 v dospělosti věnovat farmaření, nebo inženýrství?",
      "sourceSHA256": "a85fd73ca200c25846aacb06f0de0c3cc2876cbcf0c47bfac4a1ee79854f334b",
      "translationSHA256": "bba03dafb4602f9a432d25d9f6cfa053ad02577df1f4a6b57dbd92fd0e70a7d8",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueMaru",
      "key": "OneKid_3",
      "field": null,
      "source": "I have high hopes for our child. I've been reading all the scientific data on the best ways to raise children.",
      "translation": "Vkládám do našeho dítěte velké naděje. Studuji všechny vědecké poznatky o nejlepších způsobech výchovy dětí.",
      "sourceSHA256": "e51ba915fe70667cbc8b26f7f339a70a1fa41e1513c97d079aef36771960e108",
      "translationSHA256": "bc5fb008d68f8bcd2262759c8a5d6b65c848a341473b25aef7bbf34b7688f978",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueMaru",
      "key": "TwoKids_3",
      "field": null,
      "source": "My own workshop, two wonderful kids, and a beautiful plot of land. Life is pretty good.",
      "translation": "Vlastní dílna, dvě úžasné děti a krásný pozemek. Život je moc fajn.",
      "sourceSHA256": "81d4c255aa7e549ac73b11bf9dabd7bd71ba812d7ae132e6de0ce6f8c219c8b6",
      "translationSHA256": "354d8394c83e760aaad7d574c44c6597fa4a175532b1ec22e2aed844cf8955c0",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueMaru",
      "key": "Good_1",
      "field": null,
      "source": "Now that we live together, it's hard to imagine being alone again.",
      "translation": "Teď, když spolu žijeme, si jen těžko dokážu představit, že bych zase byla sama.",
      "sourceSHA256": "59abcb6963d99cd868108cdc916668ca94506200d1c59fdc9fecdc4b7776d93c",
      "translationSHA256": "4fe07e138a645e44cd996c53f16c48be91ac0003816d59bb7970df056aa4923e",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueMaru",
      "key": "Good_2",
      "field": null,
      "source": "Taking a break? That's good!",
      "translation": "Dáváš si přestávku? To je dobře!",
      "sourceSHA256": "5db9e46e4db3d3bf3b1983c3d53d922619247e4136eb09b5a4fb54be756db11e",
      "translationSHA256": "5e343de355dfaff4e8f7d8d196b01c7be77ebdfcefd3a93eeed478db1d1b06cc",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueMaru",
      "key": "Good_3",
      "field": null,
      "source": "There's a lot of strategy to planning and running a farm. It's more intellectually stimulating than I thought!",
      "translation": "Při plánování a provozu farmy je potřeba hodně strategického uvažování. Je to intelektuálně podnětnější, než jsem čekala!",
      "sourceSHA256": "9f40cedbcbe348021fa79120c0116dfdca72262269164c84eb278afd759623f3",
      "translationSHA256": "b27701a04645096660b2f1057729f4beffe53ec199e1e744a6402c11e566effd",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueMaru",
      "key": "Good_4",
      "field": null,
      "source": "For a while there I was considering building a robotic ${husband^wife}$. But you're a lot more fun!$h",
      "translation": "Chvíli jsem uvažovala, že postavím ${robotického manžela^robotickou manželku}$. Ty jsi ale mnohem zábavnější!$h",
      "sourceSHA256": "f4a627d13d026c9bc903e42ca0ec78250e0e556b0f29433fdff27186e0faffc5",
      "translationSHA256": "3fc2ae7bd66ca137e2c55ca1f447e2832e309d4038d69b0e665e5f17ab146431",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueMaru",
      "key": "Good_5",
      "field": null,
      "source": "I was just admiring my wedding amulet... The shell is flawless. This is a very rare specimen!$l",
      "translation": "Právě jsem obdivovala svůj svatební amulet... Mušle je bez jediné vady. Je to velmi vzácný exemplář!$l",
      "sourceSHA256": "01bf88d1c9091bd91ab2bb237d835e6cbacc56339b3334446ca11ba526bf901c",
      "translationSHA256": "b293c5f425e9978cfc3b015ad446870356a749f38beab449999c2325342d3e17",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueMaru",
      "key": "Good_6",
      "field": null,
      "source": "Last night, I had a dream that I was looking through a gigantic telescope. I saw something moving in the %noun nebula. Kind of spooky.",
      "translation": "Včera v noci se mi zdálo, že se dívám obrovským dalekohledem. V mlhovině s názvem ‚%noun‘ jsem spatřila něco v pohybu. Bylo to trochu strašidelné.",
      "sourceSHA256": "c318975a13e37fccde4301f9b4184b42a61f1d9552328a012e70aaed2137fcc0",
      "translationSHA256": "513247258ad348af10cf86b96dab1300f6f441b64e358ad38c5172c9db48052a",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueMaru",
      "key": "Neutral_0",
      "field": null,
      "source": "I hope you'd still like me even if I gained weight.",
      "translation": "Doufám, že mě budeš milovat, i kdybych přibrala.",
      "sourceSHA256": "b7acc68736a032b81895e5938619a0e686a5cfa413e04a9636e4f3122818552e",
      "translationSHA256": "cc30185e8875701123f53e9cdde2eeb631b2dcf15b8ec82055bbd74a38ffdc54",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
