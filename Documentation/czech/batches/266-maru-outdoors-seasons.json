{
  "id": "266-maru-outdoors-seasons",
  "locale": "cs",
  "kind": "long",
  "glossarySHA256": "cb0b94baf37d83f13a5401acdc21e0c6ef37e2bfd7c91616b1db7ae966dc2161",
  "reviewNote": "Celý balíček byl dříve plně porovnán; po cílené změně znovu ověřeny všechny dotčené řádky s nepřímou otázkou, jejich význam, interpunkce a řídicí tokeny.",
  "rows": [
    {
      "target": "Characters/Dialogue/MarriageDialogueMaru",
      "key": "Outdoor_3",
      "field": null,
      "source": "Don't worry, I won't mind if you track mud into the house. It's fun to get a little dirty now and then.",
      "translation": "Neboj, nebude mi vadit, když do domu naneseš bláto. Občas je zábava trochu se ušpinit.",
      "sourceSHA256": "6f0b5f571edb06fca6982f11a534052cf8a4313a662318e80e99730f144c7ee1",
      "translationSHA256": "bf251ad610197d22ff197a2ed28cfaf4972f9e20fd405b9c107456b181b5a2d2",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
