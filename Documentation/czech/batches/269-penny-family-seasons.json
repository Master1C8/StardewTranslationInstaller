    {
      "target": "Characters/Dialogue/MarriageDialoguePenny",
      "key": "spring_15",
      "field": null,
      "source": "Ah, the 'spring cleaning'... I'm actually going to enjoy this.",
      "translation": "Ach, zase ‚jarní úklid‘... Ten si ale opravdu užiju.",
      "sourceSHA256": "07de2e7c3f5da560ae755cfb797067ee48a2c3810a485d0e9d5b4ebb88a3da12",
      "translationSHA256": "fe3af0823e51f40b5bf48afe6b85c6d2623dee0def4f10ccdc370daf8f443d29",
