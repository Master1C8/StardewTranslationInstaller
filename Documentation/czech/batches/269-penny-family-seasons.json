      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialoguePenny",
      "key": "fall_5",
      "field": null,
      "source": "The smell of fall reminds me of the smell of books... weird, isn't it?",
      "translation": "Vůně podzimu mi připomíná vůni knih... zvláštní, že?",
      "sourceSHA256": "a95a157e0158114e3404780f5806c921c57953621d77c4346c30b4cfae0322ff",
      "translationSHA256": "345ba5c702a2d363e417001d0f079994c830d773b99aa567cc3e9798c7ac9538",
      "reviewChecks": [
