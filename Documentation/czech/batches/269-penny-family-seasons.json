    {
      "target": "Characters/Dialogue/MarriageDialoguePenny",
      "key": "spring_8",
      "field": null,
      "source": "Spring is probably my favorite season. There's a certain freshness in the air that fills me with hope.",
      "translation": "Jaro je asi mé nejoblíbenější roční období. Ve vzduchu je zvláštní svěžest, která mě naplňuje nadějí.",
      "sourceSHA256": "c123c76f5a1c90c3d588ea3d5ae6a77351963fae4f167b91be159c1b5b3d69de",
      "translationSHA256": "c78b1223d003d6bbaf9929d15d1e4e613b71b8087d6c603a8832cebcb00077ea",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
