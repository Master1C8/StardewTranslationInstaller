    {
      "target": "Characters/Dialogue/MarriageDialoguePenny",
      "key": "Good_1",
      "field": null,
      "source": "I had dreams of marrying you for such a long time.$l",
      "translation": "Tak dlouho jsem snila o tom, že si tě vezmu.$l",
      "sourceSHA256": "7ca47f57649c0ccc5b3c6be501d1d8370748d2cb0a3e598befff8be7428f46a7",
      "translationSHA256": "b74a469579ae1397d49379491e0981febb4a7f5fe394f2aab2df18af09826bbf",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialoguePenny",
      "key": "Good_2",
      "field": null,
      "source": "I knew you were the one from the moment you moved here...$l",
      "translation": "Od chvíle tvého příchodu sem jsem věděla, že patříme k sobě...$l",
      "sourceSHA256": "466720ff1141e724b915bfe6c464e00e0f1650184399c79c0e951a2dad00b3d9",
      "translationSHA256": "45bebb8a361ab5cb5293d747970ebd614853d0e63f87b0df7fd3992116b33777",
      "reviewChecks": [
