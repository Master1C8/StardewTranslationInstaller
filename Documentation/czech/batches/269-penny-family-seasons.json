    {
      "target": "Characters/Dialogue/MarriageDialoguePenny",
      "key": "Good_4",
      "field": null,
      "source": "This place is really starting to feel like home.$l",
      "translation": "Tady se opravdu začínám cítit jako doma.$l",
      "sourceSHA256": "de2a12f2b6ac230fb3033a08dcf41883c2d6b7ea5f1a1a8b4893a425b6101032",
      "translationSHA256": "086776afcdbb11fbbf9750632a7846a349e024318d0c92762644ffa0acb3593f",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
