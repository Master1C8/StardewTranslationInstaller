    {
      "target": "Characters/Dialogue/MarriageDialoguePenny",
      "key": "funLeave_Penny",
      "field": null,
      "source": "I'm going to head into town today, just for fun. I'll be back in a while!",
      "translation": "Dnes se půjdu jen tak projít do města. Později se vrátím.",
      "sourceSHA256": "a52563bdb7934c49d0cfadf0f0d594ca2fda45e7541fee0e7b88e4c3aa4dd91e",
      "translationSHA256": "3bed89d18cd1fceaa302be64ba5d1ac52e3d5b398aa1ab5fafb300f7bef1f56c",
      "reviewChecks": [
        "sourceMeaning",
