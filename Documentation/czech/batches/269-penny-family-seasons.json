    {
      "target": "Characters/Dialogue/MarriageDialoguePenny",
      "key": "Good_0",
      "field": null,
      "source": "@...I still can't believe we're married...$l",
      "translation": "@... Pořád nemůžu uvěřit, že jsme svoji...$l",
      "sourceSHA256": "a822bc7ef620c3edcf86da42e15067539e5988adf31899888b11b1b22a74f691",
      "translationSHA256": "0ef46c17db8b37b706c98ca0a3d7894ff91eae139b13678c9be5610311011a8b",
      "reviewChecks": [
