    {
      "target": "Characters/Dialogue/MarriageDialoguePenny",
      "key": "Good_6",
      "field": null,
      "source": "Be careful out there! Sometimes I worry that you aren't eating enough wholesome food.",
      "translation": "Venku na sebe dávej pozor! Někdy se bojím, že nejíš dost zdravého jídla.",
      "sourceSHA256": "62d0cc6db60719f5ed24414ad36bd38e5a5584e4697491a98ed131365c3f4e81",
      "translationSHA256": "35ec1be046f74818e31d97acf6b07cb101a4503b0ece1c1ad81bb86c2dd57d61",
      "reviewChecks": [
