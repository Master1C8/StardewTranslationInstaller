    {
      "target": "Characters/Dialogue/MarriageDialoguePenny",
      "key": "funReturn_Penny",
      "field": null,
      "source": "I had a nice time... It's good to stay in contact with everyone. Tell me about your day.",
      "translation": "Dnes jsem se měla hezky. Je příjemné udržovat kontakt se všemi. Pověz mi o svém dni.",
      "sourceSHA256": "df506d40b0ac9fec1c0740ff510958714085678f09e1fa190f11be9af8dcbb71",
      "translationSHA256": "f0ea91d6e55b3be83919a0032f36d0bf46bdba04422b7e8b44487ee0339c8cc8",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
