    {
      "target": "Characters/Dialogue/MarriageDialoguePenny",
      "key": "OneKid_0",
      "field": null,
      "source": "Have you had any time to play with %kid1 today? Maybe a second child will make things better.",
      "translation": "Byl dnes čas na hraní s %kid1? Možná se s druhým dítětem všechno zlepší.",
      "sourceSHA256": "87e5da54f3652723972535efa302be5f7a888b8bc6fd44c844cbf6a5f782397c",
      "translationSHA256": "b73c36b486a0878feee1a95bbf6bde8038ace02c7368e75e9caedf0145461e04",
      "reviewChecks": [
