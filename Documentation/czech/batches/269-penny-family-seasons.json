    {
      "target": "Characters/Dialogue/MarriageDialoguePenny",
      "key": "OneKid_1",
      "field": null,
      "source": "Little %kid1 is going to have such a great childhood here.",
      "translation": "%kid1 tu čeká nádherné dětství.",
      "sourceSHA256": "f4d4a1827a090ab2c552d16b6e2de88b57dd84f7a6086774cfc8204499ef8f53",
      "translationSHA256": "9825d44174c00eb994c6e7cdfbb605e9e5eddcc71b10dc9d72883aeb039de8d2",
      "reviewChecks": [
        "sourceMeaning",
