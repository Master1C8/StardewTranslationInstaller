    {
      "target": "Characters/Dialogue/MarriageDialoguePenny",
      "key": "spring_1",
      "field": null,
      "source": "We've got a long, warm year to look forward to. Let's make it a productive one.",
      "translation": "Čeká nás dlouhý a teplý rok. Postarejme se, aby byl produktivní.",
      "sourceSHA256": "3fbfea2dd17d7c47023b1e35ce088f7105814df2bebcb0858b128874fa810c51",
      "translationSHA256": "9db40e8fcefb55e01fe4a8c142a8b5d0b9a695eeb331d4dabc83937121ad7764",
      "reviewChecks": [
