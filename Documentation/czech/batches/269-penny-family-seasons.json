    {
      "target": "Characters/Dialogue/MarriageDialoguePenny",
      "key": "summer_16",
      "field": null,
      "source": "*phew*... I need to eat more melon to combat this heat!",
      "translation": "*uf*... Abych zvládla tohle vedro, musím jíst víc melounu!",
      "sourceSHA256": "059e4f50459f34cfec1414e4708374f358bccc3907857793fc51297398f836ae",
      "translationSHA256": "7167b3eb72aa049e3f99fbca1add78ca47e109f512f151fb80c9aecd5cee687b",
      "reviewChecks": [
