    {
      "target": "Characters/Dialogue/MarriageDialoguePenny",
      "key": "summer_1",
      "field": null,
      "source": "Summer may be searing hot, but the humidity feels great on the skin.",
      "translation": "Léto je možná úmorně horké, ale vlhkost je na kůži velmi příjemná.",
      "sourceSHA256": "f543fb4d9828b1e666b0b8510bb69d56789369dc7c34c390846264c54971f741",
      "translationSHA256": "f129e75ecaa79530fbf766f6b6a952a8727975ea90ade296cdc3742bd200bc96",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
