      "target": "Characters/Dialogue/MarriageDialogueSebastian",
      "key": "Bad_6",
      "field": null,
      "source": "What do you want? You sound like my step-dad. Go away.$a",
      "translation": "Co chceš? Mluvíš jako můj otčím. Jdi pryč.$a",
