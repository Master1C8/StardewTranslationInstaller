    {
      "target": "Characters/Dialogue/MarriageDialogueSebastian",
      "key": "spring_12",
      "field": null,
      "source": "Are you excited for tomorrow's festival? It'll be good to see Sam again.",
      "translation": "Těšíš se na zítřejší festival? Bude fajn zase vidět Sama.",
      "sourceSHA256": "6c476f851fac893bef167b0857d4b6195916b87e7d9da59cb2111794e4effe65",
      "translationSHA256": "2d37d9fb87f30a97fbf682e908d0e216389cb3bca1e5e550741888440a864af0",
      "reviewChecks": [
        "sourceMeaning",
