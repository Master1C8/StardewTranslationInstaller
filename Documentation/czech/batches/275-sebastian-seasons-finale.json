    {
      "target": "Characters/Dialogue/MarriageDialogueSebastian",
      "key": "funLeave_Sebastian",
      "field": null,
      "source": "I'm going to take a walk today. I need some time to myself. I'll see you in the evening.",
      "translation": "Dnes se půjdu projít. Potřebuji chvíli pro sebe. Uvidíme se večer.",
      "sourceSHA256": "3e2ccca43d51c119d44b75afb98a802ae93e8faab134decacab01ead470f19ff",
      "translationSHA256": "08b1cea6a598d8b1b1affa7178f82264ff4e797e28b2d80f6193c5556e875bae",
