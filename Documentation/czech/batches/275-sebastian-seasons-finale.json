      "sourceSHA256": "e1a3e574b5688a8a03df7e3a34f6dfec4ea443f171014e6b2dc37e6150241382",
      "translationSHA256": "a144f7e367f2264b702ff0b9326f7f5bb0c8f0897411c38893222d92d3591977",
