    {
      "target": "Characters/Dialogue/MarriageDialogueSebastian",
      "key": "Bad_8",
      "field": null,
      "source": "I started smoking again... I've just been really stressed out lately.$s",
      "translation": "Zase jsem začal kouřit... Poslední dobou jsem prostě pod velkým stresem.$s",
      "sourceSHA256": "994cae9094ec5180f467f10610401470a423e1cee493acde053d62a4e636ebc5",
      "translationSHA256": "591d0d97ae29294972bb4aa93c30498f3f9961eff4d6adcd9d6d5e82975235ad",
