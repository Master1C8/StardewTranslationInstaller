    {
      "target": "Characters/Dialogue/MarriageDialogueSebastian",
      "key": "summer_10",
      "field": null,
      "source": "Have you thought about what you're going to put in the luau soup?#$e#I have no idea what's good... you're the chef!$7",
      "translation": "Už víš, co dáš do polévky na Luau?#$e#Já vůbec netuším, co je dobré... Vaření je tvoje parketa!$7",
      "sourceSHA256": "facd1a4a1404319650a18fecfd638fc432d5f4b7a526babe09c9292eaa16a67f",
      "translationSHA256": "92fc4c904c27045d817d65784dd86d3ad3d33dcda881e643baac67dd774043ea",
      "reviewChecks": [
