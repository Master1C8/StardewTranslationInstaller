      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueSebastian",
      "key": "fall_26",
      "field": null,
      "source": "I'm excited for the Spirit's Eve tomorrow. I wonder what horrors we'll find there.$h",
      "translation": "Těším se na zítřejší Předvečer duchů. Zajímalo by mě, jaké hrůzy tam najdeme.$h",
      "sourceSHA256": "6f49bd0a9ff0596ea505fc57918a6d9fde8cc2d90366563f92806eadbb2c1e66",
      "translationSHA256": "446d955ed40e428a795aa7226e05f51e5764290e61195478fd41682f4ffb392a",
      "reviewChecks": [
