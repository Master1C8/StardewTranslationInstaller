    {
      "target": "Characters/Dialogue/MarriageDialogueSebastian",
      "key": "spring_1",
      "field": null,
      "source": "Oohh... my head. Happy new year...$h",
      "translation": "Úúú... moje hlava. Šťastný nový rok...$h",
      "sourceSHA256": "4101907745a2c3113c479eb845a292f5afa9758c964b7d6d2c3000b61e266a49",
      "translationSHA256": "066ac14e28030ca10f75e6d779fe613a535271fdb7001652eb65c9db01d7b180",
      "reviewChecks": [
