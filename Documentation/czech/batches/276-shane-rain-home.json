      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueShane",
      "key": "Rainy_Day_4",
      "field": null,
      "source": "@, should I do something useful today?... or just nap forever?",
      "translation": "@, měl bych dnes udělat něco užitečného?... nebo si prostě zdřímnout na věky?",
      "sourceSHA256": "869456860321a2e56db725924bf701bc730372db79687b0ce7074aab6d922de3",
      "translationSHA256": "330f5695196e5c968545c60c7f9bf809744114d22f583a423c7bd0707ac5cda6",
      "reviewChecks": [
