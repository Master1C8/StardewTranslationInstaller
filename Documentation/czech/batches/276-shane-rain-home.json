    {
      "target": "Characters/Dialogue/MarriageDialogueShane",
      "key": "Rainy_Day_3",
      "field": null,
      "source": "Buhh... I don't feel like being productive today.",
      "translation": "Blé... Dnes se mi nechce dělat nic užitečného.",
      "sourceSHA256": "f10724e31c10c8fa360bbed74e40a83012cfd14509b5545bf0f2c67849434d27",
      "translationSHA256": "0ffc972c77500adc038d99a6e0ae7809486edf2b2c3da5025904ed1626ac9b23",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
