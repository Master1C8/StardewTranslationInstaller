    {
      "target": "Characters/Dialogue/MarriageDialogueShane",
      "key": "Rainy_Day_1",
      "field": null,
      "source": "You know what? I think I've lost some weight since moving in with you.$6",
      "translation": "Víš co? Myslím, že jsem od chvíle, kdy s tebou bydlím, trochu zhubl.$6",
      "sourceSHA256": "885baceb09d53c43235de99bc880fd7d41f260a03ce6cb5dac0c39ad7332338e",
      "translationSHA256": "aa55127eaac07c3ed6a113eab0b5ff4861deb218737c1e9fdd8c4e473945c06c",
      "reviewChecks": [
