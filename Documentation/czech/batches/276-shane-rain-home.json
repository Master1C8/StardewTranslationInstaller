    {
      "target": "Characters/Dialogue/MarriageDialogueShane",
      "key": "Rainy_Day_2",
      "field": null,
      "source": "Here... take this.[346 174 303 305 215]#$e#I bought some of those a while ago and they're almost expired...",
      "translation": "Tady... vezmi si to.[346 174 303 305 215]#$e#Před nějakou dobou jsem jich pár koupil a skoro jim končí trvanlivost...",
      "sourceSHA256": "27a8408dd4da84b395524810d7b56c6e6d30aced0f0e79c834634a9a643f7dd3",
      "translationSHA256": "9e1059ff7d289fdb1f675c119a47cf55be272d9f4996b8dff74c28d5937021ec",
      "reviewChecks": [
