    {
      "target": "Characters/Dialogue/MarriageDialogueShane",
      "key": "Rainy_Day_0",
      "field": null,
      "source": "I hope Jas and Marnie are doing alright without me.#$e#I'm not too worried... Jas is old enough now to take care of the animals on her own.",
      "translation": "Doufám, že to Jas a Marnie beze mě zvládají.#$e#Nemám velké obavy... Jas je už dost stará, aby se o zvířata postarala sama.",
      "sourceSHA256": "ccf0dd631d173bdd4dd8de04f78cc052c527f3028d00d6fd9e3325a520690c14",
      "translationSHA256": "9b2a86f3ad52ac2a995323043944f712c834209b3f79cfa89650b12db55f11fd",
