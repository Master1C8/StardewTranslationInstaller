      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueShane",
      "key": "patio_Shane",
      "field": null,
      "source": "Charlie's doing well.$8",
      "translation": "Charlie se má dobře.$8",
      "sourceSHA256": "842aad0da126f4002a5c86021766bda6fcac8be435ee02a515cdabede7f57576",
      "translationSHA256": "0c4dfd1e4c2b770cbefe8bf221bbafef6246b3137f29fa6b2c394583a17444c4",
      "reviewChecks": [
        "sourceMeaning",
