    {
      "target": "Characters/Dialogue/MarriageDialogueShane",
      "key": "TwoKids_1",
      "field": null,
      "source": "I'll be honest... two kids is enough for me.",
      "translation": "Upřímně... dvě děti mi stačí.",
      "sourceSHA256": "53872669132cee716474ce9384395366160aebd0294330da216628d49854d4aa",
      "translationSHA256": "55689be5c963d976c9ba81ff482753a1c805f3a536be11b39fdfae32463d928d",
      "reviewChecks": [
        "sourceMeaning",
