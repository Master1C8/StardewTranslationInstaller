    {
      "target": "Characters/Dialogue/MarriageDialogueShane",
      "key": "TwoKids_3",
      "field": null,
      "source": "*Sigh*... If only we could send the kids off to Joja work-camp for a season...#$e#I'm just kidding.$h",
      "translation": "*povzdech*... Kéž bychom mohli děti na jednu sezónu poslat do pracovního tábora Joja...#$e#Jen žertuju.$h",
      "sourceSHA256": "4b1314010a0e749e051810806d960dbb1ae01a32b82102ebb5e1b8964158ba25",
      "translationSHA256": "692bb1185a7f6e16816f16d53af8f07699abe087507e55dfaf3fe13f12518814",
