        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueShane",
      "key": "TwoKids_0",
      "field": null,
      "source": "I already fed the kids two bowls of pizza puffs cereal. They'll be full for a while.",
      "translation": "Děti už dostaly dvě misky cereálií s pizzovými křupkami. Chvíli budou syté.",
      "sourceSHA256": "5242f93a42c0489ad802d39982dbc61b481ad58beaccca85e315c356f0229a70",
      "translationSHA256": "9c91c1d98a13de72d74b992f4e42838ec9f415eb98147aa4ff74e20389449949",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
