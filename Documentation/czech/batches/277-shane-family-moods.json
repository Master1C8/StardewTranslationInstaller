    {
      "target": "Characters/Dialogue/MarriageDialogueShane",
      "key": "OneKid_0",
      "field": null,
      "source": "It's weird, when I was younger I swore I'd never have a kid. I wonder what happened to me?$6",
      "translation": "Je to zvláštní. Když jsem byl mladší, přísahal jsem, že nikdy nebudu mít dítě. Co se to se mnou asi stalo?$6",
      "sourceSHA256": "e7f49cb99610f7802d579c47540beb902e0390792393c3215d4daae5e9902e3d",
      "translationSHA256": "0f58a8ffe1c04aca9afb7ca5fd35b00e36934570c7317973ee074d755721bf6b",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueShane",
      "key": "OneKid_1",
      "field": null,
      "source": "Let's make sure to give %kid1 lots of eggs... Baby's gotta grow those legs!",
      "translation": "Dávejme %kid1 hodně vajec... Dítěti musí pořádně narůst nohy!",
      "sourceSHA256": "3e497dad58ed7630ad7343855ef5a1482d96fc12f7a4a0c5a32b23dde6d93a3b",
      "translationSHA256": "642b9a8ec77f86f5cfcb461f1478ef02a926cd105ed3bfce7cf97f411877bef9",
      "reviewChecks": [
        "sourceMeaning",
