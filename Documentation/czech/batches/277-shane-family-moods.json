        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueShane",
      "key": "TwoKids_2",
      "field": null,
      "source": "Ugh... %kid2 is being a little brat today. Must've gotten that from me...",
      "translation": "Uch... %kid2 se dnes chová jako spratek. To musí mít po mně...",
      "sourceSHA256": "ffc49ed2fd8570f829544a9fb02721fee5fe108eb5ce8c7b45688d902cc0619c",
      "translationSHA256": "df5df4f1cc19e78ff9c33a50e74a50299f592ec625f20bed097d448df6163de1",
      "reviewChecks": [
        "sourceMeaning",
