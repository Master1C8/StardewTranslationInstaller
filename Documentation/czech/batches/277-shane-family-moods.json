      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueShane",
      "key": "OneKid_3",
      "field": null,
      "source": "Papa Shane reporting for duty...$6#$e#Buh... I've become corny in my old age.",
      "translation": "Táta Shane hlásí nástup do služby...$6#$e#Blé... S věkem mám čím dál trapnější hlášky.",
      "sourceSHA256": "60a439a8722eb98aa348773916f2e93a349cd0e1c8b955377669eabfdd2300cc",
      "translationSHA256": "e00b03fbda83415174900bb1ef6c71155110bc69ec8e7ed2cc7b8134946e7d77",
      "reviewChecks": [
        "sourceMeaning",
