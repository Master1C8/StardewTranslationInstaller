    {
      "target": "Characters/Dialogue/MarriageDialogueShane",
      "key": "Good_0",
      "field": null,
      "source": "*Sniff*... *sniff*... mmm... what's that wonderful fragrance you're wearing? Eau de pepperoni?$6",
      "translation": "*čmuch*... *čmuch*... mmm... copak to máš za nádhernou vůni? Eau de pepperoni?$6",
      "sourceSHA256": "14281227c6a99966104b7833e82cacbabbb7f6b199342af9deb6feaae4b27dd3",
      "translationSHA256": "e9a69732ac6a6ebbfc657c51fc404b3cecd1e89e5a83258dbcefa5811ddcf6dd",
      "reviewChecks": [
        "sourceMeaning",
