      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueShane",
      "key": "Neutral_8",
      "field": null,
      "source": "Ugh... clean, clean, clean. Sweep, sweep, sweep. Bathe. Cook. Make the bed... Oh, well. Life's alright.",
      "translation": "Uch... uklízet, uklízet, uklízet. Zametat, zametat, zametat. Vykoupat se. Vařit. Ustlat postel... No nic. Život je v pohodě.",
      "sourceSHA256": "d1a92585c70a299448126eae13e82b2f69ba30c3012f2f12fd57c6d85db13a43",
      "translationSHA256": "e6edb2f80841463456a514555623a3f461e78bfcfbec3e3b3b35e097b6fb41c1",
      "reviewChecks": [
        "sourceMeaning",
