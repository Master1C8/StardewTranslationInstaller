    {
      "target": "Characters/Dialogue/MarriageDialogueShane",
      "key": "Bad_5",
      "field": null,
      "source": "Look, I just want to be alone. Why don't you go outside and do your own thing for a while?",
      "translation": "Poslyš, chci být prostě sám. Nechceš jít na chvíli ven a věnovat se něčemu svému?",
      "sourceSHA256": "1bad87edd0d372a170eb5896522963499b6eb27b43965cc71bb4353d04778d78",
      "translationSHA256": "217c8787770b321930f35f4f47aec8c57f35e2c359e582c332b00d78346f7161",
