      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueShane",
      "key": "Good_1",
      "field": null,
      "source": "You're a lot better-looking than me, you know that?$h",
      "translation": "Víš, že vypadáš mnohem lépe než já?$h",
      "sourceSHA256": "ea350a908e375688ab02e994affc85ae1ded5e0f5533a11d53252f9a402aa66b",
      "translationSHA256": "4d06fc3406043d31d58f9a0949659ee1db87352db2fd02da856a81e98e2dbada",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueShane",
      "key": "Good_2",
      "field": null,
      "source": "The name 'Shane' means 'Gift from Yoba'... What a joke.",
      "translation": "Jméno ‚Shane‘ znamená ‚Dar od Yoby‘... To je ale vtip.",
      "sourceSHA256": "3ab29166ef81b2c9f92b72a0512172cd08de5efd49ab108dab3a258f5e2b2362",
      "translationSHA256": "1d57ea40acc812f313810d0f4710759cb5776fc40d0a66ed5b7a23e140214321",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueShane",
      "key": "Good_3",
      "field": null,
      "source": "I'm in a great mood today... The Tunnelers won big last night.$h",
      "translation": "Dnes mám skvělou náladu... Tunnelers včera večer drtivě vyhráli.$h",
      "sourceSHA256": "001def27cea6df7b8a2329b684382564f0d8a30c7c0a7d0b84bf92a9c5e31139",
      "translationSHA256": "40c50d6bfb90ba0eac5a18f825622ac0a5db116cc1b92102f832fce85e406a3d",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueShane",
      "key": "Good_4",
      "field": null,
      "source": "Hey, if I ever seem cranky, just ignore it. I get in weird moods sometimes, but it's not about you... okay?",
      "translation": "Hej, když občas působím mrzutě, nevšímej si toho. Někdy mívám divné nálady, ale s tebou to nemá nic společného... dobře?",
      "sourceSHA256": "1912023f82b696fa377953a7661549dc0725b9884eaa101fcd70bd19eaf236d4",
      "translationSHA256": "3b8abe9ce7635ec4a228bfde45291160aba6d3233db443d73513b6b370796812",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueShane",
      "key": "Good_5",
      "field": null,
      "source": "Ah... life on the farm sure beats working at Joja. That place was disgusting.$h#$e#You think it was depressing out front? Kid, you should've seen the back room...",
      "translation": "Ach... Život na farmě je mnohem lepší než práce v JojaMartu. Bylo to tam příšerné.$h#$e#Prodejna ti připadala hrozná? Zázemí bylo ještě horší...",
      "sourceSHA256": "efbcdd4e7c21c22515f5862928841c8561aafce66d96b395a9008cdcee2b9dd4",
      "translationSHA256": "b365b928ac46cc737a3b703e1cf7b8ca32f758d9a1a57cc0b7a73335993ba39a",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueShane",
      "key": "Good_6",
      "field": null,
      "source": "Ah... this is the life. No responsibilities, Tunnelers game tonight, fridge stocked with all the goodies a guy could need.$h",
      "translation": "Ach... to je život. Žádné povinnosti, dnes večer hrají Tunnelers a lednice je plná všech dobrot, které chlap potřebuje.$h",
      "sourceSHA256": "fbb04637402e38fbef15f8370f8710870d15c9bf1d9f41f78d9868b0fc6f8225",
      "translationSHA256": "1f4ee4a98518879a6e0c563ca7053e5765477b1b77d41c16803c49d88808046f",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueShane",
      "key": "Good_8",
      "field": null,
      "source": "I don't really feel like doing work today. Maybe I'll see what's on TV.",
      "translation": "Dnes se mi do práce opravdu nechce. Možná se podívám, co dávají v televizi.",
      "sourceSHA256": "23a8e7507428dd16ccf33033a988eaf6b054da27900cf5639f48e256b13b2077",
      "translationSHA256": "cb3822689339172ad84cce21ff67b15f7a5e139588b3b9385c15cbbc2a1ad9cf",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueShane",
      "key": "Good_9",
      "field": null,
      "source": "Huh... You're wondering why I have this goofy grin on my face? You really have a short memory span, don't you? *blush*$h",
      "translation": "Hmm... Ptáš se, proč mám ve tváři tenhle přihlouplý úsměv? Máš opravdu krátkou paměť, co? *zardí se*$h",
      "sourceSHA256": "e70c4135c471f90c4e3a72b4f8043f4649ca486325ff0fc5f714a07d90a7d8fc",
      "translationSHA256": "4e171f41803a023ad5c58e1beea5e395bc09b851f5088d4889bb6fab8067c200",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueShane",
      "key": "Neutral_0",
      "field": null,
      "source": "Oh, do you need something from me? Sorry, I'm kind of busy at the moment.",
      "translation": "Ach, něco ode mě potřebuješ? Promiň, teď mám docela práci.",
      "sourceSHA256": "f6f5874d829a26fef7d7f4b9555cf90929f76bccda4528178da17cd21c8f988e",
      "translationSHA256": "25091a8a3ec87be29b2adef6e9d505742ff6eb760a76c67f283be810809af9f2",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueShane",
      "key": "Neutral_2",
      "field": null,
      "source": "Why don't you tell me about your day when we're in bed tonight? I'm kind of busy right now...",
      "translation": "Neřekneš mi o svém dni, až budeme večer v posteli? Teď mám docela práci...",
      "sourceSHA256": "29f3efc2263ad19873bc0784ab648f929f38026f08423a93ffb273d11123be99",
      "translationSHA256": "3a623b6f3d6ea4faadc2a2602bc7fc0c08bfebee36fe61a1abd928103959c4ca",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueShane",
      "key": "Neutral_3",
      "field": null,
      "source": "Working at Joja was a drag, but at least I got to interact with people occasionally.",
      "translation": "Pracovat pro Joja bylo otravné, ale aspoň jsem občas přišel do styku s lidmi.",
      "sourceSHA256": "f9b8dec2251147e9a105b138e9c2acca8b748749c3f66206c731c2cb4da508bf",
      "translationSHA256": "0e927296c19d9df9b1dbc1741dabd5dce8df23ec516aa3e85ace01d41509da71",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueShane",
      "key": "Neutral_4",
      "field": null,
      "source": "What, you want me to clean the dishes? I'll do it... eventually...",
      "translation": "Cože, chceš, abych umyl nádobí? Udělám to... někdy...",
      "sourceSHA256": "0f97dde054e87f098d92612fb73db69802f1e158f80aa605cf6fdf17171256df",
      "translationSHA256": "8f4c32db9b61e07d29e1275079293e801531c8d956afe6c877c3bf252cf5bc1b",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueShane",
      "key": "Neutral_5",
      "field": null,
      "source": "Are we doing okay on money? I don't want to have to go back to work at Joja.",
      "translation": "Jsme na tom s penězi dobře? Nechci se muset vrátit do práce v JojaMartu.",
      "sourceSHA256": "b462bcbd2d697aef650d578be637a3434ebff653b9a4c35904ab9d31003a61dc",
      "translationSHA256": "f18c3e093a193ca8e493ef6432863fe847d6b7c6e416bfb3922ac23fc519771a",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueShane",
      "key": "Neutral_6",
      "field": null,
      "source": "If you need to go see your friends in town, go ahead. I'm happy in the company of the TV and a couple of tall boys.",
      "translation": "Jestli potřebuješ jít za přáteli do města, klidně běž. Mně stačí společnost televize a pár velkých piv.",
      "sourceSHA256": "f5ba15b751c383d177126923c78ace31d34315606a251c62f9d6def6d5c40e09",
      "translationSHA256": "7f36551b48084ba3b53f16920780f06be3269d7a4f6f936ff15f910e7f4f0cc8",
      "reviewChecks": [
        "sourceMeaning",
