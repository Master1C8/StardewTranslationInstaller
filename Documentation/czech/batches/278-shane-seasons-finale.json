      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueShane",
      "key": "winter_28",
      "field": null,
      "source": "Well, another year gone by... I look a little older, but that's about all.$6",
      "translation": "Tak, další rok je pryč... Vypadám trochu starší, ale to je asi všechno.$6",
      "sourceSHA256": "0d9d4d6e437122e7fb840d4c3525ac1f9538b5d8c1db1444f431bb8524113849",
      "translationSHA256": "bea7450ede82d3996ee3add154515889a922a741bf8f5ecae181ab1dbb234815",
