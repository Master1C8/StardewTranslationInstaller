    {
      "target": "Characters/Dialogue/MarriageDialogueShane",
      "key": "Bad_7",
      "field": null,
      "source": "Farm-life is actually really boring. What am I doing here?$s",
      "translation": "Život na farmě je vlastně opravdu nudný. Co tu dělám?$s",
