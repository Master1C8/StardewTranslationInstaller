      "sourceSHA256": "7d02c9587932b25b8ef298830461dcedc62058dd8d8d8a58501b3ca90eb9ff35",
      "translationSHA256": "75dc21755ae1583217e63a0048bdbf36163c1d57a139693e7f1d3476695864c4",
