    {
      "target": "Characters/Dialogue/MarriageDialogueShane",
      "key": "fall_15",
      "field": null,
      "source": "I'll be helping Marnie with the animals at tomorrow's fair, like usual. You should just kick back and have some fun.$6",
      "translation": "Na zítřejším Jarmarku údolí Stardew budu jako obvykle pomáhat Marnie se zvířaty. Ty si prostě odpočiň a bav se.$6",
      "sourceSHA256": "f075640d2fc3d92f12f861b82ac324fddb7e07a86818f9e02fccba253bf9a8a7",
      "translationSHA256": "f99799e4aebe265734b0f73d7fecae1df24aa628d630b6eaace0ee866da4d183",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
