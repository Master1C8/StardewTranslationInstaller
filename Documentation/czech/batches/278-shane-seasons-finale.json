    {
      "target": "Characters/Dialogue/MarriageDialogueShane",
      "key": "spring_12",
      "field": null,
      "source": "The egg festival is probably my favorite... you know how I am, I go crazy for anything to do with chickens.$h",
      "translation": "Slavnost vajec je asi moje nejoblíbenější... Víš, jaký jsem. Ze všeho, co má něco společného se slepicemi, úplně šílím.$h",
      "sourceSHA256": "482bd0b39344da86ad0ffa166d1d970144e15a4358ccfc5e7b5aa1431d93de14",
      "translationSHA256": "a5aaaafc9d5d2c66ed2e0d39cf6c50f4273f5e85a6705e32527f4d352b8b57fa",
      "reviewChecks": [
        "sourceMeaning",
