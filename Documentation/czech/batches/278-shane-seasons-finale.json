    {
      "target": "Characters/Dialogue/MarriageDialogueShane",
      "key": "spring_23",
      "field": null,
      "source": "Oh, right. It's the flower dance tomorrow. Hey, if it makes you happy, I'm happy.",
      "translation": "Ach, jasně. Zítra je Květinový tanec. Hele, když to dělá radost tobě, mám radost i já.",
      "sourceSHA256": "6ed305d0496b5e079b590711135e87679ac8a43f161e53d8124b80374960725d",
      "translationSHA256": "c6efe7bca658647508bdca849e23058a956ff18064559c1c28d9b6caf2bc8acb",
      "reviewChecks": [
        "sourceMeaning",
