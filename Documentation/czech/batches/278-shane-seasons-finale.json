        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueShane",
      "key": "fall_17",
      "field": null,
      "source": "I'm starting to really feel my age... and I'm not comfortable with that at all.",
      "translation": "Začínám opravdu cítit svůj věk... a vůbec se mi to nelíbí.",
      "sourceSHA256": "0e89e10676c1256277e27bc46a7bdb5b4c04391297894d70d9067849304dd5e4",
      "translationSHA256": "d9a6e82ce0b5b46621f9ec93b26e64d676809028ce2cd93af427684475e7b79d",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/MarriageDialogueShane",
      "key": "winter_1",
      "field": null,
      "source": "Any big plans this winter? I'll probably end up watching a lot of TV and just hanging out around the house.",
      "translation": "Máš na zimu nějaké velké plány? Nejspíš budu hodně sledovat televizi a poflakovat se po domě.",
      "sourceSHA256": "7e740efe088fce83ff1eb1050d39c9d314b77fba7d72d274e3ec6ab85fa59488",
      "translationSHA256": "96e523ac9480b79ae90f6d521a481c8468ef787500188a0527275cc95e5ec597",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
