    {
      "target": "Characters/Dialogue/MarriageDialogueShane",
      "key": "Bad_8",
      "field": null,
      "source": "Yeah... *hic* ... Sure, honey. Whatever you say... *hic*",
      "translation": "Jo... *škyt*... Jistě, zlato. Cokoli řekneš... *škyt*",
