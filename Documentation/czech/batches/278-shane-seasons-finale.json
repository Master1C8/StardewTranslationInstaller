    {
      "target": "Characters/Dialogue/MarriageDialogueShane",
      "key": "spring_1",
      "field": null,
      "source": "Ooo... my throbbing head. How many did I have last night?",
      "translation": "Úúú... hlava mi třeští. Kolik jsem jich včera večer vypil?",
      "sourceSHA256": "f04c89030ac901438401980c436922efcc6b7f7a472d633d97529190d08554e8",
      "translationSHA256": "d4b274d41bd00d22e822c47d27eb73a4bfabeaea41d4571eb379c06531127b87",
      "reviewChecks": [
