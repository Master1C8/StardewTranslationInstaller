    {
      "target": "Characters/Dialogue/Maru",
      "key": "Thu_01_01",
      "field": null,
      "source": "You don't think I could do it?$s",
      "translation": "Myslíš, že bych to nedokázala?$s",
      "sourceSHA256": "e02763367799be53db1c0c11b29931a5548a6087c3499cae0102465251d800b0",
      "translationSHA256": "50233f66c44e57919676a15dcede4bc73400eba0c8a9a6678b5d646c85a54dff",
      "reviewChecks": [
        "sourceMeaning",
