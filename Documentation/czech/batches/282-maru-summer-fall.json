    {
      "target": "Characters/Dialogue/Maru",
      "key": "Thu_0",
      "field": null,
      "source": "Really? Are you sure you're not just trying to flatter me?",
      "translation": "Opravdu? Určitě se mi nesnažíš jen lichotit?",
      "sourceSHA256": "f68ae01630aba9683531c18f4131d0d0758a67ca89cea0706a870aeb1da1fda0",
      "translationSHA256": "8eece8cbfbc6f877dbcef7a40eca0932d10cd0f954b00986aea1996fbefa622d",
      "reviewChecks": [
