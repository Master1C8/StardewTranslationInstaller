    {
      "target": "Characters/Dialogue/Maru",
      "key": "fall_Mon8",
      "field": null,
      "source": "You should come visit me at the clinic tomorrow. I work from 10 a.m. to 4 p.m.$h",
      "translation": "Zítra se za mnou stav na klinice. Pracuji od 10:00 do 16:00.$h",
      "sourceSHA256": "84ea5179b9179959173b9022bf1e06b151568deac6fdec4161340a26f88db802",
      "translationSHA256": "4dbc6033fc10f6032dc842a606256a1a7a151e751792548349701035ae904a6f",
