    {
      "target": "Characters/Dialogue/Maru",
      "key": "Thu_01_02",
      "field": null,
      "source": "You're right, but I love a challenge!$h",
      "translation": "Máš pravdu, ale výzvy miluji!$h",
      "sourceSHA256": "fda7db01c031981ea28a9152c1d02b71eb2d2f606012f34c557947653ae39b4f",
      "translationSHA256": "7360f88f32c25f25c8ce369f82a48c521f36ee24302be92b9856990409ba58d8",
      "reviewChecks": [
        "sourceMeaning",
