    },
    {
      "target": "Characters/Dialogue/Maru",
      "key": "summer_Thu10",
      "field": null,
      "source": "How do your hands stay so soft with all that farm work?",
      "translation": "Jak to, že máš při vší té práci na farmě tak hebké ruce?",
      "sourceSHA256": "04436814269f06628143e6f5d6d7cdc21d5fcc63886f4833860296d80753ff9d",
      "translationSHA256": "04c418606e202bd3b1c8fd27cee7bf0474f21c9e3314688df851cf819ed112c9",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
