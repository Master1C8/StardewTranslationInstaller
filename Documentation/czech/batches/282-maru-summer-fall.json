    {
      "target": "Characters/Dialogue/Maru",
      "key": "fall_Thu10",
      "field": null,
      "source": "You have a leaf in your hair. Let me get it for you.#$e#...$h",
      "translation": "Máš ve vlasech list. Ukaž, vyndám ti ho.#$e#...$h",
      "sourceSHA256": "8ef1cefdf38da33fcde31125b1d1ebb70c4002312cbe8c9578394d19a1fddb03",
      "translationSHA256": "7c89825b4782dddc165a068c26623cfd85e508b1230e478d691b55520bef80ca",
