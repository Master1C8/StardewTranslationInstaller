    {
      "target": "Characters/Dialogue/Maru",
      "key": "fall_Wed4",
      "field": null,
      "source": "If you have any extra metal laying around, I could always use it for one of my projects.#$e#But only if you don't need it yourself.",
      "translation": "Pokud se ti někde válí přebytečný kov, vždycky ho můžu využít na některý ze svých projektů.#$e#Ale jen pokud pro něj nemáš vlastní využití.",
      "sourceSHA256": "a63e4f9824a4670236e7512f8992b809bc5eda5b265e0d80a53249da80d9621b",
      "translationSHA256": "18b264616b66ae15abd349ed0ca3f31e8d23b3d0dc7060c0565b171e767f4883",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/Maru",
      "key": "fall_Fri6",
      "field": null,
      "source": "I've been feeling especially optimistic lately...$h",
      "translation": "Poslední dobou jsem obzvlášť optimistická...$h",
      "sourceSHA256": "5506328afab5c4f5591f20fb5e9157ee4c928f2d5ad78b52433874df5b8b248e",
      "translationSHA256": "105c8c415e7e55ef2cf4229197a890a3869f405ed0d7f8e8e178a5da2db7cfae",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
