    {
      "target": "Characters/Dialogue/Maru",
      "key": "winter_Thu",
      "field": null,
      "source": "Hey! What's up?#$e#It's a good time to explore the caves.#$e#I would go but my Dad would flip.",
      "translation": "Hej! Jak se vede?#$e#Je vhodná doba na průzkum jeskyní.#$e#Šla bych tam, ale táta by se zbláznil.",
      "sourceSHA256": "7b2735090724c5bbf2529d862fe3e4dff4686e722b87f3686122692fce1f3a52",
      "translationSHA256": "72a78ec86291ecccadb6e8822e9b9235d59235a94c4b9510640854625486d8e4",
      "reviewChecks": [
