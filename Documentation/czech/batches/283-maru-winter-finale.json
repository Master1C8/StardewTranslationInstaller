    {
      "target": "Characters/Dialogue/Maru",
      "key": "winter_Tue",
      "field": null,
      "source": "My hair gets so frizzy in this dry weather. *sigh*",
      "translation": "V tomhle suchém počasí se mi vlasy hrozně krepatí. *povzdechne si*",
