    {
      "target": "Characters/Dialogue/Maru",
      "key": "winter_Sat2",
      "field": null,
      "source": "Hey, if any of your farming machines need to be fixed, just let me know.$h",
      "translation": "Hej, pokud bude potřeba opravit některý z tvých strojů na farmě, stačí mi říct.$h",
      "sourceSHA256": "14fe101cfc2c591227837c39c4c2fd3670f176d3b951a340621eddc9ca517633",
