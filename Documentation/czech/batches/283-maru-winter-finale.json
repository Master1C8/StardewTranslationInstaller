    {
      "target": "Characters/Dialogue/Maru",
      "key": "winter_Sat",
      "field": null,
      "source": "Have you built a furnace yet?#$e#You can use them to turn raw material like ores into more useful products.$u",
      "translation": "Máš už postavenou pec?#$e#Můžeš v ní přeměnit suroviny, například rudu, na užitečnější výrobky.$u",
      "sourceSHA256": "6b175a836da6085fd8f8b42d626537c42f0b1ebee5a2a63c680d72a4664ed247",
      "translationSHA256": "df64424d190e356f87e3801d4a5bb5d643b38ce42b88c29264d1ee0e0ac372e8",
      "reviewChecks": [
