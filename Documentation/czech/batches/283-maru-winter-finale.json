    {
      "target": "Characters/Dialogue/Maru",
      "key": "winter_Wed",
      "field": null,
      "source": "I guess winter is a good time to work on my gadgets.#$e#I wonder if I could make anything useful for farmers?",
      "translation": "Zima je asi vhodná doba věnovat se svým přístrojům.#$e#Zajímalo by mě, jestli bych dokázala vyrobit něco užitečného pro farmáře.",
      "sourceSHA256": "050f1968f80be0b9223b89871a3a1f54bfe8fb2b4be91665d497e0742c31820a",
      "translationSHA256": "00bec240a535451ec1455dcbdb218deeb8f3255f49dd3a098d816c6fd4aabfb5",
      "reviewChecks": [
