    {
      "target": "Characters/Dialogue/Maru",
      "key": "winter_Fri",
      "field": null,
      "source": "I hope I don't catch the flu this year.",
      "translation": "Doufám, že letos nedostanu chřipku.",
      "sourceSHA256": "b401b7b121f726caf650da399759eb588d62acec77a718e6fbaa2e7dcd64df42",
      "translationSHA256": "a5671f824b13561f14f11075a18018fc39968a10b2ea534cf47ac609e9a25269",
      "reviewChecks": [
        "sourceMeaning",
