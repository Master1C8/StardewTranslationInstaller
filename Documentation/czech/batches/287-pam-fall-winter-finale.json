  "glossarySHA256": "cb0b94baf37d83f13a5401acdc21e0c6ef37e2bfd7c91616b1db7ae966dc2161",
  "reviewNote": "Full 21-row English/Czech reread completed after player-neutral yard and loitering rewrites; Pam voice, explicit gender branch, seasonal meaning, and dialogue controls checked with no remaining issue found.",
  "rows": [
    {
      "target": "Characters/Dialogue/Pam",
      "key": "summer_Thu4",
      "field": null,
      "source": "I always seem to end up at the saloon at some point.#$e#It's too close to my house. It ain't healthy.",
      "translation": "Dřív nebo později vždycky skončím v saloonu.#$e#Je moc blízko mého domu. Není to zdravé.",
      "sourceSHA256": "e407dbec0b8957b393c681b88b9de8d43c1c3ce612e8aaa1708bf285e2679bed",
      "translationSHA256": "a33db901a4e83ce55189bb060c115e2bbaa3be3d765ff121ed56407807902618",
      "reviewChecks": [
