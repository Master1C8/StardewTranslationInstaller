    {
      "target": "Characters/Dialogue/Penny",
      "key": "summer_Mon4",
      "field": null,
      "source": "$d cc#Thanks for fixing the community center back up. I guess you're kind of a town hero.|Hello, @. It's nice to see you're doing well.",
      "translation": "$d cc#Děkuji za opravu Komunitního centra. Teď tě asi obdivuje celé město.|Ahoj, @. Ráda vidím, že se ti daří dobře.",
      "sourceSHA256": "bcfa3f4843ccca91ba12ce58c2fed5cd0a737914a0b7a744280547902e5846c4",
      "translationSHA256": "fe7a11834ad192498100970e6914221898c6cf0ca1460cbcb05aef07afedad45",
