    {
      "target": "Characters/Dialogue/Penny",
      "key": "fall_Tue4",
      "field": null,
      "source": "Your farm looks really pretty right now.$h",
      "translation": "Tvá farma teď vypadá opravdu krásně.$h",
      "sourceSHA256": "4f1dfc4c02e5756fb17d6f767af8bc55a304ba84c64ef26e32ed51b10371a320",
      "translationSHA256": "6289d2a8e159196f619d4d9a2be3591408bc781cc60425e21854de4c5d53a5a1",
      "reviewChecks": [
