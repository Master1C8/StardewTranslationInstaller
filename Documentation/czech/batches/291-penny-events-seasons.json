    {
      "target": "Characters/Dialogue/Penny",
      "key": "fall_Thu6",
      "field": null,
      "source": "Mom doesn't take very good care of herself...$u#$e#I worry about her.$u",
      "translation": "Máma se o sebe moc dobře nestará...$u#$e#Mám o ni starost.$u",
      "sourceSHA256": "4f42d2c70aab943d640613d894c7d460d409059f77f14497ff4cc4c64181ca9e",
      "translationSHA256": "03db10a48018076e6790f2e2a1f63c94bf54af46b1e2104c78431b4cae3bab69",
      "reviewChecks": [
