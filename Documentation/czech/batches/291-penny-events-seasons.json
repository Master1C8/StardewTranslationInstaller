    {
      "target": "Characters/Dialogue/Penny",
      "key": "fall_Fri",
      "field": null,
      "source": "Fall is a sad time of year for me...$s",
      "translation": "Podzim je pro mě smutné období...$s",
      "sourceSHA256": "55d886d0f021a66d3c0b635a4cb441d1929bb5080375054a5adba92d1436462d",
      "translationSHA256": "6b0824dd94299166a5508cb8882361daa4cde681a3218970556017f2fa3f3e97",
      "reviewChecks": [
        "sourceMeaning",
