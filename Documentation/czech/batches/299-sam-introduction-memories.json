    {
      "target": "Characters/Dialogue/Sam",
      "key": "eventSeen_45_memory_oneweek",
      "field": null,
      "source": "Wouldn't it be cool if the town had a skate park, though?#$b#Now, how to convince Mayor Lewis...$s",
      "translation": "Nebylo by ale skvělé, kdyby mělo město skatepark?#$b#Teď jen přijít na to, jak přesvědčit starostu Lewise...$s",
      "sourceSHA256": "31d1c2e44d4bb597578b9e4c1cf3a281daa40d875a31297526e163d5efb3e282",
      "translationSHA256": "165b2b3aa9d68692ca1fd6069c4cde934db9b12bdc939cbfaffe5f5ffa6f1e11",
