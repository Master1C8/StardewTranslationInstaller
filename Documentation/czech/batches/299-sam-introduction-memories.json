      "target": "Characters/Dialogue/Sam",
      "key": "AcceptBirthdayGift_Negative",
      "field": null,
      "source": "Hey, hey, hey! You rememb--$h#$b#...*sniff*...*sniff*... what's that gnarly smell...?$8#$b#...Oh.$5",
