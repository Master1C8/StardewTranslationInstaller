    {
      "target": "Characters/Dialogue/Sam",
      "key": "eventSeen_45",
      "field": null,
      "source": "I better lay low for a while. I wouldn't want to get on Mayor Lewis' bad side!",
      "translation": "Radši se nějakou dobu nebudu ukazovat. Nechci si starostu Lewise znepřátelit!",
      "sourceSHA256": "bc50fbd018d83ce8725e1990e5b9467a537c8bb34ee5c5537f05fe34d4679b84",
      "translationSHA256": "26e762a5691d9da277a57c903df3cad90ef1889d1ec55bfa09a10f0ca76e7496",
