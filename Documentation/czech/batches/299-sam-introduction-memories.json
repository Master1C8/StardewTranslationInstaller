    {
      "target": "Characters/Dialogue/Sam",
      "key": "dating_Sebastian",
      "field": null,
      "source": "I heard you and Sebastian are going out... he better still be coming to band practice every week!",
      "translation": "Slyšel jsem, že spolu se Sebastianem chodíte... Radši ať ale dál každý týden chodí na zkoušku kapely!",
      "sourceSHA256": "31857f2f493521ec96b4d48404270b579e6a3973cfd3e07cfea6dd9e3935cf7a",
      "translationSHA256": "ad358ede95c6b80af5dca3689ffb132e64b6af0bb3103b9fde8d4527c079440d",
