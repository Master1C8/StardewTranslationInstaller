    {
      "target": "Characters/Dialogue/Sebastian",
      "key": "AcceptGift_(O)StardropTea",
      "field": null,
      "source": "Hey, thank you. I'll drink this when the sky gets dark.",
      "translation": "Hej, děkuji. Vypiju to, až se setmí.",
      "sourceSHA256": "00a9d100be1125b7aa585fcb82eab21be03ad05de072aa02cd2f0f600a8e1124",
      "translationSHA256": "8eb816bab44fee02abef62c76ea8bf1380aff3b2e9c0c5adb03c7e0d04a0378e",
