    {
      "target": "Characters/Dialogue/Sebastian",
      "key": "AcceptBirthdayGift_Negative",
      "field": null,
      "source": "Uhh... well, I appreciate the thought.",
      "translation": "Ehm... no, vážím si toho gesta.",
