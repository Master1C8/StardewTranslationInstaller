    {
      "target": "Characters/Dialogue/Sebastian",
      "key": "eventSeen_4081148",
      "field": null,
      "source": "The show went well. I was kind of nervous beforehand, but once we went up on stage I just kinda got into the zone.",
      "translation": "Vystoupení dopadlo dobře. Předem jsem byl trochu nervózní, ale jakmile jsme vyšli na pódium, dostal jsem se do tempa.",
      "sourceSHA256": "e779d49a92adb84678e209d4816ec5dc2f26feb61b20c73e1b497de6ca90932a",
      "translationSHA256": "ec0493f673482f251bf35ed98df6b4e3c8470af71fd5bbcfe0f8403958d9467c",
      "reviewChecks": [
