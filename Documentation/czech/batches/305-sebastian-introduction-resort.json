    {
      "target": "Characters/Dialogue/Sebastian",
      "key": "GreenRain_2",
      "field": null,
      "source": "I was hoping this weather would come back. It makes me appreciate the summer a little more.",
      "translation": "Doufal jsem, že se tohle počasí vrátí. Díky němu si léta vážím o něco víc.",
      "sourceSHA256": "585350b84a15a104d9f839109e8de8231cb800ab7353037224ab231b7eef1c5d",
      "translationSHA256": "1554bfe66688c3257e8cd4ec532bd32656d391cb49e42652e426cf1e9c0eafef",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
