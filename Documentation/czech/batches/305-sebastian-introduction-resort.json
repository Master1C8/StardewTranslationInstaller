    {
      "target": "Characters/Dialogue/Sebastian",
      "key": "FlowerDance_Accept",
      "field": null,
      "source": "Oh yeah? ... Alright, I will.#$b#Heh... maybe this festival isn't so bad.$h",
      "translation": "Vážně? ... Tak jo, budu s tebou tančit.#$b#Heh... Možná tahle slavnost není tak špatná.$h",
      "sourceSHA256": "73118e401e93a5b1e02f042998ea3721ed477cb4efd9da4d752309b4e6484be2",
      "translationSHA256": "aa2782eadc46aa974832dd819dfb9b504e6de2614039600ad5ec2dd85f25f898",
