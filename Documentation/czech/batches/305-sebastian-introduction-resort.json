    {
      "target": "Characters/Dialogue/Sebastian",
      "key": "dating_Sebastian_memory_oneyear",
      "field": null,
      "source": "Hey... It's been a year since we started dating, remember?$h#$e#It's been the best year of my life...$l",
      "translation": "Hej... Už je to rok, co jsme spolu začali chodit, vzpomínáš?$h#$e#Byl to nejlepší rok mého života...$l",
      "sourceSHA256": "7268f9264f9fa2003830d96f0beba9274f21211c1db5025ab79953ce53052dac",
      "translationSHA256": "64af3f9e8567005a8e0a9271a63c2263239750e04a3b5502681d639c3cde15ea",
      "reviewChecks": [
