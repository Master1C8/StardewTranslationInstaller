    {
      "target": "Characters/Dialogue/Sebastian",
      "key": "AcceptBirthdayGift_Positive",
      "field": null,
      "source": "Oh, really? I wasn't expecting this. It looks great, though. Thank you.$h",
      "translation": "Ach, vážně? Tohle jsem nečekal. Ale vypadá to skvěle. Děkuji.$h",
      "sourceSHA256": "a0972cf0d30a68dbdf231e4610399cda4423cd2f9ad85c68ce8d8218ea0ca3a7",
      "translationSHA256": "f0eb20aa8d86bd6ec96b8e23461a78a2a6d5b8e9ff00aecc6d509ea9c10deffb",
