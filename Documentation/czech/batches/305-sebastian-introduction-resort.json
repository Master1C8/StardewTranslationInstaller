      "key": "AcceptGift_(O)236",
      "field": null,
      "source": "You brought me soup? That's really nice of you.$h#$b#This one brings back a lot of memories...",
      "translation": "Polévka pro mě? To je od tebe vážně milé.$h#$b#Tahle ve mně probouzí spoustu vzpomínek...",
      "sourceSHA256": "c781dfac61458c8e6bca1027659edbf059e5363c619332db24bb2207b94cebbc",
      "translationSHA256": "2b10c0466a35600c4c47519b81f364a53db4cb93e4e70427ce209e8e41971f8f",
