    {
      "target": "Characters/Dialogue/Sebastian",
      "key": "dating_Sebastian_memory_oneday",
      "field": null,
      "source": "Hey... you look great.$l#$e#I've been thinking about you all day...$l",
      "translation": "Hej... Vypadáš skvěle.$l#$e#Celý den na tebe myslím...$l",
      "sourceSHA256": "b53dfe746457b93079102e36ca30364a74dcc41e24b5dda9339330173f6b3455",
      "translationSHA256": "7b5274d59afadac8a284f70ea1b7d76ba80376c39bb8212ca9fb9051606913b1",
