    },
    {
      "target": "Characters/Dialogue/Sebastian",
      "key": "Wed",
      "field": null,
      "source": "What am I going to do today?#$e#Probably nothing.",
      "translation": "Co budu dnes dělat?#$e#Nejspíš nic.",
