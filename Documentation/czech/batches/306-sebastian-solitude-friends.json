    {
      "target": "Characters/Dialogue/Sebastian",
      "key": "Thu6",
      "field": null,
      "source": "Could you picture someone like me living on a farm? It seems ridiculous.$h",
      "translation": "Dokážeš si představit, že by někdo jako já žil na farmě? Zní to směšně.$h",
      "sourceSHA256": "6bee89ea7a0319dd62fc0b9b43ce8e390c21980f7f6e817aa0477b92dbfb4657",
      "translationSHA256": "4e53d70d9e92b0c18d88d274904ce7a8d84c3d7027c126b47634664037794610",
