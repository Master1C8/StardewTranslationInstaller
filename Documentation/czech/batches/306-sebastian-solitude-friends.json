    {
      "target": "Characters/Dialogue/Sebastian",
      "key": "Thu",
      "field": null,
      "source": "#$1 Sebastian1#I snuck into the caves last night and got a nasty cut from a rock crab. Don't tell anyone, okay?#$e#Hi.#$e#...want something?",
      "translation": "#$1 Sebastian1#Včera v noci jsem se vplížil do jeskyní a skalní krab mě ošklivě pořezal. Nikomu to neříkej, ano?#$e#Ahoj.#$e#... Něco chceš?",
      "sourceSHA256": "c6f29cba6777c005af964a513e6f2b457e9aa16abc93168e40918c98d2427da0",
      "translationSHA256": "5ccd566aa8c391cf3e973bc847dcdaa929c3d09fc00513e7d31d073089bac5c3",
      "reviewChecks": [
