    {
      "target": "Characters/Dialogue/Sebastian",
      "key": "Tue",
      "field": null,
      "source": "I was thinking... people are like stones skipping over the water.#$b#Eventually we're going to sink.",
      "translation": "Přemýšlel jsem... Lidé jsou jako kamínky odrážející se od vodní hladiny.#$b#Nakonec se všichni potopíme.",
      "sourceSHA256": "7272dbb141be742f4820cc9c32f1e5fc710c83c721a80e22fe1ad0a2ff0876b5",
      "translationSHA256": "06ad75a52e93c916fd0e13569e360317c70a01ce67fb6fb633b827b3851cf63c",
      "reviewChecks": [
        "sourceMeaning",
