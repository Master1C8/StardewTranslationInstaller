    {
      "target": "Characters/Dialogue/Sebastian",
      "key": "Wed2",
      "field": null,
      "source": "Sam is probably my only friend in this town.#$e#Well, Abby is nice too, but...$h#$e#Umm.. never mind.",
      "translation": "Sam je v tomhle městě nejspíš můj jediný přítel.#$e#No, Abby je taky milá, ale...$h#$e#Ehm... To je jedno.",
      "sourceSHA256": "b21a639acb71ada1540859df0e850d3417c5c5397e685b1b03a40628ede7730c",
      "translationSHA256": "9f3fb286f938bf9326eafed082ad55038f9c68a15d59cc9c3b2486a90da2226b",
