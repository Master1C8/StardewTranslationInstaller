      ]
    },
    {
      "target": "Characters/Dialogue/Sebastian",
      "key": "Mountain_47_23",
      "field": null,
      "source": "I come here for the peace and quiet.",
      "translation": "Chodím sem za klidem a tichem.",
      "sourceSHA256": "e40703dbdc4c5df96323118e10b520f46fa72ddcb145ff0430f17074de192a34",
      "translationSHA256": "c7987d9dbbd4ed660663e68c87e5b555a11593371d7ede676a007bae1b72f096",
      "reviewChecks": [
