    {
      "target": "Characters/Dialogue/Sebastian",
      "key": "Event_game2",
      "field": null,
      "source": "Good choice. That works well with my role.",
      "translation": "Dobrá volba. K mé roli se to hodí.",
      "sourceSHA256": "579fb468630545c77000156fbb4f58442262f36d10604ad59ef5d36f51e22f16",
      "translationSHA256": "d6d9e8dc0805afdb8ed665b0083a5fcc74c6ab2783a15066fc3eab2bf2265971",
