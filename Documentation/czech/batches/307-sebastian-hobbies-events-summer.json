    {
      "target": "Characters/Dialogue/Sebastian",
      "key": "summer_Tue",
      "field": null,
      "source": "I'm looking forward to the cold, damp season. I feel more at home.",
      "translation": "Těším se na chladné, sychravé období. Cítím se v něm víc jako doma.",
      "sourceSHA256": "0efa7257b88264929ce8ba9772f41927775f47c30875f86243a30ede4a4992f5",
      "translationSHA256": "30d6eeac61d41f8e83e72e64aa8a996855e0b849eff7f9448c46503a7a78104e",
      "reviewChecks": [
