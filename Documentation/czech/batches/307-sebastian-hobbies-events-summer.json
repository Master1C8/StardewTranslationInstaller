    {
      "target": "Characters/Dialogue/Sebastian",
      "key": "event_garage1",
      "field": null,
      "source": "Great.$8",
      "translation": "Skvělé.$8",
      "sourceSHA256": "2fbe35f49b29b1f62700fbd3c578c7f319fe0a3648c0ebe5e72f49398ddcc914",
      "translationSHA256": "838462be11827f2ea750e66fffa5f73fe1ec61d7694e11dec20bcf9657f1e018",
