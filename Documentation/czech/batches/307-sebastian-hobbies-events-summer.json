    {
      "target": "Characters/Dialogue/Sebastian",
      "key": "event_city3",
      "field": null,
      "source": "Oh... Well maybe this wasn't the right place to bring you, then. I thought you'd see the beauty in it.$s",
      "translation": "Ach... Tak tohle možná nebylo to pravé místo, kam tě vzít. Myslel jsem, že v tom uvidíš tu krásu.$s",
      "sourceSHA256": "c0a62aa8cc159c4b5261981bb513b7858c70d7644dad42264528d276b4bf504e",
      "translationSHA256": "76a34687ec84d7c4f3c57633019a0c2f276683361564eb6852245120b0ab07eb",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
