    {
      "target": "Characters/Dialogue/Sebastian",
      "key": "Sat",
      "field": null,
      "source": "What? I didn't hear you... I'm busy thinking about something.#$e#What do you want?",
      "translation": "Cože? Neslyšel jsem tě... Nad něčím přemýšlím.#$e#Co chceš?",
      "sourceSHA256": "113e04849770c3e43b0b2f5130a9547c6860f34f7787f5dd52eb374c2dac45e3",
      "translationSHA256": "f159588477cffa24670f07937fad6235e345a8cb2b53ffb3d109846c779f7300",
      "reviewChecks": [
