    {
      "target": "Characters/Dialogue/Sebastian",
      "key": "Event_cave2",
      "field": null,
      "source": "Really? It was making a lot of noise!",
      "translation": "Vážně? Dělalo to pořádný rámus!",
      "sourceSHA256": "e2de16b7f240f4f9f4feef8a5a4c5a94a4931f8cb6bf5f10ad179306a5aeecba",
      "translationSHA256": "7fc526470a902fb1e674679b4ef476a38047c2bb9dcdbab8745e2d791be82beb",
      "reviewChecks": [
