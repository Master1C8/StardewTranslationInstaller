    {
      "target": "Characters/Dialogue/Sebastian",
      "key": "event_garage2",
      "field": null,
      "source": "Okay... Never mind then.$9",
      "translation": "Dobře... Tak nic.$9",
      "sourceSHA256": "eced2363840a675e14b1bb946d56eda93e23adb9cdd3a11c8fef890c77eb4462",
      "translationSHA256": "9302d46f257cc5892d3fc2aec93b0cea5116042c7111709eefcee041eaea3c37",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
