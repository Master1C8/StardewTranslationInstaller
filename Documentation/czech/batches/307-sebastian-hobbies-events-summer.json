    },
    {
      "target": "Characters/Dialogue/Sebastian",
      "key": "Fri8",
      "field": null,
      "source": "What's new?$h#$e#I'll be at the saloon tonight destroying Sam at pool again.$h",
      "translation": "Co je nového?$h#$e#Večer budu zase v saloonu drtit Sama v kulečníku.$h",
      "sourceSHA256": "8c8e8fcd96d74159e9d323e8db2e2ef5f5dea78234640697bffa4be7e78a2f98",
      "translationSHA256": "4a9cdb2e90b7e9fe3eeb2613e34a2ab07aab20a32e2325e3fea5dceee8d80302",
