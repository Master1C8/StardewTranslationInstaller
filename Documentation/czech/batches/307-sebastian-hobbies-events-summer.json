    {
      "target": "Characters/Dialogue/Sebastian",
      "key": "Sun",
      "field": null,
      "source": "Hey. Your name is @, right?",
      "translation": "Ahoj. Jmenuješ se @, že?",
      "sourceSHA256": "45f60c6b791df462133332ab4746aee40e946b90de0e60b8f067420fabb61ace",
      "translationSHA256": "bc905a80fa80cd8cdae946acb960bf27d577c7c886912de4c660c0c6e9dd79fd",
