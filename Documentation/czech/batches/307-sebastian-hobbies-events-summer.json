      ]
    },
    {
      "target": "Characters/Dialogue/Sebastian",
      "key": "event_city2",
      "field": null,
      "source": "Yea... That's exactly how I feel, too.$l",
      "translation": "Jo... Přesně tak to cítím i já.$l",
      "sourceSHA256": "18436c4f9b5e828552f125849e53d894c09961d79f22664d3747c0d569b35f7e",
      "translationSHA256": "95412df5fbbc17c53b1b240c3e75ca6497b5f819089290163b9aa993a4e5ae7a",
      "reviewChecks": [
        "sourceMeaning",
