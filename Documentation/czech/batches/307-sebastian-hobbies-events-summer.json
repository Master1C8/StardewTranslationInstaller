    {
      "target": "Characters/Dialogue/Sebastian",
      "key": "Sun2",
      "field": null,
      "source": "Having a good weekend? ...nice.",
      "translation": "Užíváš si víkend? ... To je fajn.",
      "sourceSHA256": "5a5753ca95cb9c289718b2739e9d33bd368741c1144660ce63eacee9b23052ff",
      "translationSHA256": "9ca8946cd0cc4770a345a75f499c76687b54fc381d52a6ef80b8d8229b3ba804",
      "reviewChecks": [
