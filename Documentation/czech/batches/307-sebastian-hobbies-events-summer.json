    {
      "target": "Characters/Dialogue/Sebastian",
      "key": "Event_cave3",
      "field": null,
      "source": "It's too dangerous without a sword. But I like your sense of adventure.$h",
      "translation": "Bez meče je to příliš nebezpečné. Ale líbí se mi tvůj smysl pro dobrodružství.$h",
      "sourceSHA256": "5ee4776d29ea52f0150df3b03404aaa8f691e874edb30c81da0beae964f50f18",
      "translationSHA256": "1071d4500c034d03024220489392faf07c10f24c9054ac2ad40912ab4bcf2f16",
