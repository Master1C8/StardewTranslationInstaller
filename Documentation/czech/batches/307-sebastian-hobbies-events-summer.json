    {
      "target": "Characters/Dialogue/Sebastian",
      "key": "Fri_bad",
      "field": null,
      "source": "Oh yea? Hmm... Not really my thing, but everyone's different I guess.$u",
      "translation": "Vážně? Hm... Není to zrovna pro mě, ale každému se líbí něco jiného.$u",
      "sourceSHA256": "8a5c536e2006ac726716b584de07562bc356552021f221a23c4896c614343705",
      "translationSHA256": "0de67d18b3d06320b94d32f4f729279efac63aa82609e764ffde94b083ccf855",
      "reviewChecks": [
