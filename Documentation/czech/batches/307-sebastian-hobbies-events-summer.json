    {
      "target": "Characters/Dialogue/Sebastian",
      "key": "event_city1",
      "field": null,
      "source": "Hmm... Not exactly how I'd put it but, yeah.",
      "translation": "Hm... Já bych to takhle úplně neřekl, ale jo.",
      "sourceSHA256": "38c1b9c023f78b77add7daf3859f5ec2cc43ee5e17c48119175f6666228ef32b",
      "translationSHA256": "e613682217a9fe18f03c627e1c86a357ede3199d70cbae8c643e07771fb088b8",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
