    {
      "target": "Characters/Dialogue/Sebastian",
      "key": "summer_Mon",
      "field": null,
      "source": "Everyone is so happy in the sun. I don't get it.",
      "translation": "Všichni jsou na slunci tak šťastní. Nechápu to.",
      "sourceSHA256": "a27fe12df96e6ae59697441c9a70374513e45f9601271af6c74973332192f907",
      "translationSHA256": "bdca52e6c6930227f5dd59f0494f6ee490feac1707768a9517fb299498428c91",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/Sebastian",
      "key": "summer_Mon6",
      "field": null,
      "source": "Everyone is so happy when it's sunny out...#$e#Different people like different things, I guess.||Most people like the sun, huh?#$b#I guess you do need a minimum amount of vitamin D...",
      "translation": "Když svítí slunce, všichni jsou tak šťastní...#$e#Každý má asi rád něco jiného.||Většina lidí má ráda slunce, co?#$b#Asi je přece jen potřeba nějaké minimum vitaminu D...",
      "sourceSHA256": "f03df9b3b1aaf8e191b94532b759e710c119b752cc26f1ad282356934e90f6c5",
      "translationSHA256": "84960f1768163e16b0b12b175aa968872adae83948e5393c96863a39e4e063ce",
      "reviewChecks": [
