  "glossarySHA256": "cb0b94baf37d83f13a5401acdc21e0c6ef37e2bfd7c91616b1db7ae966dc2161",
  "reviewNote": "Re-read all 25 English/Czech rows after the audit corrections. Standardized both snowgoon jokes to the established sněhulotr terminology, corrected the present-state aspect in winter_Mon4, and verified the reading route, family and winter context, player-neutral wording, punctuation, alternatives, and all control markers.",
  "rows": [
    {
      "target": "Characters/Dialogue/Sebastian",
      "key": "fall_Thu",
      "field": null,
      "source": "My room might be a little less depressing if I had a window...$s",
      "translation": "Můj pokoj by byl možná o něco méně skličující, kdybych měl okno...$s",
      "sourceSHA256": "78ba8d9c62db36b5b13375aa1a8c9493652f54e37e21cc512f6e535d0731696b",
      "translationSHA256": "08e7bc652266dc076b3c4f32e155c2ba2e77a73f34aed28a61949870af68115e",
