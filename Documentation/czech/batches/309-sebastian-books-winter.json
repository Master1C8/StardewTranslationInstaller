    {
      "target": "Characters/Dialogue/Sebastian",
      "key": "fall_Fri_good",
      "field": null,
      "source": "Hey, me too. There's nothing like a good fiction to push the boundaries of the imagination.$h",
      "translation": "Taky. Nic neposouvá hranice představivosti tak jako dobrá beletrie.$h",
      "sourceSHA256": "1fb78e8161587097d3aa638bf94abe58a00f70ef9622e8212c0c530e65542142",
      "translationSHA256": "4c7f840d219ba717a54d0d0e28de2ed50d4029f075b3ed5679c3678db8bd4594",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Characters/Dialogue/Sebastian",
      "key": "fall_Fri_bad",
      "field": null,
      "source": "Huh. Sounds boring.",
      "translation": "Hm. To zní nudně.",
      "sourceSHA256": "9b9f46436538bee3f8c930f6350fa61a6a82cf9c48dd33642ff8f10f1efd29cf",
      "translationSHA256": "0aceaa2e4d294950f7c63bcd19dd1f97839183def02b3f2dbc337c337749b541",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
