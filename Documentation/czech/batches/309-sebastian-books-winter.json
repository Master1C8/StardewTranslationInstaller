    {
      "target": "Characters/Dialogue/Sebastian",
      "key": "fall_Fri_old",
      "field": null,
      "source": "$p 62#You probably wouldn't like it.$s|I think you'd like it.",
      "translation": "$p 62#Tobě by se asi nelíbila.$s|Myslím, že by se ti líbila.",
      "sourceSHA256": "5cb08bc4a2e41be7ffc17810deb097eaeb69051e428fac89e8439f9e455c56d2",
      "translationSHA256": "f431d13a1df4e768d0c96416242371a12fc6dd4097794031bd5cdbe6186db6e0",
      "reviewChecks": [
        "sourceMeaning",
