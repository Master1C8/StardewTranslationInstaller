    {
      "target": "Characters/Dialogue/Shane",
      "key": "dating_Shane",
      "field": null,
      "source": "I... wasn't really expecting this, after all I've put you through...",
      "translation": "Já... Tohle jsem po tom všem, co jsem ti způsobil, vážně nečekal...",
