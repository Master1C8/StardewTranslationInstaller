    {
      "target": "Characters/Dialogue/Shane",
      "key": "Resort_Leaving",
      "field": null,
      "source": "Welp... got my year's supply of Vitamin D. Now I can play video games with the blinds shut the rest of the year.",
      "translation": "Tak... Zásobu vitaminu D na celý rok mám. Teď můžu po zbytek roku hrát videohry se zataženými žaluziemi.",
      "sourceSHA256": "4ee8846c5a6c8762a3a334c794e5fb22b980d671964bdd146ed98a0e77b4728f",
      "translationSHA256": "7dbb05ef9c5bf429b13701195bf0e79447f44b0fd19066811c6fc6771c6ce05d",
