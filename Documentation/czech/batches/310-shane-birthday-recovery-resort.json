    {
      "target": "Characters/Dialogue/Shane",
      "key": "Resort_Shore",
      "field": null,
      "source": "That's right... I'm not wearing any shoes or socks.#$b#Some call it a public health risk.#$b#The crabs seem to enjoy it, though.$h",
      "translation": "Přesně tak... Nemám boty ani ponožky.#$b#Někteří tomu říkají ohrožení veřejného zdraví.#$b#Krabům se to ale zřejmě líbí.$h",
      "sourceSHA256": "283df6c53f175415a750820e178a86c40afe9f0aa394976e525e7363e10f7200",
      "translationSHA256": "dc26a14dce0f24f832b9fec8ddd969c958a743395d8bc32cc1344eb13797b0e9",
