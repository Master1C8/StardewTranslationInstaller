    {
      "target": "Characters/Dialogue/Shane",
      "key": "Resort_Chair",
      "field": null,
      "source": "Hoo... Feels good to rest these hams.#$b#If anyone needs me, I'll just be sitting here, marinating.",
      "translation": "Uf... Je fajn nechat tyhle šunky odpočinout.#$b#Kdyby mě někdo potřeboval, budu tady sedět a marinovat se.",
      "sourceSHA256": "02b95416d7bc3f9f691fff0e0ac098e231e4e8e1737ea33a45f832e3137534cc",
      "translationSHA256": "5e4d21356a947f76a7b7af0bb5892cdc9f217198fbc1e01287093356a80b5e0a",
