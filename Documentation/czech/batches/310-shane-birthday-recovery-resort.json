    {
      "target": "Characters/Dialogue/Shane",
      "key": "AcceptBirthdayGift_Loved",
      "field": null,
      "source": "Oh, is it my birthday? I was hoping I'd forget.#$b#This is actually really nice, though. Thank you.$h",
