    {
      "target": "Characters/Dialogue/Shane",
      "key": "Sat10",
      "field": null,
      "source": "Your farm seems like a great place to raise chickens.$h",
      "translation": "Tvoje farma vypadá jako skvělé místo pro chov slepic.$h",
