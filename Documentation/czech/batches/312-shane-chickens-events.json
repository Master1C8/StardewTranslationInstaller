    {
      "target": "Characters/Dialogue/Shane",
      "key": "event_room1",
      "field": null,
      "source": "Okay... that'll require a great script. Maybe I'll ask Elliott for advice next time I see him at the saloon.$s",
      "translation": "Dobře... To si vyžádá skvělý scénář. Možná příště požádám Elliotta o radu, až ho potkám v saloonu.$s",
      "sourceSHA256": "0d1f709aa5488761387d2d112ea0ceb3eee1cb364561b9a5c80352711eb99b78",
      "translationSHA256": "db0019a930801013fcacf1e9fbb9c3156c23a1d6dfc0454faf689db9b7d1c41e",
      "reviewChecks": [
        "sourceMeaning",
