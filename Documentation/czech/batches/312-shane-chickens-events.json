    {
      "target": "Characters/Dialogue/Shane",
      "key": "Sun2",
      "field": null,
      "source": "You again? How many times do I have to tell you to leave me alone?$s",
      "translation": "Zase ty? Kolikrát ti musím říkat: nech mě na pokoji?$s",
      "sourceSHA256": "0713f0629935a3265a61bb2b57458b4b1bccf245769bec617780cc2599090a91",
      "translationSHA256": "b6545dac5e5ee2ece0458a936d31d8d68004546fea7726ea25a5cbc9e787d734",
      "reviewChecks": [
