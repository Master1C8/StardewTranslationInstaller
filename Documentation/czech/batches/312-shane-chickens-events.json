    {
      "target": "Characters/Dialogue/Shane",
      "key": "Sun",
      "field": null,
      "source": "I'm busy, can't you tell?||...I don't feel like talking to anyone.",
      "translation": "Mám práci, copak to nevidíš?||... S nikým se mi nechce mluvit.",
      "sourceSHA256": "4e4cd2eb028cd4a6c28a207e03428240b97b00efbe5a7496331479cd5c9e8413",
      "translationSHA256": "d04498acc5e3ca4c63b15b5ee9b61141bdc0efca93a00a1da8573b25bf0824d8",
      "reviewChecks": [
        "sourceMeaning",
