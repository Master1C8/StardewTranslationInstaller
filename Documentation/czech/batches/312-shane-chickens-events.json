    {
      "target": "Characters/Dialogue/Shane",
      "key": "event_apologize2",
      "field": null,
      "source": "I know... that's why I stopped by, to tell you about it.",
      "translation": "Já vím... Proto jsem se zastavil, abych ti o tom řekl.",
      "sourceSHA256": "2f9a8b55c1f529db0bb268a3fe7d164b57a2a21e4d5e3f6b0e01744e196682c0",
      "translationSHA256": "541bef399958094ba5566472d651f5aaa0a033e0a34f0fa520b2e11ee0f93a9e",
      "reviewChecks": [
        "sourceMeaning",
