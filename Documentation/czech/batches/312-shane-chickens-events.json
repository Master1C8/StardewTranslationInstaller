    {
      "target": "Characters/Dialogue/Shane",
      "key": "Sun10",
      "field": null,
      "source": "Hi, @. I've actually been having a pretty good day so far.$h",
      "translation": "Ahoj, @. Dnešek je zatím vlastně docela fajn.$h",
      "sourceSHA256": "c48af942cdc84e74a2fdc0238aa5158e8504faf79240035f07d87655d210762e",
      "translationSHA256": "72a170b203755115e401d0232fdfd277b94c03a8fcfb637b63aac906cfbbea3d",
      "reviewChecks": [
