    {
      "target": "Characters/Dialogue/Shane",
      "key": "Sun8",
      "field": null,
      "source": "If I watch more TV maybe I can forget about life. That would be relaxing.$u",
      "translation": "Když budu víc sledovat televizi, možná zapomenu na život. To by bylo uklidňující.$u",
      "sourceSHA256": "788b6bb7eaaf98e755fd29eb352e78470ee384dad560e895316a5409d8a02be5",
      "translationSHA256": "a570571b4252ede899f9ee0273a9d8a6250a42c6f93f79941049080d1967049e",
      "reviewChecks": [
