      "sourceSHA256": "7f5ed558786d0ddfe0f5ea0b33f520562b16ad9af4dd91ed6c1954870de15ddd",
      "translationSHA256": "7e6e610ad5b17902817d81615e077eda15f0267510b97f40e51e12f3471451d8",
