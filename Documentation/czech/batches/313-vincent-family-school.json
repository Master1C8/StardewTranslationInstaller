      "target": "Characters/Dialogue/Vincent",
      "key": "Sat_1",
      "field": null,
      "source": "Dad's coming back soon!#$b#I hope he brings me some toys.$u",
      "translation": "Taťka se brzy vrátí!#$b#Doufám, že mi přiveze nějaké hračky.$u",
      "sourceSHA256": "7159bf15f0dade16ba7ccfabd873ab323faa4f3f922fc3e2b3412ea56957b339",
      "translationSHA256": "ac585ea535156d81907c48eae13e7a40efada22e981c9c7faf650033b6b4546b",
