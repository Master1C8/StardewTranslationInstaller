    {
      "target": "Characters/Dialogue/Vincent",
      "key": "Tue6",
      "field": null,
      "source": "Can you keep a secret, mister?^Can you keep a secret, miss?$u#$b#I wanna marry Miss Penny when I grow up.#$e#Just don't tell her, okay?$u",
      "translation": "Dokážeš udržet tajemství, pane?^Dokážeš udržet tajemství, slečno?$u#$b#Až vyrostu, chci si vzít slečnu Penny.#$e#Jen jí to neříkej, ano?$u",
      "sourceSHA256": "7f25a5aca7e04f293923701f7acf8358ffe12a5ca4bf66b0198ae3e3629f5bc5",
      "translationSHA256": "3c71081958a5ca64d1e4a90567791340e41567afd59d0e59a841b5ca4dbdde9e",
      "reviewChecks": [
        "sourceMeaning",
