    {
      "target": "Characters/Dialogue/Vincent",
      "key": "Resort",
      "field": null,
      "source": "If you look close, you can see little bugs jumping out of the sand.$h",
      "translation": "Když se podíváš zblízka, uvidíš z písku vyskakovat malé broučky.$h",
