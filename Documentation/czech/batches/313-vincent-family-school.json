    {
      "target": "Characters/Dialogue/Vincent",
      "key": "Wed",
      "field": null,
      "source": "I wanna look for bugs, but Mom gets mad when I'm all dirty.$u#$b#It's a tough choice.",
      "translation": "Chci hledat brouky, ale mamka se zlobí, když se celý ušpiním.$u#$b#Je to těžká volba.",
      "sourceSHA256": "6c39fb7b47a41e8d9c4e8cfbf4fbfb3443c4f07223db8ca80707bd1df2458d47",
      "translationSHA256": "c14839b5de35d60890205be0592e138e22f8b7b90d2a043bc67c24dcecc62375",
      "reviewChecks": [
