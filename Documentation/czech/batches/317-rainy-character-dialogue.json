    {
      "target": "Characters/Dialogue/rainy",
      "key": "Pam",
      "field": null,
      "source": "Howdy, kid. Stayin' dry?",
      "translation": "Nazdar, děcko. Jsi v suchu?",
      "sourceSHA256": "3fe8c16908d5dbe91db80bf427b4c7effc1be2fadf7cdb5baf0c70484e469eae",
      "translationSHA256": "386c87ceb3a77f10b1c94e3eb9d2307a2baa2c345c262005a12f62614ee569d9",
