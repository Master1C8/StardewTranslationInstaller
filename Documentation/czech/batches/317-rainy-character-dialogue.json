    {
      "target": "Characters/Dialogue/rainy",
      "key": "Caroline",
      "field": null,
      "source": "My garden is happy today.$h#$e#...and our water bill will be lower this month.",
      "translation": "Moje zahrada má dnes radost.$h#$e#... a tento měsíc zaplatíme méně za vodu.",
      "sourceSHA256": "96964b7b8c73bf73b68a64bff52550b84ff7331e9f06bdbec96a61a706f57f28",
      "translationSHA256": "c2df78e0ee10b5f0f3d6c36910a6c9771b3a58a24dcb05605a0ec842cdc4ac7b",
      "reviewChecks": [
