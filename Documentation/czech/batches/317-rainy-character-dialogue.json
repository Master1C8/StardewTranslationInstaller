    {
      "target": "Characters/Dialogue/rainy",
      "key": "Alex",
      "field": null,
      "source": "Hmmph. This is not good weather for sports.$s#$e#Oh well, I can always lift weights inside.$h",
      "translation": "Hmf. Tohle není dobré počasí na sport.$s#$e#No nic, vždycky můžu uvnitř zvedat činky.$h",
      "sourceSHA256": "dd46cf96ca7a856038d76fc518168a4149044d443b9b9d58d6982982006e71ba",
      "translationSHA256": "1c72b82b05d1c534e4a2dd9fe3d9911710024121d629ea3ed7eba9333c7f1b80",
      "reviewChecks": [
