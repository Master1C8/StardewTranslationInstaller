    {
      "target": "Characters/Dialogue/rainy",
      "key": "Jodi",
      "field": null,
      "source": "Did you wipe your boots off before coming in? Sorry... I just cleaned the floor.#$e#But you're always welcome in here! Heh.$h",
      "translation": "Máš otřené boty? Promiň... Zrovna jsem umyla podlahu.#$e#Ale dveře máš vždycky otevřené! Heh.$h",
      "sourceSHA256": "a1a81e6632041819e46ec8e9ed14eb9ecba0ce72df310d4040b15221eeeb0b11",
      "translationSHA256": "d1d65cd716f5424141297838d4a6e63e8a0ec1d40dbf38ff0d3a61a98e69217a",
      "reviewChecks": [
