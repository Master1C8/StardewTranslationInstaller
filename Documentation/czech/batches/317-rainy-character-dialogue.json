    {
      "target": "Characters/Dialogue/rainy",
      "key": "Clint",
      "field": null,
      "source": "Today would be a good day to explore the mines... Who knows, you might find some rare ores.",
      "translation": "Dnes by byl dobrý den na průzkum Dolů... Kdo ví, možná najdeš nějaké vzácné rudy.",
      "sourceSHA256": "f4723acbda41c66cfb3496d45d6c34fee5408f85bd7113097d6dcca38ce235ea",
      "translationSHA256": "4c9ed26e15aa438838e603bc1b434897f4187c5dc60df87fd14583d306153b84",
