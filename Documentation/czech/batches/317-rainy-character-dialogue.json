    {
      "target": "Characters/Dialogue/rainy",
      "key": "Pierre",
      "field": null,
      "source": "Most people stay indoors on days like this... It's not good for business.$s",
      "translation": "V takových dnech zůstává většina lidí uvnitř... Obchodu to neprospívá.$s",
      "sourceSHA256": "8db5aa39a2d6f2ab14659b48aa89f8e453f69a11a7b9db09cfcd2cda6e740e88",
      "translationSHA256": "d70c5bba483968c7d228ce87dd6e01dbc94512b0f7a890f843ef55056b018fe4",
      "reviewChecks": [
