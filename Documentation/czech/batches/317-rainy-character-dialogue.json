    {
      "target": "Characters/Dialogue/rainy",
      "key": "Robin",
      "field": null,
      "source": "The rain doesn't stop me from getting a job done!$h#$e#Although soggy wood isn't a joy to work with.$s",
      "translation": "Déšť mi nezabrání dokončit práci!$h#$e#S promočeným dřevem se ale nepracuje zrovna příjemně.$s",
      "sourceSHA256": "0f5ba39d7b770949dd81b555b0f4116f8a5ea0e85f74ed32c3e86da79898483e",
      "translationSHA256": "27dd620d4e1b8b495cc76e2784df1985daa6aa8dac48a77a05c87d60a32fd948",
