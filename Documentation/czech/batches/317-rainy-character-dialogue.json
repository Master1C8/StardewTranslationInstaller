    {
      "target": "Characters/Dialogue/rainy",
      "key": "Marnie",
      "field": null,
      "source": "Hi @. You look like you're soaked...you poor thing!$h",
      "translation": "Ahoj, @. Voda z tebe jen kape... To je mi tě líto!$h",
      "sourceSHA256": "f1ba16e99b16d4515c3c3c79cf6fddce1b7fd59283ee8b87aab4262c679226b3",
      "translationSHA256": "c9cf0961f6fb3790a9e4a59ba8b356395faee0891c1980424d3ba56d37c1c6b5",
