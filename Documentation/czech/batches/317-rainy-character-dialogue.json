      ]
    },
    {
      "target": "Characters/Dialogue/rainy",
      "key": "Harvey",
      "field": null,
      "source": "Hi @! Er... Read anything interesting in the library lately?#$e#Heh. Well, um... I'll see you around then?",
      "translation": "Ahoj, @! Ehm... Narazilo ti v poslední době v knihovně něco zajímavého do rukou?#$e#Heh. No, ehm... Tak se zase někdy uvidíme?",
      "sourceSHA256": "5d0be3f8f4a37de96585f8d4130c2f4e32d4b51574d4214f53520970daf2d61c",
