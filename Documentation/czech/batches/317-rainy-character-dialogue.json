    {
      "target": "Characters/Dialogue/rainy",
      "key": "Sebastian",
      "field": null,
      "source": "If you're lucky, you might see a frog in this weather.",
      "translation": "Když budeš mít štěstí, možná v tomhle počasí uvidíš žábu.",
      "sourceSHA256": "f2ba86f49055f5ff046c6c2f9d9d981e9c9a1947a9a62bbdf5f1d11ef99a93bf",
      "translationSHA256": "bba753062128503ead9baed32dc89eda84498af39cdea5f7b48bc9e744a4bd24",
      "reviewChecks": [
