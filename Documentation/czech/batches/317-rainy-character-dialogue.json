    {
      "target": "Characters/Dialogue/rainy",
      "key": "Penny",
      "field": null,
      "source": "The raindrops are really loud on the metal roof of our trailer.#$e#...It's soothing, though.$h",
      "translation": "Kapky deště na kovové střeše našeho přívěsu dělají pořádný rámus.#$e#... Je to ale uklidňující.$h",
      "sourceSHA256": "085143cd226b6e9d4b18c8b8fc6505e6f53194ad236dce9e8bc14f5ef54f3474",
      "translationSHA256": "18958df8db5041e2acbcb981b2482ee8ee00af08d4df82120ad6fad71cd2ffbc",
