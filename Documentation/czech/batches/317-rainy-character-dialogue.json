    {
      "target": "Characters/Dialogue/rainy",
      "key": "Sam",
      "field": null,
      "source": "Rain muffles sound, so I can play my guitar louder without my mom getting mad. Hehe.$h",
      "translation": "Déšť tlumí zvuk, takže můžu hrát na kytaru hlasitěji, aniž by se máma rozzlobila. Hehe.$h",
      "sourceSHA256": "2597e6b7585f698fc4d1435e9de9e81c8c112ae495b75f9182869bae177daca6",
      "translationSHA256": "b66e5f7c788570a478b2cfb43f72ab027c683ae9b80ba33e97737f509170cd74",
      "reviewChecks": [
