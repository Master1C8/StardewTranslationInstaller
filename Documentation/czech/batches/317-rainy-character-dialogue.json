    {
      "target": "Characters/Dialogue/rainy",
      "key": "Demetrius",
      "field": null,
      "source": "Greetings. Stay inside if you want to keep warm.",
      "translation": "Zdravím. Jestli chceš zůstat v teple, nevycházej ven.",
      "sourceSHA256": "1a417610ba4bda54b8fdb4270935eec7819d7f843d25739b450a2cb185cbd725",
      "translationSHA256": "d40880acf8705080ced519f8455c7a732661723de35ab9c4f3c558d21bb26531",
