    {
      "target": "Characters/Dialogue/rainy",
      "key": "Emily",
      "field": null,
      "source": "It never rains in Calico Desert... That's where my friend Sandy lives.#$e#I wish I could've visited her today.$s",
      "translation": "V poušti Calico nikdy neprší... Právě tam žije moje kamarádka Sandy.#$e#Kéž bych ji dnes mohla navštívit.$s",
      "sourceSHA256": "7f62b286d606d98a963d573396745ce3ceba96785329477bb9a810327b7489f2",
      "translationSHA256": "0b5b27def04615361fad182ac358629004c24aaf5795f7503e9ac103e59bcde6",
      "reviewChecks": [
