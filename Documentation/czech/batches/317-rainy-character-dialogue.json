    {
      "target": "Characters/Dialogue/rainy",
      "key": "Lewis",
      "field": null,
      "source": "Hi there, @. Taking a break?#$e#I hope the river doesn't overflow...$s",
      "translation": "Ahoj, @. Dáváš si pauzu?#$e#Doufám, že se řeka nevylije z břehů...$s",
      "sourceSHA256": "1a8376bc9c0e71ff1c515492c645840f7f4a32c15960cef6f4614d7b2bcbaf51",
      "translationSHA256": "2510a4a657da6a42cec145ef85d5cda2247c5f3249196720bc741c48c3b6e1d5",
