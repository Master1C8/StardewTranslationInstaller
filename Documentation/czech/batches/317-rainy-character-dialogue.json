    {
      "target": "Characters/Dialogue/rainy",
      "key": "Dwarf",
      "field": null,
      "source": "Rain... It's almost mythical to us. Some of us dwarves live our entire lives without ever experiencing it.",
      "translation": "Déšť... Pro nás je skoro mýtický. Někteří z nás trpaslíků prožijí celý život, aniž ho kdy zažijí.",
      "sourceSHA256": "62851cc4769ee9dbebde60d295cb7e00d8d56cd31c0ca6705ad8b871606f65d3",
      "translationSHA256": "17540a4ac5c95cbfbcd116d176fcc473c1e8211c565b337b04c693f07b3dc86e",
      "reviewChecks": [
        "sourceMeaning",
