    {
      "target": "Characters/Dialogue/rainy",
      "key": "Leah",
      "field": null,
      "source": "Maybe I should cook something new and exciting today. Something spicy.",
      "translation": "Možná bych dnes měla uvařit něco nového a zajímavého. Něco pikantního.",
      "sourceSHA256": "ecf35f94b410b9a4380628f7dd91c6dc986bb9b5eeebdb377b4eb5340a991f4e",
      "translationSHA256": "f43fb1b7d95b014797e1ad45aea80abae1f4916c223b87218db178bf1098d9b0",
