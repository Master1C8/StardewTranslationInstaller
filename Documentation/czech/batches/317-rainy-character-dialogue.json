    {
      "target": "Characters/Dialogue/rainy",
      "key": "Linus",
      "field": null,
      "source": "A warm rain is a pleasant way to get clean.$h",
      "translation": "Teplý déšť je příjemný způsob, jak se umýt.$h",
      "sourceSHA256": "0d0af6d71c26a712d5a2aa15c4ef219ac5a962e53be5565a79f717d6769e4ae7",
      "translationSHA256": "2fe20df63ab19d32a7ca142c42460a825c008db11aa3f29ba7188887a77427eb",
