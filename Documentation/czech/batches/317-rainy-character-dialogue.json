    {
      "target": "Characters/Dialogue/rainy",
      "key": "Shane",
      "field": null,
      "source": "Hmm... this weather makes me thirsty.$s",
      "translation": "Hm... V tomhle počasí dostávám žízeň.$s",
      "sourceSHA256": "d56d631638e1ab7d701f99eba6ca08fd0b9c4ebf561c7e72685482a700448d44",
      "translationSHA256": "58ad92f0bf9517d6fa5290854d421dacbecbfce4b7a8dbda6ede5420b6528474",
