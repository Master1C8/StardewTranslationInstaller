    {
      "target": "Characters/Dialogue/rainy",
      "key": "Wizard",
      "field": null,
      "source": "Stormy days are the only time I can commune with certain elementals.#$e#I don't expect you to understand.",
      "translation": "Pouze za bouřlivých dnů mohu rozmlouvat s některými elementály.#$e#Neočekávám, že tomu porozumíš.",
      "sourceSHA256": "3fdff7e49a98c5cd5b6613ca63a929e027646ddb56d12b82bc9e889b0f37cc04",
      "translationSHA256": "130b996bd08444eba63525d53a4997314cbbeb739da193146578752b69815495",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
