    {
      "target": "Characters/Dialogue/rainy",
      "key": "Maru",
      "field": null,
      "source": "When it rains I have a good excuse to work on my gadgets all day.$h#$e#It must be kind of boring for you, though.",
      "translation": "Když prší, mám dobrou výmluvu, abych celý den pracovala na svých přístrojích.$h#$e#Pro tebe to ale musí být trochu nudné.",
      "sourceSHA256": "dcbf051aad962a8c5795852ffa258d03efc108e9de8e2333ab8464992e1456af",
      "translationSHA256": "38146be544cb7231e2f5bfde267e638f036f571d2123c695902e6b2f80753843",
      "reviewChecks": [
