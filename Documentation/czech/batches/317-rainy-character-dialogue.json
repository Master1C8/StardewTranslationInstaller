    {
      "target": "Characters/Dialogue/rainy",
      "key": "Gus",
      "field": null,
      "source": "There's nothing like a glass of dry red wine on a day like this, huh?#$e#I love my job. Hehehe.",
      "translation": "V takový den není nic lepšího než sklenka suchého červeného vína, co?#$e#Miluji svou práci. Hehehe.",
      "sourceSHA256": "2fe701b0f98b0fc958594ff8ef6dc5da973598b2b953dd5261caa3ab88d4236c",
      "translationSHA256": "40b01a6ae27d6b10924600c7168e6fca783c11631286cdd26e17285f1f8d9c2b",
      "reviewChecks": [
