    {
      "target": "Characters/Dialogue/rainy",
      "key": "George",
      "field": null,
      "source": "It's awful cold, isn't it? What a rotten day.",
      "translation": "Je příšerná zima, co? Mizerný den.",
      "sourceSHA256": "d69fe56a682a3f3f4833f3a1f2d9c0c97b30fe7de722fe8fd8dd5c11fd2b84d4",
      "translationSHA256": "ea2ab6a4f8c7ec9f2691af98b78b39b7f9f59f7efcc3f03150debf90b5bf8663",
      "reviewChecks": [
        "sourceMeaning",
