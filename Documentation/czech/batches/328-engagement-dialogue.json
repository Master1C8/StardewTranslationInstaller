      ]
    },
    {
      "target": "Data/EngagementDialogue",
      "key": "Alex1",
      "field": null,
      "source": "I'm going to love being a farmer.$h",
      "translation": "Život farmáře si zamiluji.$h",
      "sourceSHA256": "4a6d8a21a811bd909c34507b019b4281216f8044b8a35f0e116a85c6c88d551e",
      "translationSHA256": "d26e05ae981f990bf2ed10727614c8a2ecb2b4ab27d3d1b20572c122c4bce250",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Data/EngagementDialogue",
      "key": "Shane0",
      "field": null,
      "source": "Part of me is wondering if this isn't all some elaborate prank.#$e#I can't believe you'd actually want to marry someone like me.",
      "translation": "Něco ve mně si říká, jestli to celé není nějaký propracovaný žert.#$e#Nemůžu uvěřit, že si doopravdy chceš vzít někoho, jako jsem já.",
      "sourceSHA256": "6f7e62992335f50fbefb7417780270183bca52345869f30ebae85ae33b791c02",
      "translationSHA256": "40af08f0cf802d871441ae14ac25baca38c34b2e7e76d4f73e0750aa9ac33704",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Data/EngagementDialogue",
      "key": "Shane1",
      "field": null,
      "source": "@... My head's spinning, and I haven't even had a beer today.",
      "translation": "@... Točí se mi hlava, a to jsem dnes ani neměl pivo.",
      "sourceSHA256": "4670e652ed17e9b54fec4795b26f2806cfcb8634b02ff1838bd7e58bb6e11254",
      "translationSHA256": "f7392ac4b1a115203541c424576fddf4a24e0e1c71bad4aeada8b997a732aea8",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Data/EngagementDialogue",
      "key": "Emily0",
      "field": null,
      "source": "Can you believe we're about to move in together? I've never lived with anyone but my family.#$e#It's... exciting.",
      "translation": "Věříš tomu, že spolu za chvíli začneme bydlet? Nikdy jsem nežila s nikým kromě své rodiny.#$e#Je to... vzrušující.",
      "sourceSHA256": "cce5e87a8396d5757dd9ce6f141e1d8421b8392fdb7c8167a7a323a7c2c14499",
      "translationSHA256": "1f71e43ba87c7da25e59af9fbe1b9eec68feccc024b095f46f77720a63420ae7",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Data/EngagementDialogue",
      "key": "Emily1",
      "field": null,
      "source": "I always knew something important would happen between us... I just never thought it would be this!$h#$e#The parrot is excited too.",
      "translation": "Vždycky jsem věděla, že se mezi námi stane něco důležitého... Jen jsem si nikdy nemyslela, že to bude tohle!$h#$e#Papoušek má také radost.",
      "sourceSHA256": "14bc9076e679f0caa0673b8e9c1fe1b2c2c23491f0dbe98cd6637d3b4a3964a6",
      "translationSHA256": "ba5d16a6357efce6b5cfe97168c30feb571e8201eb0d1262cf88325ce11ce871",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Data/EngagementDialogue",
      "key": "Krobus0",
      "field": null,
      "source": "@... I'm afraid we'll have to keep this a secret... Neither my people nor yours would accept us living together.",
      "translation": "@... Obávám se, že to budeme muset udržet v tajnosti... Můj lid by naše společné bydlení nepřijal a tvůj také ne.",
      "sourceSHA256": "1557f30d12b34ba16be4c6c4cfd6720348fb2543797686dc6763b214bb191649",
      "translationSHA256": "b69a9d5b3ddb5a1815572ae12bdcaa29c0820ef54b3c528d6e02571c9712d75b",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Data/EngagementDialogue",
      "key": "Krobus1",
      "field": null,
      "source": "You know I'll be a very strange person to live with, right? I won't be able to leave the house...",
      "translation": "Víš, že budu velice zvláštní spolubydlící, že? Nebudu moct vycházet z domu...",
      "sourceSHA256": "c407ce903c7eb44b026fa6cce0bd7fda0773073527db751fa32be91480ea9bb3",
      "translationSHA256": "b5690f264932c3327431065d8e2ae2d1556df459a50f9c0c1b06b05b63042deb",
