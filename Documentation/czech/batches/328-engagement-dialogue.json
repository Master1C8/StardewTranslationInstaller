    {
      "target": "Data/EngagementDialogue",
      "key": "Haley0",
      "field": null,
      "source": "I'm so happy!$h#$e#It's just like I always dreamed.$l",
      "translation": "Jsem tak šťastná!$h#$e#Je to přesně jako v mých snech.$l",
      "sourceSHA256": "f9830da3af7c197f99d1d04ca716410a55f2e721025849938d05b37c0ff2c3ac",
      "translationSHA256": "1ac58d014445e5cbf14771834e678aa1280a566ada022deffc7bb9f3bcddef1b",
      "reviewChecks": [
