    {
      "target": "Data/EngagementDialogue",
      "key": "Maru1",
      "field": null,
      "source": "I need to get mentally prepared for being a farmer's wife.",
      "translation": "Musím se psychicky připravit na roli manželky na farmě.",
      "sourceSHA256": "355d179c168c435941763bb56e5611bae18bac223024ab7d088591f9f47d49b7",
