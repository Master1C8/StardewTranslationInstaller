    {
      "target": "Data/EngagementDialogue",
      "key": "Maru0",
      "field": null,
      "source": "I'm really excited.$h#$b#I'm going to be your wife. Hehe.$l",
      "translation": "Jsem opravdu nadšená.$h#$b#Budu tvoje žena. Hehe.$l",
      "sourceSHA256": "4a8c88d4c6d9ba824bd6e74623925a53ee15ec1cf7835e3059c433a18dd40071",
      "translationSHA256": "f25d338c7998785e01163789079dd8645b58b2c6926f4d80920767afa2274e22",
