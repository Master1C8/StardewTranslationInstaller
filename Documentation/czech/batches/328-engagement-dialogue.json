    {
      "target": "Data/EngagementDialogue",
      "key": "Haley1",
      "field": null,
      "source": "It's okay. I know we can't have a honeymoon, since your farm needs to be taken care of.#$e#I'm a farmer now, too!",
      "translation": "To nevadí. Vím, že nemůžeme mít líbánky, protože se někdo musí starat o farmu.#$e#Teď jsem taky farmářka!",
      "sourceSHA256": "796c45d97da2b5896985b84b2b4ab555e3273bec1151e3c153f8c157cc3bd979",
      "translationSHA256": "61b5222cce9cadc6a057e8e5170150c9293132a79e6982fdb9f61e88bea5400f",
      "reviewChecks": [
        "sourceMeaning",
