      ]
    },
    {
      "target": "Data/EngagementDialogue",
      "key": "Penny0",
      "field": null,
      "source": "@.. I'm a little scared. This is such a big change!#$e#Don't worry, I'm really happy, too.$h",
      "translation": "@... Trochu se bojím. Je to tak velká změna!#$e#Neboj se, zároveň mám obrovskou radost.$h",
      "sourceSHA256": "a2384d5557273cc341396a1479fe7e1331ec50a0bb65e97e6a6d6654b5c9e1fe",
      "translationSHA256": "08f9c44d72c8ec880c4cfc27b058081915df461126478e49af21d67f4f3fe976",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Data/EngagementDialogue",
      "key": "Penny1",
      "field": null,
      "source": "We're going to have a little farm family, soon.$l#$e#I'm so glad you feel this way about me.$h",
      "translation": "Brzy budeme mít malou farmářskou rodinu.$l#$e#Jsem tak ráda, že ke mně něco takového cítíš.$h",
      "sourceSHA256": "ebd8d97f04b95ddcd5f214a4d1ef92908caa610cc9780804577ddc55ec17585c",
      "translationSHA256": "41e4d24fa6b28ad5a44ba8b29410b3707f0cc5d14ffe6015b686e738ad5504b0",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Data/EngagementDialogue",
      "key": "Abigail0",
      "field": null,
      "source": "Hehe. Me? Married? I never thought this would happen.$h#$e#We're going to have a lot of fun together.$h",
      "translation": "Hehe. Já? Vdaná? Nikdy jsem si nemyslela, že se to stane.$h#$e#Spolu si užijeme spoustu zábavy.$h",
      "sourceSHA256": "c8a06d68fbe381cbb685b668e97aa57af595d0fb98afb59bda68abdc2fc91ea9",
      "translationSHA256": "250796f3be0cace49544ff10c5e34522a19944602e4390e5a56a7bc480cc5b47",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Data/EngagementDialogue",
      "key": "Abigail1",
      "field": null,
      "source": "I'm engaged to a farmer. Wow!$h#$e#Our lives are going to be a lot different from now on.$l",
      "translation": "Jsem zasnoubená s někým, kdo má farmu. Páni!$h#$e#Odteď budou naše životy úplně jiné.$l",
      "sourceSHA256": "453fe6f1cc86703ea8e163cc872719dbf3854e6962c00058cabb757c81d5d2c0",
      "translationSHA256": "01f9a9ec853a6cea3c4a359406073bb9901751723e300946f12d6ea9580cb34f",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Data/EngagementDialogue",
      "key": "Sam0",
      "field": null,
      "source": "I'm going to be really happy as your husband, @.$l#$e#I'm excited.",
      "translation": "Jako tvůj manžel budu opravdu šťastný, @.$l#$e#Už se nemůžu dočkat.",
      "sourceSHA256": "2270817dd4161582942e92be6cf634672cf5adb0b7daef57a0588109d66a842f",
      "translationSHA256": "e57c49c963d5e4283708aa2bcdedd70b66332553a2f193781cd97991b7d754cf",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Data/EngagementDialogue",
      "key": "Sam1",
      "field": null,
      "source": "I never dreamed this would happen. I'm so lucky.$l#$e#I can't wait till the wedding.$h",
      "translation": "Ani ve snu mě nenapadlo, že se tohle stane. Mám obrovské štěstí.$l#$e#Nemůžu se dočkat svatby.$h",
      "sourceSHA256": "b346220715d09fe1d46e1e1a0855921602f44de5916cded50e24a3b691e5513d",
      "translationSHA256": "72d3fcdf474d69c652ee823f3c313f9e7e3e5bb5850782a4eb57683f25b87748",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Data/EngagementDialogue",
      "key": "Sebastian0",
      "field": null,
      "source": "In a couple days I'm going to be living on a farm. I can't believe it.$h#$e#I'm happy, though.$l",
      "translation": "Za pár dní budu bydlet na farmě. Nemůžu tomu uvěřit.$h#$e#Mám ale radost.$l",
      "sourceSHA256": "0006b00aa71c63fee039ca8ded89ebc44ff3ac26e78a38508e39a7510e458f24",
      "translationSHA256": "47710772901ceb6f8eb4b56d2d9138f49bd8b108fe4a72be45eaeee04ceb6724",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Data/EngagementDialogue",
      "key": "Sebastian1",
      "field": null,
      "source": "When you showed up in town, I never thought I'd be marrying you some day.$l#$e#Life is strange, huh?$h",
      "translation": "Po tvém příchodu do města mě nikdy nenapadlo, že si tě jednou vezmu.$l#$e#Život je zvláštní, co?$h",
      "sourceSHA256": "26b92d60ba2391f05da3747727bdd0c42e9da6f8cd50acfc1ad21efb5a00572d",
      "translationSHA256": "79c119e4994fb6f86eade9662d125ed01ab1908daefb7f5993ebbebee59e63fb",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Data/EngagementDialogue",
      "key": "Harvey0",
      "field": null,
      "source": "Oh my goodness! I have so much to prepare before the wedding! I'm nervous.$l#$e#I'll be relieved after we're all settled in on your farm.$h",
      "translation": "Proboha! Před svatbou toho musím tolik připravit! Jsem nervózní.$l#$e#Uleví se mi, až se spolu zabydlíme na tvé farmě.$h",
      "sourceSHA256": "7787872bfdf6c9bbaeba399d3934d83cb432157978ff47eeb59c703ade432370",
      "translationSHA256": "ec9fce63dc33bfbd3053a2cf95d2db0f0f9d3060fae202b908e8483f2f86b2a7",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Data/EngagementDialogue",
      "key": "Harvey1",
      "field": null,
      "source": "I'm really happy.$h#$e#This was always my secret wish.$l",
      "translation": "Jsem opravdu šťastný.$h#$e#Tohle bylo vždycky mé tajné přání.$l",
      "sourceSHA256": "8c4e1a7c001b16d98d4571db8bff509c9cdbc5f4629d90eaaa96226d7594889d",
      "translationSHA256": "fdcf997b84933a5a169e208a21087ec3e27d55a7e95ddb1e717c3363e4ef3a6e",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Data/EngagementDialogue",
      "key": "Elliott0",
      "field": null,
      "source": "The farm will be such a lovely place to write. I'm really looking forward to this.$h#$e#We're going to make a great pair.$l",
      "translation": "Na farmě se bude nádherně psát. Opravdu se na to těším.$h#$e#Bude z nás skvělá dvojice.$l",
      "sourceSHA256": "c9ba7c58bd012fa923b8b031610afe24935824ea9af9adf7c9362e0508210dff",
      "translationSHA256": "7c2112dc0c8dd311d643d786b4d79f129a070f9d362b44651e9fc5e727d087fc",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Data/EngagementDialogue",
      "key": "Elliott1",
      "field": null,
      "source": "This is going to be such an adventure! I'm really excited. Aren't you?$h#$e#We can use my cottage as a beach house.$l",
      "translation": "Tohle bude veliké dobrodružství! Jsem opravdu nadšený. Ty ne?$h#$e#Mou chatu můžeme využívat jako domek na pláži.$l",
      "sourceSHA256": "ae845da7acfd1eeb4feedb03d1f2af918ef57c09aaff15b51a4ad4d78a9dc9da",
      "translationSHA256": "fa5118e16526beeedae47dd4c442f06fcac74c520f7e5e67d3d7d75daf756b1e",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Data/EngagementDialogue",
      "key": "Alex0",
      "field": null,
      "source": "@, this is the greatest thing that could have happened.$l#$e#I can't wait.$h",
      "translation": "@, nic lepšího se mi nemohlo stát.$l#$e#Nemůžu se dočkat.$h",
      "sourceSHA256": "c270b0323c8733613b55ce9ab366d61f23e500bef7f5746fff72fa3736bcea41",
      "translationSHA256": "73027635b4017596c1020756b974561889961911c903aa4ec6b1e5391bc38499",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
