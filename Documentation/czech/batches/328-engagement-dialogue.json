    {
      "target": "Data/EngagementDialogue",
      "key": "Leah1",
      "field": null,
      "source": "I've always dreamed of living on a farm.$h#$e#I'm going to be so happy.",
      "translation": "Vždycky jsem snila o životě na farmě.$h#$e#Budu tak šťastná.",
      "sourceSHA256": "0930aa0c6626f61449e7bb43d3631a704f673f326b6d04f7a5b34ba7a6f7d811",
      "translationSHA256": "d2ac966e4711c6050788b9595a5d3c5d33daf8332d7d7b2dbbc268f1b4f80af6",
      "reviewChecks": [
