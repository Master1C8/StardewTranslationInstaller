      ]
    },
    {
      "target": "Data/Festivals/fall27",
      "key": "Clint",
      "field": null,
      "source": "One of my iridium-infused maces would make quick work of these things.",
      "translation": "Jeden z mých palcátů napuštěných iridiem by s těmihle potvorami rychle zatočil.",
      "sourceSHA256": "2ec75e54f254ee8b7ab2f3dfdae4825559e5c4ccb258e24500d0a9503e54adb0",
      "translationSHA256": "75571eb3982a529fe1bd840bd0c5bef0419f97c41155f2216601f3dbbcc73cca",
