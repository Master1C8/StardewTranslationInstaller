    {
      "target": "Data/Festivals/spring24",
      "key": "Pam_y2",
      "field": null,
      "source": "The red jelly wafting in the wind looks like it's dancing!$1#$e#Heh... Maybe that's just the wine speaking.$0",
      "translation": "Červené želé se ve vánku vlní, jako by tančilo!$1#$e#Heh... Možná ze mě jen mluví víno.$0",
      "sourceSHA256": "7fa9d1c643bafbeb905e7acbf9656b4bbd518a970d503a0d47328919e69627d1",
      "translationSHA256": "496c45995714a5fb4750f1c35655cc2aaaa7fb0a324f3e752b1d57200d4aa9b9",
      "reviewChecks": [
