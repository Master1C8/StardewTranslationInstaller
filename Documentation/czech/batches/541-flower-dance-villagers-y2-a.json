    },
    {
      "target": "Data/Festivals/spring24",
      "key": "Maru_y2",
      "field": null,
      "source": "It can be a little nerve-racking to ask someone to dance with you.$0",
      "translation": "Požádat někoho o tanec může být trochu stresující.$0",
      "sourceSHA256": "510d5aef3f9b182512f373dfb088f0013c0c96d73a016e02a0066268561a8ecb",
      "translationSHA256": "42830322cf420828b3a2734397303cd7f7874695bf3c37cdb70b68f4a5a09273",
      "reviewChecks": [
        "sourceMeaning",
