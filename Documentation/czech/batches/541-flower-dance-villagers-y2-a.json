    {
      "target": "Data/Festivals/spring24",
      "key": "Demetrius_y2",
      "field": null,
      "source": "Gatherings like this give a sense of identity to our community.#$b#Or as my wife says... 'it makes the town lively'!",
      "translation": "Taková setkání dávají naší komunitě pocit vlastní identity.#$b#Nebo jak říká má žena... „oživují město“!",
      "sourceSHA256": "5f9718c0f45a460045b56d79995664849fd43b51a8c3d308689a22c7a4ee4808",
      "translationSHA256": "e72d8ebd2a3a72918748133be930f19da457ae1e14f27790efb470f06d31386c",
      "reviewChecks": [
        "sourceMeaning",
