    {
      "target": "Data/Festivals/spring24",
      "key": "Evelyn_y2",
      "field": null,
      "source": "I used to visit this spot when I was younger. It hasn't changed much over the years.$0",
      "translation": "Když jsem byla mladší, chodívala jsem na toto místo. Za ta léta se příliš nezměnilo.$0",
      "sourceSHA256": "0adcdd2569faa8664ddfb8df300081fb5cb6a0c1be2dcdf2063c03e0e2370321",
      "translationSHA256": "21792a334323a8139080718d9949bc2fcf79a13ccc6b8a1c6085b07d29b46da0",
      "reviewChecks": [
