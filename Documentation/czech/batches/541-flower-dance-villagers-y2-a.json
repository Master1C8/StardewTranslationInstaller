    {
      "target": "Data/Festivals/spring24",
      "key": "Penny_y2",
      "field": null,
      "source": "Vincent asked me to dance with him. Isn't that cute?$0",
      "translation": "Vincent mě požádal o tanec. Není to roztomilé?$0",
      "sourceSHA256": "44faa6ca08aed92a1218944733d9bad6f91f9d01352aac0005e5dd2e1a7cf751",
      "translationSHA256": "bfaaecc76586bf255a943023b99f51cf7458e2cf6de267db5fdffad876601dce",
