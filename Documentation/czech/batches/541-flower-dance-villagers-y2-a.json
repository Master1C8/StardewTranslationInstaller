    {
      "target": "Data/Festivals/spring24",
      "key": "Lewis_y2",
      "field": null,
      "source": "Good afternoon, @. The weather for today's festivities couldn't be more perfect.$0#$b#Come talk to me when you're ready to start the ceremony.$0",
      "translation": "Dobré odpoledne, @. Počasí pro dnešní slavnost nemohlo být dokonalejší.$0#$b#Až budeš chtít zahájit obřad, přijď za mnou.$0",
      "sourceSHA256": "7805357c1eca49755b4acce6f14abdcdacfdf026f98edd96d1fefc92f6576016",
      "translationSHA256": "d1ecfe07a5c24af11d4553309933961d820d18e86281fef846bd4d49448b7d5b",
