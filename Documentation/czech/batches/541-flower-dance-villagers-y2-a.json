      ]
    },
    {
      "target": "Data/Festivals/spring24",
      "key": "Caroline_y2",
      "field": null,
      "source": "I'd ask my husband to dance, but he doesn't really know how.$0",
      "translation": "Požádala bych manžela o tanec, ale on vlastně tančit neumí.$0",
      "sourceSHA256": "da3ea5a552ee4b4758db4b429aa6d25aafe0bc4b4080abe629e0906d70091a2b",
      "translationSHA256": "9337238b75a3b951a5857bd1de02cc3417e6b6a46bd5b445865791b13d0fde45",
      "reviewChecks": [
        "sourceMeaning",
