    {
      "target": "Data/Festivals/spring24",
      "key": "Alex_y2",
      "field": null,
      "source": "The key to dancing is to have confidence.$1",
      "translation": "Klíčem k tanci je sebevědomí.$1",
      "sourceSHA256": "c8dc37eb06320bce39cb2bf3657e5312d97a15483602fdbc106c8eb04f27bd14",
      "translationSHA256": "ce12dc1ac4274f3b11ecec65fff9b560ec60491acbdb081509b1fbd382ea8f21",
