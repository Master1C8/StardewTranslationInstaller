    {
      "target": "Data/Festivals/spring24",
      "key": "Sebastian_y2",
      "field": null,
      "source": "I didn't come here by choice.$0",
      "translation": "Nepřišel jsem sem dobrovolně.$0",
      "sourceSHA256": "3268e04020b79f92120abb15d8e9f454e11690402005fbfb4cbcc65e1d078dab",
      "translationSHA256": "6bed21f60ca8a687dc300ca859d8449d8d67aedc36f17d1a7c2fff38a3255aa1",
      "reviewChecks": [
        "sourceMeaning",
