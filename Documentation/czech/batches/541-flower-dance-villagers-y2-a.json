    {
      "target": "Data/Festivals/spring24",
      "key": "George_y2",
      "field": null,
      "source": "Flowers? More like bumblebee magnets. Hmph. Can't smell much anyway.$0",
      "translation": "Květiny? Spíš magnety na čmeláky. Hmf. Stejně toho moc necítím.$0",
      "sourceSHA256": "8fc54356f509a65ace349b46e8cc6b2713f97e90b2d67d76cdf1ca667c740219",
      "translationSHA256": "fa02c85fe68e6a8d006a887e5fd163b25728d6772bcd1a379308b894738fca36",
      "reviewChecks": [
