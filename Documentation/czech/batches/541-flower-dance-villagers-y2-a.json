    {
      "target": "Data/Festivals/spring24",
      "key": "Robin_y2",
      "field": null,
      "source": "Is that the smell of flowers? Or is it Caroline's perfume?$0",
      "translation": "Je to vůně květin? Nebo Carolinin parfém?$0",
      "sourceSHA256": "748988b15cd9d55a46422235e7faab729ef698c8ec5d178c51660569b834dc51",
      "translationSHA256": "bdf600cee7618f224f63272fa2f36564a9f3a3539bdc3eca9eb5db7cb202cd8e",
      "reviewChecks": [
