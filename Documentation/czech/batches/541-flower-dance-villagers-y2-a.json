    {
      "target": "Data/Festivals/spring24",
      "key": "Jodi_y2",
      "field": null,
      "source": "I have special earrings I only wear once a year for this event.$0#$e#They're little daffodils... see?$h",
      "translation": "Mám zvláštní náušnice, které nosím jen jednou ročně na tuto slavnost.$0#$e#Jsou to malé narcisy... vidíš?$h",
      "sourceSHA256": "03bba59cceba3f8e53dbc820db62dea20ff60f054707499bafa170e566012d92",
      "translationSHA256": "9ae26ada4bc455fdd0f3308d3ddc20ada4d4b8d565a5d39cded89ae765284a5b",
      "reviewChecks": [
