        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Data/Festivals/spring24",
      "key": "Haley_y2",
      "field": null,
      "source": "One, two, three... one, two, three... Oh, hi. I'm a little busy.$0",
      "translation": "Raz, dva, tři... raz, dva, tři... Ach, ahoj. Mám teď trochu napilno.$0",
      "sourceSHA256": "f231c691d4a33b675246e3ae2a41db797a11aab3ed38a4b642d26db3c15a55b6",
      "translationSHA256": "f8b49f676491bc546f08720dcb567c7d97b5847165b653435ed0cbe266954bdf",
      "reviewChecks": [
