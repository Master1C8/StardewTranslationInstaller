    {
      "target": "Data/Festivals/spring24",
      "key": "Linus_y2",
      "field": null,
      "source": "Did you have a successful salmonberry harvest?$0#$b#I picked enough to make a sweet and tangy jelly! I brought some today for everyone to taste.$1",
      "translation": "Máš za sebou úspěšnou sklizeň lososových bobulí?$0#$b#Nasbíral jsem jich dost na sladkokyselé želé! Nějaké jsem dnes přinesl, aby ho mohli všichni ochutnat.$1",
      "sourceSHA256": "47834187b7400931d0e2d1d102e2547754ebe78315bdfce5a6e5ba12363dcd1e",
      "translationSHA256": "c3d1d44bc41cde6bb7bdbe1129c038407fed01667edf302f96212fa77616d924",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Data/Festivals/spring24",
      "key": "Pierre_y2",
      "field": null,
      "source": "Hey, you shouldn't be back here!$3#$e#Well, if you're sticking around... mind manning the booth for a while? I want to taste Linus' sweet and tangy jelly.#$e#I'm joking, I can't bear to be away from the register...$2",
      "translation": "Hej, tady vzadu nemáš co dělat!$3#$e#No, když už tu zůstaneš... Pohlídáš na chvíli stánek? Chci ochutnat Linusovo sladkokyselé želé.#$e#Jen žertuji, od pokladny se nedokážu odtrhnout...$2",
      "sourceSHA256": "75bbcdc8cc9bf08a414b42ac7478ae478f020cd9951ddf48c98e881b56752a2d",
      "translationSHA256": "f72ca31803754538e79c586e0ba0668a1bb4ebb567da23eb85b95fcba22dcbc2",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
