    {
      "target": "Data/Festivals/spring24",
      "key": "Emily_y2",
      "field": null,
      "source": "Oh, hey! This year I'm giving my sister competition for the flower queen title.$0#$b#I've been working on my choreography!$1",
      "translation": "Ale, ahoj! Letos soupeřím se sestrou o titul květinové královny.$0#$b#Pracovala jsem na své choreografii!$1",
      "sourceSHA256": "7b91f37d3e0a505e793cc0b7f1885032f5a66dc8de9c7701abe8e36999bbab88",
      "translationSHA256": "ebb3081d5b98e83d5be35afb45d23074cd62984de6280dd05eace38f12b978c4",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
