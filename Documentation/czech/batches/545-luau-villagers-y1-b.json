    {
      "target": "Data/Festivals/summer11",
      "key": "Lewis",
      "field": null,
      "source": "Look sharp! The governor's here for his annual visit.#$b#If you brought something for the potluck make sure and add it to the soup cauldron.",
      "translation": "Do pozoru! Guvernér je tu na své každoroční návštěvě.#$b#Pokud máš něco do společné hostiny, nezapomeň to přidat do kotle s polévkou.",
      "sourceSHA256": "edc5bd836075117b6819c1696be6b7bd2fd0a6ad9b11f2c77a315c83a593a13f",
      "translationSHA256": "3a31d7d28c7316afc12ceebb97f34cf0f07a3a5531f56e766af9f6b6f80b6adf",
