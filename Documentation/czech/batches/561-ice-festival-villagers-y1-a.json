    {
      "target": "Data/Festivals/winter8",
      "key": "Linus",
      "field": null,
      "source": "Igloo-building's an art I picked up from the tundra dwellers who live beyond the frozen sea.#$e#That was many years ago.$h#$e#An Igloo makes a nice home, but it's easier to just stay in my tent year-round.",
      "translation": "Stavění iglú je umění, které jsem se naučil od obyvatel tundry za zamrzlým mořem.#$e#To už bylo před mnoha lety.$h#$e#Iglú je příjemný domov, ale jednodušší je zůstat ve stanu po celý rok.",
      "sourceSHA256": "7a9780ff6f06175801cbf04408e4cc83047b2e2f3174191b0fbe572a1ca5b5ef",
      "translationSHA256": "1f0ac97866f6cc2b522cb88698bbe0ec34500fe1d26fbb688b364243fd7d0e12",
