    {
      "target": "Strings/1_6_Strings",
      "key": "DesertFestival_Lewis3",
      "field": null,
      "source": "Remember, today is the last day of the festival. We'll be back next year, though.",
      "translation": "Pamatuj, dnes je poslední den festivalu. Příští rok se sem ale vrátíme.",
