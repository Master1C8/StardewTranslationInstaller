      ]
    },
    {
      "target": "Strings/1_6_Strings",
      "key": "DesertFestival_Sam",
      "field": null,
      "source": "Hey, @. Check out my cactus. I'm trying to think of a name for him.#$e#Hmm... maybe '%name'?",
      "translation": "Ahoj, @. Podívej na můj kaktus. Snažím se pro něj vymyslet jméno.#$e#Hmm... třeba „%name“?",
      "sourceSHA256": "d08c2ddbfa6ce398d3309fdbc390a9963bfab09635ba18e64bfa900b8d082254",
      "translationSHA256": "13a9b1f959a2390ee343d3fae3aa19b1922d2dd64d3338719255cb6b8232392f",
      "reviewChecks": [
