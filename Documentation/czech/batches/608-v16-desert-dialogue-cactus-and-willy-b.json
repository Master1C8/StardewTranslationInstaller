        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Strings/1_6_Strings",
      "key": "DesertFestival_Penny",
      "field": null,
      "source": "Thousands of years ago, this place was the homeland of an ancient civilization. I wonder what they were like?",
      "translation": "Před tisíci lety bylo toto místo domovem dávné civilizace. Zajímalo by mě, jací asi byli.",
      "sourceSHA256": "a507258b63b05de266c373bcacc5400e85651ad272efa6ecd02cc732464e822c",
      "translationSHA256": "471f3547c98a77a8d90dfde64e027ad048a4f83b89ac11e25c670592151a4fd9",
      "reviewChecks": [
        "sourceMeaning",
