    {
      "target": "Strings/1_6_Strings",
      "key": "DesertFestival_Sebastian",
      "field": null,
      "source": "Hey. I'm just hanging out with this bird. She seems to like me.",
      "translation": "Čau. Jen tu trávím čas s touhle ptačí kamarádkou. Zdá se, že mě má ráda.",
      "sourceSHA256": "615aa538180e2a172bec536b8478d35561b3ff1bbe39f757430e1b5a4e324610",
      "translationSHA256": "6b79df137960c438902f7843eb8b6c1268e1330747cba378c24b3d58e8953d68",
