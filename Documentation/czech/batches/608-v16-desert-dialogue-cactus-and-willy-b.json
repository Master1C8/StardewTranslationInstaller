    {
      "target": "Strings/1_6_Strings",
      "key": "DesertFestival_Sandy",
      "field": null,
      "source": "This is probably the busiest time of the year for me! It's nice to be able to see everyone.",
      "translation": "Tohle je pro mě asi nejrušnější část roku! Je příjemné vidět všechny pohromadě.",
      "sourceSHA256": "537d7c61639594a0b40ba5fc026ea6fb99a6ad479d032b0da4e17ed733088f28",
      "translationSHA256": "b9f33368047dea50143343b8f80ac91c740409e663e9a9c058c8da10ed3b46ab",
      "reviewChecks": [
