      ]
    },
    {
      "target": "Strings/1_6_Strings",
      "key": "DesertFestival_Pierre",
      "field": null,
      "source": "As a shopkeeper, I find it interesting to see how other people run their shops.#$e#*whisper* Don't tell Sandy, but my grocery selection blows hers out of the water!",
      "translation": "Jako obchodníka mě zajímá, jak vedou své obchody ostatní.#$e#*šeptá* Neříkej to Sandy, ale můj výběr potravin ten její hravě strčí do kapsy!",
      "sourceSHA256": "153a23865ce5b8bbd9d5d7aab896e3030c7427ce635ab0054f6dafdd672ec19e",
      "translationSHA256": "a481caa13d10c20905058888e35f0f1429ad59100ebbed11ba1cc68dde220c2d",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
