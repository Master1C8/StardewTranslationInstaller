        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Strings/1_6_Strings",
      "key": "DesertFestival_Maru",
      "field": null,
      "source": "I'm impressed with how well-trained these little racers are!$h",
      "translation": "Dělá na mě dojem, jak dobře jsou tito malí závodníci vycvičení!$h",
      "sourceSHA256": "a15d66468b1e885d1d8bc29e152607704b1fef580b2c6eb05679819b7c48ac9f",
      "translationSHA256": "3830604b1e081ef0d357cffef419abff4ad0e8eb0206abc6313ad423aee88559",
      "reviewChecks": [
        "sourceMeaning",
