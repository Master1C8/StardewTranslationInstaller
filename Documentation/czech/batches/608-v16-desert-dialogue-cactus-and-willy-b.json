    {
      "target": "Strings/1_6_Strings",
      "key": "DesertFestival_Linus",
      "field": null,
      "source": "I hitched a ride underneath the bus.#$e#You can't find this Calico Desert flavor anywhere else. Heheh...$h",
      "translation": "Svezl jsem se pod autobusem.#$e#Takovou příchuť pouště Calico nikde jinde nenajdeš. Hehehe...$h",
      "sourceSHA256": "c88708f454f5aaba1c4b2734411c3d8f6f4aeb062ff6b1b08797aef152718e90",
      "translationSHA256": "c5415d68b2a4b91552f2e3b70358e4c5a6e7772488c2950d56a497a8e6da8563",
      "reviewChecks": [
