    {
      "target": "Strings/1_6_Strings",
      "key": "DesertFestival_Marnie",
      "field": null,
      "source": "Hey, @. I was just thinking about milk.#$e#Would you ever try camel's milk? I've heard it's salty.",
      "translation": "Ahoj, @. Zrovna jsem přemýšlela o mléce.#$e#Co říkáš na velbloudí mléko? Ochutnáš ho někdy? Slyšela jsem, že je slané.",
      "sourceSHA256": "9dbf956d7f6c35b7f56591fb08678d39b866536fa525fdb93d47b97efb12c66f",
      "translationSHA256": "bd4793afef6ae68b5a29985ff3cb2126ec9a6ac328aba92427dfa33fd6d3218e",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
