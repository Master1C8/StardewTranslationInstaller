    {
      "target": "Strings/1_6_Strings",
      "key": "Marlon_Intro",
      "field": null,
      "source": "Hey there, @. Welcome to the Adventurer's Guild Challenge Booth.#$b#Every day, we'll have a pair of challenges for you to choose from. Complete one, and the guild will reward you with a bounty of Calico Eggs.#$b#Once you've selected a challenge, you won't be able to change your decision, so choose carefully!",
      "translation": "Ahoj, @. Vítej ve stánku výzev Cechu dobrodruhů.#$b#Každý den pro tebe budeme mít dvojici výzev, ze kterých si můžeš vybrat. Jednu splň a cech tě odmění spoustou Vajec Calico.#$b#Jakmile si výzvu vybereš, své rozhodnutí už nebudeš moct změnit, takže vybírej pečlivě!",
      "sourceSHA256": "a3daa15f740cf3c9006933468a203c631c587b871ae067a1b9b1772f67387127",
      "translationSHA256": "eccc3a7542ab0ddc886fbb305ca22bed2c82be69534153cb189eee52f5390743",
      "reviewChecks": [
        "sourceMeaning",
        "detailsAndTone",
        "glossary",
        "czechGrammar",
        "englishResidue",
        "characterVoice",
        "context",
        "tokensAndStructure"
      ]
    },
    {
      "target": "Strings/1_6_Strings",
      "key": "Marlon_1",
      "field": null,
      "source": "Looking to test your mettle, huh?#$b#I've got a few challenges that might do just that.",
      "translation": "Chceš vyzkoušet svou odvahu, co?#$b#Mám několik výzev přesně pro tebe.",
      "sourceSHA256": "cb3d492101f5ee513b90615860a7eb8311c9455792e9195d21469a6910f40a23",
      "translationSHA256": "689c080c79d6a295e6bd609fbc7806dbd07441b886bd8369bdcfffc5d9efd2ee",
