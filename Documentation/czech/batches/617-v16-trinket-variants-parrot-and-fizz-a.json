      "sourceSHA256": "3293f18284b525ce38bedac8c05dc505eee7c4fde809a179d5152e7df8b06eee",
      "translationSHA256": "4208b1b8852fd91ed93247958b9356e660f5ec8e2dddd760112dceac8848b62c",
