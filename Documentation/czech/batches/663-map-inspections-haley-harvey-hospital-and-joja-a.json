    {
      "target": "Strings/StringsFromMaps",
      "key": "Hospital.3",
      "field": null,
      "source": "It's probably not a good idea to stick your hands in there. It's full of used syringes, dirty swabs, and little nozzles that Harvey stuck into people's ears.",
      "translation": "Strkat tam ruce nejspíš není dobrý nápad. Je to plné použitých injekčních stříkaček, špinavých tamponů a malých nástavců, které Harvey strkal lidem do uší.",
      "sourceSHA256": "23f51ed3a9a827f0f62d9c89e62579d7ee73d1b0272567158beb661c03072bce",
      "translationSHA256": "0d03471a878eac7c7ae621c84cff94dc5c1860ca7254d5f2cbfb690f7f5e7403",
