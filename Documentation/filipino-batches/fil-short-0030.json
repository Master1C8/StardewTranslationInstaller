{
  "id": "fil-short-0030",
  "kind": "short",
  "records": [
    {
      "target": "Strings/StringsFromMaps",
      "key": "HarveyRoom.13",
      "source": "\"Ground-To-Air Radio Protocol\"",
      "translation": "\"Protokol sa Radyong Lupa-Papawid\""
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "HarveyRoom.14",
      "source": "It's a pretty standard TV set. It's set to the history station.",
      "translation": "Karaniwan lang na telebisyon ito. Nakatutok ito sa himpilan ng kasaysayan."
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "Hospital.1",
      "source": "The sign of the vessel. It's here to comfort those who believe in Yoba.",
      "translation": "Sagisag ng sisidlan. Narito ito upang magbigay-ginhawa sa mga naniniwala kay Yoba."
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "Hospital.2",
      "source": "It's a sample jar. Better not put your fingers in there.",
      "translation": "Garapon ito ng ispesimen. Huwag mo na sigurong ipasok ang mga daliri mo roon."
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "Hospital.3",
      "source": "It's probably not a good idea to stick your hands in there. It's full of used syringes, dirty swabs, and little nozzles that Harvey stuck into people's ears.",
      "translation": "Hindi magandang ideya na ipasok ang mga kamay mo roon. Punô ito ng mga nagamit na hiringgilya, maruruming pamunas, at maliliit na tubong ipinasok ni Harvey sa mga tainga ng mga tao."
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "Hospital.4",
      "source": "Is life sometimes difficult? Do you ever have trouble staying focused? Talk to your doctor about Pravoloxinone.^(Pravoloxinone is not for everyone. Side effects may include insomnia, severe anger, uncontrollable swelling of the throat, permanent discoloration of the lips, hair loss, and stroke. In extremely rare cases (1 in 500), test subjects experienced complete disintegration of one or more bones.) ",
      "translation": "Mahirap ba kung minsan ang buhay? Nahihirapan ka bang manatiling nakatuon? Kausapin ang doktor mo tungkol sa Pravoloxinone.^(Hindi para sa lahat ang Pravoloxinone. Maaaring kabilang sa mga masamang epekto ang hindi pagkakatulog, matinding galit, hindi mapigil na pamamaga ng lalamunan, permanenteng pagbabago ng kulay ng mga labi, pagkalagas ng buhok, at stroke. Sa napakadalang na mga kaso (1 sa 500), naranasan ng mga kalahok sa pagsubok ang ganap na pagkawatak-watak ng isa o higit pang buto.) "
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "Hospital.5",
      "source": "'Don't spread disease... Cover your sneeze!'",
      "translation": "'Huwag magkalat ng sakit... Takpan ang bibig kapag bumabahing!'"
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "Hospital.6",
      "source": "This clinic is licensed for medical practice by the Ferngill Republic Health Authority.",
      "translation": "Lisensiyado ng Awtoridad sa Kalusugan ng Republika ng Ferngill ang klinikang ito para sa medikal na panggagamot."
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "Hospital.7",
      "source": "Hey, this plant's fake!",
      "translation": "Hoy, peke ang halamang ito!"
    },
