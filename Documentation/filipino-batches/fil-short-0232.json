    {
      "target": "Strings/StringsFromCSFiles",
      "key": "Event.cs.1068",
      "source": "Dr. Harvey charged me {0}g for the hospital visit. ",
      "translation": "Siningil ako ni Dr. Harvey ng {0}g para sa pagpapagamot sa ospital. "
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "Event.cs.1070",
      "source": "I have no money, but Harvey was obligated to save my life free of charge. ",
      "translation": "Wala akong pera, ngunit tungkulin ni Harvey na iligtas ang buhay ko nang walang bayad. "
    },
