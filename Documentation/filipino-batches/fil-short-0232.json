    {
      "target": "Strings/StringsFromCSFiles",
      "key": "Event.cs.1018",
      "source": "Maybe I was being a little presumptuous earlier... sorry.$5",
      "translation": "Baka medyo naging pangahas ako kanina... pasensiya na.$5"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "Event.cs.1020",
      "source": "Thanks for helping out in the lab.$h",
      "translation": "Salamat sa pagtulong sa laboratoryo.$h"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "Event.cs.1025",
      "source": "That was a beautiful ceremony. Congratulations!$h",
      "translation": "Napakaganda ng seremonya. Binabati ko kayo!$h"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "Event.cs.1057",
      "source": "Ow...",
