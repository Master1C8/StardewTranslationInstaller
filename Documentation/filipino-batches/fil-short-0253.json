    {
      "target": "Strings/StringsFromCSFiles",
      "key": "PurchaseAnimalsMenu.cs.11334",
      "source": "Well cared-for adult chickens lay eggs every day.",
      "translation": "Araw-araw ay nangingitlog ang mga manok na nasa hustong gulang at naaalagaang mabuti."
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "PurchaseAnimalsMenu.cs.11335",
      "source": "Lives in the coop.",
      "translation": "Nakatira sa Kulungan."
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "PurchaseAnimalsMenu.cs.11337",
      "source": "Happy adults lay duck eggs every other day.",
      "translation": "Nangingitlog kada dalawang araw ang masasayang bibe na nasa hustong gulang."
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "PurchaseAnimalsMenu.cs.11340",
      "source": "These are woolly rabbits! They shed precious wool every few days.",
      "translation": "Mga balahibuhing kuneho ang mga ito! Naglalagas sila ng mahalagang lana kada ilang araw."
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "PurchaseAnimalsMenu.cs.11343",
      "source": "Adults can be milked daily. A milk pail is required to harvest the milk.",
      "translation": "Maaaring gatasan araw-araw ang mga nasa hustong gulang. Kailangan ng Timba ng Gatas upang makuha ang gatas."
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "PurchaseAnimalsMenu.cs.11344",
      "source": "Lives in the barn.",
      "translation": "Nakatira sa Kamalig."
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "PurchaseAnimalsMenu.cs.11346",
      "source": "These pigs are trained to find truffles!",
      "translation": "Sinanay ang mga baboy na ito upang humanap ng mga truffle!",
      "reviewedEnglishResidue": true,
      "englishResidueReason": "Truffle is a standard Filipino culinary loanword without a clearer natural equivalent."
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "PurchaseAnimalsMenu.cs.11349",
      "source": "Happy adults provide goat milk every other day. A milk pail is required to harvest the milk.",
      "translation": "Nagbibigay ng gatas ng kambing kada dalawang araw ang masasayang kambing na nasa hustong gulang. Kailangan ng Timba ng Gatas upang makuha ang gatas."
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "PurchaseAnimalsMenu.cs.11352",
      "source": "Adults can be shorn for wool. Sheep who form a close bond with their owners can grow wool faster. A pair of shears is required to harvest the wool.",
      "translation": "Maaaring gupitan ang mga tupang nasa hustong gulang upang makakuha ng lana. Mas mabilis magpatubo ng lana ang mga tupang malapit sa kanilang mga amo. Kailangan ng Gunting-Panglana upang makuha ang lana."
    },
