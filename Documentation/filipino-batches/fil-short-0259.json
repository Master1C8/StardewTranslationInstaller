    {
      "target": "Strings/StringsFromCSFiles",
      "key": "Object.cs.12942",
      "source": "The hopper is empty. Build a silo and cut grass with your scythe to refill it.",
      "translation": "Walang laman ang lagayan ng dayami. Magtayo ng Silo at gumapas ng damo gamit ang Karit upang mapuno itong muli."
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "Object.cs.12993",
      "source": "You found an artifact! The curator of the local museum might want to know about this.",
      "translation": "Nakakita ka ng artepakto! Baka nais malaman ito ng tagapangasiwa ng lokal na museo."
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "Object.cs.12994",
      "source": "You found a 'Lost Book'. The library's collection has expanded!",
      "translation": "Nakakita ka ng 'Nawawalang Aklat'. Nadagdagan ang koleksiyon ng aklatan!"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "Object.cs.12995",
      "source": "You found a 'Geode'! The local blacksmith can break it open for you. Who knows what might be hidden inside?",
      "translation": "Nakakita ka ng 'Heoda'! Maaaring basagin ito ng lokal na panday para sa iyo. Sino ang nakaaalam kung ano ang nakatago sa loob?"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "Object.cs.12996",
      "source": "You found a peculiar statue behind Grandpa's Shrine.",
      "translation": "Nakakita ka ng kakaibang rebulto sa likod ng Dambana ni Lolo."
    },
