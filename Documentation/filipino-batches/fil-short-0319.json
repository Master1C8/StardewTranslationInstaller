  "records": [
    {
      "target": "Strings/1_6_Strings",
      "key": "Shop_Kent",
      "source": "Hey, I've got a few things for sale. Let me know if anything catches your eye.",
      "translation": "Hoy, may ilan akong bagay na ibinebenta. Sabihin mo sa akin kung may magustuhan ka."
    },
    {
      "target": "Strings/1_6_Strings",
      "key": "Shop_Eggs",
      "source": "T...Trade... E...Eggs...",
      "translation": "P...Palitan... M...Mga Itlog..."
    },
    {
      "target": "Strings/1_6_Strings",
      "key": "DF_Mine_Explanation",
      "source": "---Welcome to the Skull Cavern Challenge!---^^Calico Eggs and mysterious Calico Statues have appeared throughout the caverns.^",
      "translation": "---Maligayang pagdating sa Hamon sa Yungib ng Bungo!---^^Lumitaw sa buong yungib ang mga Itlog ng Calico at mga mahiwagang Estatwa ng Calico.^"
    },
    {
      "target": "Strings/1_6_Strings",
      "key": "DF_Mine_Explanation_2",
      "source": "Your \"Egg Rating\" determines the likelihood of finding Calico Eggs.^^\"Egg Rating\" increases every 5 levels down, as well as whenever you activate a Calico Statue.^",
      "translation": "Ang iyong \"Marka ng Itlog\" ang tumutukoy sa posibilidad na makahanap ka ng mga Itlog ng Calico.^^Tumataas ang \"Marka ng Itlog\" tuwing makabababa ka ng 5 palapag at tuwing magpapagana ka ng Estatwa ng Calico.^"
    },
    {
      "target": "Strings/1_6_Strings",
      "key": "DF_Mine_Explanation_3",
      "source": "...But be careful! The Calico Statues will also invoke various strange and dangerous effects!^^Visit Gil to receive prizes for achieving a high \"Egg Rating\".^",
      "translation": "...Ngunit mag-ingat ka! Magdudulot din ang mga Estatwa ng Calico ng iba't ibang kakaiba at mapanganib na epekto!^^Bisitahin si Gil upang makatanggap ng mga premyo kapag mataas ang iyong \"Marka ng Itlog\".^"
    },
