    {
      "target": "Strings/StringsFromCSFiles",
      "key": "TitleMenu.cs.11718",
      "source": "Plug in an Xbox One or Xbox 360 controller to activate game pad mode.",
      "translation": "Συνδέστε ένα χειριστήριο Xbox One ή Xbox 360 για να ενεργοποιήσετε τη λειτουργία χειριστηρίου."
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "TitleMenu.cs.11719",
      "source": "Tip: Giving gifts is a good way to make friends with the residents of Stardew Valley.",
      "translation": "Συμβουλή: Τα δώρα είναι ένας καλός τρόπος να γίνετε φίλοι με τους κατοίκους του Stardew Valley."
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "TitleMenu.cs.11720",
      "source": "Tip: Shift-click to purchase 5 items at a time.",
      "translation": "Συμβουλή: Κάντε κλικ με πατημένο το Shift για να αγοράσετε 5 αντικείμενα κάθε φορά."
