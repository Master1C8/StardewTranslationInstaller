    {
      "target": "Strings/StringsFromCSFiles",
      "key": "GrandpaStory.cs.12026",
      "source": "...and for my very special grandson:",
      "translation": "...και για τον πολυαγαπημένο μου εγγονό:"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "GrandpaStory.cs.12028",
      "source": "...and for my very special granddaughter:",
      "translation": "...και για την πολυαγαπημένη μου εγγονή:"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "GrandpaStory.cs.12029",
      "source": "I want you to have this sealed envelope.",
      "translation": "Θέλω να σου δώσω αυτόν τον σφραγισμένο φάκελο."
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "GrandpaStory.cs.12030",
      "source": "No, no, don't open it yet... have patience.",
      "translation": "Όχι, όχι, μην τον ανοίξεις ακόμα... κάνε υπομονή."
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "GrandpaStory.cs.12031",
      "source": "Now, listen close...",
      "translation": "Τώρα, άκου προσεκτικά..."
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "GrandpaStory.cs.12034",
      "source": "There will come a day when you feel crushed by the burden of modern life...",
      "translation": "Θα έρθει μια μέρα που το βάρος της σύγχρονης ζωής θα σε συνθλίβει..."
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "GrandpaStory.cs.12035",
      "source": "...and your bright spirit will fade before a growing emptiness.",
      "translation": "...και το φωτεινό σου πνεύμα θα θαμπώσει μπροστά σε ένα κενό που όλο μεγαλώνει."
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "GrandpaStory.cs.12036",
      "source": "When that happens, my boy, you'll be ready for this gift.",
      "translation": "Όταν συμβεί αυτό, αγόρι μου, θα είσαι έτοιμος γι’ αυτό το δώρο."
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "GrandpaStory.cs.12038",
      "source": "When that happens, my dear, you'll be ready for this gift.",
      "translation": "Όταν συμβεί αυτό, κορίτσι μου, θα είσαι έτοιμη γι’ αυτό το δώρο."
    },
