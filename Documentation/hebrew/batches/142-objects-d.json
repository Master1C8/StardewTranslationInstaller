    {
      "target": "Strings/Objects",
      "key": "Chanterelle_Description",
      "english": "A tasty mushroom with a fruity smell and slightly peppery flavor.",
      "translation": "פטרייה טעימה בעלת ריח פירותי וטעם מעט פלפלי."
    },
    {
