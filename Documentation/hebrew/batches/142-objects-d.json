  "records": [
    {
      "target": "Strings/Objects",
      "key": "CalicoEgg_Name",
      "english": "Calico Egg",
      "translation": "ביצת קליקו"
    },
    {
      "target": "Strings/Objects",
      "key": "CalicoEgg_Description",
      "english": "A unique egg that can be found during the Desert Festival.",
      "translation": "ביצה ייחודית שאפשר למצוא במהלך פסטיבל המדבר."
    },
    {
      "target": "Strings/Objects",
      "key": "CalicoEggStone_Name",
      "english": "Calico Egg Stone",
      "translation": "אבן ביצת קליקו"
    },
    {
      "target": "Strings/Objects",
      "key": "CalicoEggStone_Description",
      "english": "Break apart to obtain Calico Eggs.",
      "translation": "שברו אותה כדי להשיג ביצי קליקו."
    },
    {
      "target": "Strings/Objects",
      "key": "CampingStove_Name",
      "english": "Camping Stove",
      "translation": "כירת מחנאות"
    },
    {
      "target": "Strings/Objects",
      "key": "CampingStove_Description",
      "english": "This allows you to cook anywhere, and is not consumed on use.",
      "translation": "מאפשרת לבשל בכל מקום ואינה מתכלה בשימוש."
    },
    {
