      "translation": "קרפיון"
    },
    {
      "target": "Strings/Objects",
      "key": "Carp_Description",
      "english": "A common pond fish.",
      "translation": "דג בריכות נפוץ."
    },
    {
      "target": "Strings/Objects",
      "key": "CarpSurprise_Name",
      "english": "Carp Surprise",
      "translation": "הפתעת קרפיון"
    },
    {
      "target": "Strings/Objects",
      "key": "CarpSurprise_Description",
      "english": "It's bland and oily.",
      "translation": "היא תפלה ושמנונית."
    },
    {
      "target": "Strings/Objects",
      "key": "Carrot_Name",
      "english": "Carrot",
      "translation": "גזר"
    },
    {
      "target": "Strings/Objects",
      "key": "Carrot_Description",
      "english": "A fast-growing, colorful tuber that makes for a great snack.",
      "translation": "פקעת צבעונית ומהירת צמיחה שמתאימה מאוד כחטיף."
    },
    {
      "target": "Strings/Objects",
      "key": "CarrotSeeds_Name",
      "english": "Carrot Seeds",
      "translation": "זרעי גזר"
    },
    {
      "target": "Strings/Objects",
      "key": "CarrotSeeds_Description",
      "english": "Plant in the spring. Takes 3 days to grow.",
      "translation": "שתלו באביב. גדלים בתוך 3 ימים."
    },
    {
      "target": "Strings/Objects",
      "key": "Catfish_Name",
      "english": "Catfish",
      "translation": "שפמנון"
    },
    {
      "target": "Strings/Objects",
      "key": "Catfish_Description",
      "english": "An uncommon fish found in streams.",
      "translation": "דג לא נפוץ המצוי בנחלים."
    },
    {
      "target": "Strings/Objects",
      "key": "Cauliflower_Name",
      "english": "Cauliflower",
      "translation": "כרובית"
    },
    {
      "target": "Strings/Objects",
      "key": "Cauliflower_Description",
      "english": "Valuable, but slow-growing. Despite its pale color, the florets are packed with nutrients.",
      "translation": "יקרת ערך, אך צומחת לאט. למרות צבעה החיוור, התפרחות הקטנות עמוסות בחומרי הזנה."
    },
    {
      "target": "Strings/Objects",
      "key": "CauliflowerSeeds_Name",
      "english": "Cauliflower Seeds",
      "translation": "זרעי כרובית"
    },
    {
      "target": "Strings/Objects",
      "key": "CauliflowerSeeds_Description",
      "english": "Plant these in the spring. Takes 12 days to produce a large cauliflower.",
      "translation": "שתלו אותם באביב. נדרשים 12 ימים לגדל כרובית גדולה."
    },
    {
      "target": "Strings/Objects",
      "key": "CaveCarrot_Name",
      "english": "Cave Carrot",
      "translation": "גזר מערות"
    },
    {
      "target": "Strings/Objects",
      "key": "CaveCarrot_Description",
      "english": "A starchy snack found in caves. It helps miners work longer.",
      "translation": "חטיף עמילני המצוי במערות. הוא עוזר לכורים לעבוד זמן רב יותר."
    },
    {
      "target": "Strings/Objects",
      "key": "CaveJelly_Name",
      "english": "Cave Jelly",
      "translation": "ג'לי מערות"
    },
    {
      "target": "Strings/Objects",
      "key": "CaveJelly_Description",
      "english": "A rare jelly found in underground lakes.",
      "translation": "ג'לי נדיר המצוי באגמים תת-קרקעיים."
    },
    {
      "target": "Strings/Objects",
      "key": "Caviar_Name",
      "english": "Caviar",
      "translation": "קוויאר"
    },
    {
      "target": "Strings/Objects",
      "key": "Caviar_Description",
      "english": "The cured roe of a sturgeon fish. Considered to be a luxurious delicacy!",
      "translation": "ביצי חדקן כבושות. נחשבות למעדן יוקרתי!"
    },
    {
      "target": "Strings/Objects",
      "key": "Celestine_Name",
      "english": "Celestine",
      "translation": "סלסטין"
    },
    {
      "target": "Strings/Objects",
      "key": "Celestine_Description",
      "english": "Some early life forms had bones made from this.",
      "translation": "לכמה מצורות החיים הקדומות היו עצמות עשויות ממנו."
    },
    {
