      "key": "ChewingStick_Name",
      "english": "Chewing Stick",
      "translation": "מקל לעיסה"
    },
    {
      "target": "Strings/Objects",
      "key": "ChewingStick_Description",
      "english": "Ancient people chewed on these to keep their teeth clean.",
      "translation": "אנשים קדומים לעסו מקלות כאלה כדי לשמור על ניקיון שיניהם."
    },
    {
