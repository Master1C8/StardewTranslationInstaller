      "english": "It's your basic cheese.",
      "translation": "זו גבינה בסיסית."
    },
    {
      "target": "Strings/Objects",
      "key": "CheeseCauliflower_Name",
      "english": "Cheese Cauliflower",
      "translation": "כרובית בגבינה"
    },
    {
      "target": "Strings/Objects",
      "key": "CheeseCauliflower_Description",
      "english": "It smells great!",
      "translation": "הריח נהדר!"
    },
    {
      "target": "Strings/Objects",
      "key": "Cherry_Name",
      "english": "Cherry",
      "translation": "דובדבן"
    },
    {
      "target": "Strings/Objects",
      "key": "Cherry_Description",
      "english": "It's popular, and ripens sooner than most other fruits.",
      "translation": "הוא פופולרי ומבשיל מוקדם מרוב הפירות האחרים."
    },
    {
      "target": "Strings/Objects",
      "key": "CherryBomb_Name",
      "english": "Cherry Bomb",
      "translation": "פצצת דובדבן"
