      "english": "Prehistoric Rib",
      "translation": "צלע פרהיסטורית"
    },
    {
      "target": "Strings/Objects",
      "key": "PrehistoricRib_Description",
      "english": "Little gouge marks on the side suggest that this rib was someone's dinner.",
      "translation": "חריצים קטנים בצד מרמזים שהצלע הזאת הייתה ארוחתו של מישהו."
    },
    {
      "target": "Strings/Objects",
      "key": "PrehistoricScapula_Name",
