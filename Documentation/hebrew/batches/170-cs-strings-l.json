    {
      "target": "Strings/StringsFromCSFiles",
      "key": "TitleMenu.cs.11718",
      "english": "Plug in an Xbox One or Xbox 360 controller to activate game pad mode.",
      "translation": "חברו בקר אקסבוקס וואן או אקסבוקס 360 כדי להפעיל מצב בקר משחק."
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "TitleMenu.cs.11719",
      "english": "Tip: Giving gifts is a good way to make friends with the residents of Stardew Valley.",
      "translation": "טיפ: מתן מתנות הוא דרך טובה להתיידד עם תושבי עמק סטארדיו."
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "TitleMenu.cs.11720",
      "english": "Tip: Shift-click to purchase 5 items at a time.",
      "translation": "טיפ: לחצו תוך כדי החזקת Shift כדי לקנות 5 פריטים בכל פעם.",
      "latinException": {
        "tokens": [
          "Shift"
        ],
        "reason": "Shift is the exact keyboard key label the player must hold, so it remains in Latin script."
      }
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "TitleMenu.cs.11721",
      "english": "After upgrading your hoe or watering can, hold down the tool button to increase the area of effect!",
      "translation": "אחרי שדרוג המעדר או המזלף, החזיקו את כפתור השימוש בכלי כדי להגדיל את אזור ההשפעה!"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "TitleMenu.cs.11722",
      "english": "Tip: Right-click to use a weapon's special move.",
      "translation": "טיפ: לחצו בלחצן העכבר הימני כדי להשתמש במהלך המיוחד של הנשק."
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "TitleMenu.cs.11723",
      "english": "Watch TV shows to learn useful tips, cooking recipes, and more!",
      "translation": "צפו בתוכניות טלוויזיה כדי ללמוד טיפים שימושיים, מתכוני בישול ועוד!"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "TitleMenu.cs.11724",
      "english": "The traveling merchant visits Stardew Valley twice a week. She sells a wide variety of goods, often at exorbitant prices!",
      "translation": "הסוחרת הנודדת מבקרת בעמק סטארדיו פעמיים בשבוע. היא מוכרת מגוון רחב של סחורות, לעיתים קרובות במחירים מופקעים!"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "TitleMenu.cs.11725",
      "english": "Thanks for playing!",
      "translation": "תודה ששיחקתם!"
    },
    {
      "target": "Strings/StringsFromCSFiles",
