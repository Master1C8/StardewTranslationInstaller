    {
      "target": "Strings/StringsFromCSFiles",
      "key": "GrandpaStory.cs.12026",
      "english": "...and for my very special grandson:",
      "translation": "...ולנכד המיוחד מאוד שלי:"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "GrandpaStory.cs.12028",
      "english": "...and for my very special granddaughter:",
      "translation": "...ולנכדה המיוחדת מאוד שלי:"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "GrandpaStory.cs.12029",
      "english": "I want you to have this sealed envelope.",
      "translation": "אני רוצה לתת לך את המעטפה החתומה הזאת."
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "GrandpaStory.cs.12030",
      "english": "No, no, don't open it yet... have patience.",
      "translation": "לא, לא, עוד לא לפתוח אותה... צריך סבלנות."
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "GrandpaStory.cs.12031",
      "english": "Now, listen close...",
      "translation": "עכשיו, כדאי להקשיב היטב..."
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "GrandpaStory.cs.12034",
      "english": "There will come a day when you feel crushed by the burden of modern life...",
      "translation": "יבוא יום שבו תרגישו שאתם קורסים תחת עול החיים המודרניים..."
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "GrandpaStory.cs.12035",
      "english": "...and your bright spirit will fade before a growing emptiness.",
      "translation": "...ורוחכם הזוהרת תדעך מול ריקנות הולכת וגדלה."
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "GrandpaStory.cs.12036",
      "english": "When that happens, my boy, you'll be ready for this gift.",
      "translation": "כשזה יקרה, ילד שלי, תהיה מוכן למתנה הזאת."
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "GrandpaStory.cs.12038",
      "english": "When that happens, my dear, you'll be ready for this gift.",
      "translation": "כשזה יקרה, יקירתי, תהיי מוכנה למתנה הזאת."
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "GrandpaStory.cs.12040",
      "english": "Now, let Grandpa rest...",
      "translation": "עכשיו תנו לסבא לנוח..."
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "GrandpaStory.cs.12051",
      "english": "Dear {0},^^If you're reading this, you must be in dire need of a change.^^The same thing happened to me, long ago. I'd lost sight of what mattered most in life... real connections with other people and nature. So I dropped everything and moved to the place I truly belong.^^^I've enclosed the deed to that place... my pride and joy: {1} Farm. It's located in Stardew Valley, on the southern coast. It's the perfect place to start your new life.^^This was my most precious gift of all, and now it's yours. I know you'll honor the family name, my boy. Good luck.^^Love, Grandpa^^P.S. If Lewis is still alive say hi to the old guy for me, will ya?",
      "translation": "{0} היקר,^^אם אתה קורא את זה, סימן שאתה זקוק נואשות לשינוי.^^אותו הדבר קרה לי לפני זמן רב. שכחתי מה חשוב באמת בחיים... קשרים אמיתיים עם אנשים אחרים ועם הטבע. לכן עזבתי הכול ועברתי למקום שאליו אני באמת שייך.^^^צירפתי את שטר הבעלות על המקום הזה... גאוותי ושמחת חיי: חוות {1}. היא נמצאת בעמק סטארדיו, על החוף הדרומי. זה המקום המושלם להתחיל בו את חייך החדשים.^^זאת הייתה המתנה היקרה ביותר שהייתה לי, ועכשיו היא שלך. אני יודע שתכבד את שם המשפחה, ילד שלי. בהצלחה.^^באהבה, סבא^^נ\"ב: אם לואיס עדיין בחיים, מסור לזקן דרישת שלום ממני, טוב?"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "GrandpaStory.cs.12055",
      "english": "Dear {0},^^If you're reading this, you must be in dire need of a change.^^The same thing happened to me, long ago. I'd lost sight of what mattered most in life... real connections with other people and nature. So I dropped everything and moved to the place I truly belong.^^^I've enclosed the deed to that place... my pride and joy: {1} Farm. It's located in Stardew Valley, on the southern coast. It's the perfect place to start your new life.^^This was my most precious gift of all, and now it's yours. I know you'll honor the family name, my dear. Good luck.^^Love, Grandpa^^P.S. If Lewis is still alive say hi to the old guy for me, will ya?",
      "translation": "{0} היקרה,^^אם את קוראת את זה, סימן שאת זקוקה נואשות לשינוי.^^אותו הדבר קרה לי לפני זמן רב. שכחתי מה חשוב באמת בחיים... קשרים אמיתיים עם אנשים אחרים ועם הטבע. לכן עזבתי הכול ועברתי למקום שאליו אני באמת שייך.^^^צירפתי את שטר הבעלות על המקום הזה... גאוותי ושמחת חיי: חוות {1}. היא נמצאת בעמק סטארדיו, על החוף הדרומי. זה המקום המושלם להתחיל בו את חייך החדשים.^^זאת הייתה המתנה היקרה ביותר שהייתה לי, ועכשיו היא שלך. אני יודע שתכבדי את שם המשפחה, יקירתי. בהצלחה.^^באהבה, סבא^^נ\"ב: אם לואיס עדיין בחיים, מסרי לזקן דרישת שלום ממני, טוב?"
    },
