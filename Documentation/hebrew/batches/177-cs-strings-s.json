    {
      "target": "Strings/StringsFromCSFiles",
      "key": "RandomSentence.6",
      "english": "The Gigantic Submarine floated uncomfortably close to the Mermaid",
      "translation": "הצוללת הענקית צפה קרוב מדי ובאי נוחות לבת הים"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "RandomSentence.7",
      "english": "The Greasy Hyena stood too close to the other Hyena",
      "translation": "הצבוע השמנוני עמד קרוב מדי לצבוע האחר"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "RandomSentence.8",
      "english": "The Gloomy Elf danced atop the Tomb",
      "translation": "השדון הקודר רקד על ראש הקבר"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "RandomSentence.9",
      "english": "The Crusty Lip cracked way above the Biscuit",
      "translation": "השפה הקרושה נסדקה גבוה מעל הביסקוויט"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "RandomSentence.10",
      "english": "The Rubbery Elf swam near the Disaster",
      "translation": "השדון הגמיש שחה ליד האסון"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "RandomSentence.11",
      "english": "The Courageous Quail grilled far, far away from the other Quail",
      "translation": "השליו האמיץ נצלה הרחק הרחק מהשליו האחר"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "RandomSentence.12",
      "english": "The Reasonable Hyena spoke with the Shoe",
      "translation": "הצבוע ההגיוני דיבר עם הנעל"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "RandomSentence.13",
      "english": "The Practical Submarine cracked miles below the Mermaid",
      "translation": "הצוללת המעשית נסדקה קילומטרים מתחת לבת הים"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "RandomSentence.14",
      "english": "The Lonely Puppet ran far, far away from the Planet",
      "translation": "הבובה הבודדה רצה הרחק הרחק מכוכב הלכת"
    },
