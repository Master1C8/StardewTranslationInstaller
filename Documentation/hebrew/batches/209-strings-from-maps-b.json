    {
      "target": "Strings/StringsFromMaps",
      "key": "HaleyHouse.11",
      "english": "It's Haley's camera.",
      "translation": "זו המצלמה של היילי."
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "HaleyHouse.12",
      "english": "'Flailing With Purpose: A Modern Approach To The Art Of Dance'",
      "translation": "'להתנועע בפראות מתוך כוונה: גישה מודרנית לאמנות המחול'"
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "HaleyHouse.13",
      "english": "'Build Your Own Darkroom From Scratch'",
      "translation": "'בנו חדר חושך משלכם מאפס'"
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "HaleyHouse.14",
      "english": "It's a globe. Hey, there's Stardew Valley!",
      "translation": "זה גלובוס. היי, הנה עמק סטארדיו!"
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "HaleyHouse.15",
      "english": "The oven smells sweet like fresh cupcakes.",
      "translation": "מהתנור עולה ריח מתוק של קאפקייקס טריים."
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "HaleyHouse.16",
      "english": "Cupcakes, milk, a tightly sealed jar of cornichons, and quinoa salad.",
      "translation": "קאפקייקס, חלב, צנצנת אטומה היטב של קורנישונים וסלט קינואה."
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "HaleyHouse.17",
      "english": "To our beloved girls:^We miss you and hope that you are doing okay on your own. We just left the Fern Islands last night, after staying for two months.^It was a wonderful experience... highly recommended.^Make sure you eat healthy and don't forget to pay the electricity bill!^^Love, Mom & Dad",
      "translation": "לבנותינו האהובות:^אנחנו מתגעגעים אליכן ומקווים שאתן מסתדרות בכוחות עצמכן. עזבנו את איי פרן רק אמש, לאחר ששהינו שם חודשיים.^זו הייתה חוויה נפלאה... מומלץ בחום.^הקפידו לאכול אוכל בריא ואל תשכחו לשלם את חשבון החשמל!^^באהבה, אמא ואבא"
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "HaleyHouse.18",
      "english": "'Super Fashion Girl' magazine",
      "translation": "כתב העת 'נערת-על אופנתית'"
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "HarveyRoom.1",
      "english": "A comparison between fighter planes of the Ferngill Republic and the Gotoro Empire.",
      "translation": "השוואה בין מטוסי הקרב של רפובליקת פרנגיל לבין אלה של אימפריית גוטורו."
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "HarveyRoom.2",
      "english": "There's a beautiful view of the sky above Stardew Valley.",
      "translation": "יש כאן נוף יפהפה של השמים שמעל עמק סטארדיו."
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "HarveyRoom.3",
      "english": "It's Harvey's model airplane collection.",
      "translation": "זה אוסף דגמי המטוסים של הארווי."
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "HarveyRoom.4",
      "english": "It's Harvey's model airplane collection.",
      "translation": "זה אוסף דגמי המטוסים של הארווי."
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "HarveyRoom.5",
      "english": "It's a complicated radio broadcasting set.",
      "translation": "זו מערכת שידור רדיו מורכבת."
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "HarveyRoom.6",
      "english": "It's a complicated radio broadcasting set.",
      "translation": "זו מערכת שידור רדיו מורכבת."
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "HarveyRoom.7",
      "english": "There's a tape inside: 'Anthology Of Classic Jazz'",
      "translation": "יש בפנים קלטת: 'אנתולוגיה של ג'אז קלאסי'"
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "HarveyRoom.8",
      "english": "'Do-It-Yourself! Knee Surgery'",
      "translation": "'עשו זאת בעצמכם! ניתוח ברך'"
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "HarveyRoom.9",
      "english": "'The Lone Ranger Of Pulmonary Hypertension'",
      "translation": "'הפרש הבודד של יתר לחץ דם ריאתי'"
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "HarveyRoom.10",
      "english": "You didn't find anything, and now your hands smell bad.",
      "translation": "לא מצאתם שום דבר, ועכשיו הידיים שלכם מסריחות."
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "HarveyRoom.11",
      "english": "It looks well used.",
      "translation": "נראה שהשתמשו בו הרבה."
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "HarveyRoom.12",
      "english": "It's full of convenience food.",
      "translation": "הוא מלא במזון מהיר להכנה."
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "HarveyRoom.13",
      "english": "\"Ground-To-Air Radio Protocol\"",
      "translation": "\"נוהל תקשורת רדיו קרקע-אוויר\""
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "HarveyRoom.14",
      "english": "It's a pretty standard TV set. It's set to the history station.",
      "translation": "זה מקלט טלוויזיה רגיל למדי. הוא מכוון לערוץ ההיסטוריה."
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "Hospital.1",
      "english": "The sign of the vessel. It's here to comfort those who believe in Yoba.",
      "translation": "סימן הכלי. הוא נמצא כאן כדי לנחם את המאמינים ביובה."
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "Hospital.2",
      "english": "It's a sample jar. Better not put your fingers in there.",
      "translation": "זו צנצנת דגימות. עדיף שלא תכניסו אצבעות פנימה."
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "Hospital.3",
      "english": "It's probably not a good idea to stick your hands in there. It's full of used syringes, dirty swabs, and little nozzles that Harvey stuck into people's ears.",
      "translation": "כנראה לא כדאי להכניס לשם את הידיים. המכל מלא במזרקים משומשים, מטושים מלוכלכים ופיות קטנות שהארווי הכניס לאוזניהם של אנשים."
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "Hospital.4",
      "english": "Is life sometimes difficult? Do you ever have trouble staying focused? Talk to your doctor about Pravoloxinone.^(Pravoloxinone is not for everyone. Side effects may include insomnia, severe anger, uncontrollable swelling of the throat, permanent discoloration of the lips, hair loss, and stroke. In extremely rare cases (1 in 500), test subjects experienced complete disintegration of one or more bones.) ",
      "translation": "האם החיים קשים לפעמים? האם אתם מתקשים לפעמים להתרכז? שאלו את הרופא שלכם על פרבולוקסינון.^(פרבולוקסינון אינו מתאים לכולם. תופעות הלוואי עלולות לכלול נדודי שינה, כעס חמור, התנפחות בלתי נשלטת של הגרון, שינוי קבוע בצבע השפתיים, נשירת שיער ושבץ. במקרים נדירים ביותר (1 מכל 500), נבדקים חוו התפוררות מוחלטת של עצם אחת או יותר.) "
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "Hospital.5",
      "english": "'Don't spread disease... Cover your sneeze!'",
      "translation": "'אל תפיצו מחלות... כסו את הפה ואת האף כשאתם מתעטשים!'"
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "Hospital.6",
      "english": "This clinic is licensed for medical practice by the Ferngill Republic Health Authority.",
      "translation": "מרפאה זו מורשית לעסוק ברפואה מטעם רשות הבריאות של רפובליקת פרנגיל."
