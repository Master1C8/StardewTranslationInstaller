{
  "id": "hi-long-0171",
  "kind": "long",
  "records": [
    {
      "target": "Strings/SpecialOrderStrings",
      "key": "Clint_Name",
      "translation": "गुफ़ा गश्त"
    },
    {
      "target": "Strings/SpecialOrderStrings",
      "key": "Clint_Text",
      "translation": "स्थानीय गुफ़ाओं में {Monster:LocalizedName} की संख्या ने खनन को ख़तरनाक बना दिया है... दूसरे लोगों के लिए, मेरे लिए नहीं! इनमें से 50 को मारने वाले को अच्छे पैसे मिलेंगे।          -क्लिंट"
    },
    {
      "target": "Strings/SpecialOrderStrings",
      "key": "Clint_Objective_0_Text",
      "translation": "50 {Monster:LocalizedName} मारें।"
    },
    {
      "target": "Strings/SpecialOrderStrings",
      "key": "Clint_RE_Monster_0_LocalizedName",
      "translation": "चमगादड़"
    },
    {
      "target": "Strings/SpecialOrderStrings",
      "key": "Clint_RE_Monster_1_LocalizedName",
      "translation": "धूल आत्माएँ"
    },
    {
      "target": "Strings/SpecialOrderStrings",
      "key": "Clint_RE_Monster_2_LocalizedName",
      "translation": "कंकाल"
    },
    {
      "target": "Strings/SpecialOrderStrings",
      "key": "Clint_RE_Monster_3_LocalizedName",
      "translation": "लार्वा"
    },
    {
      "target": "Strings/SpecialOrderStrings",
      "key": "Linus_Name",
      "translation": "सामुदायिक सफ़ाई"
    },
    {
      "target": "Strings/SpecialOrderStrings",
      "key": "Linus_Text",
      "translation": "मेरे पास एक विचार है। पानी में बहुत कचरा है। क्यों न उसमें से कुछ निकालकर वैली को और सुंदर बनाएँ?                     -लायनस"
    },
    {
      "target": "Strings/SpecialOrderStrings",
      "key": "Linus_Objective_0_Text",
      "translation": "कचरे के 20 टुकड़े इकट्ठे करें।"
    },
    {
      "target": "Strings/SpecialOrderStrings",
      "key": "Linus_Objective_1_Text",
      "translation": "कचरा रेल प्लेटफ़ॉर्म के पीछे पुनर्चक्रण पेटी में डालें।"
    },
    {
      "target": "Strings/SpecialOrderStrings",
      "key": "Evelyn_Name",
      "translation": "जॉर्ज के लिए उपहार"
    },
    {
      "target": "Strings/SpecialOrderStrings",
      "key": "Evelyn_Text",
      "translation": "जॉर्ज को लगता है नगर में किसी को उसकी परवाह नहीं। मैं उसे ग़लत साबित करना चाहती हूँ! एक दर्जन लीक से काम बन जाना चाहिए... वे उसके पसंदीदा हैं।                      -एवलिन"
    },
    {
      "target": "Strings/SpecialOrderStrings",
      "key": "Evelyn_Objective_0_Text",
      "translation": "12 लीक इकट्ठे करें।"
    },
    {
      "target": "Strings/SpecialOrderStrings",
      "key": "Evelyn_Objective_1_Text",
      "translation": "लीक एवलिन की रसोई में रखें।"
    },
    {
      "target": "Strings/SpecialOrderStrings",
      "key": "Wizard2_Name",
      "translation": "प्रिज़्म जेली"
    },
    {
      "target": "Strings/SpecialOrderStrings",
      "key": "Wizard2_Text",
      "translation": "स्थानीय गुफ़ाओं में दुर्लभ और ख़तरनाक प्रिज़्म स्लाइम खोजने के लिए मुझे मदद चाहिए। उसकी प्रिज़्म जेली का एक मर्तबान लाओ और तुम्हें उचित पुरस्कार मिलेगा।        -एम. रास्मोडियस"
    },
    {
      "target": "Strings/SpecialOrderStrings",
      "key": "Wizard2_Objective_0_Text",
      "translation": "एक प्रिज़्म स्लाइम मारें।"
    },
    {
      "target": "Strings/SpecialOrderStrings",
      "key": "Wizard2_Objective_1_Text",
      "translation": "जादूगर को प्रिज़्म जेली दें"
    },
    {
      "target": "Strings/SpecialOrderStrings",
      "key": "Wizard2_Objective_1_Message",
      "translation": "आह... तुम शिकार से लौट आए। मुझे आभास है कि तुम सफल रहे!$h#$b#अब जेली मुझे सौंपो और जाओ! मुझे ज़रूरी काम करना है।"
    },
    {
      "target": "Strings/SpecialOrderStrings",
      "key": "Robin2_Name",
      "translation": "रॉबिन की संसाधन दौड़"
    },
    {
      "target": "Strings/SpecialOrderStrings",
      "key": "Robin2_Text",
      "translation": "मैं बस मज़े के लिए छोटा-सा प्रचार चला रही हूँ। अगर कोई एक सप्ताह में {Resource:Text} के 1000 टुकड़े इकट्ठे कर ले, तो उसे पुरस्कार मिलेगा। और {Resource:Text} तुम अपने पास रख सकते हो!             -रॉबिन"
    },
    {
      "target": "Strings/SpecialOrderStrings",
      "key": "Robin2_Objective_0_Text",
      "translation": "{Resource:Text} के 1000 टुकड़े इकट्ठे करें।"
    },
    {
      "target": "Strings/SpecialOrderStrings",
      "key": "Gunther_Name",
      "translation": "अतीत के टुकड़े"
    },
    {
      "target": "Strings/SpecialOrderStrings",
      "key": "Gunther_Text",
      "translation": "सभी शौकिया जीवाश्म विज्ञानियों को बुलावा! अपने अध्ययन के लिए मुझे हड्डी के 100 टुकड़े चाहिए। कृपया इन्हें संग्रहालय के काउंटर पर जमा कर दें!          -गुंथर"
    },
    {
      "target": "Strings/SpecialOrderStrings",
      "key": "Gunther_Objective_1_Text",
      "translation": "हड्डी के 100 टुकड़े इकट्ठे करें।"
    },
    {
      "target": "Strings/SpecialOrderStrings",
      "key": "Gunther_Objective_0_Text",
      "translation": "हड्डियाँ संग्रहालय के काउंटर पर जमा पेटी में रखें।"
    },
    {
      "target": "Strings/SpecialOrderStrings",
      "key": "Caroline_Name",
      "translation": "द्वीप की सामग्री"
    },
    {
      "target": "Strings/SpecialOrderStrings",
      "key": "Caroline_Text",
      "translation": "मैं उष्णकटिबंधीय पकवानों के प्रयोग करना चाहती हूँ, मगर कोई सामग्री मिलना कठिन है। अगर कोई 100 {Crop:TextPlural} भेज सके, तो शायद मदद हो जाए! "
    },
    {
      "target": "Strings/SpecialOrderStrings",
      "key": "Caroline_Objective_0_Text",
      "translation": "100 {Crop:Text} भेजें।"
    }
  ]
}
