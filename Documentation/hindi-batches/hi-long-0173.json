{
  "id":"hi-long-0173","kind":"long","records":[
    {"target":"Strings/SpecialOrderStrings","key":"QiChallenge8_Name","translation":"विस्तृत परिवार"},
    {"target":"Strings/SpecialOrderStrings","key":"QiChallenge8_Text","translation":"पौराणिक मछलियों के परिवार वाले वैली लौट आए हैं। तुम्हारे पास सुश्री एंगलर, कनिष्ठ हिमनद मछली, क्रिमसनफ़िश का बेटा, रेडियोधर्मी कार्प और लीजेंड द्वितीय को पकड़ने के लिए तीन दिन हैं।"},
    {"target":"Strings/SpecialOrderStrings","key":"QiChallenge8_Objective_0_Text","translation":"सुश्री एंगलर को पकड़ें।"},
    {"target":"Strings/SpecialOrderStrings","key":"QiChallenge8_Objective_1_Text","translation":"कनिष्ठ हिमनद मछली को पकड़ें।"},
    {"target":"Strings/SpecialOrderStrings","key":"QiChallenge8_Objective_2_Text","translation":"क्रिमसनफ़िश के बेटे को पकड़ें।"},
    {"target":"Strings/SpecialOrderStrings","key":"QiChallenge8_Objective_3_Text","translation":"रेडियोधर्मी कार्प को पकड़ें।"},
    {"target":"Strings/SpecialOrderStrings","key":"QiChallenge8_Objective_4_Text","translation":"लीजेंड द्वितीय को पकड़ें।"},
    {"target":"Strings/SpecialOrderStrings","key":"QiChallenge9_Name","translation":"गहराई में ख़तरा"},
    {"target":"Strings/SpecialOrderStrings","key":"QiChallenge9_Text","translation":"खदान की लिफ़्ट प्रणाली फिर से शुरू हुई है और भूमिगत गहराई से नए ख़तरे उभरे हैं। एक सप्ताह में खदानों की तलहटी तक पहुँचो।"},
    {"target":"Strings/SpecialOrderStrings","key":"QiChallenge9_Objective_0_Text","translation":"दोबारा खदानों की तलहटी तक पहुँचें।"},
    {"target":"Strings/SpecialOrderStrings","key":"QiChallenge10_Name","translation":"खोपड़ी गुफ़ा पर हमला"},
    {"target":"Strings/SpecialOrderStrings","key":"QiChallenge10_Text","translation":"शक्तिशाली राक्षसों ने खोपड़ी गुफ़ा पर हमला कर दिया है। सही-सलामत स्तर 100 तक पहुँचो।"},
    {"target":"Strings/SpecialOrderStrings","key":"QiChallenge10_Objective_0_Text","translation":"खोपड़ी गुफ़ा के स्तर 100 तक पहुँचें।"},
    {"target":"Strings/SpecialOrderStrings","key":"QiChallenge11_Name","translation":"ची का हमशक्ल खोजो"},
    {"target":"Strings/SpecialOrderStrings","key":"QiChallenge11_Text","translation":"नगर में कहीं मेरा दूसरा रूप छिपा है। क्या तुम उसे पकड़ सकते हो?"},
    {"target":"Strings/SpecialOrderStrings","key":"QiChallenge11_Objective_0_Text","translation":"ची के हमशक्ल को पकड़ें।"},
    {"target":"Strings/SpecialOrderStrings","key":"QiChallenge12_Name","translation":"ची की प्रिज़्म प्रदर्शनी"},
    {"target":"Strings/SpecialOrderStrings","key":"QiChallenge12_Text","translation":"लाल, नारंगी, पीली, हरी, नीली और बैंगनी रंग की 100-100 वस्तुएँ खोजो। उन्हें मेरी संग्रह पेटी में रखो।"},
    {"target":"Strings/SpecialOrderStrings","key":"QiChallenge12_Objective_0_Text","translation":"ची की संग्रह पेटी में 100 लाल वस्तुएँ रखें।"},
    {"target":"Strings/SpecialOrderStrings","key":"QiChallenge12_Objective_1_Text","translation":"ची की संग्रह पेटी में 100 नारंगी वस्तुएँ रखें।"},
    {"target":"Strings/SpecialOrderStrings","key":"QiChallenge12_Objective_2_Text","translation":"ची की संग्रह पेटी में 100 पीली वस्तुएँ रखें।"},
    {"target":"Strings/SpecialOrderStrings","key":"QiChallenge12_Objective_3_Text","translation":"ची की संग्रह पेटी में 100 हरी वस्तुएँ रखें।"},
    {"target":"Strings/SpecialOrderStrings","key":"QiChallenge12_Objective_4_Text","translation":"ची की संग्रह पेटी में 100 नीली वस्तुएँ रखें।"},
    {"target":"Strings/SpecialOrderStrings","key":"QiChallenge12_Objective_5_Text","translation":"ची की संग्रह पेटी में 100 बैंगनी वस्तुएँ रखें।"},
    {"target":"Strings/SpecialOrderStrings","key":"Marlon_DF_0_Name","translation":"राक्षस शिकार"},
    {"target":"Strings/SpecialOrderStrings","key":"Marlon_DF_0_Text","translation":"खोपड़ी गुफ़ा में उतरकर 10 {Monster:LocalizedName} मारें।"},
