    {"target":"Characters/Dialogue/MarriageDialogueKrobus","key":"spring_1","translation":"नए साल के लिए तुम्हारी क्या योजना है, @?"},
    {"target":"Characters/Dialogue/MarriageDialogueKrobus","key":"spring_23","translation":"कल पुष्प नृत्य में ज़रूर जाना! मेरी चिंता मत करना।"},
    {"target":"Characters/Dialogue/MarriageDialogueKrobus","key":"summer_1","translation":"मुझे बहुत आसानी से धूप से जलन हो जाती है, इसलिए साल के इस समय सावधान रहना पड़ता है।"},
    {"target":"Characters/Dialogue/MarriageDialogueKrobus","key":"summer_8","translation":"हम्म... यह प्यारी महक कैसी है? लगता है रात भर ख़ूब पसीना आया...$h"},
    {"target":"Characters/Dialogue/MarriageDialogueKrobus","key":"summer_15","translation":"ग्रीष्म आ गया है... यानी घर मक्खियों से भर गया है।#$e#चिंता मत करो, मैं उन्हें सँभाल लूँगा। अच्छा प्रोटीन है!$h"},
    {"target":"Characters/Dialogue/MarriageDialogueKrobus","key":"fall_8","translation":"आज कुछ भी करने का मन नहीं है।"},
    {"target":"Characters/Dialogue/MarriageDialogueKrobus","key":"fall_15","translation":"कल के कृषि प्रदर्शन में क्या इस्तेमाल करना है, तय किया?"},
    {"target":"Characters/Dialogue/MarriageDialogueKrobus","key":"fall_24","translation":"अगर आत्माओं की संध्या त्योहार में दिखाई दिया तो वे मुझे पिंजरे में डाल देंगे...$s"},
    {"target":"Characters/Dialogue/MarriageDialogueKrobus","key":"winter_28","translation":"मुझे यहाँ रहने देने के लिए धन्यवाद, @। एक और शानदार साल की प्रतीक्षा है!$h"},
    {"target":"Characters/Dialogue/MarriageDialogueKrobus","key":"spouseRoom_Krobus","translation":"#$c .5#हम शारीरिक रूप से इतने अलग हैं कि साथ रहना एक चुनौती है, है न?#$e#उम्मीद है यहाँ की नमी तुम्हें परेशान नहीं करती। साथ रहने के लिए हम दोनों को समझौते करने होंगे!"},
    {"target":"Characters/Dialogue/MarriageDialogueKrobus","key":"spring_Krobus","translation":"अब 'वसंत' है, है न? मुझे जंगली हॉर्सरैडिश की तीखी सुगंध आ रही है।"},
    {"target":"Characters/Dialogue/MarriageDialogueKrobus","key":"summer_Krobus","translation":"तुम साल के इस समय को 'ग्रीष्म' कहते हो, है न? गर्मी और नमी अच्छी है, मगर काश इतनी धूप न होती।"},
    {"target":"Characters/Dialogue/MarriageDialogueKrobus","key":"fall_Krobus","translation":"इन दिनों थोड़ी ठंडक और सीलन भरी महक महसूस हो रही है। तुम साल के इस समय को 'पतझड़' कहते हो, सही?"},
    {"target":"Characters/Dialogue/MarriageDialogueKrobus","key":"winter_Krobus","translation":"साल के इस समय का अँधेरा बहुत सुकून देता है। काश बस थोड़ी गर्मी होती!"}
  ]
}
