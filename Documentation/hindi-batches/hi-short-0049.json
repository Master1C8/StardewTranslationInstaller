    },
    {
      "target": "Strings/Characters",
      "key": "AbigailInMineFlute",
      "translation": "%एबिगेल अपने संगीत में खोई हुई है..."
    },
    {
      "target": "Strings/Characters",
      "key": "AbigailInMineFirst",
      "translation": "अरे, @। हैरान हो? ...आख़िरकार मुझे यहाँ नीचे आने की हिम्मत मिल ही गई।#$b#शुरू में डर लगा, लेकिन मैंने उस पर काबू पा लिया।#$b#अब मेरा आत्मविश्वास काफ़ी बढ़ गया है। सच कहूँ तो इसमें बहुत मज़ा आ रहा है!$h"
    },
    {
      "target": "Strings/Characters",
      "key": "AbigailInMine0",
      "translation": "अरे! मैं काफ़ी अंदर तक आ गई हूँ, है न?$h"
    },
    {
      "target": "Strings/Characters",
      "key": "AbigailInMine1",
      "translation": "ईईक!$7#$b#हाहाहा! तुमने मुझे डरा दिया! मुझे यहाँ नीचे किसी और इंसान के मिलने की उम्मीद नहीं थी!$h#$e#माफ़ करना, रोमांच के मारे मैं पसीने से तर हूँ..."
    },
    {
      "target": "Strings/Characters",
      "key": "AbigailInMine2",
      "translation": "नमस्ते @! मैं किसी भी राक्षस से लड़े बिना यहाँ तक आ गई... "
    },
    {
      "target": "Strings/Characters",
      "key": "AbigailInMine3",
      "translation": "अरे! तुम्हें यहाँ नीचे देखकर राहत मिली...$h#$e#उम्म... मेरे पापा को मत बताना कि मैं यहाँ हूँ, ठीक है?$9"
    },
    {
      "target": "Strings/Characters",
      "key": "AbigailInMine4",
      "translation": "अरे! बारिश के दिन खदानें घूम रहे हो, है न? मैं भी!$h"
    },
    {
      "target": "Strings/Characters",
      "key": "Henchman1",
      "translation": "ग्वीई-आह!! इंसान!#$b#...आगे जाना है? माफ़ करना, यह निजी जगह है।$s"
    },
    {
      "target": "Strings/Characters",
      "key": "Henchman2",
      "translation": "माफ़ करना, लेकिन मैं तुम्हें आगे नहीं जाने दे सकता... मेरी नौकरी चली जाएगी।"
    },
    {
      "target": "Strings/Characters",
      "key": "Henchman3",
      "translation": "यह मुझे दे रहे हो? हम्म... नहीं, धन्यवाद।$s"
    },
    {
      "target": "Strings/Characters",
      "key": "Henchman4",
      "translation": "म्म्म्म... यह ताज़ा तो लग रहा है, लेकिन नहीं चाहिए... तुम ही क्यों नहीं रख लेते?"
    }
  ]
