    {"target":"Strings/Objects","key":"Apple_Name","translation":"सेब"},
    {"target":"Strings/Objects","key":"Apple_Description","translation":"रस और साइडर बनाने में इस्तेमाल होने वाला कुरकुरा फल।"},
    {"target":"Strings/Objects","key":"AppleSapling_Name","translation":"सेब का पौधा"},
    {"target":"Strings/Objects","key":"AppleSapling_Description","translation":"परिपक्व सेब का पेड़ बनने में 28 दिन लगते हैं। पतझड़ में फल देता है। केवल तभी बढ़ता है जब आस-पास के 8 'खाने' ख़ाली हों।"},
    {"target":"Strings/Objects","key":"Apricot_Name","translation":"खुबानी"},
    {"target":"Strings/Objects","key":"Apricot_Description","translation":"पत्थर जैसी सख़्त गुठली वाला नाज़ुक छोटा फल।"},
    {"target":"Strings/Objects","key":"ApricotSapling_Name","translation":"खुबानी का पौधा"},
    {"target":"Strings/Objects","key":"ApricotSapling_Description","translation":"परिपक्व खुबानी का पेड़ बनने में 28 दिन लगते हैं। वसंत में फल देता है। केवल तभी बढ़ता है जब आस-पास के 8 'खाने' ख़ाली हों।"},
    {"target":"Strings/Objects","key":"Aquamarine_Name","translation":"ऐक्वामरीन"},
    {"target":"Strings/Objects","key":"Aquamarine_Description","translation":"झिलमिलाता नीला-हरा रत्न।"},
