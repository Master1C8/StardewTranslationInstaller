    {"target":"Strings/Objects","key":"AncientDoll_Name","translation":"प्राचीन गुड़िया"},
    {"target":"Strings/Objects","key":"AncientDoll_Description","translation":"मैल से ढकी प्राचीन गुड़िया। शायद इसका इस्तेमाल खिलौने, सजावट या किसी अनुष्ठान की वस्तु के रूप में होता था।"},
    {"target":"Strings/Objects","key":"AncientDrum_Name","translation":"प्राचीन ढोल"},
    {"target":"Strings/Objects","key":"AncientDrum_Description","translation":"लकड़ी और पशु की खाल से बना ढोल। इसकी आवाज़ नीची और गूँजदार है।"},
    {"target":"Strings/Objects","key":"AncientFruit_Name","translation":"प्राचीन फल"},
    {"target":"Strings/Objects","key":"AncientFruit_Description","translation":"यह युगों से सुप्त पड़ा है।"},
    {"target":"Strings/Objects","key":"AncientSeed_Name","translation":"प्राचीन बीज"},
    {"target":"Strings/Objects","key":"AncientSeed_Description","translation":"किसी प्राचीन पौधे का सूखा पुराना बीज। देखने से लगता है यह बहुत पहले मर चुका है..."},
    {"target":"Strings/Objects","key":"AncientSeeds_Name","translation":"प्राचीन बीज"},
    {"target":"Strings/Objects","key":"AncientSeeds_Description","translation":"क्या ये अब भी उग सकते हैं?"},
    {"target":"Strings/Objects","key":"AncientSword_Name","translation":"प्राचीन तलवार"},
    {"target":"Strings/Objects","key":"AncientSword_Description","translation":"एक प्राचीन तलवार के अवशेष। ज़्यादातर फल पर ज़ंग लग चुका है, मगर मूठ बहुत बारीकी से बनाई गई है।"},
    {"target":"Strings/Objects","key":"Angler_Name","translation":"एंगलर मछली"},
