{
  "id":"hi-short-0142","kind":"short","records":[
    {"target":"Strings/Objects","key":"AquamarineStone_Name","translation":"ऐक्वामरीन पत्थर"},
    {"target":"Strings/Objects","key":"AquamarineStone_Description","translation":"ऐक्वामरीन पाने के लिए इसे तोड़ें।"},
    {"target":"Strings/Objects","key":"ArcticShard_Name","translation":"आर्कटिक टुकड़ा"},
    {"target":"Strings/Objects","key":"ArcticShard_Description","translation":"यह टुकड़ा दूसरी दुनिया की नीली रोशनी से चमकता है।"},
    {"target":"Strings/Objects","key":"Arrowhead_Name","translation":"तीर का फल"},
    {"target":"Strings/Objects","key":"Arrowhead_Description","translation":"शिकार के लिए इस्तेमाल होने वाला बेढंगे ढंग से बनाया नुकीला सिरा।"},
    {"target":"Strings/Objects","key":"Artichoke_Name","translation":"आर्टिचोक"},
    {"target":"Strings/Objects","key":"Artichoke_Description","translation":"काँटेदार पौधे की कली। बाहर की नुकीली पत्तियाँ भीतर का गूदेदार, पेट भरने वाला हिस्सा छिपाती हैं।"},
    {"target":"Strings/Objects","key":"ArtichokeDip_Name","translation":"आर्टिचोक डिप"},
    {"target":"Strings/Objects","key":"ArtichokeDip_Description","translation":"यह ठंडा और ताज़गी भरा है।"},
    {"target":"Strings/Objects","key":"ArtichokeSeeds_Name","translation":"आर्टिचोक के बीज"},
    {"target":"Strings/Objects","key":"ArtichokeSeeds_Description","translation":"इन्हें पतझड़ में बोएँ। पकने में 8 दिन लगते हैं।"},
    {"target":"Strings/Objects","key":"ArtifactSpot_Name","translation":"पुरावशेष स्थल"},
    {"target":"Strings/Objects","key":"ArtifactSpot_Description","translation":"यह तुम्हारी सूची में कैसे आया?"},
    {"target":"Strings/Objects","key":"ArtifactTrove_Name","translation":"पुरावशेष भंडार"},
    {"target":"Strings/Objects","key":"ArtifactTrove_Description","translation":"लोहार इसे तुम्हारे लिए खोल सकता है। इन भंडारों में अक्सर प्राचीन अवशेष और विचित्र वस्तुएँ होती हैं।"},
    {"target":"Strings/Objects","key":"AutumnsBounty_Name","translation":"पतझड़ की सौगात"},
    {"target":"Strings/Objects","key":"AutumnsBounty_Description","translation":"ऋतु का स्वाद।"},
    {"target":"Strings/Objects","key":"Bait_Name","translation":"चारा"},
    {"target":"Strings/Objects","key":"Bait_Description","translation":"मछलियों को जल्दी काटने पर मजबूर करता है। पहले इसे मछली पकड़ने की छड़ पर लगाना होगा।"},
    {"target":"Strings/Objects","key":"BakedFish_Name","translation":"भुनी मछली"},
    {"target":"Strings/Objects","key":"BakedFish_Description","translation":"जड़ी-बूटियों की तह पर भुनी मछली।"},
    {"target":"Strings/Objects","key":"Banana_Name","translation":"केला"},
    {"target":"Strings/Objects","key":"Banana_Description","translation":"मीठा और स्टार्च से भरपूर उष्णकटिबंधीय फल।"},
    {"target":"Strings/Objects","key":"BananaPudding_Name","translation":"केले की पुडिंग"},
    {"target":"Strings/Objects","key":"BananaPudding_Description","translation":"शानदार उष्णकटिबंधीय स्वाद वाली मलाईदार मिठाई।"},
    {"target":"Strings/Objects","key":"BananaSapling_Name","translation":"केले का पौधा"},
    {"target":"Strings/Objects","key":"BananaSapling_Description","translation":"परिपक्व केले का पेड़ बनने में 28 दिन लगते हैं। गर्मियों में, या जिंजर द्वीप पर बोने पर पूरे साल फल देता है।"},
    {"target":"Strings/Objects","key":"BarbedHook_Name","translation":"काँटेदार हुक"},
    {"target":"Strings/Objects","key":"BarbedHook_Description","translation":"पकड़ को सुरक्षित बनाता है, जिससे 'मछली पकड़ने की पट्टी' मछली से चिपकी रहती है। धीमी, कमज़ोर मछलियों पर सबसे अच्छा काम करता है।"},
    {"target":"Strings/Objects","key":"Baryte_Name","translation":"बैराइट"},
    {"target":"Strings/Objects","key":"Baryte_Description","translation":"सबसे अच्छे नमूने मरुस्थली गुलाब जैसे दिखते हैं।"},
    {"target":"Strings/Objects","key":"Basalt_Name","translation":"बेसाल्ट"},
    {"target":"Strings/Objects","key":"Basalt_Description","translation":"झुलसा देने वाले गर्म मैग्मा के पास बनता है।"},
    {"target":"Strings/Objects","key":"BasicFertilizer_Name","translation":"साधारण उर्वरक"},
    {"target":"Strings/Objects","key":"BasicFertilizer_Description","translation":"मिट्टी की गुणवत्ता थोड़ी सुधारता है, जिससे गुणवत्तापूर्ण फ़सल उगने की संभावना बढ़ती है। जोती हुई मिट्टी में मिलाएँ।"},
    {"target":"Strings/Objects","key":"BasicRetainingSoil_Name","translation":"साधारण जलधारी मिट्टी"},
    {"target":"Strings/Objects","key":"BasicRetainingSoil_Description","translation":"इस मिट्टी के रात भर नम रहने की संभावना होती है। जोती हुई मिट्टी में मिलाएँ।"},
    {"target":"Strings/Objects","key":"BatteryPack_Name","translation":"बैटरी पैक"},
    {"target":"Strings/Objects","key":"BatteryPack_Description","translation":"यह बहुमूल्य ऊर्जा से पूरी तरह भरा है।"},
    {"target":"Strings/Objects","key":"BatWing_Name","translation":"चमगादड़ का पंख"},
    {"target":"Strings/Objects","key":"BatWing_Description","translation":"यह सामग्री आश्चर्यजनक रूप से नाज़ुक है।"},
    {"target":"Strings/Objects","key":"BeanHotpot_Name","translation":"सेम की हांडी"},
    {"target":"Strings/Objects","key":"BeanHotpot_Description","translation":"यह सच में सेहतमंद है।"},
    {"target":"Strings/Objects","key":"BeanStarter_Name","translation":"सेम की पौध"},
    {"target":"Strings/Objects","key":"BeanStarter_Description","translation":"इसे वसंत में रोपें। पकने में 10 दिन लगते हैं और फिर लगातार फलती है। मचान पर बढ़ती है।"},
    {"target":"Strings/Objects","key":"Beer_Name","translation":"बीयर"},
    {"target":"Strings/Objects","key":"Beer_Description","translation":"संयम से पिएँ।"},
    {"target":"Strings/Objects","key":"Beet_Name","translation":"चुकंदर"},
    {"target":"Strings/Objects","key":"Beet_Description","translation":"मीठी और मिट्टी जैसी सुगंध वाली जड़ सब्ज़ी। अतिरिक्त फ़ायदे के रूप में इसकी पत्तियों का शानदार सलाद बनता है।"},
    {"target":"Strings/Objects","key":"BeetSeeds_Name","translation":"चुकंदर के बीज"},
    {"target":"Strings/Objects","key":"BeetSeeds_Description","translation":"इन्हें पतझड़ में बोएँ। पकने में 6 दिन लगते हैं।"},
    {"target":"Strings/Objects","key":"BerryBasket_Name","translation":"बेरी की टोकरी"}
  ]
}
