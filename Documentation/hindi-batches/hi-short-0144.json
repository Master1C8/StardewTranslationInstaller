{
  "id":"hi-short-0144","kind":"short","records":[
    {"target":"Strings/Objects","key":"Broccoli_Description","translation":"ब्रोकली के पौधे का फूलदार सिर। छोटी कलियाँ इसे अनोखी बनावट देती हैं।"},
    {"target":"Strings/Objects","key":"BroccoliSeeds_Name","translation":"ब्रोकली के बीज"},
    {"target":"Strings/Objects","key":"BroccoliSeeds_Description","translation":"पतझड़ में बोएँ। पकने में 8 दिन लगते हैं और पहली कटाई के बाद लगातार फलती है।"},
    {"target":"Strings/Objects","key":"BrokenCD_Name","translation":"टूटी सीडी"},
    {"target":"Strings/Objects","key":"BrokenCD_Description","translation":"यह जोजानेट 2.0 की परीक्षण सीडी है। उन्होंने ऐसी एक अरब सीडी बनाई होंगी।"},
    {"target":"Strings/Objects","key":"BrokenGlasses_Name","translation":"टूटा चश्मा"},
    {"target":"Strings/Objects","key":"BrokenGlasses_Description","translation":"लगता है किसी का चश्मा खो गया। यह टूट चुका है।"},
    {"target":"Strings/Objects","key":"BrownEgg_Name","translation":"अंडा"},
    {"target":"Strings/Objects","key":"BrownEgg_Description","translation":"सामान्य भूरी मुर्गी का अंडा।"},
    {"target":"Strings/Objects","key":"Bruschetta_Name","translation":"ब्रुशेटा"},
    {"target":"Strings/Objects","key":"Bruschetta_Description","translation":"कुरकुरी सफ़ेद ब्रेड पर भुने टमाटर।"},
    {"target":"Strings/Objects","key":"BugMeat_Name","translation":"कीट मांस"},
    {"target":"Strings/Objects","key":"BugMeat_Description","translation":"कीट के मांस का रसदार ढेला।"},
    {"target":"Strings/Objects","key":"BugSteak_Name","translation":"कीट स्टेक"},
    {"target":"Strings/Objects","key":"BugSteak_Description","translation":"भूखे गुफ़ा खोजी का आख़िरी सहारा।"},
    {"target":"Strings/Objects","key":"Bullhead_Name","translation":"बुलहेड"},
    {"target":"Strings/Objects","key":"Bullhead_Description","translation":"कैटफ़िश की रिश्तेदार जो झील की तलहटी से कई तरह का भोजन खाती है।"},
    {"target":"Strings/Objects","key":"BurglarsRing_Name","translation":"चोर की अँगूठी"},
    {"target":"Strings/Objects","key":"BurglarsRing_Description","translation":"राक्षसों से माल गिरने की संभावना बढ़ाती है।"},
    {"target":"Strings/Objects","key":"ButterflyPowder_Name","translation":"तितली चूर्ण"},
    {"target":"Strings/Objects","key":"ButterflyPowder_Description","translation":"किसी पालतू पशु को फ़ार्म से हटाने के लिए उस पर छिड़कें। यह प्रक्रिया वापस नहीं की जा सकती।"},
    {"target":"Strings/Objects","key":"CactusFruit_Name","translation":"कैक्टस फल"},
    {"target":"Strings/Objects","key":"CactusFruit_Description","translation":"काँटेदार नाशपाती कैक्टस का मीठा फल।"},
    {"target":"Strings/Objects","key":"CactusSeeds_Name","translation":"कैक्टस के बीज"},
    {"target":"Strings/Objects","key":"CactusSeeds_Description","translation":"केवल घर के भीतर उग सकते हैं। पकने में 12 दिन लगते हैं और फिर हर 3 दिन में फल देते हैं।"},
    {"target":"Strings/Objects","key":"Calcite_Name","translation":"कैल्साइट"},
    {"target":"Strings/Objects","key":"Calcite_Description","translation":"इस पीले क्रिस्टल पर झिलमिलाती गाँठों के धब्बे हैं।"},
    {"target":"Strings/Objects","key":"CalicoEgg_Name","translation":"कैलिको अंडा"},
    {"target":"Strings/Objects","key":"CalicoEgg_Description","translation":"मरुस्थल त्योहार के दौरान मिलने वाला अनोखा अंडा।"},
    {"target":"Strings/Objects","key":"CalicoEggStone_Name","translation":"कैलिको अंडा पत्थर"},
    {"target":"Strings/Objects","key":"CalicoEggStone_Description","translation":"कैलिको अंडे पाने के लिए इसे तोड़ें।"},
    {"target":"Strings/Objects","key":"CampingStove_Name","translation":"शिविर चूल्हा"},
    {"target":"Strings/Objects","key":"CampingStove_Description","translation":"इससे कहीं भी खाना बना सकते हैं और इस्तेमाल करने पर यह ख़त्म नहीं होता।"},
    {"target":"Strings/Objects","key":"Carp_Name","translation":"कार्प"},
    {"target":"Strings/Objects","key":"Carp_Description","translation":"तालाब की आम मछली।"},
    {"target":"Strings/Objects","key":"CarpSurprise_Name","translation":"कार्प सरप्राइज़"},
    {"target":"Strings/Objects","key":"CarpSurprise_Description","translation":"यह फीका और तैलीय है।"},
    {"target":"Strings/Objects","key":"Carrot_Name","translation":"गाजर"},
    {"target":"Strings/Objects","key":"Carrot_Description","translation":"तेज़ी से बढ़ने वाली रंगीन जड़ जो बढ़िया नाश्ता बनती है।"},
    {"target":"Strings/Objects","key":"CarrotSeeds_Name","translation":"गाजर के बीज"},
    {"target":"Strings/Objects","key":"CarrotSeeds_Description","translation":"वसंत में बोएँ। उगने में 3 दिन लगते हैं।"},
    {"target":"Strings/Objects","key":"Catfish_Name","translation":"कैटफ़िश"},
    {"target":"Strings/Objects","key":"Catfish_Description","translation":"नदियों में मिलने वाली असामान्य मछली।"},
    {"target":"Strings/Objects","key":"Cauliflower_Name","translation":"फूलगोभी"},
    {"target":"Strings/Objects","key":"Cauliflower_Description","translation":"क़ीमती, मगर धीमी गति से बढ़ती है। फीके रंग के बावजूद इसके फूल पोषक तत्त्वों से भरे हैं।"},
    {"target":"Strings/Objects","key":"CauliflowerSeeds_Name","translation":"फूलगोभी के बीज"},
    {"target":"Strings/Objects","key":"CauliflowerSeeds_Description","translation":"इन्हें वसंत में बोएँ। बड़ी फूलगोभी बनने में 12 दिन लगते हैं।"},
    {"target":"Strings/Objects","key":"CaveCarrot_Name","translation":"गुफ़ा गाजर"},
    {"target":"Strings/Objects","key":"CaveCarrot_Description","translation":"गुफ़ाओं में मिलने वाला स्टार्च से भरपूर नाश्ता। खनिकों को लंबे समय तक काम करने में मदद करता है।"},
    {"target":"Strings/Objects","key":"CaveJelly_Name","translation":"गुफ़ा जेली"},
    {"target":"Strings/Objects","key":"CaveJelly_Description","translation":"भूमिगत झीलों में मिलने वाली दुर्लभ जेली।"},
    {"target":"Strings/Objects","key":"Caviar_Name","translation":"कैवियार"},
    {"target":"Strings/Objects","key":"Caviar_Description","translation":"स्टर्जन मछली के संरक्षित अंडे। विलासितापूर्ण व्यंजन माने जाते हैं!"},
    {"target":"Strings/Objects","key":"Celestine_Name","translation":"सेलेस्टीन"},
    {"target":"Strings/Objects","key":"Celestine_Description","translation":"कुछ शुरुआती जीवों की हड्डियाँ इससे बनी थीं।"},
    {"target":"Strings/Objects","key":"ChallengeBait_Name","translation":"चुनौती चारा"},
    {"target":"Strings/Objects","key":"ChallengeBait_Description","translation":"'सटीक' पकड़ पर तिगुनी मछलियाँ मिलती हैं। मगर जब भी मछली 'मछली पकड़ने की पट्टी' से निकलती है, पकड़ घट जाती है।"},
    {"target":"Strings/Objects","key":"Chanterelle_Name","translation":"चैंटरेल"},
    {"target":"Strings/Objects","key":"Chanterelle_Description","translation":"फलों जैसी महक और हल्के मिर्चीदार स्वाद वाला स्वादिष्ट कुकुरमुत्ता।"},
    {"target":"Strings/Objects","key":"Cheese_Name","translation":"पनीर"},
    {"target":"Strings/Objects","key":"Cheese_Description","translation":"यह सामान्य पनीर है।"},
    {"target":"Strings/Objects","key":"CheeseCauliflower_Name","translation":"पनीर वाली फूलगोभी"},
    {"target":"Strings/Objects","key":"CheeseCauliflower_Description","translation":"इसकी महक बहुत अच्छी है!"},
    {"target":"Strings/Objects","key":"Cherry_Name","translation":"चेरी"},
    {"target":"Strings/Objects","key":"Cherry_Description","translation":"यह लोकप्रिय है और ज़्यादातर फलों से जल्दी पकती है।"},
    {"target":"Strings/Objects","key":"CherryBomb_Name","translation":"चेरी बम"},
    {"target":"Strings/Objects","key":"CherryBomb_Description","translation":"छोटा विस्फोट करता है। पीछे हटें!"}
  ]
}
