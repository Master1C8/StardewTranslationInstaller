{
  "id":"hi-short-0145","kind":"short","records":[
    {"target":"Strings/Objects","key":"CherrySapling_Name","translation":"चेरी का पौधा"},
    {"target":"Strings/Objects","key":"CherrySapling_Description","translation":"परिपक्व चेरी का पेड़ बनने में 28 दिन लगते हैं। वसंत में फल देता है। केवल तभी बढ़ता है जब आस-पास के 8 'खाने' ख़ाली हों।"},
    {"target":"Strings/Objects","key":"ChewingStick_Name","translation":"चबाने की छड़ी"},
    {"target":"Strings/Objects","key":"ChewingStick_Description","translation":"प्राचीन लोग दाँत साफ़ रखने के लिए इन्हें चबाते थे।"},
    {"target":"Strings/Objects","key":"ChickenStatue_Name","translation":"मुर्गी की मूर्ति"},
    {"target":"Strings/Objects","key":"ChickenStatue_Description","translation":"काँसे के आधार पर मुर्गी की मूर्ति। इस क्षेत्र के प्राचीन लोगों को मुर्गियाँ बहुत प्रिय रही होंगी।"},
    {"target":"Strings/Objects","key":"ChippedAmphora_Name","translation":"टूटा एम्फ़ोरा"},
    {"target":"Strings/Objects","key":"ChippedAmphora_Description","translation":"चीनी मिट्टी से बना प्राचीन पात्र। सूखा और तरल, दोनों तरह का सामान ढोने में इस्तेमाल होता था।"},
    {"target":"Strings/Objects","key":"ChocolateCake_Name","translation":"चॉकलेट केक"},
    {"target":"Strings/Objects","key":"ChocolateCake_Description","translation":"गाढ़े फ़ज की परत वाला भरपूर और नम केक।"},
    {"target":"Strings/Objects","key":"Chowder_Name","translation":"चाउडर"},
    {"target":"Strings/Objects","key":"Chowder_Description","translation":"समुद्र की ठंडी रात के बाद ख़ुद को गर्म करने का एकदम सही तरीक़ा।"},
    {"target":"Strings/Objects","key":"Chub_Name","translation":"चब"},
    {"target":"Strings/Objects","key":"Chub_Description","translation":"बहुत भूख के लिए जानी जाने वाली आम मीठे पानी की मछली।"},
    {"target":"Strings/Objects","key":"CinderShard_Name","translation":"अंगार खंड"},
    {"target":"Strings/Objects","key":"CinderShard_Description","translation":"इस पत्थर के भीतर से गर्म चमक महसूस होती है।"},
    {"target":"Strings/Objects","key":"CinderShardStone_Name","translation":"अंगार खंड पत्थर"},
    {"target":"Strings/Objects","key":"CinderShardStone_Description","translation":"अंगार खंड पाने के लिए इसे तोड़ें।"},
    {"target":"Strings/Objects","key":"Clam_Name","translation":"क्लैम"},
    {"target":"Strings/Objects","key":"Clam_Description","translation":"इसके भीतर चबाने लायक़ छोटा जीव है..."},
    {"target":"Strings/Objects","key":"Clay_Name","translation":"चिकनी मिट्टी"},
    {"target":"Strings/Objects","key":"Clay_Description","translation":"वस्तु-निर्माण और निर्माण कार्य में इस्तेमाल होती है।"},
    {"target":"Strings/Objects","key":"ClayStone_Name","translation":"चिकनी मिट्टी का पत्थर"},
    {"target":"Strings/Objects","key":"ClayStone_Description","translation":"चिकनी मिट्टी पाने के लिए इसे तोड़ें।"},
    {"target":"Strings/Objects","key":"Cloth_Name","translation":"कपड़ा"},
    {"target":"Strings/Objects","key":"Cloth_Description","translation":"महीन ऊनी कपड़े का थान।"},
    {"target":"Strings/Objects","key":"Coal_Name","translation":"कोयला"},
    {"target":"Strings/Objects","key":"Coal_Description","translation":"वस्तु-निर्माण और गलाने में काम आने वाला ज्वलनशील पत्थर।"},
    {"target":"Strings/Objects","key":"CobblestonePath_Name","translation":"कंकड़-पत्थर का रास्ता"},
    {"target":"Strings/Objects","key":"CobblestonePath_Description","translation":"रास्ते बनाने या फ़र्श सँवारने के लिए ज़मीन पर रखें।"},
    {"target":"Strings/Objects","key":"Cockle_Name","translation":"कॉकल"},
    {"target":"Strings/Objects","key":"Cockle_Description","translation":"खारे पानी की आम सीपी।"},
    {"target":"Strings/Objects","key":"Coconut_Name","translation":"नारियल"},
    {"target":"Strings/Objects","key":"Coconut_Description","translation":"नारियल के पेड़ का बीज। भोजन में इसके कई उपयोग हैं।"},
    {"target":"Strings/Objects","key":"Coffee_Name","translation":"कॉफ़ी"},
    {"target":"Strings/Objects","key":"Coffee_Description","translation":"इसकी महक स्वादिष्ट है। यह तुम्हें ज़रूर फुर्ती देगी।"},
    {"target":"Strings/Objects","key":"CoffeeBean_Name","translation":"कॉफ़ी का दाना"},
    {"target":"Strings/Objects","key":"CoffeeBean_Description","translation":"कॉफ़ी का पौधा उगाने के लिए वसंत या गर्मी में बोएँ। कॉफ़ी बनाने के लिए पाँच दाने पीपे में डालें।"},
    {"target":"Strings/Objects","key":"Coleslaw_Name","translation":"कोलस्लॉ"},
    {"target":"Strings/Objects","key":"Coleslaw_Description","translation":"यह हल्का, ताज़ा और बहुत सेहतमंद है।"}
  ]
}
