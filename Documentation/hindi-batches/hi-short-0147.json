{
  "id":"hi-short-0147","kind":"short","records":[
    {"target":"Strings/Objects","key":"DishOTheSea_Name","translation":"समुद्री थाली"},
    {"target":"Strings/Objects","key":"DishOTheSea_Description","translation":"समुद्र की ठंडी हवा में यह तुम्हें गर्म रखेगी।"},
    {"target":"Strings/Objects","key":"Dolomite_Name","translation":"डोलोमाइट"},
    {"target":"Strings/Objects","key":"Dolomite_Description","translation":"यह प्रवाल भित्तियों में, अक्सर किसी समुद्री ज्वालामुखी के पास मिल सकता है।"},
    {"target":"Strings/Objects","key":"Dorado_Name","translation":"डोराडो"},
    {"target":"Strings/Objects","key":"Dorado_Description","translation":"चमकीले नारंगी शल्कों वाली ख़ूँख़ार मांसाहारी मछली।"},
    {"target":"Strings/Objects","key":"DragonTooth_Name","translation":"ड्रैगन दाँत"},
    {"target":"Strings/Objects","key":"DragonTooth_Description","translation":"कहते हैं ये प्राचीन सर्पों के दाँत हैं। इनका इनैमल शुद्ध इरिडियम से बना है!"},
    {"target":"Strings/Objects","key":"DressedSpinner_Name","translation":"सजावटी स्पिनर"},
    {"target":"Strings/Objects","key":"DressedSpinner_Description","translation":"धातु की पट्टी और रंगीन फीतियाँ मछलियों के लिए लुभावना नज़ारा बनाती हैं। मछली पकड़ते समय काटने की दर बढ़ाता है।"},
    {"target":"Strings/Objects","key":"DriedFruit_Name","translation":"सूखा"},
    {"target":"Strings/Objects","key":"DriedFruit_Description","translation":"सूखे {0} के चबाने लायक़ टुकड़े।"},
    {"target":"Strings/Objects","key":"DriedFruit_CollectionsTabDescription","translation":"सूखे फल के चबाने लायक़ टुकड़े।"},
    {"target":"Strings/Objects","key":"DriedFruit_CollectionsTabName","translation":"सूखा फल"},
    {"target":"Strings/Objects","key":"DriedFruit_Flavored_Name","translation":"सूखा {0}"},
    {"target":"Strings/Objects","key":"DriedMushrooms_Name","translation":"सूखे"},
    {"target":"Strings/Objects","key":"DriedMushrooms_Description","translation":"उम्दा कुकुरमुत्तों का पैकेट।"},
    {"target":"Strings/Objects","key":"DriedMushrooms_CollectionsTabDescription","translation":"उम्दा कुकुरमुत्तों का पैकेट।"},
    {"target":"Strings/Objects","key":"DriedMushrooms_CollectionsTabName","translation":"सूखे कुकुरमुत्ते"},
    {"target":"Strings/Objects","key":"DriedStarfish_Name","translation":"सूखी तारामछली"},
    {"target":"Strings/Objects","key":"DriedStarfish_Description","translation":"आदिम समुद्र की एक तारामछली। यह असामान्य रूप से बेदाग़ नमूना है!"},
    {"target":"Strings/Objects","key":"Driftwood_Name","translation":"बहकर आई लकड़ी"},
    {"target":"Strings/Objects","key":"Driftwood_Description","translation":"समुद्र से आया लकड़ी का टुकड़ा।"},
    {"target":"Strings/Objects","key":"DrumBlock_Name","translation":"ढोल ब्लॉक"},
    {"target":"Strings/Objects","key":"DrumBlock_Description","translation":"पास से गुज़रने पर ढोल की आवाज़ बजाता है।"},
    {"target":"Strings/Objects","key":"DuckEgg_Name","translation":"बत्तख का अंडा"},
    {"target":"Strings/Objects","key":"DuckEgg_Description","translation":"यह अब भी गरम है।"},
    {"target":"Strings/Objects","key":"DuckFeather_Name","translation":"बत्तख का पंख"},
    {"target":"Strings/Objects","key":"DuckFeather_Description","translation":"यह कितना रंगीन है।"},
    {"target":"Strings/Objects","key":"DuckMayonnaise_Name","translation":"बत्तख मेयोनेज़"},
    {"target":"Strings/Objects","key":"DuckMayonnaise_Description","translation":"गाढ़ी, पीली मेयोनेज़।"},
    {"target":"Strings/Objects","key":"DwarfGadget_Name","translation":"बौना यंत्र"},
    {"target":"Strings/Objects","key":"DwarfGadget_Description","translation":"कभी बौनों को ज्ञात उन्नत तकनीक का एक हिस्सा। यह अब भी चमकता और गुनगुनाता है, मगर तुम नहीं समझ सकते कि यह कैसे काम करता है।"},
    {"target":"Strings/Objects","key":"DwarfScrollI_Name","translation":"बौना पांडुलिपि I"},
    {"target":"Strings/Objects","key":"DwarfScrollI_Description","translation":"बौनों की लिपि से भरी पीली पड़ी चर्मपत्र पांडुलिपि। इस पर लाल बो बँधा है।"},
    {"target":"Strings/Objects","key":"DwarfScrollII_Name","translation":"बौना पांडुलिपि II"},
    {"target":"Strings/Objects","key":"DwarfScrollII_Description","translation":"बौनों की लिपि से भरी पीली पड़ी चर्मपत्र पांडुलिपि। इस पर हरा फीता बँधा है।"},
    {"target":"Strings/Objects","key":"DwarfScrollIII_Name","translation":"बौना पांडुलिपि III"},
    {"target":"Strings/Objects","key":"DwarfScrollIII_Description","translation":"बौनों की लिपि से भरी पीली पड़ी चर्मपत्र पांडुलिपि। इस पर नीली रस्सी बँधी है।"},
    {"target":"Strings/Objects","key":"DwarfScrollIV_Name","translation":"बौना पांडुलिपि IV"},
    {"target":"Strings/Objects","key":"DwarfScrollIV_Description","translation":"बौनों की लिपि से भरी पीली पड़ी चर्मपत्र पांडुलिपि। इस पर सुनहरी ज़ंजीर बँधी है।"},
    {"target":"Strings/Objects","key":"DwarvishHelm_Name","translation":"बौनों का शिरस्त्राण"},
    {"target":"Strings/Objects","key":"DwarvishHelm_Description","translation":"बौनों द्वारा आम तौर पर पहने जाने वाले शिरस्त्राणों में से एक। धातु की मोटी परत उन्हें गिरते मलबे और गुफ़ा की लटकती चट्टानों से बचाती है।"},
    {"target":"Strings/Objects","key":"DwarvishTranslationGuide_Name","translation":"बौनों की भाषा का अनुवाद-मार्गदर्शक"},
    {"target":"Strings/Objects","key":"DwarvishTranslationGuide_Description","translation":"तुम्हें बौनों की भाषा सिखाता है।"},
    {"target":"Strings/Objects","key":"EarthCrystal_Name","translation":"पृथ्वी क्रिस्टल"},
    {"target":"Strings/Objects","key":"EarthCrystal_Description","translation":"सतह के पास मिलने वाला राल जैसा पदार्थ।"},
    {"target":"Strings/Objects","key":"Ectoplasm_Name","translation":"एक्टोप्लाज़्म"},
    {"target":"Strings/Objects","key":"Ectoplasm_Description","translation":"गाढ़ा, लिसलिसा पदार्थ जो किसी कारण जादूगर को चाहिए।"},
    {"target":"Strings/Objects","key":"Eel_Name","translation":"ईल"},
    {"target":"Strings/Objects","key":"Eel_Description","translation":"लंबी, फिसलन भरी छोटी मछली।"},
    {"target":"Strings/Objects","key":"Eggplant_Name","translation":"बैंगन"},
    {"target":"Strings/Objects","key":"Eggplant_Description","translation":"टमाटर का भरपूर और पौष्टिक रिश्तेदार। तला या दम किया हुआ स्वादिष्ट लगता है।"},
    {"target":"Strings/Objects","key":"EggplantParmesan_Name","translation":"बैंगन पार्मेज़ान"},
    {"target":"Strings/Objects","key":"EggplantParmesan_Description","translation":"खट्टा, पनीरदार और लाजवाब।"},
    {"target":"Strings/Objects","key":"EggplantSeeds_Name","translation":"बैंगन के बीज"},
    {"target":"Strings/Objects","key":"EggplantSeeds_Description","translation":"इन्हें पतझड़ में बोएँ। पकने में 5 दिन लगते हैं और पहली कटाई के बाद लगातार फलते हैं।"},
    {"target":"Strings/Objects","key":"ElvishJewelry_Name","translation":"एल्फ़ आभूषण"},
    {"target":"Strings/Objects","key":"ElvishJewelry_Description","translation":"गंदा, मगर अब भी सुंदर। किनारे पर बहती हुई लिपि है जिसे कुछ लोग एल्फ़ों की प्राचीन भाषा मानते हैं। एल्फ़ों की कोई हड्डी कभी नहीं मिली।"},
    {"target":"Strings/Objects","key":"Emerald_Name","translation":"पन्ना"},
    {"target":"Strings/Objects","key":"Emerald_Description","translation":"चमकीले हरे रंग का क़ीमती पत्थर।"},
    {"target":"Strings/Objects","key":"EmeraldRing_Name","translation":"पन्ना अँगूठी"},
    {"target":"Strings/Objects","key":"EmeraldRing_Description","translation":"हथियार की गति 10% बढ़ाती है।"},
    {"target":"Strings/Objects","key":"EmeraldStone_Name","translation":"पन्ना पत्थर"},
    {"target":"Strings/Objects","key":"EmeraldStone_Description","translation":"पन्ने पाने के लिए इसे तोड़ें।"},
    {"target":"Strings/Objects","key":"EnergyTonic_Name","translation":"ऊर्जा टॉनिक"},
    {"target":"Strings/Objects","key":"EnergyTonic_Description","translation":"बहुत सारी ऊर्जा बहाल करता है।"},
    {"target":"Strings/Objects","key":"Enricher_Name","translation":"संवर्धक"}
  ]
}
