{
  "id":"hi-short-0148","kind":"short","records":[
    {"target":"Strings/Objects","key":"Enricher_Description","translation":"स्प्रिंकलर पर रखें और उर्वरक भरें, ताकि पास बीज बोते समय वह अपने-आप लग जाए।"},
    {"target":"Strings/Objects","key":"Escargot_Name","translation":"एस्कार्गो"},
    {"target":"Strings/Objects","key":"Escargot_Description","translation":"मक्खन में डूबे घोंघे जिन्हें एकदम सही पकाया गया है।"},
    {"target":"Strings/Objects","key":"Esperite_Name","translation":"एस्पेराइट"},
    {"target":"Strings/Objects","key":"Esperite_Description","translation":"उत्तेजित करने पर क्रिस्टल चमकीले हरे रंग से चमकते हैं।"},
    {"target":"Strings/Objects","key":"ExplosiveAmmo_Name","translation":"विस्फोटक गोला-बारूद"},
    {"target":"Strings/Objects","key":"ExplosiveAmmo_Description","translation":"इसे गुलेल से चलाएँ।"},
    {"target":"Strings/Objects","key":"FairyDust_Name","translation":"परी धूल"},
    {"target":"Strings/Objects","key":"FairyDust_Description","translation":"पीपों, भट्टियों और दूसरे परिष्करण उपकरणों पर छिड़ककर तुरंत उनका उत्पाद पाएँ।"},
    {"target":"Strings/Objects","key":"FairyRose_Name","translation":"परी गुलाब"},
    {"target":"Strings/Objects","key":"FairyRose_Description","translation":"एक पुरानी लोककथा के अनुसार इस फूल की मीठी सुगंध परियों को आकर्षित करती है।"},
    {"target":"Strings/Objects","key":"FairySeeds_Name","translation":"परी बीज"},
    {"target":"Strings/Objects","key":"FairySeeds_Description","translation":"पतझड़ में बोएँ। रहस्यमयी फूल बनने में 12 दिन लगते हैं। कई रंगों में।"},
    {"target":"Strings/Objects","key":"FairyStone_Name","translation":"परी पत्थर"},
    {"target":"Strings/Objects","key":"FairyStone_Description","translation":"एक पुराने खनिक गीत के अनुसार ये प्राचीन परियों की हड्डियों से बने हैं।"},
    {"target":"Strings/Objects","key":"FallSeeds_Name","translation":"पतझड़ के बीज"},
    {"target":"Strings/Objects","key":"FallSeeds_Description","translation":"पतझड़ के कई जंगली बीजों का मिश्रण।"},
    {"target":"Strings/Objects","key":"FarAwayStone_Name","translation":"सुदूर पत्थर"},
    {"target":"Strings/Objects","key":"FarAwayStone_Description","translation":"अज्ञात मूल का पत्थर। लगता है इसे किसी चीज़ में लगाया जा सकता है।"},
    {"target":"Strings/Objects","key":"FarmersLunch_Name","translation":"किसान का दोपहर का भोजन"},
    {"target":"Strings/Objects","key":"FarmersLunch_Description","translation":"यह तुम्हें काम करते रहने देगा।"},
    {"target":"Strings/Objects","key":"Fiber_Name","translation":"रेशा"},
    {"target":"Strings/Objects","key":"Fiber_Description","translation":"पौधों से मिलने वाली कच्ची सामग्री।"},
    {"target":"Strings/Objects","key":"FiberSeeds_Name","translation":"रेशे के बीज"},
    {"target":"Strings/Objects","key":"FiberSeeds_Description","translation":"इन्हें किसी भी ऋतु में बोएँ। पानी की ज़रूरत नहीं। हँसिये से काटें। उगने में 7 दिन लगते हैं।"},
    {"target":"Strings/Objects","key":"FiddleheadFern_Name","translation":"फिडलहेड फ़र्न"},
    {"target":"Strings/Objects","key":"FiddleheadFern_Description","translation":"नई कोपलें खाने की ख़ास चीज़ हैं।"},
    {"target":"Strings/Objects","key":"FiddleheadRisotto_Name","translation":"फिडलहेड रिसोटो"},
    {"target":"Strings/Objects","key":"FiddleheadRisotto_Description","translation":"भुने फ़र्न सिरों के साथ परोसा मलाईदार चावल का व्यंजन। थोड़ा फीका है।"},
    {"target":"Strings/Objects","key":"FieldSnack_Name","translation":"मैदानी नाश्ता"},
