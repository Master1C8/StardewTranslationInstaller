    {"target":"Strings/Objects","key":"Flounder_Name","translation":"फ़्लाउंडर"},
    {"target":"Strings/Objects","key":"Flounder_Description","translation":"यह तलहटी में रहती है, इसलिए दोनों आँखें सिर के ऊपर हैं।"},
    {"target":"Strings/Objects","key":"Fluorapatite_Name","translation":"फ़्लोरोएपेटाइट"},
