    {"target":"Strings/Objects","key":"FireworksGreen_Name","translation":"आतिशबाज़ी (हरी)"},
    {"target":"Strings/Objects","key":"FireworksGreen_Description","translation":"जश्न और उत्सवों की पुरानी परंपरा। सावधानी से सँभालें!"},
    {"target":"Strings/Objects","key":"FireworksPurple_Name","translation":"आतिशबाज़ी (बैंगनी)"},
    {"target":"Strings/Objects","key":"FireworksPurple_Description","translation":"जश्न और उत्सवों की पुरानी परंपरा। सावधानी से सँभालें!"},
    {"target":"Strings/Objects","key":"FireworksRed_Name","translation":"आतिशबाज़ी (लाल)"},
    {"target":"Strings/Objects","key":"FireworksRed_Description","translation":"जश्न और उत्सवों की पुरानी परंपरा। सावधानी से सँभालें!"},
    {"target":"Strings/Objects","key":"FishStew_Name","translation":"मछली की हांडी"},
