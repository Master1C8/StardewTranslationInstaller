    {"target":"Strings/Objects","key":"Lobster_Name","translation":"लॉब्स्टर"},
    {"target":"Strings/Objects","key":"Lobster_Description","translation":"समुद्र में रहने वाला बड़ा कवचधारी जीव, जिसकी पूँछ मज़बूत होती है।"},
    {"target":"Strings/Objects","key":"LobsterBisque_Name","translation":"लॉब्स्टर बिस्क"},
    {"target":"Strings/Objects","key":"LobsterBisque_Description","translation":"यह नाज़ुक सूप विली के परिवार की गुप्त व्यंजन-विधि से बनता है।"}
  ]
}
