{
  "id":"hi-short-0152","kind":"short","records":[
    {"target":"Strings/Objects","key":"Kale_Name","translation":"केल"},
    {"target":"Strings/Objects","key":"Kale_Description","translation":"इसकी मोम-जैसी पत्तियाँ सूप और तली हुई सब्ज़ियों में बहुत अच्छी लगती हैं।"},
    {"target":"Strings/Objects","key":"KaleSeeds_Name","translation":"केल के बीज"},
    {"target":"Strings/Objects","key":"KaleSeeds_Description","translation":"इन्हें वसंत में बोएँ। पकने में 6 दिन लगते हैं। हँसिए से काटें।"},
    {"target":"Strings/Objects","key":"Kyanite_Name","translation":"कायनाइट"},
    {"target":"Strings/Objects","key":"Kyanite_Description","translation":"इसकी ज्यामितीय सतहें काँच जितनी चिकनी हैं।"},
    {"target":"Strings/Objects","key":"LargeBrownEgg_Name","translation":"बड़ा अंडा"},
    {"target":"Strings/Objects","key":"LargeBrownEgg_Description","translation":"यह असामान्य रूप से बड़ा भूरा अंडा है!"},
    {"target":"Strings/Objects","key":"LargeMilk_Name","translation":"बड़ा दूध"},
    {"target":"Strings/Objects","key":"LargeMilk_Description","translation":"गाय के दूध का बड़ा जग।"},
    {"target":"Strings/Objects","key":"LargemouthBass_Name","translation":"लार्जमाउथ बास"},
    {"target":"Strings/Objects","key":"LargemouthBass_Description","translation":"झीलों में रहने वाली लोकप्रिय मछली।"},
    {"target":"Strings/Objects","key":"LargeWhiteEgg_Name","translation":"बड़ा अंडा"},
    {"target":"Strings/Objects","key":"LargeWhiteEgg_Description","translation":"यह असामान्य रूप से बड़ा सफ़ेद अंडा है!"},
    {"target":"Strings/Objects","key":"LavaEel_Name","translation":"लावा ईल"},
    {"target":"Strings/Objects","key":"LavaEel_Description","translation":"न जाने कैसे यह धधकते लाल लावा के तालाबों में भी जीवित रह सकती है।"},
    {"target":"Strings/Objects","key":"LeadBobber_Name","translation":"सीसे की तैरनी"},
    {"target":"Strings/Objects","key":"LeadBobber_Description","translation":"तुम्हारी \"मछली पकड़ने की पट्टी\" में वज़न जोड़ती है, जिससे वह नीचे टकराकर उछलती नहीं।"},
    {"target":"Strings/Objects","key":"Leek_Name","translation":"लीक"},
    {"target":"Strings/Objects","key":"Leek_Description","translation":"प्याज़ का एक स्वादिष्ट रिश्तेदार।"},
    {"target":"Strings/Objects","key":"Legend_Name","translation":"लीजेंड"},
    {"target":"Strings/Objects","key":"Legend_Description","translation":"सभी मछलियों का राजा! लोग कहते थे इसे कभी पकड़ा नहीं जा सकेगा।"},
    {"target":"Strings/Objects","key":"LegendII_Name","translation":"लीजेंड द्वितीय"},
    {"target":"Strings/Objects","key":"LegendII_Description","translation":"मूल लीजेंड का उत्तराधिकारी।"},
    {"target":"Strings/Objects","key":"LemonStone_Name","translation":"नींबू पत्थर"},
    {"target":"Strings/Objects","key":"LemonStone_Description","translation":"कुछ लोगों का दावा है कि इस क्रिस्टल का चूरा बौनों के लिए लज़ीज़ पकवान है।"},
    {"target":"Strings/Objects","key":"LGoatMilk_Name","translation":"बकरी का बड़ा दूध"},
    {"target":"Strings/Objects","key":"LGoatMilk_Description","translation":"मलाईदार बकरी के दूध का एक गैलन।"},
    {"target":"Strings/Objects","key":"LifeElixir_Name","translation":"जीवन अमृत"},
    {"target":"Strings/Objects","key":"LifeElixir_Description","translation":"स्वास्थ्य पूरी तरह बहाल करता है।"},
    {"target":"Strings/Objects","key":"Limestone_Name","translation":"चूना पत्थर"},
    {"target":"Strings/Objects","key":"Limestone_Description","translation":"बहुत आम किस्म का पत्थर। इसकी क़ीमत ज़्यादा नहीं है।"},
    {"target":"Strings/Objects","key":"Lingcod_Name","translation":"लिंगकॉड"},
    {"target":"Strings/Objects","key":"Lingcod_Description","translation":"ख़ूँख़ार शिकारी, जो अपने मुँह में समा सकने वाली लगभग हर चीज़ खा जाता है।"},
    {"target":"Strings/Objects","key":"Lionfish_Name","translation":"लायनफ़िश"},
