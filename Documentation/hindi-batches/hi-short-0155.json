{
  "id":"hi-short-0155","kind":"short","records":[
    {"target":"Strings/Objects","key":"Pancakes_Name","translation":"पैनकेक"},
    {"target":"Strings/Objects","key":"Pancakes_Description","translation":"मुलायम और फूले हुए पैनकेक की दोहरी तह।"},
    {"target":"Strings/Objects","key":"Parsnip_Name","translation":"पार्सनिप"},
    {"target":"Strings/Objects","key":"Parsnip_Description","translation":"गाजर का नज़दीकी रिश्तेदार, वसंत में उगने वाला कंद। इसका स्वाद मिट्टी-सा होता है और यह पोषक तत्वों से भरपूर है।"},
    {"target":"Strings/Objects","key":"ParsnipSeeds_Name","translation":"पार्सनिप के बीज"},
    {"target":"Strings/Objects","key":"ParsnipSeeds_Description","translation":"इन्हें वसंत में बोएँ। पकने में 4 दिन लगते हैं।"},
    {"target":"Strings/Objects","key":"ParsnipSoup_Name","translation":"पार्सनिप का सूप"},
    {"target":"Strings/Objects","key":"ParsnipSoup_Description","translation":"यह ताज़ा और पेट भरने वाला है।"},
    {"target":"Strings/Objects","key":"Peach_Name","translation":"आड़ू"},
    {"target":"Strings/Objects","key":"Peach_Description","translation":"छूने पर यह लगभग रोएँदार लगता है।"},
    {"target":"Strings/Objects","key":"PeachSapling_Name","translation":"आड़ू का पौधा"},
    {"target":"Strings/Objects","key":"PeachSapling_Description","translation":"आड़ू का परिपक्व पेड़ बनने में 28 दिन लगते हैं। गर्मियों में फल देता है। केवल तभी बढ़ता है जब आसपास के 8 \"खाने\" खाली हों।"},
    {"target":"Strings/Objects","key":"Pearl_Name","translation":"मोती"},
    {"target":"Strings/Objects","key":"Pearl_Description","translation":"समुद्र से मिलने वाला दुर्लभ ख़ज़ाना।"},
    {"target":"Strings/Objects","key":"PepperPoppers_Name","translation":"मिर्च पॉपर"},
    {"target":"Strings/Objects","key":"PepperPoppers_Description","translation":"पनीर भरी मसालेदार मिर्च, जिस पर ब्रेड के चूरे की परत चढ़ी है।"},
    {"target":"Strings/Objects","key":"PepperSeeds_Name","translation":"मिर्च के बीज"},
    {"target":"Strings/Objects","key":"PepperSeeds_Description","translation":"इन्हें गर्मियों में बोएँ। पकने में 5 दिन लगते हैं और पहली कटाई के बाद भी उपज देते रहते हैं।"},
    {"target":"Strings/Objects","key":"Perch_Name","translation":"पर्च"},
    {"target":"Strings/Objects","key":"Perch_Description","translation":"शीत ऋतु में मिलने वाली मीठे पानी की मछली।"},
    {"target":"Strings/Objects","key":"Periwinkle_Name","translation":"पेरिविंकल"},
    {"target":"Strings/Objects","key":"Periwinkle_Description","translation":"नीले कवच में रहने वाला मीठे पानी का नन्हा घोंघा।"},
    {"target":"Strings/Objects","key":"PetLicense_Name","translation":"पालतू पशु लाइसेंस"},
    {"target":"Strings/Objects","key":"PetLicense_Description","translation":"अपने घर में नया पालतू पशु बुलाएँ। अगर तुम्हारे पालतू पशुओं के लिए बाहर पर्याप्त कटोरे नहीं होंगे, तो वे नाराज़ हो जाएँगे।"},
    {"target":"Strings/Objects","key":"PetrifiedSlime_Name","translation":"पत्थर बना स्लाइम"},
    {"target":"Strings/Objects","key":"PetrifiedSlime_Description","translation":"यह नन्हा जीव शायद 100,000 साल पुराना है।"},
    {"target":"Strings/Objects","key":"PhoenixRing_Name","translation":"फ़ीनिक्स अँगूठी"},
    {"target":"Strings/Objects","key":"PhoenixRing_Description","translation":"दिन में एक बार युद्ध में धराशायी होने के बाद थोड़ा स्वास्थ्य वापस पाओ।"},
    {"target":"Strings/Objects","key":"Pickles_Name","translation":"अचार"},
    {"target":"Strings/Objects","key":"Pickles_Description","translation":"तुम्हारे घर में बने अचार का मर्तबान।"},
    {"target":"Strings/Objects","key":"Pickles_Flavored_Name","translation":"{0} का अचार"},
    {"target":"Strings/Objects","key":"PierresMissingStocklist_Name","translation":"पियरे की खोई माल-सूची"},
    {"target":"Strings/Objects","key":"PierresMissingStocklist_Description","translation":"शायद पियरे को इसमें दिलचस्पी हो।"},
    {"target":"Strings/Objects","key":"Pike_Name","translation":"पाइक"},
    {"target":"Strings/Objects","key":"Pike_Description","translation":"मीठे पानी की ऐसी मछली, जिसे पकड़ना कठिन है।"},
    {"target":"Strings/Objects","key":"PinaColada_Name","translation":"पिना कोलाडा"},
    {"target":"Strings/Objects","key":"PinaColada_Description","translation":"संयम से पिएँ।"},
    {"target":"Strings/Objects","key":"Pineapple_Name","translation":"अनानास"},
    {"target":"Strings/Objects","key":"Pineapple_Description","translation":"मीठा और चटपटा उष्णकटिबंधीय स्वाद।"},
    {"target":"Strings/Objects","key":"PineappleSeeds_Name","translation":"अनानास के बीज"},
    {"target":"Strings/Objects","key":"PineappleSeeds_Description","translation":"इन्हें गर्म मौसम में बोएँ। पकने में 14 दिन लगते हैं, फिर ये लगातार फल देते रहते हैं।"},
    {"target":"Strings/Objects","key":"PineCone_Name","translation":"चीड़ का शंकु"},
    {"target":"Strings/Objects","key":"PineCone_Description","translation":"इसे बोकर चीड़ का पेड़ उगाया जा सकता है।"},
    {"target":"Strings/Objects","key":"PineTar_Name","translation":"चीड़ तारकोल"},
    {"target":"Strings/Objects","key":"PineTar_Description","translation":"चीड़ के वृक्ष-रस से मिलने वाला तीखी गंध वाला पदार्थ।"},
    {"target":"Strings/Objects","key":"PinkCake_Name","translation":"गुलाबी केक"},
    {"target":"Strings/Objects","key":"PinkCake_Description","translation":"ऊपर दिल के आकार की छोटी कैंडी लगी हैं।"},
    {"target":"Strings/Objects","key":"PiratesLocket_Name","translation":"समुद्री डाकू का लॉकेट"},
    {"target":"Strings/Objects","key":"PiratesLocket_Description","translation":"किसी पुराने समुद्री डाकू की निशानी।"},
    {"target":"Strings/Objects","key":"Pizza_Name","translation":"पिज़्ज़ा"},
    {"target":"Strings/Objects","key":"Pizza_Description","translation":"सभी अच्छे कारणों से लोकप्रिय।"},
    {"target":"Strings/Objects","key":"PlumPudding_Name","translation":"आलूबुखारा पुडिंग"},
    {"target":"Strings/Objects","key":"PlumPudding_Description","translation":"छुट्टियों का पारंपरिक स्वाद।"},
    {"target":"Strings/Objects","key":"Poi_Name","translation":"पोई"},
    {"target":"Strings/Objects","key":"Poi_Description","translation":"ताज़ा खाने पर हल्का मीठा स्वाद देने वाला पारंपरिक भोजन।"},
    {"target":"Strings/Objects","key":"Pomegranate_Name","translation":"अनार"},
    {"target":"Strings/Objects","key":"Pomegranate_Description","translation":"फल के भीतर रसदार बीजों के गुच्छे होते हैं।"},
    {"target":"Strings/Objects","key":"PomegranateSapling_Name","translation":"अनार का पौधा"},
    {"target":"Strings/Objects","key":"PomegranateSapling_Description","translation":"अनार का परिपक्व पेड़ बनने में 28 दिन लगते हैं। पतझड़ में फल देता है। केवल तभी बढ़ता है जब आसपास के 8 \"खाने\" खाली हों।"},
    {"target":"Strings/Objects","key":"Poppy_Name","translation":"पोस्ता"},
    {"target":"Strings/Objects","key":"Poppy_Description","translation":"रंगीन फूल के अलावा पोस्ते का इस्तेमाल खाना पकाने और औषधि में भी होता है।"},
    {"target":"Strings/Objects","key":"PoppyseedMuffin_Name","translation":"पोस्ते के बीज का मफ़िन"},
    {"target":"Strings/Objects","key":"PoppyseedMuffin_Description","translation":"इसका असर सुकून देने वाला है।"},
    {"target":"Strings/Objects","key":"PoppySeeds_Name","translation":"पोस्ते के बीज"},
    {"target":"Strings/Objects","key":"PoppySeeds_Description","translation":"गर्मियों में बोएँ। 7 दिन में चमकीला लाल फूल देता है।"},
    {"target":"Strings/Objects","key":"Potato_Name","translation":"आलू"},
    {"target":"Strings/Objects","key":"Potato_Description","translation":"व्यापक रूप से उगाया जाने वाला कंद।"},
    {"target":"Strings/Objects","key":"PotatoSeeds_Name","translation":"आलू के बीज"},
    {"target":"Strings/Objects","key":"PotatoSeeds_Description","translation":"इन्हें वसंत में बोएँ। पकने में 6 दिन लगते हैं और कटाई पर कई आलू मिलने की संभावना रहती है।"},
    {"target":"Strings/Objects","key":"Powdermelon_Name","translation":"पाउडरमेलन"},
    {"target":"Strings/Objects","key":"Powdermelon_Description","translation":"सतह पर बनने वाली चूरे-जैसी परत के नाम पर रखा गया यह खरबूजा करारा, मीठा और हल्के स्वाद वाला है।"},
    {"target":"Strings/Objects","key":"PowdermelonSeeds_Name","translation":"पाउडरमेलन के बीज"},
    {"target":"Strings/Objects","key":"PowdermelonSeeds_Description","translation":"यह ख़ास खरबूजा शीत ऋतु में उगता है। उगने में 7 दिन लगते हैं।"},
    {"target":"Strings/Objects","key":"PrehistoricHandaxe_Name","translation":"प्रागैतिहासिक हस्त-कुल्हाड़ी"},
    {"target":"Strings/Objects","key":"PrehistoricHandaxe_Description","translation":"मनुष्यों के सबसे शुरुआती औज़ारों में से एक। यह \"अनगढ़\" औज़ार एक पत्थर को दूसरे पर मारकर धार बनाने से तैयार हुआ था।"},
    {"target":"Strings/Objects","key":"PrehistoricRib_Name","translation":"प्रागैतिहासिक पसली"},
    {"target":"Strings/Objects","key":"PrehistoricRib_Description","translation":"किनारे पर छोटे कटाव बताते हैं कि यह पसली कभी किसी का भोजन थी।"},
    {"target":"Strings/Objects","key":"PrehistoricScapula_Name","translation":"प्रागैतिहासिक कंधे की हड्डी"},
    {"target":"Strings/Objects","key":"PrehistoricScapula_Description","translation":"आम तौर पर इसे \"शोल्डर ब्लेड\" कहते हैं... यह स्पष्ट नहीं कि यह किस प्रजाति की थी।"}
  ]
}
