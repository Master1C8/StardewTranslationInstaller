  "records": [
    {
      "target": "Strings/UI",
      "key": "Character_FarmFishing",
      "translation": "नदीभूमि फ़ार्म_आपका फ़ार्म कई द्वीपों और सुंदर नदी-तटों पर फैला है। यहाँ सामान्य से अधिक मछलियाँ मिलती हैं। शुरुआत में आपके पास मछली स्मोकर मिलता है।"
    },
    {
      "target": "Strings/UI",
      "key": "Character_FarmMining",
      "translation": "पहाड़ी फ़ार्म_पथरीली भूमि और घुमावदार नदी फ़ार्म का विन्यास कठिन बनाते हैं। मगर एक खनिज भंडार खनन के अवसर देता है।"
    },
    {
      "target": "Strings/UI",
      "key": "Character_FarmCombat",
      "translation": "बीहड़ फ़ार्म_यहाँ अच्छी ज़मीन बहुत है, मगर सावधान... रात में राक्षस बाहर निकलते हैं।"
    },
    {
      "target": "Strings/UI",
      "key": "Character_FarmFourCorners",
      "translation": "चार कोनों वाला फ़ार्म_भूमि चार भूखंडों में बँटी है और हर एक का अपना लाभ है। समूह के लिए उत्तम!"
    },
