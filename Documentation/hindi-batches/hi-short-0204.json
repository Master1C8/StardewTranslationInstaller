      "target": "Strings/UI",
      "key": "shippingInstructionText",
      "translation": "बेचने के लिए भेजने हेतु वस्तुएँ यहाँ डालें।"
    },
    {
      "target": "Strings/UI",
      "key": "tutorialWant",
      "translation": "प्रशिक्षण संकेत चालू करें?"
    },
    {
      "target": "Strings/UI",
      "key": "tutorial1",
      "translation": "पहले अपना रूप और फ़ार्म का प्रकार चुनें। पूरा होने पर खेल शुरू करने के लिए सही का निशान छुएँ।"
    },
    {
      "target": "Strings/UI",
      "key": "tutorial2",
      "translation": "सुप्रभात! बाद में सोने और खेल सहेजने के लिए फ़ार्महाउस वापस जाना याद रखें।"
    },
    {
      "target": "Strings/UI",
      "key": "tutorial3",
      "translation": "आपको उपहार मिला है! खोलने के लिए पैकेट छुएँ।"
    },
    {
      "target": "Strings/UI",
      "key": "tutorial4",
      "translation": "नई खोज दैनिकी में दिखाई जाती हैं। ध्यान से देखने के लिए खोज छुएँ—वहाँ उपयोगी जानकारी है!"
    },
    {
      "target": "Strings/UI",
      "key": "tutorial5",
      "translation": "दैनिकी का काम पूरा होने पर बंद करें बटन छुएँ।"
    },
    {
      "target": "Strings/UI",
      "key": "tutorial6",
      "translation": "यहाँ तो बड़ी गड़बड़ी लगती है! चलो इसे साफ़ करें।"
    },
    {
      "target": "Strings/UI",
      "key": "tutorial7",
      "translation": "खरपतवार हटाने के लिए उसे छुएँ।"
    },
    {
      "target": "Strings/UI",
      "key": "tutorial8",
      "translation": "बहुत अच्छे! कुछ और खरपतवार और पत्थर हटाने की कोशिश करें।"
    },
    {
      "target": "Strings/UI",
      "key": "tutorial9",
      "translation": "रोपण के लिए मिट्टी तैयार करने को कुदाल इस्तेमाल कर सकते हैं।"
    },
    {
      "target": "Strings/UI",
      "key": "tutorial10",
      "translation": "अपने पहले बीज बोने के लिए बगीचे का एक टुकड़ा तैयार करें।"
    },
    {
      "target": "Strings/UI",
      "key": "tutorial11",
      "translation": "बहुत बढ़िया... अब कुछ बीज डालने का समय है।"
    },
    {
      "target": "Strings/UI",
      "key": "tutorial12",
      "translation": "वे प्यासे लगते हैं—औज़ार-पट्टी में पानी का डिब्बा है।"
    },
    {
      "target": "Strings/UI",
      "key": "tutorial13",
      "translation": "बहुत अच्छे! अपनी फ़सलों को हर दिन पानी देना याद रखें।"
    },
    {
      "target": "Strings/UI",
      "key": "tutorial14",
      "translation": "पानी देना पूरा होने पर पेलिकन टाउन घूमने और नए पड़ोसियों से मिलने निकलें!"
    },
    {
      "target": "Strings/UI",
      "key": "tutorial15",
      "translation": "पानी का डिब्बा तालाब या नदी पर भर सकते हैं।"
    },
    {
      "target": "Strings/UI",
      "key": "tutorial16",
      "translation": "अपनी उँगली की ओर चलने के लिए छूकर पकड़े रखें।"
    },
    {
      "target": "Strings/UI",
      "key": "tutorial17",
      "translation": "अपनी उँगली के पीछे चलाने के लिए पकड़कर खींचें।"
    },
    {
      "target": "Strings/UI",
      "key": "tutorial18",
      "translation": "आइए खेल के कुछ और कार्य देखें।"
    },
    {
      "target": "Strings/UI",
      "key": "tutorial19",
      "translation": "वस्तु-सूची आपके पास की वस्तुएँ दिखाती है। उन्हें व्यवस्थित करने के लिए खींच सकते हैं या नष्ट करने के लिए कचरे में डाल सकते हैं।"
    },
    {
      "target": "Strings/UI",
      "key": "tutorial20",
      "translation": "यह पृष्ठ आपके कौशल दिखाता है—औज़ार इस्तेमाल करके, वन-संग्रह, मछली पकड़ने और लड़ने से कौशल सुधार सकते हैं।"
    },
    {
      "target": "Strings/UI",
      "key": "tutorial21",
      "translation": "सामाजिक पृष्ठ आपको मिलने वाले लोगों के साथ आपके संबंध बताता है।"
    },
    {
      "target": "Strings/UI",
      "key": "tutorial22",
      "translation": "यहाँ आप जुटाई और उगाई चीज़ों से नई वस्तुएँ बना सकते हैं। खेल के दौरान वस्तु-निर्माण की नई विधियाँ मिलेंगी।"
    },
    {
      "target": "Strings/UI",
      "key": "tutorial23",
      "translation": "पेलिकन टाउन और उसके आसपास घूमने के लिए मानचित्र पर उँगली सरकाएँ।"
    },
    {
      "target": "Strings/UI",
      "key": "tutorial24",
      "translation": "संग्रह पृष्ठ भेजी, पकड़ी, खोदी, पकाई या खोजी गई चीज़ों का लेखा रखता है।"
    },
    {
      "target": "Strings/UI",
      "key": "tutorial25",
      "translation": "दुकानों में सामान खरीदने या बेचने के लिए दुकानदार के सामने का काउंटर छुएँ।"
    },
    {
      "target": "Strings/UI",
      "key": "tutorial26",
      "translation": "बोने के लिए कुछ बीज चाहिए... क्या फ़ार्महाउस में कुछ छूट गया?"
    },
