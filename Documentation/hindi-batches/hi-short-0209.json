{
  "id": "hi-short-0209",
  "kind": "short",
  "records": [
    {
      "target": "Strings/1_6_Strings",
      "key": "MakeOver_Emily_Reaction6",
      "translation": "ओह देखो, फूलगोभी का पकौड़ा..."
    },
    {
      "target": "Strings/1_6_Strings",
      "key": "MakeOver_Emily_Reaction7",
      "translation": "यहाँ से इसे थोड़ा काटते हैं..."
    },
    {
      "target": "Strings/1_6_Strings",
      "key": "MakeOver_Emily_Reaction8",
      "translation": "यहाँ, मुझे उँगली से इसे थोड़ा फैलाने दो..."
    },
    {
      "target": "Strings/1_6_Strings",
      "key": "MakeOver_Emily_Reaction9",
      "translation": "ठीक है, तैयार रहना, शायद थोड़ा कसा हुआ लगे..."
    },
    {
      "target": "Strings/1_6_Strings",
      "key": "MakeOver_Emily_3",
      "translation": "ठीक है, समझ गई!$h#$b#मैं भीतर आ रही हूँ, इसलिए घबराना मत!"
    },
    {
      "target": "Strings/1_6_Strings",
      "key": "MakeOver_Emily_4",
      "translation": "यह लो!"
    },
    {
      "target": "Strings/1_6_Strings",
      "key": "MakeOver_Emily_5",
      "translation": "हाँ! मैं महसूस कर सकती हूँ, अब तुम्हारा भीतरी और बाहरी रूप पूरी तरह एक लय में हैं!$h#$b#तुम्हें नया 'तुम' दिखाने का इंतज़ार नहीं हो रहा!$h"
    },
    {
      "target": "Strings/1_6_Strings",
      "key": "MakeOver_Emily_Done",
      "translation": "तो? कैसा लगा?#$b#मन बदल जाए तो पुराने वस्त्र मैंने तुम्हारे बैग में रख दिए हैं!$h"
    },
    {
      "target": "Strings/1_6_Strings",
      "key": "MakeOver_Sandy_1",
      "reviewedPreserve": true
    },
    {
      "target": "Strings/1_6_Strings",
      "key": "MakeOver_Sandy_2",
      "translation": "ऊप्स! अब मेरी बारी है!"
    },
    {
      "target": "Strings/1_6_Strings",
      "key": "MakeOver_Sandy_3",
      "translation": "खट-खट, जान! मैं भीतर आ रही हूँ!"
    },
    {
      "target": "Strings/1_6_Strings",
      "key": "MakeOver_Sandy_4",
      "translation": "ज़रा देखें..."
    },
    {
      "target": "Strings/1_6_Strings",
      "key": "MakeOver_Sandy_5",
      "translation": "ठीक है!"
    },
    {
      "target": "Strings/1_6_Strings",
      "key": "MakeOver_Sandy_6",
      "translation": "बड़ा मज़ा आया!$h#$b#उम्मीद है अपने नए रूप से तुम भी उतने ही ख़ुश हो जितनी मैं हूँ!$h"
    },
    {
      "target": "Strings/1_6_Strings",
      "key": "MakeOver_Sandy_Done",
      "translation": "तुम्हारे चेहरे पर कितनी चमक है!#$b#मन बदल जाए तो पुराने वस्त्र मैंने तुम्हारे बैग में रख दिए हैं।$h"
    },
    {
      "target": "Strings/1_6_Strings",
      "key": "Shop_Abigail",
      "translation": "अरे, मैंने अपनी अलमारी से कुछ यूँ ही चीज़ें उठा लीं। इनमें से कुछ चाहिए?"
    },
    {
      "target": "Strings/1_6_Strings",
      "key": "Shop_Maru",
      "translation": "अपनी पसंद की कोई चीज़ दिखी?"
    },
    {
      "target": "Strings/1_6_Strings",
      "key": "Shop_Emily",
      "translation": "आह, यहाँ छाँव में अच्छा लग रहा है।"
    },
    {
      "target": "Strings/1_6_Strings",
      "key": "Shop_Leah",
      "translation": "मेरे पास कुछ अतिरिक्त लकड़ी थी, इसलिए ये छोटी पुस्तक अलमारियाँ बना दीं..."
    },
    {
      "target": "Strings/1_6_Strings",
      "key": "Shop_Harvey",
      "translation": "ओह, उम्म... ये मेरे बनाए कुछ आदर्श विमान हैं... तुम्हें पसंद हैं?"
    },
    {
      "target": "Strings/1_6_Strings",
      "key": "Shop_Pierre",
      "translation": "श्श... मैं नक़द के लिए अंडे बेच रहा हूँ! हेहे... लुईस से मत कहना।"
    },
    {
      "target": "Strings/1_6_Strings",
      "key": "Shop_Sam",
      "translation": "मेरा पुराना टूटा स्केटबोर्ड चाहिए? शायद सजावट या किसी और काम में इस्तेमाल किया जा सकता है।"
    },
    {
      "target": "Strings/1_6_Strings",
      "key": "Shop_Sebastian",
      "translation": "झील के पास कुछ सामान मिला।"
    },
    {
      "target": "Strings/1_6_Strings",
      "key": "Shop_Alex",
      "translation": "अरे, कोई अंडे हैं?"
    },
    {
      "target": "Strings/1_6_Strings",
      "key": "Shop_Caroline",
      "translation": "नमस्ते। उम्मीद है तुम्हें अपनी पसंद की कोई चीज़ मिलेगी।"
    },
    {
      "target": "Strings/1_6_Strings",
      "key": "Shop_Gus",
      "translation": "कुछ स्वादिष्ट खाने का मन है?"
    },
    {
      "target": "Strings/1_6_Strings",
      "key": "Shop_Elliott",
      "translation": "कुछ रोचक चीज़ें बहकर समुद्र तट पर आईं। विनिमय का मन है?"
    },
    {
      "target": "Strings/1_6_Strings",
      "key": "Shop_Haley",
      "translation": "और अंडे खोजकर लाओ ताकि मेरा सारा सामान खरीद सको!"
    },
    {
      "target": "Strings/1_6_Strings",
      "key": "Shop_Demetrius",
      "translation": "विनिमय के लिए कोई अंडे हैं? मैं खोल की संरचना का अध्ययन कर रहा हूँ।"
    },
    {
      "target": "Strings/1_6_Strings",
      "key": "Shop_Clint",
      "translation": "कोई अयस्क चाहिए?"
    },
    {
      "target": "Strings/1_6_Strings",
      "key": "Shop_Robin",
      "translation": "अरे, मेरे बनाए इस विशेष वॉलपेपर को देखो। चाहिए?"
    },
    {
      "target": "Strings/1_6_Strings",
      "key": "Shop_Pam",
      "translation": "हेहेहे... फ़्रिज के पीछे कुछ पुराने पेय मिले।"
    },
    {
      "target": "Strings/1_6_Strings",
      "key": "Shop_Penny",
      "translation": "नमस्ते! उम्मीद है अपनी पसंद की कोई चीज़ मिलेगी।"
    },
    {
      "target": "Strings/1_6_Strings",
      "key": "Shop_Leo",
      "translation": "मुझे कुछ अंडे मिल सकते हैं? मैं उन्हें अपने घोंसले में रखना चाहता हूँ।"
    },
    {
      "target": "Strings/1_6_Strings",
      "key": "Shop_Evelyn",
      "translation": "नमस्ते प्रिय। आराम से देखो, मैं दिन भर यहीं रहूँगी!"
    },
    {
      "target": "Strings/1_6_Strings",
      "key": "Shop_George",
      "translation": "बेचने लायक़ हर चीज़ मेरे पास है।"
    },
    {
      "target": "Strings/1_6_Strings",
      "key": "Shop_Marnie",
      "translation": "घर से वॉलपेपर का एक अतिरिक्त रोल मिला। 20 अंडों में तुम्हारा!"
    },
    {
      "target": "Strings/1_6_Strings",
      "key": "Shop_Shane",
      "translation": "फ़्रीज़र में कुछ खाना मिला। सस्ते में तुम्हारा। बस समाप्ति तिथि मत देखना।"
    },
    {
      "target": "Strings/1_6_Strings",
      "key": "Shop_Jas",
      "translation": "नमस्ते... उम्म... *खिलखिलाती है*"
    },
    {
      "target": "Strings/1_6_Strings",
      "key": "Shop_Jodi",
      "translation": "माफ़ करना, इस वर्ष मेरा चुनाव बहुत अच्छा नहीं है..."
    },
    {
      "target": "Strings/1_6_Strings",
      "key": "Shop_Vincent",
      "translation": "नमस्ते! उम्म... मुझे कुछ सामान मिला। ख़रीदना है!?"
    },
    {
      "target": "Strings/1_6_Strings",
      "key": "Shop_Kent",
      "translation": "अरे, मेरे पास बेचने के लिए कुछ चीज़ें हैं। कोई पसंद आए तो बताना।"
    },
    {
      "target": "Strings/1_6_Strings",
      "key": "Shop_Eggs",
      "translation": "व... विनिमय... अ... अंडे..."
    },
    {
      "target": "Strings/1_6_Strings",
      "key": "DF_Mine_Explanation",
      "translation": "---खोपड़ी गुफ़ा चुनौती में स्वागत है!---^^कैलिको अंडे और रहस्यमयी कैलिको प्रतिमाएँ पूरी गुफ़ा में प्रकट हुई हैं।^"
    },
    {
      "target": "Strings/1_6_Strings",
      "key": "DF_Mine_Explanation_2",
      "translation": "आपका \"अंडा अंक\" कैलिको अंडे मिलने की संभावना तय करता है।^^हर 5 स्तर नीचे जाने पर और कैलिको प्रतिमा सक्रिय करने पर \"अंडा अंक\" बढ़ता है।^"
    },
    {
      "target": "Strings/1_6_Strings",
      "key": "DF_Mine_Explanation_3",
      "translation": "...मगर सावधान! कैलिको प्रतिमाएँ कई अजीब और ख़तरनाक प्रभाव भी बुलाएँगी!^^ऊँचा \"अंडा अंक\" पाने के पुरस्कार लेने गिल के पास जाएँ।^"
    },
    {
      "target": "Strings/1_6_Strings",
