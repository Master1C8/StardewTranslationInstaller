{
  "id": "hi-short-0215",
  "kind": "short",
  "records": [
    {
      "target": "Strings/StringsFromMaps",
      "key": "HaleyHouse.12",
      "translation": "'उद्देश्य के साथ हाथ-पैर चलाना: नृत्य कला का आधुनिक दृष्टिकोण'"
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "HaleyHouse.13",
      "translation": "'अपना अँधेरा फ़ोटो-कक्ष शुरू से बनाएँ'"
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "HaleyHouse.14",
      "translation": "यह ग्लोब है। अरे, यह रही स्टारड्यू वैली!"
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "HaleyHouse.15",
      "translation": "ओवन से ताज़े कपकेक जैसी मीठी महक आती है।"
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "HaleyHouse.16",
      "translation": "कपकेक, दूध, कसकर बंद कॉर्निशॉन का मर्तबान और क्विनोआ सलाद।"
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "HaleyHouse.17",
      "translation": "हमारी प्यारी बेटियों के लिए:^तुम्हारी याद आती है और उम्मीद है तुम दोनों अपने दम पर ठीक हो। दो महीने रहने के बाद हम कल रात ही फ़र्न द्वीपसमूह से निकले हैं।^यह अद्भुत अनुभव था... इसकी बहुत सलाह देंगे।^स्वस्थ भोजन करना और बिजली का बिल चुकाना मत भूलना!^^प्यार, माँ और पापा"
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "HaleyHouse.18",
      "translation": "'सुपर फ़ैशन गर्ल' पत्रिका"
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "HarveyRoom.1",
      "translation": "फ़र्नगिल गणराज्य और गोतोरो साम्राज्य के लड़ाकू विमानों की तुलना।"
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "HarveyRoom.2",
      "translation": "स्टारड्यू वैली के ऊपर आकाश का सुंदर दृश्य है।"
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "HarveyRoom.3",
      "translation": "यह हार्वी का आदर्श विमानों का संग्रह है।"
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "HarveyRoom.4",
      "translation": "यह हार्वी का आदर्श विमानों का संग्रह है।"
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "HarveyRoom.5",
      "translation": "यह जटिल रेडियो प्रसारण उपकरण है।"
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "HarveyRoom.6",
      "translation": "यह जटिल रेडियो प्रसारण उपकरण है।"
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "HarveyRoom.7",
      "translation": "भीतर एक कैसेट है: 'कालजयी जैज़ संकलन'"
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "HarveyRoom.8",
      "translation": "'ख़ुद करें! घुटने की शल्यक्रिया'"
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "HarveyRoom.9",
      "translation": "'फुफ्फुसीय उच्च रक्तचाप का अकेला रक्षक'"
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "HarveyRoom.10",
      "translation": "आपको कुछ नहीं मिला और अब आपके हाथों से बदबू आ रही है।"
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "HarveyRoom.11",
      "translation": "यह खूब इस्तेमाल किया हुआ लगता है।"
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "HarveyRoom.12",
      "translation": "यह झटपट खाने से भरा है।"
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "HarveyRoom.13",
      "translation": "\"ज़मीन-से-हवा रेडियो नियमावली\""
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "HarveyRoom.14",
      "translation": "यह काफ़ी सामान्य टीवी है। इसमें इतिहास वाला चैनल लगा है।"
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "Hospital.1",
      "translation": "यह पात्र का चिह्न है। योबा में विश्वास रखने वालों को सांत्वना देने के लिए यहाँ है।"
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "Hospital.2",
      "translation": "यह नमूने का मर्तबान है। इसमें उँगलियाँ न डालना बेहतर होगा।"
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "Hospital.3",
      "translation": "इसमें हाथ डालना शायद अच्छा विचार नहीं। यह इस्तेमाल हुई सिरिंज, गंदे फाहों और उन छोटी नलिकाओं से भरा है जिन्हें हार्वी ने लोगों के कानों में डाला था।"
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "Hospital.4",
      "translation": "क्या जीवन कभी-कभी कठिन होता है? क्या ध्यान लगाए रखने में परेशानी होती है? प्रैवोलॉक्सिनोन के बारे में अपने डॉक्टर से बात करें।^(प्रैवोलॉक्सिनोन सभी के लिए नहीं है। दुष्प्रभावों में अनिद्रा, अत्यधिक क्रोध, गले की अनियंत्रित सूजन, होंठों का स्थायी बदरंग होना, बाल झड़ना और आघात शामिल हो सकते हैं। अत्यंत दुर्लभ मामलों में (500 में 1), परीक्षण विषयों की एक या अधिक हड्डियाँ पूरी तरह विघटित हो गईं।) "
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "Hospital.5",
      "translation": "'बीमारी न फैलाएँ... छींक ढककर आएँ!'"
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "Hospital.6",
      "translation": "इस चिकित्सालय को फ़र्नगिल गणराज्य स्वास्थ्य प्राधिकरण ने चिकित्सा का लाइसेंस दिया है।"
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "Hospital.7",
      "translation": "अरे, यह पौधा नक़ली है!"
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "JojaMart.1",
      "translation": "होइसिन चटनी"
    },
    {
