    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "JojaMart.3",
      "translation": "बिना चीनी के मार्शमैलो"
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "JojaMart.4",
