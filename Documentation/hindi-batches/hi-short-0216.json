    {
      "target": "Strings/StringsFromMaps",
      "key": "JoshHouse.1",
      "translation": "माँ-^अगर तुम यह पढ़ रही हो तो इसका मतलब मैं जा चुकी हूँ। तुम्हें यह सहना पड़ा, इसके लिए बहुत दुखी हूँ। जान लो कि मैं तुम दोनों से प्यार करती हूँ।^बहुत दुखी मत होना, अब मैं योबा के साथ हूँ। ^मेरी अंतिम विनती: एलेक्स का ख़याल रखना। उसे एक परिवार, कुछ स्थिरता चाहिए। वह अच्छा बच्चा है।^ प्यार, ^क्लारा"
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "JoshHouse.2",
      "translation": "रेडियो पर पुराने गीतों वाला चैनल लगा है।"
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "JoshHouse.3",
      "translation": "'पेशेवर ग्रिडबॉल ऋतु 44: आँकड़े और स्थान'"
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "JoshHouse.4",
      "translation": "'हानि से उबरना'"
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "JoshHouse.5",
      "translation": "'विशाल मांसपेशियाँ' पत्रिका"
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "JoshHouse.6",
      "translation": "यह तीस पाउंड का भार है।"
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "JoshHouse.7",
      "translation": "आप एलेक्स की दराज़ में झाँकते हैं। वहाँ वस्त्र, बाल जेल और ग्रिडबॉल संग्रह-पत्तों की एक पेटी है।"
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "JoshHouse.8",
      "translation": "आप एलेक्स की दराज़ में झाँकते हैं। वहाँ वस्त्र, बाल जेल और ग्रिडबॉल संग्रह-पत्तों की एक पेटी है।"
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "JoshHouse.9",
      "translation": "यह एलेक्स का ग्रिडबॉल शिरस्त्राण है। लगता है वह इसे चमकाकर रखता है।"
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "JoshHouse.10",
      "translation": "यह ग्रिडबॉल है।"
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "JoshHouse.11",
      "translation": "यह अच्छी तरह भरा फ़्रिज है।"
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "JoshHouse.12",
      "translation": "'हर ऋतु के लिए कुकी'"
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "JoshHouse.13",
      "translation": "'गहरा नीला जीवन: एक कोयला खनिक का संस्मरण'"
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "JoshHouse.14",
      "translation": "यह खाली है।"
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "LeahHouse.1",
      "translation": "इस पर अभी काम चल रहा है।"
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "LeahHouse.2",
      "translation": "यह लिया की तस्वीरों का ढेर है। ज़्यादातर प्राकृतिक दृश्यों और प्रकृति के अध्ययन हैं।"
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "LeahHouse.3",
      "translation": "'ज़मीन के सहारे जीना: व्यावहारिक मार्गदर्शक'"
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "LeahHouse.4",
      "translation": "'दबंग लोगों से कैसे निपटें'"
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "LeahHouse.5",
      "translation": "यह लिया की बन रही लकड़ी की मूर्ति है। इससे देवदार की अद्भुत महक आती है।"
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "LeahHouse.6",
      "translation": "कोई संदेश नहीं।"
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "ManorHouse.1",
      "translation": "महापौर के ओवन को अच्छी सफ़ाई चाहिए।"
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "ManorHouse.2",
      "translation": "पारंपरिक चाय की सजावट। महापौर चाय को बहुत गंभीरता से लेते होंगे।"
    },
    {
      "target": "Strings/StringsFromMaps",
      "key": "ManorHouse.3",
      "translation": "कल रात मिलने आओगे?^पिछली खिड़की से आओ तो किसी को पता नहीं चलेगा।^मैं तुमसे और अक्सर मिलना चाहती हूँ।^जानती हूँ तुम व्यस्त हो, मगर क्या मेरे लिए समय नहीं निकाल सकते?^उम्मीद है कल मिलोगे।^-एम"
