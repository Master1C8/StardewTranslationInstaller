    {
      "target": "Strings/Locations",
      "key": "BeachNightMarket_Closed",
      "translation": "शाम 5 बजे खुलता है।"
    },
    {
      "target": "Strings/Locations",
      "key": "BeachNightMarket_SubmarineInUse",
      "translation": "पनडुब्बी अभी इस्तेमाल हो रही है। बाद में लौटें।"
    },
    {
      "target": "Strings/Locations",
      "key": "BeachNightMarket_GiftGiverClosed",
      "translation": "व्यापारी: रात्रि बाज़ार शाम 5 बजे शुरू होता है... तब एक मुफ़्त कप कॉफ़ी के लिए मेरे पास आना! "
    },
    {
      "target": "Strings/Locations",
      "key": "BeachNightMarket_GiftGiverQuestion",
      "translation": "व्यापारी: नमस्ते! एक कप कॉफ़ी चाहिए?"
    },
    {
      "target": "Strings/Locations",
      "key": "BeachNightMarket_GiftGiverEnjoy",
      "translation": "व्यापारी: म्म्म... शानदार महक है, है न?"
    },
    {
      "target": "Strings/Locations",
      "key": "BeachNightMarket_PainterClosed",
      "translation": "प्रसिद्ध चित्रकार लुपिनी: मेरी उत्कृष्ट कलाकृति खरीदना चाहें तो बाज़ार खुलने पर लौटें।"
    },
    {
      "target": "Strings/Locations",
      "key": "BeachNightMarket_PainterQuestion",
      "translation": "प्रसिद्ध चित्रकार लुपिनी: मैं यह तस्वीर 1200g में बेच रहा हूँ। क्या कहते हैं?"
    },
    {
      "target": "Strings/Locations",
      "key": "BeachNightMarket_PainterSold",
      "translation": "प्रसिद्ध चित्रकार लुपिनी: क्षमा करें... आज बेचने के लिए कोई तस्वीर बाकी नहीं है।"
    },
    {
      "target": "Strings/Locations",
      "key": "BeachNightMarket_WarperQuestion",
      "translation": "ढकी आकृति: मैं आपको 250g में घर भेज सकता हूँ।"
    },
    {
      "target": "Strings/Locations",
      "key": "Beach_FixBridge_Question",
      "translation": "पुल सुधारने के लिए लकड़ी के 300 टुकड़े इस्तेमाल करें?"
    },
    {
      "target": "Strings/Locations",
      "key": "Beach_FixBridge_Hint",
      "translation": "हम्म... लकड़ी के 300 टुकड़ों से इसे सुधारा जा सकता है।"
    },
    {
      "target": "Strings/Locations",
      "key": "Beach_GoneFishingMessage",
      "translation": "    मछली पकड़ने गया हूँ।\n\n   कल लौटूँगा।"
    },
    {
