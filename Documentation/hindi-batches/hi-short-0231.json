  "records": [
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "Event.cs.1850",
      "translation": "क्रिस्टल गेंद आगे बढ़ गई है... यह तुम हो... वन में। घास के गुच्छे के नीचे छिपे कुछ दुर्लभ और स्वादिष्ट मशरूम दिखते हैं... क्या खोज है!"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "Event.cs.1851",
      "translation": "क्रिस्टल गेंद आगे बढ़ गई है... मैं तुम्हें एक सुनहरे कमरे में देख रही हूँ... तुम्हारे चेहरे पर किसी बात की मुस्कान है। ओह, समझी... यह कोई ऐसा खेल है जिसमें तुम्हारी हार हो ही नहीं सकती!"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "Event.cs.1852",
      "translation": "आह... क्रिस्टल गेंद धुँधली हो गई। अभी तुम्हारे लिए इतना ही कर सकती हूँ, बच्चे।"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "Event.cs.1853",
      "translation": "बस याद रखना, भविष्य पत्थर पर नहीं लिखा होता! आज मैंने जो भी बताया है, मन में ठान लो तो उसे अब भी बदल सकते हो। विदा।"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "Event.cs.1857",
      "translation": "आपने सूप में {0} डाला।"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "Event.cs.1862",
      "translation": "एबिगेल!"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "Event.cs.1864",
      "translation": "बराबरी हुई है इनके बीच:"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "Event.cs.1865",
      "translation": " और"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "Event.cs.1871",
      "translation": "विली, 5 बड़ी और ताज़ी मछलियों के साथ!"
    },
    {
