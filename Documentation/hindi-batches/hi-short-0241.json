    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "Object.cs.12926",
      "translation": "अब तक कोई कौआ नहीं मिला।"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "Object.cs.12927",
      "translation": "मैंने 1 कौआ भगाया है।"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "Object.cs.12929",
      "translation": "मैंने {0} कौए भगाए हैं।"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "Object.cs.12942",
      "translation": "चारा-पात्र ख़ाली है। इसे फिर भरने के लिए चारा-भंडार बनाएँ और हँसिए से घास काटें।"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "Object.cs.12993",
      "translation": "आपको एक पुरावशेष मिला! शायद स्थानीय संग्रहालय के क्यूरेटर इसके बारे में जानना चाहेंगे।"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "Object.cs.12994",
      "translation": "आपको एक 'खोई पुस्तक' मिली। पुस्तकालय का संग्रह बढ़ गया है!"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "Object.cs.12995",
      "translation": "आपको एक 'जियोड' मिला! स्थानीय लोहार इसे आपके लिए खोल सकता है। कौन जाने भीतर क्या छिपा हो?"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "Object.cs.12996",
      "translation": "आपको दादाजी के मंदिर के पीछे एक विचित्र प्रतिमा मिली।"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "Object.cs.13021",
      "translation": "अमान्य स्थान।"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "Object.cs.13053",
      "translation": "अनुपयुक्त जगह।"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "Object.cs.13060",
      "translation": "दूसरे पेड़ के बहुत पास।"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "Object.cs.13068",
      "translation": "यहाँ नहीं लगाया जा सकता।"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "Object.cs.13073",
      "translation": "{0} बनाने की विधि"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "Object.cs.13074",
      "translation": "{0} बनाने का खाका"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "Object.cs.13078",
      "translation": "इसे संग्रहालय में दान दें तो गुंथर इसके बारे में और बता सकता है।"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "SpecialItem.cs.13088",
      "translation": "खोपड़ी चाबी"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "SpecialItem.cs.13089",
      "translation": "क्लब कार्ड"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "SpecialItem.cs.13090",
      "translation": "लकड़ी के एक टुकड़े के नीचे आपको {0} मिला! आपको नहीं पता कि यह किस काम आता है, मगर महत्वपूर्ण लगता है। इसे आपके बटुए में जोड़ दिया गया है।"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "SpecialItem.cs.13092",
      "translation": "आपको {0} मिल गया! आपको नहीं पता कि यह किस काम आता है, मगर महत्वपूर्ण लगता है। इसे आपके बटुए में जोड़ दिया गया है।"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "SpecialItem.cs.13094",
      "translation": "आपको {0} मिल गया! आपके सामान की जगह बढ़कर {1} हो गई है।"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "TV.cs.13105",
      "translation": "मौसम का हाल"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "TV.cs.13107",
      "translation": "भविष्यवक्ता"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "TV.cs.13111",
      "translation": "ज़मीन के सहारे"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "TV.cs.13114",
      "translation": "सॉस की रानी"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "TV.cs.13117",
      "translation": "सॉस की रानी (पुनः प्रसारण)"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "TV.cs.13118",
      "translation": "(जाएँ)"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "TV.cs.13120",
      "translation": "चैनल चुनें:"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "TV.cs.13124",
      "translation": "\"ज़मीन के सहारे\" में स्वागत है। हम आप सबके लिए एक और सुझाव लेकर लौटे हैं। अब ध्यान से सुनिए:"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "TV.cs.13127",
      "translation": "अभिवादन! मैं हूँ, सॉस की रानी... अपनी गुप्त पाक-पुस्तक से आपको एक नई मुँह में पानी लाने वाली विधि सिखाने आई हूँ। इस सप्ताह का पकवान है..."
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "TV.cs.13128",
      "translation": "आह... मुझे आभास हो रहा है कि एक नया दर्शक हमसे जुड़ा है। एक युवक... स्टारड्यू वैली से? स्वागत है, स्वागत है!"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "TV.cs.13130",
      "translation": "आह... मुझे आभास हो रहा है कि एक नई दर्शक हमसे जुड़ी है। एक युवती... स्टारड्यू वैली से? स्वागत है, स्वागत है!"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "TV.cs.13132",
      "translation": "आह... हाँ, मुझे आत्माएँ कुछ फुसफुसाती सुनाई दे रही हैं... "
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "TV.cs.13133",
      "translation": "'वेलविक की भविष्यवाणी' में फिर स्वागत है... अगर भविष्य का गुप्त ज्ञान चाहते हैं तो आप सही जगह आए हैं।"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "TV.cs.13134",
      "translation": "ऊह... मेरी भविष्यदर्शी गेंद के भीतर एक चमक दिख रही है... भविष्य से ज्ञान का एक अंश!"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "TV.cs.13135",
      "translation": "वेलविक की भविष्यवाणी में स्वागत है... एकमात्र कार्यक्रम, जहाँ आत्माओं की आवाज़ सीधे... आप तक पहुँचती है।"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "TV.cs.13136",
      "translation": "कोज़ू 5 में स्वागत है... मौसम, समाचार और मनोरंजन के लिए आपका पहला स्रोत।^और अब, कल के मौसम का हाल..."
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "TV.cs.13148",
      "translation": "बस मज़ाक़ था... मैं तैयार नहीं हूँ। आज आपके लिए कुछ नहीं है।"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "TV.cs.13151",
      "translation": "आप {0} पकाना पहले से जानते हैं।"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "TV.cs.13153",
      "translation": "आपने '{0}' पकाना सीख लिया!"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "TV.cs.13164",
      "translation": "उम्म... यह अजीब है। मेरी सूचना-पर्ची पर बस 'null' लिखा है। कितनी शर्मिंदगी की बात है... "
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "TV.cs.13170",
      "translation": "पेलिकन टाउन में"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "TV.cs.13172",
      "translation": "समुद्रतट पर"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "TV.cs.13174",
      "translation": "वन में"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "TV.cs.13175",
      "translation": "कल आसमान साफ़ और धूप खिली रहेगी... {0} के लिए एकदम सही मौसम! आयोजन {1} होगा और {2} से {3} के बीच शुरू होगा। देर मत करना!"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "TV.cs.13180",
      "translation": "गरम कपड़े पहनिए, दोस्तो। कल बर्फ़ गिरेगी!"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "TV.cs.13181",
      "translation": "कल कुछ इंच बर्फ़ गिरने की संभावना है।"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "TV.cs.13182",
      "translation": "कल का दिन सुंदर और धूप भरा होगा!"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "TV.cs.13183",
      "translation": "पूरा दिन आसमान साफ़ और धूप खिली रहेगी।"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "TV.cs.13184",
      "translation": "कल पूरे दिन वर्षा होगी।"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "TV.cs.13185",
      "translation": "लगता है तूफ़ान आ रहा है। गरज और बिजली की संभावना है।"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "TV.cs.13187",
      "translation": "हल्की हवा के साथ कुछ बादल रहेंगे। बहुत पराग उड़ने की संभावना है!"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "TV.cs.13189",
      "translation": "पूरे दिन तेज़ हवा के झोंकों के साथ बादल छाए रहेंगे।"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "TV.cs.13190",
      "translation": "पूरे दिन बर्फ़ गिरेगी। गरम कपड़े पहनना न भूलें, दोस्तो!"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "TV.cs.13191",
      "translation": "आत्माएँ क्रोधित हैं। लगता है किसी ने उन्हें बेकार भेंट देने की कोशिश की... हम्म। आत्माओं से मज़ाक़ करना बुद्धिमानी नहीं है!"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "TV.cs.13192",
      "translation": "आज आत्माएँ बहुत अप्रसन्न हैं। वे आपका जीवन कठिन बनाने की पूरी कोशिश करेंगी।"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "TV.cs.13193",
      "translation": "आज आत्माएँ कुछ चिढ़ी हुई हैं। भाग्य आपके साथ नहीं होगा।"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "TV.cs.13195",
      "translation": "आज आत्माएँ कुछ हल्के रूप से व्याकुल हैं। भाग्य आपके साथ नहीं होगा।"
    }
  ]
}
