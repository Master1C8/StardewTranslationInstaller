    {
      "target": "Strings/StringsFromCSFiles",
      "key": "ItemDeliveryQuest.cs.13464",
      "translation": "मैं {0} को {1} रखना चाहता हूँ। कृपया आज किसी समय इसे पहुँचा दें।"
