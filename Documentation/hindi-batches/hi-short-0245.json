    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "SlayMonsterQuest.cs.13760",
      "translation": "तुम्हारे काम से तात्त्विक शक्तियाँ प्रसन्न हैं। वादे के अनुसार यह रहा तुम्हारा भुगतान।"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "SlayMonsterQuest.cs.13764",
      "translation": "वांछित: स्थानीय खदानों में {0} {1} मारने वाला राक्षस शिकारी।"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "SlayMonsterQuest.cs.13767",
      "translation": "आह, @! तो तुमने हमारी राक्षस समस्या में मदद की? धन्यवाद!$h#$b#आशा है तुम्हें बहुत परेशानी नहीं हुई..."
    },
    {
      "target": "Strings/StringsFromCSFiles",
