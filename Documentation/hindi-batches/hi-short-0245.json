    {
      "target": "Strings/StringsFromCSFiles",
      "key": "ResourceClump.cs.13945",
      "translation": "आपकी कुल्हाड़ी इस ठूँठ को तोड़ने जितनी शक्तिशाली नहीं है।"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "ResourceClump.cs.13948",
