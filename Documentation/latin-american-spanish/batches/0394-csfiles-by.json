    "FishingQuest.cs.13255": "Calamares capturados: {0}/{1}",
    "FishingQuest.cs.13256": "¡Oye, lo lograste, @!$h#$b#Capturar {0} es emocionante, ¿no crees? ",
    "FishingQuest.cs.13258": "Siempre se esconden en los lugares más peculiares.",
    "FishingQuest.cs.13259": "Nadan con una fuerza impresionante.",
    "FishingQuest.cs.13260": "Una vez atrapé uno del tamaño de{0}",
    "FishingQuest.cs.13261": " una motocicleta pequeña!",
    "FishingQuest.cs.13262": " una silla plegable!",
    "FishingQuest.cs.13263": " una cortadora de césped!",
    "FishingQuest.cs.13264": " una enciclopedia completa!",
    "FishingQuest.cs.13265": " una máquina arcade!",
    "FishingQuest.cs.13266": " una ternera!",
    "FishingQuest.cs.13267": "A veces parecen tan inteligentes que da miedo.$u",
    "FishingQuest.cs.13268": "#$b#Bueno, aquí tienes tu recompensa. Felicidades.$h",
    "FishingQuest.cs.13274": "\n\n- Recompensa de {0}g.",
    "FishingQuest.cs.13275": "\n- Puedes quedarte con los peces."
  },
  "notes": {}
}
