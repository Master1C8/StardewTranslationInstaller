    { "target": "Characters/Dialogue/Leo", "key": "Mon", "source": "Hi... Everything okay?", "translation": "سلام... همه‌چیز خوبه؟" },
    { "target": "Characters/Dialogue/Leo", "key": "AcceptGift_(O)StardropTea", "source": "Wow, tastes just like golden walnuts! This is great!", "translation": "وای، مزه‌اش درست مثل گردوی طلاییه! عالیه!" },
    { "target": "Characters/Dialogue/Leo", "key": "AcceptGift_(TR)ParrotEgg", "source": "This is a precious egg... A baby! I'm glad you brought it to me, I'll keep it safe.", "translation": "این تخم خیلی ارزشمنده... یه بچه! خوشحالم آوردیش پیش من؛ مواظبش می‌مونم." },
    { "target": "Characters/Dialogue/Leo", "key": "Mon4", "source": "I've learned a lot from my parrot family...#$b#But I'm sure there's a lot more out there I don't know.$s", "translation": "از خانوادهٔ طوطی‌ام خیلی چیزها یاد گرفته‌ام...#$b#ولی مطمئنم بیرون چیزهای خیلی بیشتری هست که نمی‌دانم.$s" },
    { "target": "Characters/Dialogue/Leo", "key": "Tue", "source": "When Sun is angry, it feels good in the jungle.#$e#Sun can't find us beneath the leaves. We trick him! Haha...$h", "translation": "وقتی خورشید عصبانی است، توی جنگل هوا خوبه.#$e#خورشید زیر برگ‌ها پیدامون نمی‌کنه. گولش زدیم! هاها...$h" },
    { "target": "Characters/Dialogue/Leo", "key": "Wed", "source": "...Sorry... I'm shy today.$3", "translation": "...ببخشید... امروز خجالت می‌کشم.$3" },
    { "target": "Characters/Dialogue/Leo", "key": "Wed2", "source": "Be careful in the volcano... the spirits don't like outsiders.", "translation": "توی آتشفشان مراقب باش... روح‌ها غریبه‌ها رو دوست ندارند." },
    { "target": "Characters/Dialogue/Leo", "key": "Thu", "source": "Have you met the others like you?#$b#I don't talk to them much. I feel safer with my own kind...$3", "translation": "بقیهٔ آدم‌هایی که مثل تو هستند را دیده‌ای؟#$b#من زیاد باهاشون حرف نمی‌زنم. کنار هم‌نوع‌های خودم احساس امنیت بیشتری دارم...$3" },
    { "target": "Characters/Dialogue/Leo", "key": "Fri", "source": "One time... I was at the top of the volcano at night, and I saw lights far, far away.#$b#I wonder if there are other bird families out there?$3", "translation": "یک بار... شب بالای آتشفشان بودم و خیلی خیلی دور نورهایی دیدم.#$b#یعنی آن بیرون خانواده‌های پرندهٔ دیگری هم هستند؟$3" },
    { "target": "Characters/Dialogue/Leo", "key": "Fri4", "source": "I wonder if I could see your home from the top of the volcano?", "translation": "یعنی از بالای آتشفشان می‌توانم خانه‌ات را ببینم؟" },
    { "target": "Characters/Dialogue/Leo", "key": "Sat", "source": "...I'm sad today.$s#$e#You go on... have fun. Let me be sad.$s", "translation": "...امروز غمگینم.$s#$e#تو برو... خوش بگذران. بگذار من غمگین باشم.$s" },
    { "target": "Characters/Dialogue/Leo", "key": "Sun", "source": "When it rains, strange birds visit.#$b#I try to speak to them... but they fly away.$s#$b#I guess they don't want to be friends...$s", "translation": "وقتی باران می‌بارد، پرنده‌های عجیبی می‌آیند.#$b#سعی می‌کنم باهاشون حرف بزنم... اما پرواز می‌کنند و می‌روند.$s#$b#فکر کنم نمی‌خواهند دوست بشوند...$s" }
  ]
