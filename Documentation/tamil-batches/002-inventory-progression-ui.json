    { "target": "Strings/UI", "key": "JojaCDMenu_Hover0", "source": "Repairs the bus that runs to Calico Desert.", "translation": "காலிகோ பாலைவனத்துக்குச் செல்லும் பேருந்தைச் சீரமைக்கிறது." },
    { "target": "Strings/UI", "key": "JojaCDMenu_Hover1", "source": "Repairs the minecart system that runs between the bus stop, the mountains, and Pelican Town.", "translation": "பேருந்து நிறுத்தம், மலைப்பகுதி, பெலிக்கன் நகரம் ஆகியவற்றுக்கு இடையே இயங்கும் சுரங்கவண்டி முறையைச் சீரமைக்கிறது." },
    { "target": "Strings/UI", "key": "JojaCDMenu_Hover2", "source": "Repairs the broken bridge in the mountains.", "translation": "மலைப்பகுதியில் உடைந்த பாலத்தைச் சீரமைக்கிறது." },
    { "target": "Strings/UI", "key": "JojaCDMenu_Hover3", "source": "Repairs the old ruins on the farm, turning it into a greenhouse.", "translation": "பண்ணையிலுள்ள பழைய இடிபாடுகளைச் சீரமைத்துப் பசுமைக்குடிலாக மாற்றுகிறது." },
    { "target": "Strings/UI", "key": "JojaCDMenu_Hover4", "source": "Removes the glimmering boulder near the mine entrance.", "translation": "சுரங்க நுழைவுக்கு அருகிலுள்ள மின்னும் பாறையை அகற்றுகிறது." },
