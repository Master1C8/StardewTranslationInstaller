    { "target": "Strings/UI", "key": "PondQuery_StatusRequestPending0", "source": "\"You know, {1} {0} would liven things up around here!\"", "translation": "\"தெரியுமா, {1} {0} இங்கே கலகலப்பைக் கூட்டும்!\"" },
