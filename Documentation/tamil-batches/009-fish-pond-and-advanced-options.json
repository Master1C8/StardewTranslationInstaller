    { "target": "Strings/UI", "key": "PondQuery_StatusRequestPending5", "source": "\"Excuse me... we'd like {1} {0}, please.\"", "translation": "\"மன்னிக்கவும்... எங்களுக்கு {1} {0} வேண்டும், தயவுசெய்து.\"" },
    { "target": "Strings/UI", "key": "PondQuery_StatusRequestPending6", "source": "\"We'd feel more at home with {1} {0}...\"", "translation": "\"{1} {0} இருந்தால் எங்கள் வீட்டிலிருப்பதுபோல் உணர்வோம்...\"" },
    { "target": "Strings/UI", "key": "PondQuery_StatusRequestPending_Rude0_Male", "source": "\"Hey, landlubber, you think you could bring us {1} {0}?\"", "translation": "\"ஏய், நிலவாசியே, எங்களுக்கு {1} {0} கொண்டுவர முடியுமா?\"" },
