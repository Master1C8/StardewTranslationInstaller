    { "target": "Strings/UI", "key": "PondQuery_StatusRequestPending_Stiff2", "source": "\"We've decided that we need {1} {0}.\"", "translation": "\"எங்களுக்கு {1} {0} தேவை என்று முடிவுசெய்துள்ளோம்.\"" },
