    { "target": "Strings/UI", "key": "PondQuery_StatusRequestPending_Demanding0", "source": "\"{2}! {2}! We want {1} {0}...!\"", "translation": "\"{2}! {2}! எங்களுக்கு {1} {0} வேண்டும்...!\"" },
