{
  "id": "010-advanced-setup-forge-and-build-ui",
  "kind": "short",
  "records": [
    { "target": "Strings/UI", "key": "AGO_CCB_Normal", "source": "Normal", "translation": "சாதாரணம்" },
    { "target": "Strings/UI", "key": "AGO_Year1Completable_Tooltip", "source": "Ensures that the Traveling Merchant sells a Red Cabbage seed some time during the first year.", "translation": "முதல் ஆண்டில் எப்போதாவது சுற்றுலா வணிகர் சிவப்பு முட்டைக்கோஸ் விதையை விற்பதை உறுதிசெய்கிறது." },
    { "target": "Strings/UI", "key": "AGO_MineTreasureShuffle", "source": "Mine Rewards:", "translation": "சுரங்க வெகுமதிகள்:" },
    { "target": "Strings/UI", "key": "AGO_MineTreasureShuffle_Tooltip", "source": "Modifies the rewards that appear in the Mines.", "translation": "சுரங்கங்களில் தோன்றும் வெகுமதிகளை மாற்றுகிறது." },
    { "target": "Strings/UI", "key": "AGO_FarmMonsters_Tooltip", "source": "Allows monsters to spawn at night.", "translation": "இரவில் அரக்கர்கள் தோன்ற அனுமதிக்கிறது." },
    { "target": "Strings/UI", "key": "AGO_ProfitMargin_Tooltip", "source": "A multiplier applied to the price of items sold.", "translation": "விற்கப்படும் பொருட்களின் விலைக்குப் பயன்படுத்தப்படும் பெருக்கி." },
    { "target": "Strings/UI", "key": "AGO_MPOptions_Label", "source": "Multiplayer Options:", "translation": "பலர் விளையாட்டு விருப்பங்கள்:" },
    { "target": "Strings/UI", "key": "AGO_StartingCabins_Tooltip", "source": "The number of starting cabins.", "translation": "தொடக்கக் குடில்களின் எண்ணிக்கை." },
    { "target": "Strings/UI", "key": "AGO_OtherOptions_Label", "source": "Other Options:", "translation": "மற்ற விருப்பங்கள்:" },
    { "target": "Strings/UI", "key": "AGO_CabinLayout_Tooltip", "source": "Whether the cabins are placed closer or further away from one another.", "translation": "குடில்கள் ஒன்றுக்கொன்று அருகிலா தொலைவிலா வைக்கப்பட வேண்டும் என்பதைத் தீர்மானிக்கிறது." },
    { "target": "Strings/UI", "key": "AGO_RandomSeed", "source": "Random Seed:", "translation": "சீரற்ற விதை:" },
    { "target": "Strings/UI", "key": "AGO_RandomSeed_Tooltip", "source": "The seed used to randomize the game world.", "translation": "விளையாட்டு உலகைச் சீரற்றதாக்கப் பயன்படுத்தப்படும் விதை." },
    { "target": "Strings/UI", "key": "AGO_LegacyRandomization_Tooltip", "source": "Make random choices in a way that often repeats patterns. Most players should keep this disabled.", "translation": "அடிக்கடி ஒரே வடிவங்கள் திரும்ப வரும் முறையில் சீரற்ற தேர்வுகளைச் செய்கிறது. பெரும்பாலான வீரர்கள் இதை முடக்கிவைக்க வேண்டும்." },
    { "target": "Strings/UI", "key": "Options_SlingshotMode_Hold", "source": "Hold and release", "translation": "பிடித்திருந்து விடு" },
    { "target": "Strings/UI", "key": "Options_SlingshotMode_Pull", "source": "Pull in opposite direction", "translation": "எதிர்த்திசையில் இழு" },
    { "target": "Strings/UI", "key": "Bed_InUse", "source": "Cannot move a bed that is currently being used.", "translation": "பயன்பாட்டிலுள்ள படுக்கையை நகர்த்த முடியாது." },
    { "target": "Strings/UI", "key": "Bed_CantMoveOthersBeds", "source": "You cannot move beds in another player's house.", "translation": "மற்றொரு வீரரின் வீட்டிலுள்ள படுக்கைகளை நீங்கள் நகர்த்த முடியாது." },
    { "target": "Strings/UI", "key": "Bed_NeedsUpgrade", "source": "Bed type cannot be placed without further house upgrades.", "translation": "வீட்டை மேலும் மேம்படுத்தாமல் இந்த வகைப் படுக்கையை வைக்க முடியாது." },
    { "target": "Strings/UI", "key": "Chat_LobbyLost", "source": "Disconnected from the game session. {0}", "translation": "விளையாட்டு அமர்விலிருந்து இணைப்பு துண்டிக்கப்பட்டது. {0}" },
    { "target": "Strings/UI", "key": "Chat_LobbyLost_UserLeft", "source": "(User left session)", "translation": "(பயனர் அமர்விலிருந்து வெளியேறினார்)" },
    { "target": "Strings/UI", "key": "Chat_LobbyLost_LobbyClosed", "source": "(Session ended)", "translation": "(அமர்வு முடிந்தது)" },
    { "target": "Strings/UI", "key": "Chat_LobbyLost_ConnectionLost", "source": "(Lost connection to lobby server)", "translation": "(காத்திருப்பறைச் சேவையகத்துடனான இணைப்பு துண்டிக்கப்பட்டது)" },
    { "target": "Strings/UI", "key": "Chat_LobbyJoined", "source": "Connected to game session. {0}", "translation": "விளையாட்டு அமர்வுடன் இணைக்கப்பட்டது. {0}" },
    { "target": "Strings/UI", "key": "Chat_LobbyRecreated", "source": "Established a new game session. {0}", "translation": "புதிய விளையாட்டு அமர்வு உருவாக்கப்பட்டது. {0}" },
    { "target": "Strings/UI", "key": "Chat_LobbyJoined_InviteCode", "source": "(Invite code: {0})", "translation": "(அழைப்புக் குறியீடு: {0})" },
    { "target": "Strings/UI", "key": "Chat_LobbyCreateFail", "source": "Failed to create a new game session...", "translation": "புதிய விளையாட்டு அமர்வை உருவாக்க முடியவில்லை..." },
    { "target": "Strings/UI", "key": "Chat_StartingServer", "source": "You are now hosting a multiplayer game.", "translation": "இப்போது நீங்கள் பலர் விளையாட்டை விருந்தோம்புகிறீர்கள்." },
    { "target": "Strings/UI", "key": "Chat_DisablingServer", "source": "You are no longer hosting a multiplayer game.", "translation": "இனி நீங்கள் பலர் விளையாட்டை விருந்தோம்பவில்லை." },
    { "target": "Strings/UI", "key": "Farmhand_Locked", "source": "This character belongs to another player.", "translation": "இந்தப் பாத்திரம் மற்றொரு வீரருக்குரியது." },
    { "target": "Strings/UI", "key": "Item_Tooltip_Forged", "source": "Forged", "translation": "வடிக்கப்பட்டது" },
    { "target": "Strings/UI", "key": "LocalJoinPrompt", "source": "Press * to join game.", "translation": "விளையாட்டில் இணைய * அழுத்தவும்." },
    { "target": "Strings/UI", "key": "StartLocalMulti", "source": "Start Local Co-op", "translation": "உள்ளூர்க் கூட்டாட்டத்தைத் தொடங்கு" },
    { "target": "Strings/UI", "key": "DropOutLocalMulti", "source": "Leave Game", "translation": "விளையாட்டிலிருந்து வெளியேறு" },
    { "target": "Strings/UI", "key": "ChooseOne", "source": "Choose One:", "translation": "ஒன்றைத் தேர்ந்தெடுக்கவும்:" },
    { "target": "Strings/UI", "key": "Carpenter_CannotPaint", "source": "This building cannot be painted", "translation": "இந்தக் கட்டிடத்திற்கு வண்ணம் பூச முடியாது" },
    { "target": "Strings/UI", "key": "Carpenter_CannotPaint_Permission", "source": "You do not have permission to paint this building", "translation": "இந்தக் கட்டிடத்திற்கு வண்ணம் பூச உங்களுக்கு அனுமதி இல்லை" },
    { "target": "Strings/UI", "key": "GameMenu_MoveBuildingPermissions", "source": "Building Move Mode", "translation": "கட்டிடம் நகர்த்தும் முறை" },
    { "target": "Strings/UI", "key": "GameMenu_MoveBuildingPermissions_Off", "source": "Host Only", "translation": "விருந்தோம்பி மட்டும்" },
    { "target": "Strings/UI", "key": "GameMenu_MoveBuildingPermissions_Owned", "source": "Building Owner Only", "translation": "கட்டிட உரிமையாளர் மட்டும்" },
    { "target": "Strings/UI", "key": "GameMenu_MoveBuildingPermissions_On", "source": "Everyone", "translation": "அனைவரும்" },
    { "target": "Strings/UI", "key": "Character_FarmBeach", "source": "Beach Farm_Good foraging and fishing, and tons of open space. Sometimes, supply crates wash up on shore. However, sprinklers don't work in the sandy soil.", "translation": "கடற்கரைப் பண்ணை_காட்டுச்சேகரிப்புக்கும் மீன்பிடித்தலுக்கும் ஏற்றது; நிறையத் திறந்த வெளியும் உள்ளது. சிலசமயம் பொருள் பெட்டிகள் கரையொதுங்கும். ஆனால் மணற்பாங்கான மண்ணில் தெளிப்பான்கள் இயங்காது." },
    { "target": "Strings/UI", "key": "Forge_enchanting", "source": "Now enchanting...", "translation": "இப்போது மந்திரமேற்றுகிறது..." },
    { "target": "Strings/UI", "key": "Forge_forging", "source": "Now forging...", "translation": "இப்போது வடிக்கிறது..." },
    { "target": "Strings/UI", "key": "Forge_description1", "source": "Place weapon or tool in the left slot. Place gemstone in the right slot.", "translation": "இடது இடத்தில் ஆயுதம் அல்லது கருவியை வைக்கவும். வலது இடத்தில் ரத்தினத்தை வைக்கவும்." },
    { "target": "Strings/UI", "key": "Forge_description2", "source": "You can also combine two rings.", "translation": "இரண்டு மோதிரங்களையும் இணைக்கலாம்." },
    { "target": "Strings/UI", "key": "Forge_shards", "source": "Cinder shards are automatically consumed when forging.", "translation": "வடிக்கும்போது தணல் துண்டுகள் தானாகப் பயன்படுத்தப்படும்." },
    { "target": "Strings/UI", "key": "Forge_notenoughshards", "source": "Not enough cinder shards...", "translation": "போதுமான தணல் துண்டுகள் இல்லை..." },
    { "target": "Strings/UI", "key": "Forge_wrongorder", "source": "Incorrect order", "translation": "தவறான வரிசை" },
    { "target": "Strings/UI", "key": "Forge_noroom", "source": "No room in inventory...", "translation": "பொருட்பட்டியில் இடமில்லை..." },
    { "target": "Strings/UI", "key": "Forge_unforge_right_slot", "source": "Empty out the right slot to unforge...", "translation": "வடிப்பை அகற்ற வலது இடத்தைக் காலியாக்கவும்..." },
    { "target": "Strings/UI", "key": "Forge_unforge_invalid", "source": "Only forged items and combined rings can be unforged...", "translation": "வடித்த பொருட்கள் மற்றும் இணைத்த மோதிரங்களில் மட்டுமே வடிப்பை அகற்ற முடியும்..." },
    { "target": "Strings/UI", "key": "Forge_valid", "source": "Press the power button to begin forging!", "translation": "வடித்தலைத் தொடங்க இயக்கப் பொத்தானை அழுத்தவும்!" },
    { "target": "Strings/UI", "key": "Chat_BuildingBuild", "source": "{0} has requested construction of {1} {2}!", "translation": "{0}, {1} {2} கட்டுமாறு கோரியுள்ளார்!" },
    { "target": "Strings/UI", "key": "Chat_BuildingMagicBuild", "source": "{0} has summoned {1} {2}!", "translation": "{0}, {1} {2}-ஐ மந்திரத்தால் வரவழைத்துள்ளார்!" },
    { "target": "Strings/UI", "key": "Chat_HouseUpgrade", "source": "{0} has requested construction on {1} home!", "translation": "{0}, {1}-இன் வீட்டை மேம்படுத்தக் கோரியுள்ளார்!" },
    { "target": "Strings/UI", "key": "Chat_CommunityUpgrade", "source": "{0} has requested a community upgrade!", "translation": "{0} சமூக மேம்பாட்டைக் கோரியுள்ளார்!" },
    { "target": "Strings/UI", "key": "Chat_AcceptedSpecialOrder", "source": "{0} has accepted the special order '{1}'!", "translation": "{0} '{1}' என்ற சிறப்பு ஆணையை ஏற்றுக்கொண்டார்!" },
    { "target": "Strings/UI", "key": "Chat_CompletedSpecialOrder", "source": "The special order '{0}' has been fulfilled!", "translation": "'{0}' என்ற சிறப்பு ஆணை நிறைவேற்றப்பட்டது!" },
    { "target": "Strings/UI", "key": "Chat_DartsWin", "source": "{0} has won a game of darts in {1} throws!", "translation": "{0} {1} எறிதல்களில் ஈட்டி விளையாட்டை வென்றார்!" },
    { "target": "Strings/UI", "key": "Chat_DartsWinPerfect", "source": "{0} has won a perfect game of darts!", "translation": "{0} ஈட்டி விளையாட்டில் முழுநிறைவான வெற்றி பெற்றார்!" }
  ]
}
