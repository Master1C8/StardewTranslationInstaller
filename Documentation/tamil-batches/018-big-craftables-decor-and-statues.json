  "records": [
    { "target": "Strings/BigCraftables", "key": "SeasonalDecor_Name", "source": "Seasonal Decor", "translation": "பருவகால அலங்காரம்" },
    { "target": "Strings/BigCraftables", "key": "SeasonalDecor_Description", "source": "This decoration changes with the seasons.", "translation": "இந்த அலங்காரம் பருவங்களுக்கு ஏற்ப மாறும்." },
    { "target": "Strings/BigCraftables", "key": "SeasonalPlant_Name", "source": "Seasonal Plant", "translation": "பருவகாலச் செடி" },
    { "target": "Strings/BigCraftables", "key": "SeasonalPlant_Description", "source": "An ornamental plant that changes with each season. It doesn't need to be watered.", "translation": "ஒவ்வொரு பருவத்திற்கும் ஏற்ப மாறும் அலங்காரச் செடி. இதற்கு நீரூற்றத் தேவையில்லை." },
    { "target": "Strings/BigCraftables", "key": "SeedMaker_Description", "source": "Place crops inside to produce a varying amount of seeds. Doesn't work with fruit tree crops.", "translation": "மாறுபட்ட அளவு விதைகளை உற்பத்தி செய்யப் பயிர்களை உள்ளே வைக்கவும். பழமரப் பயிர்களுடன் இயங்காது." },
    { "target": "Strings/BigCraftables", "key": "SewingMachine_Name", "source": "Sewing Machine", "translation": "தையல் இயந்திரம்" },
    { "target": "Strings/BigCraftables", "key": "SewingMachine_Description", "source": "Use to tailor clothes from the convenience of your home!", "translation": "உங்கள் வீட்டிலிருந்தே ஆடைகளைத் தைக்கப் பயன்படுத்துங்கள்!" },
    { "target": "Strings/BigCraftables", "key": "SignOfTheVessel_Name", "source": "Sign Of The Vessel", "translation": "கலத்தின் குறியீடு" },
    { "target": "Strings/BigCraftables", "key": "SignOfTheVessel_Description", "source": "A decorative piece for your farm.", "translation": "உங்கள் பண்ணைக்கான அலங்காரப் பொருள்." },
    { "target": "Strings/BigCraftables", "key": "SingingStone_Name", "source": "Singing Stone", "translation": "பாடும் கல்" },
    { "target": "Strings/BigCraftables", "key": "SingingStone_Description", "source": "It rings out with a pure tone when struck.", "translation": "தட்டும்போது தூய இசையொலியை எழுப்பும்." },
    { "target": "Strings/BigCraftables", "key": "SkeletonModel_Name", "source": "Skeleton Model", "translation": "எலும்புக்கூடு மாதிரி" },
    { "target": "Strings/BigCraftables", "key": "SkeletonModel_Description", "source": "A model of a skeleton.", "translation": "ஓர் எலும்புக்கூட்டின் மாதிரி." },
    { "target": "Strings/BigCraftables", "key": "SkullBrazier_Name", "source": "Skull Brazier", "translation": "மண்டையோட்டு நெருப்புக்கலம்" },
    { "target": "Strings/BigCraftables", "key": "SkullBrazier_Description", "source": "Provides a moderate amount of light.", "translation": "மிதமான அளவு வெளிச்சம் தரும்." },
    { "target": "Strings/BigCraftables", "key": "SlimeBall_Name", "source": "Slime Ball", "translation": "ஸ்லைம் பந்து" },
    { "target": "Strings/BigCraftables", "key": "SlimeBall_Description", "source": "Filled with slime.", "translation": "ஸ்லைமால் நிரம்பியுள்ளது." },
    { "target": "Strings/BigCraftables", "key": "SlimeEggPress_Description", "source": "Compresses 100 pieces of slime into a slime egg. It's a miracle of science!", "translation": "100 ஸ்லைம் துண்டுகளை அழுத்தி ஒரு ஸ்லைம் முட்டையாக மாற்றும். இது அறிவியலின் அற்புதம்!" },
    { "target": "Strings/BigCraftables", "key": "SlimeIncubator_Description", "source": "Hatches slimes eggs into slimes. Allows you to raise slimes outdoors.", "translation": "ஸ்லைம் முட்டைகளிலிருந்து ஸ்லைம்களைப் பொரிக்கும். வெளிப்புறத்தில் ஸ்லைம்களை வளர்க்க அனுமதிக்கும்." },
    { "target": "Strings/BigCraftables", "key": "SlothSkeletonL_Name", "source": "Sloth Skeleton L", "translation": "சோம்பற்கரடி எலும்புக்கூடு இடது பகுதி" },
    { "target": "Strings/BigCraftables", "key": "SlothSkeletonL_Description", "source": "This extinct sloth roamed the lush, prehistoric forests of Stardew Valley. Its powerful jaw tore through the toughest plant fibers.", "translation": "அழிந்துபோன இந்தச் சோம்பற்கரடி ஸ்டார்டியூ பள்ளத்தாக்கின் செழிப்பான வரலாற்றுக்கு முந்தைய காடுகளில் திரிந்தது. அதன் வலிமையான தாடை கடினமான தாவர நார்களையும் கிழித்தது." },
    { "target": "Strings/BigCraftables", "key": "SlothSkeletonM_Name", "source": "Sloth Skeleton M", "translation": "சோம்பற்கரடி எலும்புக்கூடு நடுப்பகுதி" },
    { "target": "Strings/BigCraftables", "key": "SlothSkeletonM_Description", "source": "The ribs of a prehistoric sloth. ", "translation": "வரலாற்றுக்கு முந்தைய சோம்பற்கரடியின் விலா எலும்புகள். " },
    { "target": "Strings/BigCraftables", "key": "SlothSkeletonR_Name", "source": "Sloth Skeleton R", "translation": "சோம்பற்கரடி எலும்புக்கூடு வலது பகுதி" },
    { "target": "Strings/BigCraftables", "key": "SlothSkeletonR_Description", "source": "The hind legs and tail of a prehistoric sloth.", "translation": "வரலாற்றுக்கு முந்தைய சோம்பற்கரடியின் பின்கால்களும் வாலும்." },
    { "target": "Strings/BigCraftables", "key": "SodaMachine_Name", "source": "Soda Machine", "translation": "சோடா இயந்திரம்" },
