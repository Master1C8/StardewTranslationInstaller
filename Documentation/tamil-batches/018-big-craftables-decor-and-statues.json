    { "target": "Strings/BigCraftables", "key": "StatueOfBlessings_Description", "source": "Touching the statue gives a unique blessing every day.", "translation": "சிலையைத் தொடுவது ஒவ்வொரு நாளும் ஒரு தனித்துவமான ஆசீர்வாதத்தைத் தரும்." },
    { "target": "Strings/BigCraftables", "key": "StatueOfEndlessFortune_Name", "source": "Statue Of Endless Fortune", "translation": "முடிவற்ற செல்வத்தின் சிலை" },
