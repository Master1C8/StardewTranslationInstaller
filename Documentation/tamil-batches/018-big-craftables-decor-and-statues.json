    { "target": "Strings/BigCraftables", "key": "SolarPanel_Description", "source": "Slowly generates batteries when left in the sun.", "translation": "வெயிலில் வைக்கும்போது மெதுவாக மின்கலங்களை உருவாக்கும்." },
    { "target": "Strings/BigCraftables", "key": "SolidGoldLewis_Name", "source": "Solid Gold Lewis", "translation": "திடத் தங்க லூயிஸ்" },
