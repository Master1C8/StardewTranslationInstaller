    { "target": "Strings/BigCraftables", "key": "StatueOfTruePerfection_Name", "source": "Statue Of True Perfection", "translation": "உண்மையான முழுமையின் சிலை" },
    { "target": "Strings/BigCraftables", "key": "StatueOfTruePerfection_Description", "source": "It's made of pure iridium.", "translation": "இது தூய இரிடியத்தால் செய்யப்பட்டது." },
    { "target": "Strings/BigCraftables", "key": "StoneBrazier_Name", "source": "Stone Brazier", "translation": "கல் நெருப்புக்கலம்" },
