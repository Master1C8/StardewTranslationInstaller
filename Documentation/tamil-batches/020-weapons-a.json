    { "target": "Strings/Weapons", "key": "DwarfSword_Name", "source": "Dwarf Sword", "translation": "குள்ளர் வாள்" },
    { "target": "Strings/Weapons", "key": "DwarfSword_Description", "source": "It's ancient, but the blade never dulls.", "translation": "இது பழங்காலத்தது; ஆனால் இதன் கூர்மை ஒருபோதும் மங்காது." },
    { "target": "Strings/Weapons", "key": "ElfBlade_Name", "source": "Elf Blade", "translation": "எல்ஃப் வாள்" },
