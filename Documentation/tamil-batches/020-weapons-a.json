  "records": [
    { "target": "Strings/Weapons", "key": "AbbysPlanchette_Name", "source": "Abby's Planchette", "translation": "அப்பியின் ஆவிப்பலகைச் சுட்டி" },
    { "target": "Strings/Weapons", "key": "AbbysPlanchette_Description", "source": "It's made from fine marblewood.", "translation": "இது நேர்த்தியான பளிங்கு மரத்தால் செய்யப்பட்டது." },
    { "target": "Strings/Weapons", "key": "AlexsBat_Name", "source": "Alex's Bat", "translation": "அலெக்ஸின் மட்டை" },
    { "target": "Strings/Weapons", "key": "AlexsBat_Description", "source": "The sweet spot is dented from Alex's famous Grand Slam.", "translation": "அலெக்ஸின் புகழ்பெற்ற கிராண்ட் ஸ்லாம் அடியால் இதன் சரியான தாக்குமிடம் பள்ளமாகியுள்ளது." },
    { "target": "Strings/Weapons", "key": "BoneSword_Name", "source": "Bone Sword", "translation": "எலும்பு வாள்" },
    { "target": "Strings/Weapons", "key": "BoneSword_Description", "source": "A very light piece of sharpened bone.", "translation": "கூராக்கப்பட்ட மிகவும் இலேசான எலும்புத் துண்டு." },
    { "target": "Strings/Weapons", "key": "BrokenTrident_Name", "source": "Broken Trident", "translation": "உடைந்த மூவிலைச் சூலம்" },
    { "target": "Strings/Weapons", "key": "BrokenTrident_Description", "source": "It came from the sea, but it's still sharp.", "translation": "இது கடலிலிருந்து வந்தது; ஆனாலும் இன்னும் கூர்மையாக உள்ளது." },
    { "target": "Strings/Weapons", "key": "BurglarsShank_Name", "source": "Burglar's Shank", "translation": "திருடனின் கத்தி" },
