    { "target": "Strings/Weapons", "key": "GalaxySlingshot_Name", "source": "Galaxy Slingshot", "translation": "கேலக்ஸி கவண்" },
    { "target": "Strings/Weapons", "key": "GalaxySlingshot_Description", "source": "It looks really powerful.", "translation": "இது மிகவும் வலிமையாகத் தெரிகிறது." },
    { "target": "Strings/Weapons", "key": "GalaxySword_Description", "source": "It's unlike anything you've ever seen.", "translation": "நீங்கள் இதுவரை பார்த்த எதையும் போல இது இல்லை." },
    { "target": "Strings/Weapons", "key": "GoldenScythe_Description", "source": "It's more powerful than a normal scythe.", "translation": "இது சாதாரண அரிவாளைவிட வலிமையானது." },
    { "target": "Strings/Weapons", "key": "HaleysIron_Name", "source": "Haley's Iron", "translation": "ஹேலியின் இஸ்திரிப்பெட்டி" },
    { "target": "Strings/Weapons", "key": "HaleysIron_Description", "source": "It's searing hot and smells like Haley's hair.", "translation": "இது சுட்டெரிக்கும் அளவு சூடாகவும் ஹேலியின் முடியின் மணத்துடனும் உள்ளது." },
    { "target": "Strings/Weapons", "key": "HarveysMallet_Name", "source": "Harvey's Mallet", "translation": "ஹார்வியின் சுத்தியல்" },
    { "target": "Strings/Weapons", "key": "HarveysMallet_Description", "source": "It brings back memories of Harvey's clinic.", "translation": "இது ஹார்வியின் மருத்துவமனை நினைவுகளை மீட்டுவருகிறது." },
