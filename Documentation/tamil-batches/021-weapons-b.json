{
  "id": "021-weapons-b",
  "kind": "short",
  "records": [
    { "target": "Strings/Weapons", "key": "ObsidianEdge_Name", "source": "Obsidian Edge", "translation": "எரிமலைக் கண்ணாடி முனை" },
    { "target": "Strings/Weapons", "key": "ObsidianEdge_Description", "source": "It's incredibly sharp.", "translation": "இது நம்பமுடியாத அளவு கூர்மையானது." },
    { "target": "Strings/Weapons", "key": "OssifiedBlade_Name", "source": "Ossified Blade", "translation": "எலும்பான வாள்" },
    { "target": "Strings/Weapons", "key": "OssifiedBlade_Description", "source": "A large, sharp blade formed from bone.", "translation": "எலும்பிலிருந்து உருவான பெரிய, கூர்மையான வாள்." },
    { "target": "Strings/Weapons", "key": "PennysFryer_Name", "source": "Penny's Fryer", "translation": "பென்னியின் வாணலி" },
    { "target": "Strings/Weapons", "key": "PennysFryer_Description", "source": "Penny's favorite frying pan. There's some rubbery gunk stuck to the inside.", "translation": "பென்னிக்குப் பிடித்த வாணலி. உள்ளே ரப்பர் போன்ற ஏதோ அழுக்கு ஒட்டியுள்ளது." },
    { "target": "Strings/Weapons", "key": "PiratesSword_Name", "source": "Pirate's Sword", "translation": "கடற்கொள்ளையரின் வாள்" },
    { "target": "Strings/Weapons", "key": "PiratesSword_Description", "source": "It looks like a pirate owned this once.", "translation": "இது ஒருகாலத்தில் கடற்கொள்ளையருக்குச் சொந்தமாக இருந்ததுபோல் தெரிகிறது." },
    { "target": "Strings/Weapons", "key": "Rapier_Name", "source": "Rapier", "translation": "மெல்லிய வாள்" },
    { "target": "Strings/Weapons", "key": "Rapier_Description", "source": "An elegant blade.", "translation": "நேர்த்தியான வாள்." },
    { "target": "Strings/Weapons", "key": "RustySword_Name", "source": "Rusty Sword", "translation": "துருப்பிடித்த வாள்" },
    { "target": "Strings/Weapons", "key": "RustySword_Description", "source": "A rusty, dull old sword.", "translation": "துருப்பிடித்து மழுங்கிய பழைய வாள்." },
    { "target": "Strings/Weapons", "key": "SamsOldGuitar_Name", "source": "Sam's Old Guitar", "translation": "சாமின் பழைய கிதார்" },
    { "target": "Strings/Weapons", "key": "SamsOldGuitar_Description", "source": "It's seen better days.", "translation": "இது முன்பு நல்ல நிலையில் இருந்திருக்கிறது." },
    { "target": "Strings/Weapons", "key": "Scythe_Description", "source": "It can cut grass into hay, if you've built a silo.", "translation": "நீங்கள் வைக்கோல் களஞ்சியம் கட்டியிருந்தால், இதனால் புல்லை வெட்டி வைக்கோலாக்கலாம்." },
    { "target": "Strings/Weapons", "key": "SebsLostMace_Name", "source": "Seb's Lost Mace", "translation": "செப்பின் தொலைந்த கதாயுதம்" },
    { "target": "Strings/Weapons", "key": "SebsLostMace_Description", "source": "One of Sebastian's medieval replicas.", "translation": "செபாஸ்டியனின் இடைக்கால நகல்களில் ஒன்று." },
    { "target": "Strings/Weapons", "key": "ShadowDagger_Name", "source": "Shadow Dagger", "translation": "நிழல் குறுவாள்" },
    { "target": "Strings/Weapons", "key": "ShadowDagger_Description", "source": "When you hold the blade to your ear you can hear 1,000 souls shrieking.", "translation": "வாளை உங்கள் காதருகே வைத்தால் 1,000 ஆன்மாக்களின் அலறலைக் கேட்கலாம்." },
    { "target": "Strings/Weapons", "key": "SilverSaber_Name", "source": "Silver Saber", "translation": "வெள்ளி வீச்சுவாள்" },
    { "target": "Strings/Weapons", "key": "SilverSaber_Description", "source": "Plated with silver to deter rust.", "translation": "துருப்பிடிக்காமல் இருக்க வெள்ளி முலாம் பூசப்பட்டது." },
    { "target": "Strings/Weapons", "key": "Slingshot_Description", "source": "Requires stones for ammo.", "translation": "வெடிபொருளாகக் கற்கள் தேவை." },
    { "target": "Strings/Weapons", "key": "SteelFalchion_Name", "source": "Steel Falchion", "translation": "எஃகு வளைவாள்" },
    { "target": "Strings/Weapons", "key": "SteelFalchion_Description", "source": "Light and powerful.", "translation": "இலேசானது, வலிமையானது." },
    { "target": "Strings/Weapons", "key": "SteelSmallsword_Name", "source": "Steel Smallsword", "translation": "எஃகுச் சிறுவாள்" },
    { "target": "Strings/Weapons", "key": "SteelSmallsword_Description", "source": "A standard metal blade.", "translation": "சாதாரண உலோக வாள்." },
    { "target": "Strings/Weapons", "key": "TemperedBroadsword_Name", "source": "Tempered Broadsword", "translation": "பதனிட்ட அகல வாள்" },
    { "target": "Strings/Weapons", "key": "TemperedBroadsword_Description", "source": "It looks like it could withstand anything.", "translation": "இது எதையும் தாங்கக்கூடியதுபோல் தெரிகிறது." },
    { "target": "Strings/Weapons", "key": "TemplarsBlade_Name", "source": "Templar's Blade", "translation": "ஆலயக் காவலரின் வாள்" },
    { "target": "Strings/Weapons", "key": "TemplarsBlade_Description", "source": "It once belonged to an honorable knight.", "translation": "இது ஒருகாலத்தில் கண்ணியமான வீரருக்குச் சொந்தமாக இருந்தது." },
    { "target": "Strings/Weapons", "key": "TheSlammer_Name", "source": "The Slammer", "translation": "பேரிடிப்பான்" },
    { "target": "Strings/Weapons", "key": "TheSlammer_Description", "source": "An extremely heavy gavel that'll send foes flying.", "translation": "எதிரிகளைப் பறக்கவிடும் மிகக் கனமான கதாயுதம்." },
    { "target": "Strings/Weapons", "key": "WickedKris_Name", "source": "Wicked Kris", "translation": "தீய கிரிஸ் குறுவாள்" },
    { "target": "Strings/Weapons", "key": "WickedKris_Description", "source": "The blade is made of an iridium alloy.", "translation": "இதன் கத்தி இரிடியம் கலப்புலோகத்தால் செய்யப்பட்டது." },
    { "target": "Strings/Weapons", "key": "WindSpire_Name", "source": "Wind Spire", "translation": "காற்றுக் கூர்முனை" },
    { "target": "Strings/Weapons", "key": "WindSpire_Description", "source": "A swift little blade.", "translation": "வேகமான சிறு வாள்." },
    { "target": "Strings/Weapons", "key": "WoodClub_Name", "source": "Wood Club", "translation": "மரக் கதாயுதம்" },
    { "target": "Strings/Weapons", "key": "WoodClub_Description", "source": "A solid piece of wood, crudely chiseled into a club shape.", "translation": "தடிக்கழி வடிவில் முரட்டுத்தனமாகச் செதுக்கப்பட்ட திடமான மரத்துண்டு." },
    { "target": "Strings/Weapons", "key": "WoodenBlade_Name", "source": "Wooden Blade", "translation": "மர வாள்" },
    { "target": "Strings/Weapons", "key": "WoodenBlade_Description", "source": "Not bad for a piece of carved wood.", "translation": "செதுக்கிய மரத்துண்டுக்கு இது மோசமில்லை." },
    { "target": "Strings/Weapons", "key": "WoodMallet_Name", "source": "Wood Mallet", "translation": "மரச் சுத்தியல்" },
    { "target": "Strings/Weapons", "key": "WoodMallet_Description", "source": "The solid head packs a punch. Relatively light for a club.", "translation": "திடமான தலை வலுவாகத் தாக்கும். கதாயுதத்திற்கு ஒப்பீட்டளவில் இலேசானது." },
    { "target": "Strings/Weapons", "key": "YetiTooth_Name", "source": "Yeti Tooth", "translation": "எட்டியின் பல்" },
    { "target": "Strings/Weapons", "key": "YetiTooth_Description", "source": "It's icy cold to the touch.", "translation": "தொடுவதற்குப் பனிபோல் குளிர்ச்சியாக உள்ளது." }
  ]
}
