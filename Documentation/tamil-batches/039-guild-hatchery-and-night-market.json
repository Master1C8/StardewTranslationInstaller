    {
      "target": "Strings/Locations",
      "key": "BeachNightMarket_Closed",
      "source": "Opens at 5pm.",
      "translation": "மாலை 5 மணிக்குத் திறக்கும்."
    },
    {
      "target": "Strings/Locations",
      "key": "BeachNightMarket_SubmarineInUse",
      "source": "The submarine is currently in use. Come back later.",
      "translation": "நீர்மூழ்கிக் கப்பல் தற்போது பயன்பாட்டில் உள்ளது. பிறகு வாருங்கள்."
    },
    {
      "target": "Strings/Locations",
      "key": "BeachNightMarket_GiftGiverClosed",
      "source": "Merchant: The night market starts at 5pm... visit me then for a free cup of coffee! ",
      "translation": "வணிகர்: இரவுச் சந்தை மாலை 5 மணிக்குத் தொடங்குகிறது... இலவசமாக ஒரு கோப்பைக் காபி பெற அப்போது என்னிடம் வாருங்கள்! "
    },
    {
      "target": "Strings/Locations",
      "key": "BeachNightMarket_GiftGiverQuestion",
      "source": "Merchant: Hello there! Care for a cup of coffee?",
      "translation": "வணிகர்: வணக்கம்! ஒரு கோப்பைக் காபி வேண்டுமா?"
    },
    {
      "target": "Strings/Locations",
      "key": "BeachNightMarket_GiftGiverEnjoy",
      "source": "Merchant: Mmm... smells great, doesn't it?",
      "translation": "வணிகர்: ம்ம்... மணம் அருமையாக இருக்கிறது, இல்லையா?"
    },
    {
      "target": "Strings/Locations",
      "key": "BeachNightMarket_PainterClosed",
      "source": "Famous Painter Lupini: Come back when the market opens, if you wish to purchase my fine work.",
      "translation": "புகழ்பெற்ற ஓவியர் லுபினி: என் சிறந்த படைப்பை வாங்க விரும்பினால், சந்தை திறந்ததும் மீண்டும் வாருங்கள்."
    },
    {
      "target": "Strings/Locations",
      "key": "BeachNightMarket_PainterQuestion",
      "source": "Famous Painter Lupini: I'm selling this painting for 1200g. What do you say?",
      "translation": "புகழ்பெற்ற ஓவியர் லுபினி: இந்த ஓவியத்தை 1200gக்கு விற்கிறேன். என்ன சொல்கிறீர்கள்?"
    },
    {
      "target": "Strings/Locations",
      "key": "BeachNightMarket_PainterSold",
      "source": "Famous Painter Lupini: My apologies... I have no more paintings to sell today.",
      "translation": "புகழ்பெற்ற ஓவியர் லுபினி: மன்னிக்கவும்... இன்று விற்பதற்கு என்னிடம் வேறு ஓவியங்கள் இல்லை."
    },
    {
      "target": "Strings/Locations",
      "key": "BeachNightMarket_WarperQuestion",
      "source": "Shrouded Figure: I can send you home for 250g.",
      "translation": "போர்த்திய உருவம்: 250gக்கு உங்களை வீட்டிற்கு அனுப்ப முடியும்."
    },
    {
      "target": "Strings/Locations",
      "key": "Beach_FixBridge_Question",
      "source": "Use 300 pieces of wood to fix the bridge?",
      "translation": "பாலத்தைச் சரிசெய்ய 300 மரத்துண்டுகளைப் பயன்படுத்தவா?"
    },
    {
      "target": "Strings/Locations",
      "key": "Beach_FixBridge_Hint",
      "source": "Hmmm... With 300 pieces of wood this could be fixed.",
      "translation": "ம்ம்... 300 மரத்துண்டுகள் இருந்தால் இதைச் சரிசெய்யலாம்."
    }
  ]
}
