{
  "id": "064-objects-fish-fossils-and-frozen-goods-l",
  "kind": "short",
  "records": [
    { "target": "Strings/Objects", "key": "FireworksPurple_Description", "source": "An old tradition for celebrations and festivities. Handle with care!", "translation": "கொண்டாட்டங்களுக்கும் விழாக்களுக்கும் பயன்படும் பழைய மரபு. கவனமாகக் கையாளவும்!" },
    { "target": "Strings/Objects", "key": "FireworksRed_Name", "source": "Fireworks (Red)", "translation": "வாணவேடிக்கை (சிவப்பு)" },
    { "target": "Strings/Objects", "key": "FireworksRed_Description", "source": "An old tradition for celebrations and festivities. Handle with care!", "translation": "கொண்டாட்டங்களுக்கும் விழாக்களுக்கும் பயன்படும் பழைய மரபு. கவனமாகக் கையாளவும்!" },
    { "target": "Strings/Objects", "key": "FishStew_Name", "source": "Fish Stew", "translation": "மீன் குழம்பு" },
    { "target": "Strings/Objects", "key": "FishStew_Description", "source": "It smells a lot like the sea. Tastes better, though.", "translation": "கடல் மணம் அதிகமாக வீசுகிறது. ஆனால் சுவை இன்னும் நன்றாக உள்ளது." },
    { "target": "Strings/Objects", "key": "FishTaco_Name", "source": "Fish Taco", "translation": "மீன் டாக்கோ" },
    { "target": "Strings/Objects", "key": "FishTaco_Description", "source": "It smells delicious.", "translation": "சுவையான மணம் வீசுகிறது." },
    { "target": "Strings/Objects", "key": "Flounder_Name", "source": "Flounder", "translation": "ஃப்ளவுண்டர்" },
    { "target": "Strings/Objects", "key": "Flounder_Description", "source": "It lives on the bottom, so both eyes are on top of its head.", "translation": "அடித்தளத்தில் வாழ்வதால், இரு கண்களும் தலையின் மேற்புறத்தில் உள்ளன." },
    { "target": "Strings/Objects", "key": "Fluorapatite_Name", "source": "Fluorapatite", "translation": "ஃப்ளூராபடைட்" },
    { "target": "Strings/Objects", "key": "Fluorapatite_Description", "source": "Small amounts are found in human teeth.", "translation": "மனிதப் பற்களில் சிறிய அளவில் காணப்படுகிறது." },
    { "target": "Strings/Objects", "key": "FluteBlock_Name", "source": "Flute Block", "translation": "புல்லாங்குழல் தொகுதி" },
    { "target": "Strings/Objects", "key": "FluteBlock_Description", "source": "Plays a flute sound when you walk past.", "translation": "அருகே நடந்து செல்லும்போது புல்லாங்குழல் ஒலியை இசைக்கும்." },
    { "target": "Strings/Objects", "key": "FossilizedLeg_Name", "source": "Fossilized Leg", "translation": "புதைபடிவக் கால்" },
    { "target": "Strings/Objects", "key": "FossilizedLeg_Description", "source": "A thick and sturdy leg bone.", "translation": "தடித்த, உறுதியான கால் எலும்பு." },
    { "target": "Strings/Objects", "key": "FossilizedRibs_Name", "source": "Fossilized Ribs", "translation": "புதைபடிவ விலா எலும்புகள்" },
    { "target": "Strings/Objects", "key": "FossilizedRibs_Description", "source": "Long ago, these ribs protected the body of a large animal.", "translation": "வெகுகாலத்திற்கு முன்பு இந்த விலா எலும்புகள் ஒரு பெரிய விலங்கின் உடலைப் பாதுகாத்தன." },
    { "target": "Strings/Objects", "key": "FossilizedSkull_Name", "source": "Fossilized Skull", "translation": "புதைபடிவ மண்டையோடு" },
    { "target": "Strings/Objects", "key": "FossilizedSkull_Description", "source": "It's a perfect specimen!", "translation": "இது கச்சிதமான மாதிரி!" },
    { "target": "Strings/Objects", "key": "FossilizedSpine_Name", "source": "Fossilized Spine", "translation": "புதைபடிவ முதுகெலும்பு" },
    { "target": "Strings/Objects", "key": "FossilizedSpine_Description", "source": "A column of interlocking vertebrae.", "translation": "ஒன்றோடொன்று இணைந்த முள்ளெலும்புகளின் தூண்." },
    { "target": "Strings/Objects", "key": "FossilizedTail_Name", "source": "Fossilized Tail", "translation": "புதைபடிவ வால்" },
    { "target": "Strings/Objects", "key": "FossilizedTail_Description", "source": "This tail has a club-like feature at the tip.", "translation": "இந்த வாலின் நுனியில் தடி போன்ற அமைப்பு உள்ளது." },
    { "target": "Strings/Objects", "key": "FossilStone_Name", "source": "Fossil Stone", "translation": "புதைபடிவக் கல்" },
    { "target": "Strings/Objects", "key": "FossilStone_Description", "source": "Break apart to obtain fossils and bones.", "translation": "புதைபடிவங்களையும் எலும்புகளையும் பெற இதை உடைக்கவும்." },
    { "target": "Strings/Objects", "key": "FriedCalamari_Name", "source": "Fried Calamari", "translation": "பொரித்த கலமாரி" },
    { "target": "Strings/Objects", "key": "FriedCalamari_Description", "source": "It's so chewy.", "translation": "மிகவும் மெல்லக்கூடியதாக உள்ளது." },
    { "target": "Strings/Objects", "key": "FriedEel_Name", "source": "Fried Eel", "translation": "பொரித்த விலாங்கு" },
    { "target": "Strings/Objects", "key": "FriedEel_Description", "source": "Greasy but flavorful.", "translation": "எண்ணெய்ப்பசையாக இருந்தாலும் சுவையானது." },
    { "target": "Strings/Objects", "key": "FriedEgg_Name", "source": "Fried Egg", "translation": "பொரித்த முட்டை" },
    { "target": "Strings/Objects", "key": "FriedEgg_Description", "source": "Sunny-side up.", "translation": "மஞ்சள் கரு மேல்நோக்கி உள்ளது." },
    { "target": "Strings/Objects", "key": "FriedMushroom_Name", "source": "Fried Mushroom", "translation": "பொரித்த காளான்" },
    { "target": "Strings/Objects", "key": "FriedMushroom_Description", "source": "Earthy and aromatic.", "translation": "மண் மணமும் நறுமணமும் கொண்டது." },
    { "target": "Strings/Objects", "key": "FrozenGeode_Name", "source": "Frozen Geode", "translation": "உறைந்த ஜியோடு" },
    { "target": "Strings/Objects", "key": "FrozenGeode_Description", "source": "A blacksmith can break this open for you.", "translation": "கொல்லர் இதை உங்களுக்காக உடைத்துத் திறக்க முடியும்." },
    { "target": "Strings/Objects", "key": "FrozenGeodeStone_Name", "source": "Frozen Geode Stone", "translation": "உறைந்த ஜியோடு கல்" },
    { "target": "Strings/Objects", "key": "FrozenGeodeStone_Description", "source": "Break apart to obtain frozen geodes.", "translation": "உறைந்த ஜியோடுகளைப் பெற இதை உடைக்கவும்." },
    { "target": "Strings/Objects", "key": "FrozenTear_Name", "source": "Frozen Tear", "translation": "உறைந்த கண்ணீர்" },
    { "target": "Strings/Objects", "key": "FrozenTear_Description", "source": "A crystal fabled to be the frozen tears of a yeti.", "translation": "எட்டியின் உறைந்த கண்ணீர் என்று கதைகளில் கூறப்படும் படிகம்." },
    { "target": "Strings/Objects", "key": "FruitSalad_Name", "source": "Fruit Salad", "translation": "பழச் சாலட்" }
  ]
}
