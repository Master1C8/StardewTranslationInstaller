    { "target": "Strings/Objects", "key": "HorseFlute_Name", "source": "Horse Flute", "translation": "குதிரைப் புல்லாங்குழல்" },
    { "target": "Strings/Objects", "key": "HorseFlute_Description", "source": "Playing this flute will summon your horse. Only works outdoors.", "translation": "இந்தப் புல்லாங்குழலை இசைத்தால் உங்கள் குதிரை வரவழைக்கப்படும். வெளியில் மட்டுமே வேலைசெய்யும்." },
    { "target": "Strings/Objects", "key": "HotJavaRing_Name", "source": "Hot Java Ring", "translation": "சூடான ஜாவா மோதிரம்" },
    { "target": "Strings/Objects", "key": "HotJavaRing_Description", "source": "Greatly increases your chance to find coffee drinks when slaying monsters.", "translation": "அரக்கர்களை அழிக்கும்போது காபிப் பானங்கள் கிடைக்கும் வாய்ப்பைப் பெரிதும் அதிகரிக்கிறது." }
