  "records": [
    { "target": "Strings/Objects", "key": "HotPepper_Name", "source": "Hot Pepper", "translation": "கார மிளகாய்" },
    { "target": "Strings/Objects", "key": "HotPepper_Description", "source": "Fiery hot with a hint of sweetness.", "translation": "சிறிது இனிப்புடன் தீப்போல் காரமானது." },
    { "target": "Strings/Objects", "key": "HyperSpeedGro_Description", "source": "Greatly stimulates leaf production. Guaranteed to increase growth rate by at least 33%. Mix into tilled soil.", "translation": "இலை வளர்ச்சியைப் பெரிதும் தூண்டுகிறது. வளர்ச்சி வேகத்தைக் குறைந்தது 33% அதிகரிப்பது உறுதி. உழுத மண்ணில் கலக்கவும்." },
    { "target": "Strings/Objects", "key": "IceCream_Name", "source": "Ice Cream", "translation": "ஐஸ்கிரீம்" },
    { "target": "Strings/Objects", "key": "IceCream_Description", "source": "It's hard to find someone who doesn't like this.", "translation": "இதை விரும்பாத ஒருவரைக் கண்டுபிடிப்பது கடினம்." },
    { "target": "Strings/Objects", "key": "IceCrystal_Name", "source": "Ice Crystal", "translation": "பனிப் படிகம்" },
    { "target": "Strings/Objects", "key": "IceCrystal_Description", "source": "Might contain refined quartz.", "translation": "சுத்திகரித்த குவார்ட்ஸ் இருக்கலாம்." },
    { "target": "Strings/Objects", "key": "IcePip_Name", "source": "Ice Pip", "translation": "ஐஸ் பிப்" },
    { "target": "Strings/Objects", "key": "IcePip_Description", "source": "A rare fish that thrives in extremely cold conditions.", "translation": "மிகவும் குளிரான சூழலில் செழித்து வாழும் அரிய மீன்." },
    { "target": "Strings/Objects", "key": "ImmunityBand_Name", "source": "Immunity Band", "translation": "எதிர்ப்பாற்றல் வளையம்" },
    { "target": "Strings/Objects", "key": "ImmunityBand_Description", "source": "The top of the ring is made from enchanted purple wool.", "translation": "மோதிரத்தின் மேற்பகுதி மந்திரமேற்றிய ஊதா கம்பளியால் செய்யப்பட்டுள்ளது." },
    { "target": "Strings/Objects", "key": "IridiumBand_Name", "source": "Iridium Band", "translation": "இரிடியம் வளையம்" },
    { "target": "Strings/Objects", "key": "IridiumBand_Description", "source": "Glows, attracts items, and increases attack damage by 10%.", "translation": "ஒளிரும், பொருட்களை ஈர்க்கும், தாக்குதல் சேதத்தை 10% அதிகரிக்கும்." },
    { "target": "Strings/Objects", "key": "IridiumBar_Name", "source": "Iridium Bar", "translation": "இரிடியம் கட்டி" },
    { "target": "Strings/Objects", "key": "IridiumBar_Description", "source": "A bar of pure iridium.", "translation": "தூய இரிடியம் கட்டி." },
    { "target": "Strings/Objects", "key": "IridiumMilk_Name", "source": "Iridium Milk", "translation": "இரிடியம் பால்" },
    { "target": "Strings/Objects", "key": "IridiumMilk_Description", "source": "A powerful 'milk' of unknown origin...", "translation": "தோற்றம் தெரியாத ஆற்றல்மிக்க 'பால்'..." },
    { "target": "Strings/Objects", "key": "IridiumOre_Name", "source": "Iridium Ore", "translation": "இரிடியம் தாது" },
    { "target": "Strings/Objects", "key": "IridiumOre_Description", "source": "An exotic ore with many curious properties. Can be smelted into bars.", "translation": "பல வியப்பான பண்புகளைக் கொண்ட அயல்நாட்டுத் தாது. உருக்கிக் கட்டிகளாக மாற்றலாம்." },
    { "target": "Strings/Objects", "key": "IridiumSprinkler_Name", "source": "Iridium Sprinkler", "translation": "இரிடியம் தெளிப்பான்" },
    { "target": "Strings/Objects", "key": "IridiumSprinkler_Description", "source": "Waters the 24 adjacent tiles every morning.", "translation": "ஒவ்வொரு காலையிலும் அருகிலுள்ள 24 கட்டங்களுக்கு நீர்ப்பாய்ச்சும்." },
    { "target": "Strings/Objects", "key": "IridiumStone_Name", "source": "Iridium Stone", "translation": "இரிடியம் கல்" },
    { "target": "Strings/Objects", "key": "IridiumStone_Description", "source": "Break apart to obtain iridium ore.", "translation": "இரிடியம் தாதைப் பெற இதை உடைக்கவும்." },
    { "target": "Strings/Objects", "key": "IronBar_Name", "source": "Iron Bar", "translation": "இரும்புக் கட்டி" },
    { "target": "Strings/Objects", "key": "IronBar_Description", "source": "A bar of pure iron.", "translation": "தூய இரும்புக் கட்டி." },
    { "target": "Strings/Objects", "key": "IronFence_Name", "source": "Iron Fence", "translation": "இரும்பு வேலி" },
    { "target": "Strings/Objects", "key": "IronFence_Description", "source": "Lasts longer than a stone fence.", "translation": "கல் வேலியைவிட நீண்டகாலம் நீடிக்கும்." },
    { "target": "Strings/Objects", "key": "IronOre_Name", "source": "Iron Ore", "translation": "இரும்புத் தாது" },
    { "target": "Strings/Objects", "key": "IronOre_Description", "source": "A fairly common ore that can be smelted into bars.", "translation": "உருக்கிக் கட்டிகளாக மாற்றக்கூடிய மிகவும் பொதுவான தாது." },
    { "target": "Strings/Objects", "key": "IronStone_Name", "source": "Iron Stone", "translation": "இரும்புக் கல்" },
