    { "target": "Strings/Objects", "key": "JackOLantern_Name", "source": "Jack-O-Lantern", "translation": "பூசணி விளக்கு" },
    { "target": "Strings/Objects", "key": "JackOLantern_Description", "source": "A whimsical fall decoration.", "translation": "வேடிக்கையான இலையுதிர்கால அலங்காரம்." },
    { "target": "Strings/Objects", "key": "Jade_Name", "source": "Jade", "translation": "ஜேட்" },
    { "target": "Strings/Objects", "key": "Jade_Description", "source": "A pale green ornamental stone.", "translation": "வெளிர் பச்சை நிற அலங்காரக் கல்." },
    { "target": "Strings/Objects", "key": "JadeRing_Name", "source": "Jade Ring", "translation": "ஜேட் மோதிரம்" },
    { "target": "Strings/Objects", "key": "JadeRing_Description", "source": "Increases critical strike power by 10%.", "translation": "முக்கியத் தாக்கு ஆற்றலை 10% அதிகரிக்கிறது." },
    { "target": "Strings/Objects", "key": "JadeStone_Name", "source": "Jade Stone", "translation": "ஜேட் கல்" },
    { "target": "Strings/Objects", "key": "JadeStone_Description", "source": "Break apart to obtain jade.", "translation": "ஜேட் கற்களைப் பெற இதை உடைக்கவும்." },
    { "target": "Strings/Objects", "key": "Jagoite_Name", "source": "Jagoite", "translation": "ஜகோயைட்" }
  ]
