    { "target": "Strings/Objects", "key": "PotatoSeeds_Name", "source": "Potato Seeds", "translation": "உருளைக்கிழங்கு விதைகள்" },
    { "target": "Strings/Objects", "key": "PotatoSeeds_Description", "source": "Plant these in the spring. Takes 6 days to mature, and has a chance of yielding multiple potatoes at harvest.", "translation": "வசந்தத்தில் இவற்றை நடுங்கள். முதிர 6 நாட்கள் ஆகும்; அறுவடையில் பல உருளைக்கிழங்குகள் கிடைக்க வாய்ப்புள்ளது." },
    { "target": "Strings/Objects", "key": "Powdermelon_Name", "source": "Powdermelon", "translation": "தூள் முலாம்பழம்" }
