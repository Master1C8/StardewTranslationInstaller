    { "target": "Strings/StringsFromCSFiles", "key": "Event.cs.1018", "source": "Maybe I was being a little presumptuous earlier... sorry.$5", "translation": "முன்பு நான் கொஞ்சம் தன்னிச்சையாக நடந்துகொண்டிருக்கலாம்... மன்னியுங்கள்.$5" },
    { "target": "Strings/StringsFromCSFiles", "key": "Event.cs.1020", "source": "Thanks for helping out in the lab.$h", "translation": "ஆய்வகத்தில் உதவியதற்கு நன்றி.$h" },
    { "target": "Strings/StringsFromCSFiles", "key": "Event.cs.1025", "source": "That was a beautiful ceremony. Congratulations!$h", "translation": "அது அழகான விழாவாக இருந்தது. வாழ்த்துகள்!$h" },
    { "target": "Strings/StringsFromCSFiles", "key": "Event.cs.1057", "source": "Ow...", "translation": "ஆவ்..." },
    { "target": "Strings/StringsFromCSFiles", "key": "Event.cs.1058", "source": "I seem to have lost {0}g", "translation": "நான் {0}g இழந்துவிட்டதாகத் தெரிகிறது" },
    { "target": "Strings/StringsFromCSFiles", "key": "Event.cs.1060", "source": "It seems I've lost ", "translation": "நான் இழந்ததாகத் தெரிகிறது: " },
    { "target": "Strings/StringsFromCSFiles", "key": "Event.cs.1061", "source": "an item from my backpack.", "translation": "என் முதுகுப்பையிலிருந்து ஒரு பொருள்." },
    { "target": "Strings/StringsFromCSFiles", "key": "Event.cs.1062", "source": "{0} items from my backpack.", "translation": "என் முதுகுப்பையிலிருந்து {0} பொருட்கள்." },
    { "target": "Strings/StringsFromCSFiles", "key": "Event.cs.1063", "source": ", and ", "translation": ", மேலும் " },
    { "target": "Strings/StringsFromCSFiles", "key": "Event.cs.1068", "source": "Dr. Harvey charged me {0}g for the hospital visit. ", "translation": "மருத்துவமனை வருகைக்காக மருத்துவர் ஹார்வி என்னிடம் {0}g வசூலித்தார். " },
    { "target": "Strings/StringsFromCSFiles", "key": "Event.cs.1070", "source": "I have no money, but Harvey was obligated to save my life free of charge. ", "translation": "என்னிடம் பணம் இல்லை; ஆனால் என் உயிரை இலவசமாகக் காப்பாற்ற ஹார்வி கடமைப்பட்டிருந்தார். " },
    { "target": "Strings/StringsFromCSFiles", "key": "Event.cs.1071", "source": "It also appears that I've lost ", "translation": "மேலும் நான் இழந்ததாகத் தெரிகிறது: " },
    { "target": "Strings/StringsFromCSFiles", "key": "Event.cs.1159", "source": "Received 1000g ", "translation": "1000g பெற்றீர்கள் " },
    { "target": "Strings/StringsFromCSFiles", "key": "Event.cs.1164", "source": "Received 2000g ", "translation": "2000g பெற்றீர்கள் " },
