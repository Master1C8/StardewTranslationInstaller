    { "target": "Strings/StringsFromCSFiles", "key": "Game1.cs.3094", "source": "Your mind is filled with thoughts of ", "translation": "உங்கள் மனம் இவரைப் பற்றிய எண்ணங்களால் நிறைகிறது: " },
    { "target": "Strings/StringsFromCSFiles", "key": "Game1.cs.3095", "source": "It's strange, but the taste reminds you of ", "translation": "விசித்திரமாக இருந்தாலும், இந்தச் சுவை உங்களுக்கு இதை நினைவூட்டுகிறது: " },
    { "target": "Strings/StringsFromCSFiles", "key": "Game1.cs.3097", "source": "You feel an unwavering connection to the valley itself.", "translation": "இந்தப் பள்ளத்தாக்குடனே அசைக்க முடியாத பிணைப்பை உணர்கிறீர்கள்." },
    { "target": "Strings/StringsFromCSFiles", "key": "Game1.cs.3099", "source": "Your mind is filled with thoughts of... ConcernedApe? (Well, thanks!)", "translation": "உங்கள் மனம்... ConcernedApe பற்றிய எண்ணங்களால் நிறைகிறது? (நன்றி!)" },
