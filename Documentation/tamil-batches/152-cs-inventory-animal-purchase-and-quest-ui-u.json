    { "target": "Strings/StringsFromCSFiles", "key": "PurchaseAnimalsMenu.ChooseLocation", "source": "Where do you want to manage animals?", "translation": "விலங்குகளை எங்கே நிர்வகிக்க விரும்புகிறீர்கள்?" },
    { "target": "Strings/StringsFromCSFiles", "key": "PurchaseAnimalsMenu.cs.11311", "source": "Great! I'll send little {0} to his new home right away.", "translation": "அருமை! குட்டி {0}-ஐ உடனே புதிய வீட்டிற்கு அனுப்புகிறேன்." },
