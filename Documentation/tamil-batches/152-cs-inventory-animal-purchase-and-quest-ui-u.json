    { "target": "Strings/StringsFromCSFiles", "key": "PurchaseAnimalsMenu.cs.11321", "source": "That Building Is Full", "translation": "அந்தக் கட்டிடம் நிரம்பியுள்ளது" },
    { "target": "Strings/StringsFromCSFiles", "key": "PurchaseAnimalsMenu.cs.11326", "source": "{0}s Can't Live There.", "translation": "{0} அங்கு வாழ முடியாது." },
    { "target": "Strings/StringsFromCSFiles", "key": "PurchaseAnimalsMenu.cs.11334", "source": "Well cared-for adult chickens lay eggs every day.", "translation": "நன்கு பராமரிக்கப்படும் வளர்ந்த கோழிகள் தினமும் முட்டையிடும்." },
    { "target": "Strings/StringsFromCSFiles", "key": "PurchaseAnimalsMenu.cs.11335", "source": "Lives in the coop.", "translation": "கோழிக்கூடத்தில் வாழும்." },
    { "target": "Strings/StringsFromCSFiles", "key": "PurchaseAnimalsMenu.cs.11337", "source": "Happy adults lay duck eggs every other day.", "translation": "மகிழ்ச்சியான வளர்ந்த வாத்துகள் ஒருநாள் விட்டு ஒருநாள் முட்டையிடும்." },
    { "target": "Strings/StringsFromCSFiles", "key": "PurchaseAnimalsMenu.cs.11340", "source": "These are woolly rabbits! They shed precious wool every few days.", "translation": "இவை கம்பளி முயல்கள்! சில நாட்களுக்கு ஒருமுறை விலைமதிப்புள்ள கம்பளியை உதிர்க்கும்." },
    { "target": "Strings/StringsFromCSFiles", "key": "PurchaseAnimalsMenu.cs.11343", "source": "Adults can be milked daily. A milk pail is required to harvest the milk.", "translation": "வளர்ந்தவற்றிடம் தினமும் பால் கறக்கலாம். பாலைச் சேகரிக்கப் பால் வாளி தேவை." },
    { "target": "Strings/StringsFromCSFiles", "key": "PurchaseAnimalsMenu.cs.11344", "source": "Lives in the barn.", "translation": "தொழுவத்தில் வாழும்." },
    { "target": "Strings/StringsFromCSFiles", "key": "PurchaseAnimalsMenu.cs.11346", "source": "These pigs are trained to find truffles!", "translation": "இந்தப் பன்றிகள் டிரஃபிள்களைக் கண்டுபிடிக்கப் பயிற்றுவிக்கப்பட்டுள்ளன!" },
    { "target": "Strings/StringsFromCSFiles", "key": "PurchaseAnimalsMenu.cs.11349", "source": "Happy adults provide goat milk every other day. A milk pail is required to harvest the milk.", "translation": "மகிழ்ச்சியான வளர்ந்த வெள்ளாடுகள் ஒருநாள் விட்டு ஒருநாள் பால் தரும். பாலைச் சேகரிக்கப் பால் வாளி தேவை." },
    { "target": "Strings/StringsFromCSFiles", "key": "PurchaseAnimalsMenu.cs.11352", "source": "Adults can be shorn for wool. Sheep who form a close bond with their owners can grow wool faster. A pair of shears is required to harvest the wool.", "translation": "வளர்ந்தவற்றின் கம்பளியைக் கத்தரிக்கலாம். உரிமையாளருடன் நெருங்கிய பிணைப்பை உருவாக்கும் செம்மறியாடுகளுக்குக் கம்பளி வேகமாக வளரும். கம்பளியைச் சேகரிக்க ஒரு கத்தரிக்கோல் தேவை." },
    { "target": "Strings/StringsFromCSFiles", "key": "PurchaseAnimalsMenu.cs.11354", "source": "Livestock:", "translation": "கால்நடைகள்:" },
