  "records": [
    {
      "target": "Strings/1_6_Strings",
      "key": "Shop_Vincent",
      "source": "Hi! Um... I found some stuff. Wanna buy it!?",
      "translation": "สวัสดี! เอ่อ... ผมเจอของมานิดหน่อย คุณอยากซื้อไหม!?"
    },
    {
      "target": "Strings/1_6_Strings",
      "key": "Shop_Kent",
      "source": "Hey, I've got a few things for sale. Let me know if anything catches your eye.",
      "translation": "สวัสดี ผมมีของมาขายอยู่สองสามอย่าง ถ้ามีชิ้นไหนสะดุดตาก็บอกผมได้เลย"
    },
    {
      "target": "Strings/1_6_Strings",
      "key": "Shop_Eggs",
      "source": "T...Trade... E...Eggs...",
      "translation": "ล...แลก... ข...ไข่..."
    },
    {
      "target": "Strings/1_6_Strings",
      "key": "DF_Mine_Explanation",
      "source": "---Welcome to the Skull Cavern Challenge!---^^Calico Eggs and mysterious Calico Statues have appeared throughout the caverns.^",
      "translation": "---ยินดีต้อนรับสู่บททดสอบแห่งถ้ำกะโหลก!---^^ไข่คาลิโกและรูปปั้นคาลิโกอันลึกลับปรากฏอยู่ทั่วทั้งถ้ำ^"
    },
    {
      "target": "Strings/1_6_Strings",
      "key": "DF_Mine_Explanation_2",
      "source": "Your \"Egg Rating\" determines the likelihood of finding Calico Eggs.^^\"Egg Rating\" increases every 5 levels down, as well as whenever you activate a Calico Statue.^",
      "translation": "“คะแนนไข่” เป็นตัวกำหนดโอกาสที่จะพบไข่คาลิโก^^“คะแนนไข่” จะเพิ่มขึ้นทุกครั้งที่ลงไปครบ 5 ชั้น รวมถึงทุกครั้งที่เปิดใช้งานรูปปั้นคาลิโก^"
    },
    {
      "target": "Strings/1_6_Strings",
      "key": "DF_Mine_Explanation_3",
      "source": "...But be careful! The Calico Statues will also invoke various strange and dangerous effects!^^Visit Gil to receive prizes for achieving a high \"Egg Rating\".^",
      "translation": "...แต่ต้องระวัง! รูปปั้นคาลิโกยังก่อให้เกิดผลกระทบอันแปลกประหลาดและอันตรายในรูปแบบต่าง ๆ ด้วย!^^ไปหากิลเพื่อรับรางวัลจากการทำ “คะแนนไข่” ให้ได้สูง ๆ^"
    },
