    },
    {
      "target": "Strings/BigCraftables",
      "key": "Scarecrow_Name",
      "source": "Scarecrow",
      "translation": "หุ่นไล่กา"
    },
    {
      "target": "Strings/BigCraftables",
      "key": "Scarecrow_Description",
      "source": "Prevents crows from attacking your crops. Has a limited radius (about 8 \"tiles\").",
      "translation": "ป้องกันไม่ให้กาเข้ามาจิกกินพืชผลของคุณ มีรัศมีครอบคลุมจำกัด (ประมาณ 8 “ช่อง”)"
    },
    {
      "target": "Strings/BigCraftables",
      "key": "SeasonalDecor_Name",
      "source": "Seasonal Decor",
      "translation": "ของตกแต่งตามฤดูกาล"
    },
    {
      "target": "Strings/BigCraftables",
      "key": "SeasonalDecor_Description",
      "source": "This decoration changes with the seasons.",
      "translation": "ของตกแต่งชิ้นนี้จะเปลี่ยนรูปลักษณ์ไปตามฤดูกาล"
    },
    {
      "target": "Strings/BigCraftables",
      "key": "SeasonalPlant_Name",
      "source": "Seasonal Plant",
      "translation": "ต้นไม้ตามฤดูกาล"
    },
    {
      "target": "Strings/BigCraftables",
      "key": "SeasonalPlant_Description",
      "source": "An ornamental plant that changes with each season. It doesn't need to be watered.",
      "translation": "ไม้ประดับที่เปลี่ยนรูปลักษณ์ในแต่ละฤดู ไม่จำเป็นต้องรดน้ำ"
    },
    {
      "target": "Strings/BigCraftables",
      "key": "SeedMaker_Name",
      "source": "Seed Maker",
      "translation": "เครื่องทำเมล็ด"
    },
    {
      "target": "Strings/BigCraftables",
      "key": "SeedMaker_Description",
      "source": "Place crops inside to produce a varying amount of seeds. Doesn't work with fruit tree crops.",
      "translation": "ใส่พืชผลลงไปเพื่อผลิตเมล็ดพันธุ์ออกมาในจำนวนที่ไม่แน่นอน ใช้ไม่ได้กับผลผลิตจากไม้ผล"
    },
    {
      "target": "Strings/BigCraftables",
      "key": "SewingMachine_Name",
      "source": "Sewing Machine",
      "translation": "จักรเย็บผ้า"
    },
    {
      "target": "Strings/BigCraftables",
      "key": "SewingMachine_Description",
      "source": "Use to tailor clothes from the convenience of your home!",
      "translation": "ใช้ตัดเย็บเสื้อผ้าได้อย่างสะดวกสบายจากในบ้านของคุณ!"
    },
    {
      "target": "Strings/BigCraftables",
      "key": "SignOfTheVessel_Name",
      "source": "Sign Of The Vessel",
      "translation": "สัญลักษณ์แห่งภาชนะ"
    },
    {
      "target": "Strings/BigCraftables",
      "key": "SignOfTheVessel_Description",
      "source": "A decorative piece for your farm.",
      "translation": "ของตกแต่งสำหรับฟาร์มของคุณ"
    },
    {
