    {
      "target": "Strings/StringsFromCSFiles",
      "key": "Event.cs.1018",
      "source": "Maybe I was being a little presumptuous earlier... sorry.$5",
      "translation": "ก่อนหน้านี้ฉันอาจทึกทักไปเองนิดหน่อย... ขอโทษนะ$5"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "Event.cs.1020",
      "source": "Thanks for helping out in the lab.$h",
      "translation": "ขอบคุณที่มาช่วยในห้องทดลองนะ$h"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "Event.cs.1025",
      "source": "That was a beautiful ceremony. Congratulations!$h",
      "translation": "เป็นพิธีที่งดงามมาก ยินดีด้วยนะ!$h"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "Event.cs.1057",
      "source": "Ow...",
      "translation": "โอ๊ย..."
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "Event.cs.1058",
      "source": "I seem to have lost {0}g",
      "translation": "ดูเหมือนฉันจะเสียเงินไป {0}g"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "Event.cs.1060",
      "source": "It seems I've lost ",
      "translation": "ดูเหมือนฉันจะทำ "
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "Event.cs.1061",
      "source": "an item from my backpack.",
      "translation": "สิ่งของหนึ่งชิ้นจากกระเป๋าหาย"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "Event.cs.1062",
      "source": "{0} items from my backpack.",
      "translation": "สิ่งของ {0} ชิ้นจากกระเป๋าหาย"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "Event.cs.1063",
      "source": ", and ",
      "translation": " และ "
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "Event.cs.1068",
      "source": "Dr. Harvey charged me {0}g for the hospital visit. ",
      "translation": "คุณหมอฮาร์วีย์คิดค่ารักษาในโรงพยาบาล {0}g "
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "Event.cs.1070",
      "source": "I have no money, but Harvey was obligated to save my life free of charge. ",
      "translation": "ฉันไม่มีเงิน แต่ฮาร์วีย์จำเป็นต้องช่วยชีวิตฉันโดยไม่คิดค่าใช้จ่าย "
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "Event.cs.1071",
      "source": "It also appears that I've lost ",
      "translation": "และดูเหมือนฉันจะทำ "
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "Event.cs.1159",
      "source": "Received 1000g ",
