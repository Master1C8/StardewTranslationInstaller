  "records": [
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "RandomSentence.6",
      "source": "The Gigantic Submarine floated uncomfortably close to the Mermaid",
      "translation": "เรือดำน้ำมหึมาลอยใกล้นางเงือกจนน่าอึดอัด"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "RandomSentence.7",
      "source": "The Greasy Hyena stood too close to the other Hyena",
      "translation": "ไฮยีน่ามันเยิ้มยืนใกล้ไฮยีน่าอีกตัวมากเกินไป"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "RandomSentence.8",
      "source": "The Gloomy Elf danced atop the Tomb",
      "translation": "เอลฟ์หม่นหมองเต้นรำบนหลุมศพ"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "RandomSentence.9",
      "source": "The Crusty Lip cracked way above the Biscuit",
      "translation": "ริมฝีปากตกสะเก็ดแตกร้าวอยู่สูงเหนือบิสกิต"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "RandomSentence.10",
      "source": "The Rubbery Elf swam near the Disaster",
      "translation": "เอลฟ์ยางยืดว่ายน้ำใกล้หายนะ"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "RandomSentence.11",
      "source": "The Courageous Quail grilled far, far away from the other Quail",
      "translation": "นกกระทาผู้กล้าหาญย่างอยู่ไกลแสนไกลจากนกกระทาอีกตัว"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "RandomSentence.12",
      "source": "The Reasonable Hyena spoke with the Shoe",
      "translation": "ไฮยีน่าผู้มีเหตุผลพูดคุยกับรองเท้า"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "RandomSentence.13",
      "source": "The Practical Submarine cracked miles below the Mermaid",
      "translation": "เรือดำน้ำสารพัดประโยชน์แตกร้าวลึกลงไปใต้ตัวนางเงือกหลายไมล์"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "RandomSentence.14",
      "source": "The Lonely Puppet ran far, far away from the Planet",
      "translation": "หุ่นเชิดเดียวดายวิ่งหนีไปไกลแสนไกลจากดาวเคราะห์"
    },
