    {"target":"Strings/Objects","key":"JadeRing_Name","source":"Jade Ring","translation":"翡翠戒指"},
    {"target":"Strings/Objects","key":"JadeRing_Description","source":"Increases critical strike power by 10%.","translation":"暴擊威力提高10%。"},
    {"target":"Strings/Objects","key":"JadeStone_Name","source":"Jade Stone","translation":"翡翠礦石"},
