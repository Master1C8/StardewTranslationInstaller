    {"target":"Strings/Objects","key":"IceCrystal_Name","source":"Ice Crystal","translation":"冰晶"},
    {"target":"Strings/Objects","key":"IceCrystal_Description","source":"Might contain refined quartz.","translation":"可能含有精煉石英。"},
    {"target":"Strings/Objects","key":"IcePip_Name","source":"Ice Pip","translation":"冰刺魚"},
