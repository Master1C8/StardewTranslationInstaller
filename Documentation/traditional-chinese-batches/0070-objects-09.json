    {"target":"Strings/Objects","key":"IronBar_Name","source":"Iron Bar","translation":"鐵錠"},
    {"target":"Strings/Objects","key":"IronBar_Description","source":"A bar of pure iron.","translation":"一塊純鐵錠。"},
    {"target":"Strings/Objects","key":"IronFence_Name","source":"Iron Fence","translation":"鐵圍欄"},
    {"target":"Strings/Objects","key":"IronFence_Description","source":"Lasts longer than a stone fence.","translation":"比石圍欄更耐用。"},
    {"target":"Strings/Objects","key":"IronOre_Name","source":"Iron Ore","translation":"鐵礦石"},
    {"target":"Strings/Objects","key":"IronOre_Description","source":"A fairly common ore that can be smelted into bars.","translation":"相當常見、可冶煉成錠的礦石。"},
    {"target":"Strings/Objects","key":"IronStone_Name","source":"Iron Stone","translation":"鐵礦"},
