    {"target":"Strings/Objects","key":"IridiumBand_Name","source":"Iridium Band","translation":"銥環"},
    {"target":"Strings/Objects","key":"IridiumBand_Description","source":"Glows, attracts items, and increases attack damage by 10%.","translation":"會發光、吸引物品，並將攻擊傷害提高10%。"},
    {"target":"Strings/Objects","key":"IridiumBar_Name","source":"Iridium Bar","translation":"銥錠"},
