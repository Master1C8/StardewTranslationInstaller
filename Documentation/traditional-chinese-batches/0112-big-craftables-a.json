  "records": [
    {"target":"Strings/BigCraftables","key":"AncientStool_Name","source":"Ancient Stool","translation":"古代凳子"},
    {"target":"Strings/BigCraftables","key":"AncientStool_Description","source":"It smells like Grandma's apartment.","translation":"聞起來像奶奶的公寓。"},
    {"target":"Strings/BigCraftables","key":"AncientTable_Name","source":"Ancient Table","translation":"古代桌子"},
    {"target":"Strings/BigCraftables","key":"AncientTable_Description","source":"It's covered in the thickest cobwebs.","translation":"上面覆滿厚厚的蜘蛛網。"},
    {"target":"Strings/BigCraftables","key":"Anvil_Name","source":"Anvil","translation":"鐵砧"},
    {"target":"Strings/BigCraftables","key":"Anvil_Description","source":"Allows you to re-forge trinkets, randomizing their stats. Costs 3 iridium bars per use.","translation":"可重新鍛造飾品，隨機改變其屬性。每次使用消耗 3 個銥錠。"},
    {"target":"Strings/BigCraftables","key":"AutoGrabber_Name","source":"Auto-Grabber","translation":"自動採集器"},
    {"target":"Strings/BigCraftables","key":"AutoGrabber_Description","source":"Automatically harvests from your animals each morning. Must be placed inside a coop or barn.","translation":"每天早晨自動收取動物產品。必須放置在雞舍或畜棚內。"},
    {"target":"Strings/BigCraftables","key":"AutoPetter_Name","source":"Auto-Petter","translation":"自動撫摸機"},
    {"target":"Strings/BigCraftables","key":"AutoPetter_Description","source":"Joja Co. patented technology for coops and barns. Keeps your animals content, but can't replace the full benefit of human touch. Hand-petting can be provided to supplement.","translation":"Joja 公司為雞舍和畜棚研發的專利技術。能讓動物保持滿足，但無法完全取代人手撫摸的益處。可以再親手撫摸以補足效果。"},
    {"target":"Strings/BigCraftables","key":"BaitMaker_Name","source":"Bait Maker","translation":"魚餌製造機"},
    {"target":"Strings/BigCraftables","key":"BaitMaker_Description","source":"Place a fish inside to create targeted bait.","translation":"放入一條魚以製作針對性魚餌。"},
    {"target":"Strings/BigCraftables","key":"Barrel_Name","source":"Barrel","translation":"木桶"},
