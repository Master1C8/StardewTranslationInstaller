{
  "id": "0114-big-craftables-c",
  "kind": "short",
  "records": [
    {"target":"Strings/BigCraftables","key":"HousePlant_Description","source":"Adds some character to your home or farm.","translation":"為住家或農場增添一些特色。"},
    {"target":"Strings/BigCraftables","key":"Incubator_Name","source":"Incubator","translation":"孵化器"},
    {"target":"Strings/BigCraftables","key":"Incubator_Description","source":"Hatches eggs into baby chickens and ducks.","translation":"將雞蛋和鴨蛋孵化成幼雞與幼鴨。"},
    {"target":"Strings/BigCraftables","key":"IronLamppost_Name","source":"Iron Lamp-post","translation":"鐵製路燈"},
    {"target":"Strings/BigCraftables","key":"IronLamppost_Description","source":"Provides a good amount of light.","translation":"提供充足光線。"},
    {"target":"Strings/BigCraftables","key":"ItemPedestal_Name","source":"Item Pedestal","translation":"物品展示臺"},
    {"target":"Strings/BigCraftables","key":"ItemPedestal_Description","source":"A place to display an item.","translation":"用來展示一件物品。"},
    {"target":"Strings/BigCraftables","key":"JunimoChest_Name","source":"Junimo Chest","translation":"祝尼魔箱子"},
    {"target":"Strings/BigCraftables","key":"JunimoChest_Description","source":"Through the power of forest magic, every Junimo Chest links to the same stash.","translation":"藉由森林魔法的力量，所有祝尼魔箱子都連通同一個儲藏空間。"},
    {"target":"Strings/BigCraftables","key":"JunimoKartArcadeSystem_Name","source":"Junimo Kart Arcade System","translation":"祝尼魔賽車街機"},
    {"target":"Strings/BigCraftables","key":"JunimoKartArcadeSystem_Description","source":"Play 'Junimo Kart' at home!","translation":"在家遊玩《祝尼魔賽車》！"},
    {"target":"Strings/BigCraftables","key":"Keg_Name","source":"Keg","translation":"釀造桶"},
    {"target":"Strings/BigCraftables","key":"Keg_Description","source":"Place a fruit or vegetable in here. Eventually it will turn into a beverage.","translation":"放入水果或蔬菜，經過一段時間後就會變成飲料。"},
    {"target":"Strings/BigCraftables","key":"LawnFlamingo_Name","source":"Lawn Flamingo","translation":"草坪紅鶴"},
    {"target":"Strings/BigCraftables","key":"LawnFlamingo_Description","source":"A decorative piece for your farm.","translation":"一件裝飾農場的擺設。"},
    {"target":"Strings/BigCraftables","key":"LightningRod_Name","source":"Lightning Rod","translation":"避雷針"},
