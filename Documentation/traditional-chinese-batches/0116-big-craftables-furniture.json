    {"target":"Strings/BigCraftables","key":"Telephone_Name","source":"Telephone","translation":"電話"},
    {"target":"Strings/BigCraftables","key":"Telephone_Description","source":"Can be used to check store hours and inventory.","translation":"可用來查詢商店營業時間和庫存。"},
