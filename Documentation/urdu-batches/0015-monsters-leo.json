    { "target": "Characters/Dialogue/Leo", "key": "Mon", "source": "Hi... Everything okay?", "translation": "سلام... سب ٹھیک ہے؟" },
    { "target": "Characters/Dialogue/Leo", "key": "AcceptGift_(O)StardropTea", "source": "Wow, tastes just like golden walnuts! This is great!", "translation": "واہ، اس کا ذائقہ بالکل سنہرے اخروٹوں جیسا ہے! یہ بہت اچھا ہے!" },
    { "target": "Characters/Dialogue/Leo", "key": "AcceptGift_(TR)ParrotEgg", "source": "This is a precious egg... A baby! I'm glad you brought it to me, I'll keep it safe.", "translation": "یہ بہت قیمتی انڈا ہے... ایک بچہ! اچھا ہوا آپ اسے میرے پاس لائے، میں اسے محفوظ رکھوں گا۔" },
    { "target": "Characters/Dialogue/Leo", "key": "Mon4", "source": "I've learned a lot from my parrot family...#$b#But I'm sure there's a lot more out there I don't know.$s", "translation": "میں نے اپنے طوطوں کے خاندان سے بہت کچھ سیکھا ہے...#$b#لیکن یقیناً باہر اور بھی بہت کچھ ہے جو میں نہیں جانتا۔$s" },
    { "target": "Characters/Dialogue/Leo", "key": "Tue", "source": "When Sun is angry, it feels good in the jungle.#$e#Sun can't find us beneath the leaves. We trick him! Haha...$h", "translation": "جب سورج غصے میں ہو تو جنگل میں اچھا لگتا ہے۔#$e#سورج پتوں کے نیچے ہمیں ڈھونڈ نہیں سکتا۔ ہم نے اسے چکما دے دیا! ہاہا...$h" },
    { "target": "Characters/Dialogue/Leo", "key": "Wed", "source": "...Sorry... I'm shy today.$3", "translation": "...معاف کریں... آج مجھے شرم آ رہی ہے۔$3" },
    { "target": "Characters/Dialogue/Leo", "key": "Wed2", "source": "Be careful in the volcano... the spirits don't like outsiders.", "translation": "آتش فشاں میں احتیاط کریں... روحیں باہر والوں کو پسند نہیں کرتیں۔" },
    { "target": "Characters/Dialogue/Leo", "key": "Thu", "source": "Have you met the others like you?#$b#I don't talk to them much. I feel safer with my own kind...$3", "translation": "کیا آپ اپنے جیسے دوسرے لوگوں سے ملے ہیں؟#$b#میں ان سے زیادہ بات نہیں کرتا۔ مجھے اپنی ہی قسم کے ساتھ زیادہ تحفظ محسوس ہوتا ہے...$3" },
    { "target": "Characters/Dialogue/Leo", "key": "Fri", "source": "One time... I was at the top of the volcano at night, and I saw lights far, far away.#$b#I wonder if there are other bird families out there?$3", "translation": "ایک بار... میں رات کو آتش فشاں کی چوٹی پر تھا اور بہت، بہت دور روشنیاں دیکھیں۔#$b#پتا نہیں باہر پرندوں کے اور خاندان بھی ہیں؟$3" },
    { "target": "Characters/Dialogue/Leo", "key": "Fri4", "source": "I wonder if I could see your home from the top of the volcano?", "translation": "کیا آتش فشاں کی چوٹی سے آپ کا گھر دکھائی دے سکتا ہے؟" },
    { "target": "Characters/Dialogue/Leo", "key": "Sat", "source": "...I'm sad today.$s#$e#You go on... have fun. Let me be sad.$s", "translation": "...آج میں اداس ہوں۔$s#$e#آپ جائیں... مزے کریں۔ مجھے اداس رہنے دیں۔$s" },
    { "target": "Characters/Dialogue/Leo", "key": "Sun", "source": "When it rains, strange birds visit.#$b#I try to speak to them... but they fly away.$s#$b#I guess they don't want to be friends...$s", "translation": "جب بارش ہوتی ہے تو اجنبی پرندے آتے ہیں۔#$b#میں ان سے بات کرنے کی کوشش کرتا ہوں... مگر وہ اڑ جاتے ہیں۔$s#$b#شاید وہ دوست نہیں بننا چاہتے...$s" }
  ]
