    {
      "target": "Strings/StringsFromCSFiles",
      "key": "PurchaseAnimalsMenu.cs.11334",
      "source": "Well cared-for adult chickens lay eggs every day.",
      "translation": "Gà trưởng thành được chăm sóc tốt sẽ đẻ trứng mỗi ngày."
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "PurchaseAnimalsMenu.cs.11335",
      "source": "Lives in the coop.",
      "translation": "Sống trong Chuồng gà."
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "PurchaseAnimalsMenu.cs.11337",
      "source": "Happy adults lay duck eggs every other day.",
      "translation": "Vịt trưởng thành vui vẻ sẽ đẻ trứng cách ngày."
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "PurchaseAnimalsMenu.cs.11340",
      "source": "These are woolly rabbits! They shed precious wool every few days.",
      "translation": "Đây là những chú thỏ lông xù! Cứ vài ngày chúng lại rụng bộ lông quý giá."
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "PurchaseAnimalsMenu.cs.11343",
      "source": "Adults can be milked daily. A milk pail is required to harvest the milk.",
      "translation": "Con trưởng thành có thể được vắt sữa hằng ngày. Cần Xô Vắt sữa để lấy sữa."
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "PurchaseAnimalsMenu.cs.11344",
      "source": "Lives in the barn.",
      "translation": "Sống trong Chuồng gia súc."
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "PurchaseAnimalsMenu.cs.11346",
      "source": "These pigs are trained to find truffles!",
      "translation": "Những chú heo này được huấn luyện để tìm nấm truffle!"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "PurchaseAnimalsMenu.cs.11349",
      "source": "Happy adults provide goat milk every other day. A milk pail is required to harvest the milk.",
      "translation": "Dê trưởng thành vui vẻ sẽ cho sữa cách ngày. Cần Xô Vắt sữa để lấy sữa."
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "PurchaseAnimalsMenu.cs.11352",
      "source": "Adults can be shorn for wool. Sheep who form a close bond with their owners can grow wool faster. A pair of shears is required to harvest the wool.",
      "translation": "Cừu trưởng thành có thể được xén lông. Cừu gắn bó thân thiết với chủ sẽ mọc lông nhanh hơn. Cần Kéo Xén lông để thu hoạch."
    },
