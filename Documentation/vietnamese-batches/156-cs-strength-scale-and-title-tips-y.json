    {
      "target": "Strings/StringsFromCSFiles",
      "key": "StrengthGame.cs.11705",
      "source": "Wow. Zero strength. I'm actually impressed with how weak you are. Here's a star token.",
      "translation": "Chà. Sức mạnh bằng không. Tôi thật sự ấn tượng vì bạn yếu đến thế. Đây, nhận một Xu Sao."
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "TitleMenu.cs.11717",
      "source": "Welcome back!",
      "translation": "Chào mừng trở lại!"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "TitleMenu.cs.11718",
      "source": "Plug in an Xbox One or Xbox 360 controller to activate game pad mode.",
      "translation": "Cắm tay cầm Xbox One hoặc Xbox 360 để kích hoạt chế độ tay cầm."
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "TitleMenu.cs.11719",
      "source": "Tip: Giving gifts is a good way to make friends with the residents of Stardew Valley.",
      "translation": "Mẹo: Tặng quà là cách tốt để kết bạn với cư dân Thung lũng Stardew."
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "TitleMenu.cs.11720",
      "source": "Tip: Shift-click to purchase 5 items at a time.",
      "translation": "Mẹo: Giữ Shift và nhấp để mua 5 món cùng lúc."
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "TitleMenu.cs.11721",
      "source": "After upgrading your hoe or watering can, hold down the tool button to increase the area of effect!",
      "translation": "Sau khi nâng cấp Cuốc hoặc Bình tưới, hãy giữ nút công cụ để tăng vùng tác dụng!"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "TitleMenu.cs.11722",
      "source": "Tip: Right-click to use a weapon's special move.",
      "translation": "Mẹo: Nhấp chuột phải để dùng chiêu đặc biệt của vũ khí."
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "TitleMenu.cs.11723",
      "source": "Watch TV shows to learn useful tips, cooking recipes, and more!",
      "translation": "Xem các chương trình TV để học mẹo hữu ích, công thức nấu ăn và nhiều điều khác!"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "TitleMenu.cs.11724",
      "source": "The traveling merchant visits Stardew Valley twice a week. She sells a wide variety of goods, often at exorbitant prices!",
      "translation": "Thương nhân lữ hành ghé Thung lũng Stardew hai lần mỗi tuần. Cô ấy bán đủ loại hàng hóa, thường với giá cắt cổ!"
    },
    {
      "target": "Strings/StringsFromCSFiles",
      "key": "TitleMenu.cs.11725",
      "source": "Thanks for playing!",
      "translation": "Cảm ơn bạn đã chơi!"
    },
    {
      "target": "Strings/StringsFromCSFiles",
