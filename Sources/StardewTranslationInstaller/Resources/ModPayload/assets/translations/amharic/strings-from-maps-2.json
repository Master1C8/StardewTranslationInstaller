      "Entries": {
        "HarveyRoom.13": "\"ከመሬት ወደ አየር የሬዲዮ ፕሮቶኮል\"",
        "HarveyRoom.14": "በጣም መደበኛ ቴሌቪዥን ነው። በታሪክ ጣቢያ ላይ ተቀናብሯል።",
        "Hospital.1": "የመርከቡ ምልክት። በዮባ የሚያምኑትን ለማጽናናት እዚህ አለ።",
        "Hospital.2": "የናሙና ማሰሮ ነው። ጣቶችህን በውስጡ ባታስገባ ይሻላል።",
        "Hospital.3": "${እጆችህን^እጆችሽን}$ እዚያ ማስገባት ጥሩ ሐሳብ አይመስልም። ጥቅም ላይ በዋሉ መርፌዎች፣ በቆሸሹ ጥጥዎችና ሃርቪ በሰዎች ጆሮ ውስጥ ባስገባቸው ትንንሽ አፍንጫዎች የተሞላ ነው።",
        "Hospital.4": "ሕይወት አንዳንድ ጊዜ ከባድ ነው? ትኩረትህን ማቆየት ያስቸግርሃል? ስለ ፕራቮሎክሲኖን ሐኪምህን አነጋግር።^(ፕራቮሎክሲኖን ለሁሉም ሰው አይሆንም። የጎንዮሽ ጉዳቶች እንቅልፍ ማጣት፣ ከባድ ቁጣ፣ መቆጣጠር የማይቻል የጉሮሮ እብጠት፣ የከንፈር ቀለም በቋሚነት መቀየር፣ ፀጉር መርገፍና ስትሮክን ሊያካትቱ ይችላሉ። እጅግ አልፎ አልፎ (ከ500 1)፣ የሙከራ ተሳታፊዎች አንድ ወይም ከዚያ በላይ አጥንቶች ሙሉ በሙሉ ሲበታተኑ አጋጥሟቸዋል።) ",
        "Hospital.5": "'በሽታን አታሰራጭ... ስታስነጥስ ${አፍህን^አፍሽን}$ ሸፍን!'",
        "Hospital.6": "ይህ ክሊኒክ በፈርንጊል ሪፐብሊክ የጤና ባለሥልጣን የሕክምና ሥራ ፈቃድ አግኝቷል።",
        "Hospital.7": "ሄይ፣ ይህ ተክል ሐሰተኛ ነው!",
        "JojaMart.1": "የሆይሲን ስስ",
        "JojaMart.2": "'የሜፕል ስስ'... ሽሮፕን በጣም ይመስላል!",
        "JojaMart.3": "ስኳር የሌላቸው ማርሽማሎዎች",
        "JojaMart.4": "የሕፃናት ታኮ ስስ",
        "JojaMart.5": "የሆይሲን ስስ",
        "JojaMart.6": "ጨው",
        "JojaMart.7": "የፕሮቲን ባሮች",
        "JojaMart.8": "ስኳር የሌለው ሎሊፖፕ",
        "JojaMart.9": "ባለ24-እህል ዳቦ",
        "JojaMart.10": "የ'ሜይፑል' ሽሮፕ",
        "JojaMart.11": "የፀጉር ጄል -- ኤሌክትሪክ ሰማያዊ",
        "JojaMart.12": "የአያት ስስ",
        "JojaMart.13": "የታሸገ ሾርባ",
        "JojaMart.14": "ድርብ ቅቤ ራንች ቺፕስ",
        "JojaMart.15": "የጆጃ ኮርፖሬሽን ሁለገብ ስስ",
        "JojaMart.16": "የፕሬትዘል መክሰስ",
        "JojaMart.17": "ጆጃዳይት -- ዝቅተኛ ስብ ያለው ባቄላ! በጣፋጭ የስኳር ስስ",
        "JojaMart.18": "የፕሮቲን መጠጦች",
        "JojaMart.19": "ባለ11-እህል ዳቦ",
        "JojaMart.20": "የደረጃ D የማብሰያ ዘይት",
        "JojaMart.21": "የፀጉር ጄል -- እጅግ ጠንካራ ማያዣ",
        "JojaMart.22": "በጣም ቀላል ስስ",
        "JojaMart.23": "ወደ ቤት የሚወሰድ የቹሮ ስብስብ",
        "JojaMart.24": "በአስፈላጊ ንጥረ ምግቦች የበለጸገ ነጭ ዳቦ",
        "JojaMart.25": "የሜስኪት ጣዕም ያለው የባርቤኪው ማጨሻ ቤት ቺፕስ",
        "JojaMart.26": "ጆጃዳይት -- ዝቅተኛ ስብ ያለው ባቄላ! በጣፋጭ የስኳር ስስ",
        "JojaMart.27": "ማሪናራ ስስ",
        "JojaMart.28": "100% ንጹሕ የማር ጣዕም ያለው 'ስስ'",
        "JojaMart.29": "የነጭ ፈንገስ ሶዳ",
        "JojaMart.30": "የሚጠጣ የኬክ ቅባት",
        "JojaMart.31": "የበቀለ ስንዴ ዳቦ",
        "JojaMart.32": "በከፊል ሃይድሮጂን የተጨመረበት የበቆሎ ዘይት",
        "JojaMart.33": "የጥርስ ክር",
        "JojaMart.34": "ቀላል ስስ",
        "JojaMart.35": "100% ንጹሕ የማር ጣዕም ያለው 'ስስ'",
        "JojaMart.36": "የታሸገ ሽሪምፕ።",
        "JojaMart.37": "የቀረፋ ስኳር ቺፕስ",
        "JojaMart.38": "የነጭ ፈንገስ ሶዳ",
        "JojaMart.39": "ፔስቶ",
        "JojaMart.40": "እርሾ",
        "JojaMart.41": "የፕሮቲን ዱቄት",
        "JojaMart.42": "የኮኮዋ ዘፐሊኖች",
        "JojaMart.43": "የአጃ ዳቦ",
        "JojaMart.44": "ሰው ሠራሽ ቅቤ -- ርካሽ ነው!",
        "JojaMart.45": "የአፍ ማጠቢያ",
        "JojaMart.46": "ወደ-ድንገተኛ-ሕክምና-ክፍል-ውሰደኝ ስስ",
        "JojaMart.47": "እርሾ",
        "JojaMart.48": "የደረቀ የሽሪምፕ መክሰስ።",
        "JojaMart.49": "የሸንኮራ አገዳ ቺፕስ",
        "JojaMart.50": "የስኳር ኮኖች",
        "JojaMart.51": "የዱቄት ቁርስ -- ውሃ ብቻ ጨምር። (እንቁላልና ድንች)",
        "JojaMart.52": "የሚያንቀጠቅጥ ጭማቂ",
        "JojaMart.53": "ሞኝ ስስ",
        "JojaMart.54": "ቡናማ ዳቦ",
        "JojaMart.55": "የዱቄት ክሬም",
        "JojaMart.56": "የጥርስ ሳሙና",
        "JojaMart.57": "ሊቋቋሙት የማይቻል የስቃይ ነበልባል ስስ",
        "JojaMart.58": "የስኳር ኮኖች",
        "JojaMart.59": "ርካሽ ወይን",
        "JojaMart.60": "የዱቄት ቁርስ -- ውሃ ብቻ ጨምር። (እንቁላልና ድንች)",
        "JojaMart.61": "የቪጋን ቋሊማ",
        "JojaMart.62": "የስኳር ኮከቦች",
        "JojaMart.63": "የዱቄት ወይን",
        "JojaMart.64": "የፍንዳታ ጭማቂ",
        "JojaMart.65": "የራይ ዳቦ",
        "JojaMart.66": "የዱቄት ቅቤ",
        "JojaMart.67": "የእጅ ሳሙና",
        "JojaMart.68": "የሚያቃጥል ህመም ስስ",
        "JojaMart.69": "የስኳር ኮከቦች",
        "JojaMart.70": "እጅግ ከባድ ቺፕዝ",
        "JojaMart.71": "ከኢንፈርኖ ስስ ጋር እጅግ ከባድ ቺፕስ",
        "JojaMart.72": "የዱቄት ወይን",
        "JojaMart.73": "የኮኮናት ሥጋ",
        "JojaMart.74": "ማስቲካ ከረሜላዎች",
        "JojaMart.75": "የታሸጉ የተከረባበቱ እንቁላሎች",
        "JojaMart.76": "ሰማያዊ ኤሊየን ኃይል... ተወንጨፍ",
        "JojaMart.77": "የወይን ፍሬ ኒብል-ፔብልስ",
        "JojaMart.78": "እርሾ የተጨመረበት ዳቦ",
        "JojaMart.79": "የጆጃ ዘይት -- የጣፋጭ ዘይቶች የግል ድብልቅ። ለማንኛውም ዓላማ ተጠቀምበት።",
        "JojaMart.80": "የጆጃ ሁለገብ ሳሙና -- ${ለልብስህ^ለልብስሽ}$፣ ${ለዕቃዎችህ^ለዕቃዎችሽ}$፣ ${እጆችህን^እጆችሽን}$ ለማጽዳት፣ እንደ ሻምፑና እንደ የጥርስ ሳሙናም ተጠቀምበት! ጣፋጭ የኬክ ቅባት ለመሥራት ከጆጃሚል ጋር ቀላቅለው።",
        "JojaMart.81": "የኢንፈርኖ ስስ",
        "JojaMart.82": "ማስቲካ ከረሜላዎች",
        "JojaMart.83": "የንጹሕ ግሉተን ዲስኮችና ክብ ቁራጮች።",
        "JojaMart.84": "የታሸጉ የተከረባበቱ እንቁላሎች",
        "JojaMart.85": "የፍራፍሬ መክሰሶች",
        "JojaMart.86": "የታሸገ ዓሣ... አሁን ጥርስን ከሚያነጣ ስስ ጋር።",
        "JojaMart.87": "ሃይፐር ጭማቂ",
        "JojaMart.88": "የእንጆሪ ጣዕም ያላቸው ሎሊፖፖች",
        "JojaMart.89": "ዳቦ",
        "JojaMart.90": "የካኖላ ዘይት",
        "JojaMart.91": "የልብስ ማጠቢያ ሳሙና -- አሁን 10x መዓዛ አለው!"
      }
    }
  ]
}
