      "Entries": {
        "Willy_Name": "  !",
        "Willy_Text": " ,    ।  ,  ...       ...     ।",
        "Willy_Objective_0_Text": "    ",
        "Willy_Objective_1_Text": "      ।",
        "Pam_Name": " ",
        "Pam_Text": ",             ,  ।       -   ?",
        "Pam_Objective_0_Text": "       ",
        "Pam_Objective_1_Text": "    ।",
        "Pierre_Name": "  ",
        "Pierre_Text": "।              ...      -   , ?",
        "Pierre_Objective_0_Text": "   ",
        "Pierre_Objective_1_Text": "      ।",
        "Robin_Name": " ",
        "Robin_Text": " !       ,       ।    ?                     -",
        "Robin_Objective_0_Text": "    ।",
        "Robin_Objective_1_Text": "     ।",
        "Emily_Name": " ",
        "Emily_Text": " !    \" \"  ,         ।     ?",
        "Emily_Objective_0_Text": "   ",
        "Emily_Objective_1_Text": "   ",
        "Emily_Objective_2_Text": "   ",
        "Emily_Objective_3_Text": "   ",
        "Emily_Objective_4_Text": "   ",
        "Demetrius_Name": "   ",
        "Demetrius_Text": "   {FishType:Text}-     ।        ।",
        "Demetrius_Objective_0_Text": " {FishType:Text} ।",
        "Demetrius2_Name": " ",
        "Demetrius2_Text": "   {FishType:Text}-     ।        ।",
