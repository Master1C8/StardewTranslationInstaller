        "Gus_Name": "  ",
        "Gus_Text": "{Greeting}...      ।   ?                -",
        "Gus_Objective_0_Text": "   ।",
        "Gus_Objective_1_Text": "   ।",
        "Gus_RE_Greeting_0": "      ",
        "Gus_RE_Greeting_1": "     ",
        "Lewis_Name": " ",
        "Lewis_Text": "{Text}      {Crop:TextPlural}          ।",
        "Lewis_Objective_1_Text": " {Crop:Text} ।",
        "Lewis_Objective_0_Text": " {Crop:Text} ।",
        "Lewis_RE_Text_0": "  {Crop:TextPluralCapitalized}-   ।",
        "Lewis_RE_Text_1": " ,   {Crop:TextPlural}-  ''    ।",
        "Lewis_RE_Text_2": "     ...  , {Crop:Text}       ।",
        "Lewis_RE_Text_3": "    {Crop:Text}   ।      !",
        "Lewis_RE_Text_4": "    ,     {Crop:TextPlural}  ।",
        "Wizard_Name": "  ",
        "Wizard_Text": " ''         ।      ।      -. ",
        "Wizard_Objective_0_Text": "   ",
        "Wizard_Objective_0_Message": ",     ... ।$h#$b#  !          ।",
        "Clint_Name": " ",
        "Clint_Text": "  {Monster:LocalizedName}-       ...  ,   !          ।          -",
        "Clint_Objective_0_Text": " {Monster:LocalizedName}  ।",
        "Clint_RE_Monster_0_LocalizedName": "",
        "Clint_RE_Monster_1_LocalizedName": " ",
        "Clint_RE_Monster_2_LocalizedName": "",
        "Clint_RE_Monster_3_LocalizedName": "",
        "Linus_Name": "  ",
        "Linus_Text": "   ।    ।           ?                     -",
        "Linus_Objective_0_Text": "   ।",
        "Linus_Objective_1_Text": "       ।",
        "Evelyn_Name": "  ",
        "Evelyn_Text": " ,      ।      !     ...    ।                      -",
        "Evelyn_Objective_0_Text": "   ।",
        "Evelyn_Objective_1_Text": "   ।",
        "Wizard2_Name": " ",
        "Wizard2_Text": "            ।          ।        -. ",
        "Wizard2_Objective_0_Text": "    ।",
        "Wizard2_Objective_1_Text": "    ",
        "Wizard2_Objective_1_Message": "...    ।   ,   !$h#$b#    !    ।",
        "Robin2_Name": "   ",
        "Robin2_Text": "       ।     {Resource:Text}     ।  {Resource:Text}    !             -",
        "Robin2_Objective_0_Text": " {Resource:Text}  ।",
        "Gunther_Name": " ",
        "Gunther_Text": "     !       ।      !          -",
        "Gunther_Objective_1_Text": "    ।",
        "Gunther_Objective_0_Text": "     ।",
        "Caroline_Name": " ",
        "Caroline_Text": "     ,    ।   {Crop:TextPlural}     !",
        "Caroline_Objective_0_Text": " {Crop:Text} ।",
        "Willy2_Name": " ",
        "Willy2_Text": "     ...             ,    ।",
