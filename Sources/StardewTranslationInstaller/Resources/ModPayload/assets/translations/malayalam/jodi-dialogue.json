        "fall_Sun2": "   .#$e#   ...    .",
        "winter_Mon": "     .         .$h",
        "winter_Tue": ".      ?#$e# .",
        "winter_Tue6": "**...   ...      .  ?$s#$e# .$4",
        "winter_Wed2": "  ? ...   .#$e# .$s",
        "winter_Wed4_2": "   ,    .$s",
        "winter_Thu": "    .    .",
        "winter_Thu_inlaw_Sam": " ?  ,       ...",
        "winter_Thu8": "      ...      ;    .$s#$e#   .$4",
        "winter_Fri": "    ...$s",
        "winter_Sun": "       .#$e#,  !$h",
        "fall_Mon6": "     .    .    .$s"
