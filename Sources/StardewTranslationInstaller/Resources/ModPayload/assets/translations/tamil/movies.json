        "NaturalWonders_Title": " :    ",
        "NaturalWonders_Description": "     ...     ,    !",
        "NaturalWonders_Scene1": "' :    '",
        "NaturalWonders_Scene2": "  80      .     ;  ...",
        "NaturalWonders_Scene3": "      ...  ,    !",
        "NaturalWonders_Scene4": "     .         .",
        "NaturalWonders_Scene5": "  ;     ...",
        "NaturalWonders_Scene6": " ,       .  ,     .",
        "NaturalWonders_Scene7": "    !",
        "NaturalWonders_Scene8": ",          .",
