        "derby_contestent0": ":     .||:       !",
        "derby_contestent1": ":         .",
        "derby_contestent2": ": ...       .  !",
        "derby_contestent3": ": ,    .||: ...||: ...||: ...||:    ?||: ...||: ...||: ...||:    ;   .||:...",
        "derby_contestent4": " :    !|| :    !   !",
