        "derby_contestent7": ":   ?   .",
        "derby_contestent8": " :     ,  ...         !|| :     ...   !|| :   ,        ...",
        "derby_contestent9": ": ,  .       .",
        "winter_derby_contestent0": ":     .          .",
        "winter_derby_contestent1": ":          .||:       .",
