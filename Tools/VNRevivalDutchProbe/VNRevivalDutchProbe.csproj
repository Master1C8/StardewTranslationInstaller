<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UseAppHost>false</UseAppHost>
    <TargetFramework>net6.0</TargetFramework>
    <!-- The installed game and its Harmony build run on .NET 6. -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../VNRevivalLanguageSwitcher/VNRevivalLanguageSwitcher.csproj" />
    <Reference Include="Stardew Valley" HintPath="$(StardewGamePath)/Stardew Valley.dll" Private="false" />
    <Reference Include="MonoGame.Framework" HintPath="$(StardewGamePath)/MonoGame.Framework.dll" Private="false" />
    <Reference Include="StardewValley.GameData" HintPath="$(StardewGamePath)/StardewValley.GameData.dll" Private="false" />
    <Reference Include="StardewModdingAPI" HintPath="$(StardewGamePath)/StardewModdingAPI.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(StardewGamePath)/smapi-internal/0Harmony.dll" Private="false" />
  </ItemGroup>
</Project>
