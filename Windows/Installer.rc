#include <windows.h>

1 ICON "App.ico"
1 RT_MANIFEST "Installer.manifest"

1 VERSIONINFO
FILEVERSION VERSION_MAJOR,VERSION_MINOR,VERSION_PATCH,0
PRODUCTVERSION VERSION_MAJOR,VERSION_MINOR,VERSION_PATCH,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "VN Revival\0"
      VALUE "FileDescription", "Stardew Translation Installer\0"
      VALUE "FileVersion", VERSION_TEXT "\0"
      VALUE "InternalName", "Stardew Translation Installer.exe\0"
      VALUE "OriginalFilename", "Stardew Translation Installer.exe\0"
      VALUE "ProductName", "VN Revival Languages for Stardew Valley\0"
      VALUE "ProductVersion", VERSION_TEXT "\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
